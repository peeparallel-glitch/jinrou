      { id: 9,  archetype: "疑心暗鬼オオカミ", logicLevel: 0.55, aggression: 0.85, stubbornness: 0.80, coPreference: 0.75, speechStyle: "誰彼構わず怪しむピリピリした口調", quotePrefix: "全員の裏の顔が怪しく見えてきたよ！", quoteSuffix: "誰も信用できない！白黒を突きつけよう！" },
      { id: 10, archetype: "セオリー信奉者", logicLevel: 0.85, aggression: 0.45, stubbornness: 0.70, coPreference: 0.65, speechStyle: "審判会議のセオリーを説く口調", quotePrefix: "審判会議の定石通りに進めるべきだよ、", quoteSuffix: "定石から外れた不自然な行動は悪手でしかない。" },
      { id: 11, archetype: "揺さぶり巧者",  logicLevel: 0.75, aggression: 0.75, stubbornness: 0.40, coPreference: 0.80, speechStyle: "相手に揺さぶりをかける挑発的口調", quotePrefix: "フフッ、面白い主張をしてくれるね、", quoteSuffix: "その必死な弁明が真実かどうか試させてもらうよ。" },
      { id: 12, archetype: "頑固一徹型",    logicLevel: 0.35, aggression: 0.70, stubbornness: 0.95, coPreference: 0.40, speechStyle: "一度決めた疑いを曲げない意固地口調", quotePrefix: "一度疑ったら私はブレないよ！", quoteSuffix: "どんなに言い訳されても私の疑いは変わらない！" },
      { id: 13, archetype: "無口な観察者",  logicLevel: 0.80, aggression: 0.30, stubbornness: 0.45, coPreference: 0.25, speechStyle: "短文で鋭い指摘をする物静かな口調", quotePrefix: "……静かにログを精査していたが、", quoteSuffix: "……この一点の食い違いだけは看過できない。" },
      { id: 14, archetype: "熱血正義漢",    logicLevel: 0.50, aggression: 0.85, stubbornness: 0.60, coPreference: 0.75, speechStyle: "村のために熱く叫ぶ正義派口調", quotePrefix: "村人を守るために全力で発言するぞ！", quoteSuffix: "村の勝利のために堂々と真実を語ろう！" },
      { id: 15, archetype: "狡猾な策士",    logicLevel: 0.85, aggression: 0.65, stubbornness: 0.35, coPreference: 0.90, speechStyle: "裏で誘導をかける策士風口調", quotePrefix: "盤面の裏ラインを計算してみたんだけど、", quoteSuffix: "導き出される結論に従うのが一番賢明だよ。" },
      { id: 16, archetype: "能天気フワフワ型", logicLevel: 0.25, aggression: 0.25, stubbornness: 0.30, coPreference: 0.35, speechStyle: "マイペースでフワッとした口調", quotePrefix: "え〜っとね、フワッと感じたことだけど、", quoteSuffix: "なんとなく怪しい気がするんだよね〜。" },
      { id: 17, archetype: "分析系データ派", logicLevel: 0.95, aggression: 0.40, stubbornness: 0.50, coPreference: 0.50, speechStyle: "確率は数字で語るデータ主義口調", quotePrefix: "統計データと投票確率から算出すると、", quoteSuffix: "感情論抜きで数字の示す可能性に注目すべきです。" },
      { id: 18, archetype: "命乞い防衛型",  logicLevel: 0.40, aggression: 0.65, stubbornness: 0.75, coPreference: 0.80, speechStyle: "自身への疑いに全力で反論する口調", quotePrefix: "私を疑うなんてあり得ないよ！", quoteSuffix: "身の潔白を証明するために絶対に引かないよ！" },
      { id: 19, archetype: "皮肉屋観察官",  logicLevel: 0.80, aggression: 0.70, stubbornness: 0.55, coPreference: 0.45, speechStyle: "皮肉を交えて相手を突き刺す口調", quotePrefix: "また随分と苦しい言い訳を聞かされたね、", quoteSuffix: "矛盾を誤魔化す手口としては少々お粗末じゃない？" },
      { id: 20, archetype: "柔軟な推理作家", logicLevel: 0.80, aggression: 0.50, stubbornness: 0.15, coPreference: 0.55, speechStyle: "多様な仮説を組み立てる柔軟な口調", quotePrefix: "いくつかの可能性を物語として仮説立てると、", quoteSuffix: "柔軟に新しい視点を取り入れて推理を更新したいね。" }
    ];

    // プロファイルのシャッフル割り当て
    function assignProfilesToPlayers(chars) {
      if (!gameState.charProfiles) gameState.charProfiles = {};
      const shuffled = [...AI_PROFILES].sort(() => 0.5 - Math.random());
      chars.forEach((c, idx) => {
        gameState.charProfiles[c] = shuffled[idx % shuffled.length];
      });
    }

    // Reset game state helper update
    // =====================================================
    // 🤝 信頼度システム（Trust Rate System）
    // =====================================================

    // 証言拒否テキスト（信頼度 20% 以下時に発動・多言語対応）
    const TRUST_REFUSAL_MESSAGES = {
      ja: [
        "……あんたに話す言葉などない。どうせまた無実の者を殺すのだろう？",
        "神眼だか何だか知らんが、勇者の審判などもう誰も信じていないぞ！",
        "口を開けば明日の犠牲者にされる……何も話すつもりはない！",
        "責任転嫁のために私を利用する気か？ 答える価値もないな。",
        "無実の者を血祭りにあげておいて、よくもぬけぬけと質問できるものだ……！"
      ],
      en: [
        "...I have no words for thee. Shalt thou merely slaughter another innocent?",
        "Divine Eye or not, no soul in this village trusts the Hero's judgment anymore!",
        "If I speak, I shall become tomorrow's sacrifice... I shall say naught!",
        "Dost thou seek to scapegoat me? Thou art unworthy of an answer.",
        "Having bathed thine hands in innocent blood, how darest thou question me so brazenly...!"
      ],
      zh: [
        "……我与你无话可说。反正你又要滥杀无辜之人了吧？",
        "什么神眼圣目，这村里早已无人再信勇者的所谓审判了！",
        "一旦开口便会被打成明日的祭品……我无可奉告！",
        "想把罪责推卸到我身上？休想得到半句回应。",
        "刚将无辜村民送上断头台，竟还敢厚颜无耻地前来盘问……！"
      ],
      ko: [
        "……당신에게 해줄 말 따윈 없소. 어차피 또 무고한 자를 죽일 셈이지?",
        "신의 눈인지 뭔지 몰라도, 이제 용사의 심판 따위 아무도 믿지 않소!",
        "입을 열었다간 내일의 희생양이 될 뿐… 아무것도 말하지 않겠소!",
        "책임을 전가하기 위해 날 이용하려는 건가? 대답할 가치도 없소.",
        "죄 없는 자를 제물로 바쳐놓고, 뻔뻔스럽게도 질문을 던지다니……!"
      ]
    };

    function getTrustRefusalMessage() {
      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';
      const pool = TRUST_REFUSAL_MESSAGES[lang] || TRUST_REFUSAL_MESSAGES.ja;
      return pickRandom(pool);
    }

    // AI性格プロファイルごとの quotePrefix 多言語辞書
    const AI_PROFILE_PREFIX_I18N = {
      1: { ja: "過去ログと投票ラインを分析した結果ですが、", en: "Analyzing the logs and voting records reveals that ", zh: "分析过往发言与投票痕迹后可知，", ko: "지난 기록과 투표선을 분석한 결과입니다만, " },
      2: { ja: "ハッキリ言って怪しすぎるよ！", en: "Plainly put, this is utterly suspicious! ", zh: "直白地说，这未免太可疑了！", ko: "솔직히 말해 너무 수상하잖아! " },
      3: { ja: "みんなの意見に同調しますけど、", en: "I agree with the general consensus, yet ", zh: "我赞同诸位的大多数意见，不过", ko: "모두의 의견에 동의합니다만, " },
      4: { ja: "言い逃れはさせないよ！", en: "There is no escape from the truth! ", zh: "休想再狡辩推脱！", ko: "발뺌할 생각 마라! " },
      5: { ja: "慎重に盤面を見守りたいですが、", en: "While I prefer to watch carefully, ", zh: "虽说理应谨慎观望局势，", ko: "신중하게 상황을 지켜보고 싶지만, " },
      6: { ja: "勘違いだったらゴメンだけど、", en: "Forgive me if I am mistaken, but ", zh: "若是我误会了还请见谅，不过", ko: "착각이라면 미안하지만, " },
      7: { ja: "戦術的観点から言わせてもらうと、", en: "From a tactical perspective, ", zh: "从战术兵法的角度来看，", ko: "전술적 관점에서 말씀드리자면, " },
      8: { ja: "みんな喧嘩しないで落ち着こうよ、", en: "Peace, let us not quarrel, but remain calm; ", zh: "诸位且莫争执，平心静气；", ko: "모두 다투지 말고 진정해요, " },
      9: { ja: "全員の裏の顔が怪しく見えてきたよ！", en: "Every hidden face here reeks of malice! ", zh: "我看此地每个人的面孔都暗藏诡计！", ko: "모두의 이면이 수상하게 보이기 시작했어! " },
      10: { ja: "審判会議の定石通りに進めるべきだよ、", en: "We must adhere strictly to established doctrine: ", zh: "理当遵循审判会议之铁则：", ko: "심판 회의의 정석대로 진행해야 합니다, " },
      11: { ja: "フフッ、面白い主張をしてくれるね、", en: "Heh, a fascinating claim indeed... ", zh: "呵呵，这番说辞倒是有趣得很……", ko: "후후, 흥미로운 주장을 하시는군요, " },
      12: { ja: "一度疑ったら私はブレないよ！", en: "Once my suspicion is cast, I will not waver! ", zh: "一旦生疑，我绝不动摇！", ko: "한번 의심하면 난 흔들리지 않아! " },
      13: { ja: "……静かにログを精査していたが、", en: "...Having quietly examined the records, ", zh: "……在下静心查阅记录良久，", ko: "……조용히 기록을 살피고 있었습니다만, " },
      14: { ja: "村人を守るために全力で発言するぞ！", en: "To defend this village, I shall speak with all my might! ", zh: "为了守护村落，某必当竭力而言！", ko: "마을 사람들을 지키기 위해 전력으로 말하겠소! " },
      15: { ja: "盤面の裏ラインを計算してみたんだけど、", en: "Calculating the hidden connections between us, ", zh: "暗中推演局势盘面之暗线，", ko: "판면의 숨은 라인을 계산해 보았습니다만, " },
      16: { ja: "え〜っとね、フワッと感じたことだけど、", en: "Well, just a faint intuition of mine, ", zh: "那个，虽只是些许模糊的直觉，", ko: "저기, 어렴풋이 느낀 점이지만, " },
      17: { ja: "統計データと投票確率から算出すると、", en: "Calculating from statistical odds and vote tallies, ", zh: "依据统计推演与票数概率，", ko: "통계 데이터와 투표 확률로 산출해 보면, " },
      18: { ja: "私を疑うなんてあり得ないよ！", en: "To suspect me is utter madness! ", zh: "竟然怀疑到我头上，不可理喻！", ko: "나를 의심하다니 말도 안 돼! " },
      19: { ja: "また随分と苦しい言い訳を聞かされたね、", en: "Another pitiful, strained excuse, I see... ", zh: "又是一套破绽百出的拙劣托词呢……", ko: "또 꽤나 궁색한 변명을 듣게 되었군요, " },
      20: { ja: "いくつかの可能性を物語として仮説立てると、", en: "Constructing hypotheses among various narratives, ", zh: "若将诸般可能串联成篇展开设想，", ko: "몇 가지 가능성을 가설로 세워보자면, " }
    };

    function getProfileQuotePrefix(prof) {
      if (!prof) return '';
      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';
      if (prof.id && AI_PROFILE_PREFIX_I18N[prof.id]) {
        return AI_PROFILE_PREFIX_I18N[prof.id][lang] || AI_PROFILE_PREFIX_I18N[prof.id].ja || '';
      }
      return prof.quotePrefix || '';
    }

    // 信頼度変更ロジック
    function updateTrust(reason) {
      if (typeof gameState.playerTrust !== 'number') {
        gameState.playerTrust = 100;
      }
      const oldTrust = gameState.playerTrust;

      switch (reason) {
        case 'EXECUTE_HUMAN':    // 人間を誤処刑
          gameState.playerTrust = Math.max(0, gameState.playerTrust - 25);
          break;
        case 'EXECUTE_MONSTER':  // 魔物（人狼）を処刑
          gameState.playerTrust = Math.min(100, gameState.playerTrust + 10);
          break;
        case 'STAGE_CLEAR':     // ステージクリアボーナス
          gameState.playerTrust = Math.min(100, gameState.playerTrust + 10);
          break;
      }

      const diff = gameState.playerTrust - oldTrust;
      renderTrustUI(diff);
      checkTrustEvents();
    }

    // ★ ネタバレ防止: 処刑直後は結果を即時反映せず、保留スタックに追加
    function queuePendingTrustExecution(char, targetRole) {
      if (!gameState.pendingTrustUpdates) gameState.pendingTrustUpdates = [];
      gameState.pendingTrustUpdates.push({
        char,
        role: targetRole,
        day: gameState.day,
        resolved: false
      });
    }

    // ★ 聖職者報告や誤処刑演出などで表面的に判明したタイミングで信頼度を反映
    function resolvePendingTrustForChar(char) {
      if (!gameState.pendingTrustUpdates) return;
      const item = gameState.pendingTrustUpdates.find(p => p.char === char && !p.resolved);
      if (!item) return;

      item.resolved = true;
      if (item.role === 'wolf') {
        updateTrust('EXECUTE_MONSTER');
      } else {
        updateTrust('EXECUTE_HUMAN');
      }
    }

    // ★ 表面的にどちらの可能性もあるままゲーム終了を迎えた際、一括で残りをまとめて増減反映
    function resolveAllPendingTrustUpdates() {
      if (!gameState.pendingTrustUpdates || gameState.pendingTrustUpdates.length === 0) return;
      
      let unresolvedItems = gameState.pendingTrustUpdates.filter(p => !p.resolved);
      if (unresolvedItems.length === 0) return;

      unresolvedItems.forEach(item => {
        item.resolved = true;
        if (item.role === 'wolf') {
          gameState.playerTrust = Math.min(100, gameState.playerTrust + 10);
        } else {
          gameState.playerTrust = Math.max(0, gameState.playerTrust - 25);
        }
      });

      renderTrustUI();
      checkTrustEvents();
    }

    // 信頼度UI・ゲージ描画および通知ポップアップ演出
    function renderTrustUI(diff = 0) {
      const trustVal = typeof gameState.playerTrust === 'number' ? gameState.playerTrust : 100;
      const fillEl = document.getElementById('trust-gauge-fill');
      const valEl = document.getElementById('trust-value-display');

      if (fillEl) {
        fillEl.style.width = `${trustVal}%`;
        if (trustVal >= 60) {
          fillEl.style.background = 'linear-gradient(90deg, #22c55e, #10b981)';
        } else if (trustVal >= 30) {
          fillEl.style.background = 'linear-gradient(90deg, #f59e0b, #d97706)';
        } else {
          fillEl.style.background = 'linear-gradient(90deg, #ef4444, #dc2626)';
        }
      }

      if (valEl) {
        valEl.textContent = `${trustVal}%`;
        if (trustVal >= 60) valEl.style.color = '#10b981';
        else if (trustVal >= 30) valEl.style.color = '#fbbf24';
        else valEl.style.color = '#ef4444';

        // 減少時の点滅アニメーション
        if (diff < 0) {
          valEl.style.transition = 'transform 0.1s ease, color 0.1s ease';
          valEl.style.transform = 'scale(1.3)';
          setTimeout(() => {
            valEl.style.transform = 'scale(1)';
          }, 300);
        }
      }

      // ポップアップエフェクト（トースト通知）
      if (diff < 0) {
        showNotification(`⚠️ 信頼度低下 ${diff}% （現在: ${trustVal}%）`);
      } else if (diff > 0) {
        showNotification(`✨ 信頼度回復 +${diff}% （現在: ${trustVal}%）`);
      }
    }

    // 信頼度イベント判定（クーデター判定）
    function checkTrustEvents() {
      if (gameState.playerTrust === 0 && !gameState.gameOver) {
        triggerCoupDetat();
      }
    }

    // ① 信頼度 0% : 誤審クーデター（即ゲームオーバー）
    async function triggerCoupDetat() {
      stopAllTimers();
      cancelSpeech();
      gameState.gameOver = true;

      playBgm('haiboku');

      const modal = document.getElementById('modal-overlay');
      const title = document.getElementById('modal-title');
      const body = document.getElementById('modal-body');
      const resultCard = document.getElementById('modal-result-card');

      if (title) {
        title.textContent = '⛓️【民の反逆】クーデター発生！';
        title.className = 'modal-title lose';
      }
      if (resultCard) {
        resultCard.innerHTML = `
          <div style="background: rgba(185, 28, 28, 0.3); border: 2px solid #ef4444; border-radius: 12px; padding: 1.2rem; text-align: center; box-shadow: 0 0 25px rgba(239, 68, 68, 0.4);">
            <div style="font-size: 2.8rem; margin-bottom: 0.5rem;">⛓️💥🗡️</div>
            <div style="font-size: 1.2rem; font-weight: bold; color: #ef4444; margin-bottom: 0.6rem;">【民の反逆】 勇者拘束</div>
            <div style="font-size: 0.88rem; color: #fecaca; line-height: 1.6; text-align: left; background: rgba(0,0,0,0.4); padding: 0.8rem 1rem; border-radius: 8px;">
              信頼を完全に失った勇者は、狂気に駆られた村人たちによって逆に拘束され、処刑台へと送られた……<br><br>
              度重なる誤審により村の絆は崩壊し、反乱が勃発しました。
            </div>
          </div>
        `;
      }
      if (body) {
        body.textContent = '信頼度が0%になり、民の反逆により審判会議が強制終了しました。';
      }

      const actionBtnsContainer = document.querySelector('.result-action-buttons');
      if (actionBtnsContainer) {
        actionBtnsContainer.innerHTML = `
          <button class="btn-result-action btn-result-restart" onclick="startGame()">🔄 もう一度プレイ</button>
          <button class="btn-result-action btn-result-title" onclick="showTitleScreen()">🏠 タイトルへ</button>
        `;
      }

      if (modal) modal.classList.remove('hidden');

      await playSpeechAsync('民の反逆！信頼を完全に失った勇者は、村人たちによって拘束され、処刑台へと送られた……');
    }

    function resetGameState() {
      stopAllTimers();
      cancelSpeech();

      isDiscussionPaused = false;
      const btnPause = document.getElementById('btn-toggle-discussion-pause');
      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;
      if (btnPause) {
        const pauseText = t.btn_pause_disc || '⏸️ 議論を一時停止';
        btnPause.innerHTML = `<span>${pauseText}</span>`;
        btnPause.style.background = 'linear-gradient(135deg, #3a3f58, #2a2d42)';
        btnPause.style.borderColor = 'var(--accent-amber)';
        btnPause.style.color = '#fff';
      }

      // DOM Clear
      const grid = document.getElementById('character-grid');
      if (grid) grid.innerHTML = '';

      const timeline = document.getElementById('log-timeline');
      if (timeline) timeline.innerHTML = '';
      
      const bulletin = document.getElementById('bulletin-list');
      if (bulletin) bulletin.innerHTML = '';
      
      const morningComments = document.getElementById('morning-comments-list');
      if (morningComments) morningComments.innerHTML = '';

      const targetInfo = document.getElementById('target-info');
      if (targetInfo) targetInfo.textContent = '尋問・処刑する人物を選択してください';

      const warning = document.getElementById('action-warning');
      if (warning) warning.style.display = 'none';

      const interrogationBox = document.getElementById('interrogation-response-box');
      if (interrogationBox) {
        interrogationBox.style.display = 'none';
        const speakerEl = document.getElementById('interrogation-response-speaker');
        const textEl = document.getElementById('interrogation-response-text');
        if (speakerEl) speakerEl.textContent = '';
        if (textEl) textEl.textContent = '';
      }

      // Reset gameState object
      gameState = {
        villageSize: 6,
        targetWolvesCount: 2,
        charList: [],
        day: 1,
        phase: '朝',
        subPhase: 'discussion',
        timeLeftSeconds: discussionTimeSetting,
        mistakesLeft: 2,
        wolvesExecuted: 0,
        selectedChar: null,
        executedToday: false,
        lastExecutedChar: null,
        lastExecutedRole: null,
        mislynchProcessedDay: 0,
        heroDistrustLevel: 0,
        playerTrust: 100,
        pendingTrustUpdates: [],
        roles: {},
        coRoles: {},
        memoRoles: {},
        claimedRoleTypes: {},
        isStealthing: {},
        charProfiles: {},
        seerHistory: {},
        mediumHistory: {},
        alibis: {},
        dailySeerReports: {},
        dailyMediumReports: {},
        morningComments: {},
        morningCommentsHistory: [],
        aiDiscussionHistory: [],
        aiStatements: {},
        status: {},
