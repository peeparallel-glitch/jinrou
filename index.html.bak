      { id: 1,  archetype: "理論派探偵",    logicLevel: 0.95, aggression: 0.55, stubbornness: 0.35, coPreference: 0.60, speechStyle: "論理的で冷静な口調", quotePrefix: "過去ログと投票ラインを分析した結果ですが、", quoteSuffix: "客観的ログの整合性を最優先に検証すべきです。" },
