          hunter: '🏹 狩人', bodyguard: '🛡️ 黒服', cakeShop: '🍰 ケーキ屋', fanatic: '🖤 狂信者', immoral: '🦊 背徳者'
        },
        en: {
          wolf: '🔴 Mimic Monster', seer: '🔮 Sage', medium: '👻 Cleric', knight: '🛡️ Holy Knight',
          madman: '💗 Cultist', baker: '🍞 Baker', freemason: '🤝 Mason', fox: '🦊 Mystic Fox',
          nekomata: '🐱 Nekomata', cat: '🐱 Nekomata', villager: '🔵 Villager', citizen: '🔵 Villager',
          hunter: '🏹 Hunter', bodyguard: '🛡️ Bodyguard', cakeShop: '🍰 Patissier', fanatic: '🖤 Fanatic', immoral: '🦊 Immoralist'
        },
        zh: {
          wolf: '🔴 拟态魔物', seer: '🔮 贤者', medium: '👻 圣职者', knight: '🛡️ 圣骑士',
          madman: '💗 魔教徒', baker: '🍞 面包师', freemason: '🤝 共生者', fox: '🦊 妖狐',
          nekomata: '🐱 猫又', cat: '🐱 猫又', villager: '🔵 村民', citizen: '🔵 村民',
          hunter: '🏹 猎人', bodyguard: '🛡️ 保镖', cakeShop: '🍰 蛋糕店', fanatic: '🖤 狂信者', immoral: '🦊 背德者'
        },
        ko: {
          wolf: '🔴 의태 몬스터', seer: '🔮 현자', medium: '👻 성직자', knight: '🛡️ 성기사',
          madman: '💗 마교도', baker: '🍞 제빵사', freemason: '🤝 공유자', fox: '🦊 요호',
          nekomata: '🐱 네코마타', cat: '🐱 네코마타', villager: '🔵 마을사람', citizen: '🔵 마을사람',
          hunter: '🏹 사냥꾼', bodyguard: '🛡️ 경호원', cakeShop: '🍰 케이크점', fanatic: '🖤 광신자', immoral: '🦊 배덕자'
        }
      };
      const curMap = roleMaps[lang] || roleMaps.ja;
      return curMap[role] || role;
    }

    // =====================================================
    // Fullscreen API: 全画面化リクエスト共通関数
    // =====================================================
    function requestFullScreen() {
      const docEl = document.documentElement;
      if (docEl.requestFullscreen) {
        docEl.requestFullscreen().catch(err => console.log('Fullscreen request failed:', err));
      } else if (docEl.mozRequestFullScreen) { /* Firefox */
        docEl.mozRequestFullScreen().catch(err => console.log('Fullscreen request failed:', err));
      } else if (docEl.webkitRequestFullscreen) { /* Chrome, Safari, Opera */
        docEl.webkitRequestFullscreen().catch(err => console.log('Fullscreen request failed:', err));
      } else if (docEl.msRequestFullscreen) { /* IE/Edge */
        docEl.msRequestFullscreen().catch(err => console.log('Fullscreen request failed:', err));
      }
    }

    // =====================================================
    // 🛠️ デバッグメニュー・キーボードコマンド「testmode」システム
    // =====================================================

    let debugAIMode = 'auto'; // 'auto' | 'local' | 'api'
    let keyBuffer = "";

    // グローバルキーボード入力リスナー（「testmode」検知）
    document.addEventListener("keydown", (e) => {
      // ESCキーでデバッグメニューを閉じる
      if (e.key === "Escape") {
        const debugModal = document.getElementById("debug-modal");
        if (debugModal && debugModal.style.display === "flex") {
          toggleDebugMenu();
          return;
        }
      }

      // 入力文字をバッファに追加（英字のみ）
      if (e.key && e.key.length === 1) {
        keyBuffer += e.key.toLowerCase();
        if (keyBuffer.length > 20) {
          keyBuffer = keyBuffer.slice(-20);
        }
        if (keyBuffer.endsWith("testmode")) {
          toggleDebugMenu();
          keyBuffer = ""; // リセット
        }
      }
    });

    // デバッグメニュー表示 / 非表示切り替え
    function toggleDebugMenu() {
      let debugModal = document.getElementById("debug-modal");
      if (!debugModal) {
        createDebugMenuUI();
        debugModal = document.getElementById("debug-modal");
      }
      const isVisible = (debugModal.style.display === "flex");
      debugModal.style.display = isVisible ? "none" : "flex";
      if (!isVisible) {
        updateDebugMenuUIState();
      }
    }

    // デバッグメニュー UI Dynamic Creation
    function createDebugMenuUI() {
      if (document.getElementById("debug-modal")) return;

      const html = `
      <div id="debug-modal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.82); backdrop-filter:blur(6px); z-index:999999; justify-content:center; align-items:center;" onclick="if(event.target===this) toggleDebugMenu()">
        <div style="background:linear-gradient(145deg, #1e1e2d, #141420); border:2px solid #fbbf24; border-radius:14px; padding:1.5rem; width:92%; max-width:420px; color:#fff; font-family:'Yu Gothic', sans-serif; box-shadow:0 0 35px rgba(251,191,36,0.35); text-align:left;">
          <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(251,191,36,0.4); padding-bottom:0.8rem; margin-bottom:1.2rem;">
            <h2 style="margin:0; font-size:1.25rem; color:#fbbf24; display:flex; align-items:center; gap:0.5rem;">🛠️ デバッグメニュー</h2>
            <button onclick="toggleDebugMenu()" style="background:none; border:none; color:#94a3b8; font-size:1.4rem; cursor:pointer; padding:0 0.3rem;">✕</button>
          </div>
          
          <!-- ① AI動作モード切替 -->
          <div style="margin-bottom:1.2rem; background:rgba(0,0,0,0.4); padding:0.9rem; border-radius:8px; border:1px solid rgba(255,255,255,0.1);">
            <label style="display:block; margin-bottom:0.5rem; font-weight:bold; font-size:0.9rem; color:#fde68a;">
              🤖 AI動作モード設定:
            </label>
            <select id="debug-ai-select" onchange="setDebugAIMode(this.value)" style="width:100%; padding:0.55rem; background:#2b2b3d; color:#fff; border:1px solid #fbbf24; border-radius:6px; font-size:0.88rem; font-weight:bold;">
              <option value="auto">🔄 自動 (API優先 ➔ ローカルフォールバック)</option>
              <option value="local">📦 ローカルAI (固定定型応答エンジン)</option>
              <option value="api">⚡ Gemini API (強制LLM接続)</option>
            </select>
            <div id="debug-ai-status" style="font-size:0.78rem; color:#60a5fa; margin-top:0.5rem; font-weight:bold;">
              現在のAI状態: 自動判定中
            </div>
          </div>

          <!-- ② 章（ストーリー）ロック解除 -->
          <div style="margin-bottom:1rem;">
            <button onclick="unlockAllChapters()" style="width:100%; padding:0.75rem; background:linear-gradient(135deg, #2563eb, #1d4ed8); color:#fff; border:1px solid #60a5fa; border-radius:8px; cursor:pointer; font-weight:bold; font-size:0.92rem; display:flex; align-items:center; justify-content:center; gap:0.5rem; box-shadow:0 3px 10px rgba(37,99,235,0.4); transition:all 0.2s ease;">
              🔓 全章ロック解除（第1章〜第5章開放）
            </button>
          </div>

          <!-- ③ エンディング直接再生（3種類選択可能） -->
          <div style="margin-bottom:1.4rem; background:rgba(0,0,0,0.4); padding:0.9rem; border-radius:8px; border:1px solid rgba(255,255,255,0.1);">
            <div style="font-weight:bold; font-size:0.9rem; color:#fde68a; margin-bottom:0.6rem;">
              🏆 エンディング直接テスト再生:
            </div>
            <div style="display:flex; flex-direction:column; gap:0.5rem;">
              <button onclick="triggerGrandEndingTest(100)" style="width:100%; padding:0.6rem 0.8rem; background:linear-gradient(135deg, #10b981, #047857); color:#fff; border:1px solid #34d399; border-radius:6px; cursor:pointer; font-weight:bold; font-size:0.85rem; text-align:left; box-shadow:0 2px 6px rgba(16,185,129,0.3);">
                ✨ ①【真・救世主】 (信頼度 90%以上)
              </button>
              <button onclick="triggerGrandEndingTest(65)" style="width:100%; padding:0.6rem 0.8rem; background:linear-gradient(135deg, #f59e0b, #b45309); color:#fff; border:1px solid #fbbf24; border-radius:6px; cursor:pointer; font-weight:bold; font-size:0.85rem; text-align:left; box-shadow:0 2px 6px rgba(245,158,11,0.3);">
                🏆 ②【救済と傷痕】 (信頼度 40%〜89%)
              </button>
              <button onclick="triggerGrandEndingTest(20)" style="width:100%; padding:0.6rem 0.8rem; background:linear-gradient(135deg, #ef4444, #991b1b); color:#fff; border:1px solid #f87171; border-radius:6px; cursor:pointer; font-weight:bold; font-size:0.85rem; text-align:left; box-shadow:0 2px 6px rgba(239,68,68,0.3);">
                💀 ③【血塗られた処刑人】 (信頼度 39%以下)
              </button>
            </div>
          </div>

          <div style="display:flex; justify-content:flex-end;">
            <button onclick="toggleDebugMenu()" style="width:100%; padding:0.6rem; background:#374151; color:#fff; border:1px solid #6b7280; border-radius:6px; cursor:pointer; font-weight:bold;">
              閉じる (ESC)
            </button>
          </div>
        </div>
      </div>
      `;
      document.body.insertAdjacentHTML('beforeend', html);
    }

    // AI動作モードの変更処理
    function setDebugAIMode(mode) {
      debugAIMode = mode;
      if (mode === 'local') {
        useLLMMode = false;
      } else if (mode === 'api') {
        useLLMMode = true;
      } else {
        useLLMMode = (typeof API_KEY !== 'undefined' && API_KEY !== '');
      }
      updateDebugMenuUIState();
      showNotification(`🤖 AI動作モードを【${mode === 'local' ? 'ローカルAI固定' : (mode === 'api' ? 'Gemini API固定' : '自動判定')}】に変更しました`);
    }

    // デバッグメニューUIの状態更新
    function updateDebugMenuUIState() {
      const select = document.getElementById('debug-ai-select');
      const status = document.getElementById('debug-ai-status');
      if (select) select.value = debugAIMode;
      if (status) {
        const modeLabels = {
          auto: '🔄 自動 (API優先 ➔ ローカル)',
          local: '📦 ローカルAI固定 (定型合成エンジン動作中)',
          api: '⚡ Gemini API固定 (LLM通信優先動作中)'
        };
        status.textContent = `現在のAI状態: ${modeLabels[debugAIMode] || debugAIMode}`;
      }
    }

    // 全章ロック解除処理
    function unlockAllChapters() {
      // 全冒険の書スロット＆現在アクティブスロットのデータを全開状態にする
      const slots = ['slot_1', 'slot_2', 'slot_3'];
      slots.forEach(slot => {
        let saveData = loadGameData(slot) || {
          heroName: "勇者",
          currentChapter: 1,
          heroIQ: 100,
          totalScore: 0,
          rankTitle: "新米審判者",
          clearedVillages: 0
        };
        saveData.unlockChapter = 5;
        saveData.chapterRecords = {
          ch1: { cleared: true, highScore: 1000 },
          ch2: { cleared: true, highScore: 1500 },
          ch3: { cleared: true, highScore: 2000 },
          ch4: { cleared: true, highScore: 2500 },
          ch5: { cleared: true, highScore: 3000 }
        };
        saveGameData(slot, saveData);
      });

      // 章選択モーダルの表示を更新
      if (typeof renderStoryChapterModalContent === 'function') {
        renderStoryChapterModalContent();
      }

      showNotification("🔓 全5章（始まりの村〜絶望の村）のロックを解除しました！");
    }

    // グランドエンディングテスト再生（指定信頼度または現在の信頼度）
    function triggerGrandEndingTest(targetTrust) {
      toggleDebugMenu(); // デバッグメニューを閉じる
      showGrandEndingModal(null, null, null, targetTrust);
    }

    // =====================================================
    // 🎵 グランドエンディングBGM管理（BGM2/S_rank, A_rank, C_rank）
    // =====================================================
    let currentEndingBgm = null;
    let currentEndingRank = null;

    function playEndingBgm(rankType) {
      if (currentEndingBgm) {
        currentEndingBgm.pause();
        currentEndingBgm.currentTime = 0;
        currentEndingBgm = null;
      }

      // 他のすべてのBGMを完全停止
      if (currentBgm && !currentBgm.paused) {
        currentBgm.pause();
      }
      if (typeof stopStoryBgm === 'function') {
        stopStoryBgm();
      }

      let fileName = "";
      switch (rankType) {
        case "S":
          fileName = "S_rank";
          break;
        case "A":
          fileName = "A_rank";
          break;
        case "C":
          fileName = "C_rank";
          break;
        default:
          return;
      }

      currentEndingRank = rankType;
      currentEndingBgm = new Audio(`BGM2/${fileName}.mp3`);
      currentEndingBgm.loop = true;
      const volRate = (typeof bgmVolume === 'number' ? bgmVolume : 100) / 100;
      currentEndingBgm.volume = 0.6 * volRate;

      currentEndingBgm.play().catch(e => {
        console.log("エンディングBGM自動再生待機（ユーザー操作待ち）:", e);
      });
    }

    function stopEndingBgm() {
      if (currentEndingBgm) {
        currentEndingBgm.pause();
        currentEndingBgm.currentTime = 0;
        currentEndingBgm = null;
      }
      currentEndingRank = null;
    }

    // グランドエンディング表示モーダル関数（信頼度マルチエンディング対応）
    function showGrandEndingModal(finalIQ, totalScore, rankTitle, overrideTrust) {
      const trust = (typeof overrideTrust === 'number') 
        ? overrideTrust 
        : (typeof gameState.playerTrust === 'number' ? gameState.playerTrust : 100);
      const lang = currentAppLanguage || 'ja';

      let endingTitle = "";
      let endingContent = "";
      let endingRankType = "A";

      const ENDING_TEXTS = {
        ja: {
          s: {
            title: "【絶望を越えて ―― 聖なる救世主】",
            content: `20人の疑心が渦巻く「絶望の村」に、静寂が訪れる。\n\n妖狐の幻影を打ち破り、4体の魔物を全て審判の剣で討ち果たした瞬間、村を覆っていた不吉な暗雲がゆっくりと裂けていった。\n誤審の影は一切ない。勇者の神眼は最後まで曇ることなく、無辜の民を一人も傷つけずに悪魔だけを断罪しきったのだ。\n\n差し込む一筋の朝光が、生き残った村人たちと勇者を温かく包み込む。人々は涙を流しながら膝を折り、絶対の審判者に心からの感謝と賛美の祈りを捧げた。\n\n「讃えよ、真の救世主を。その剣は偽りを完全に断ち、レムの王国に永遠の光をもたらした」\n\n王国の歴史の最上段に、神話のごとき新たな伝説が今、刻まれたのである――。\n\n―― 『ぼっち人狼 〜審判の勇者〜』 真・完結 ――`
          },
          a: {
            title: "【嵐の過ぎ去った村で】",
            content: `激しい疑心暗鬼と幾度かの誤審を乗り越え、ついに最後の魔物が断罪された。\n\n村を覆っていた魔物の脅威は去り、暗雲の隙間から柔らかな陽光が差し込んでくる。しかし、そこにあるのは完全な歓喜ではない。審判の過程で流された無実の血の記憶が、生存者たちの胸に重く影を落としていた。\n\n生き残った村人たちは、救われた安堵の表情を浮かべつつも、どこか怯えるような瞳で勇者の背中を見つめる。\n\n「……魔物は滅びた。我々は生き延びたのだ……」\n\n傷だらけの村に訪れた静かな朝。勇者は言葉少なく剣を納め、静かに次の旅路へと歩き出す。救済の代償としての痛みを胸に刻みながら――。\n\n―― 『ぼっち人狼 〜審判の勇者〜』 通常完結 ――`
          },
          c: {
            title: "【誰もいない朝焼け】",
            content: `幾度もの誤審によって無実の村人を処刑し続け、辛うじて最後の魔物を討ち果たした終焉の朝。\n\n村の空には冷たい朝焼けが広がっているが、そこにかつての活気は微塵もない。壊れた家屋、血に染まった処刑台、そして誰一人として姿を見せない静まり返った街路。住民たちは狂気に満ちた「誤審の嵐」をもたらした勇者を恐れ、家を捨て、あるいは怯えながら闇の奥へと姿を消していたのだ。\n\n誰の感謝の声も聞こえない。称賛の祈りもない。ただ一人生き残った冷徹な処刑人は、血に濡れた剣を固く握りしめたまま、凍てつく風の中に一人立ち尽くしていた。\n\n「……これが、私に与えられた『救済』の結末か」\n\n誰からも愛されず、誰にも見送られない孤独な勝利の鐘が、寂しく荒野に響き渡る――。\n\n―― 『ぼっち人狼 〜審判の勇者〜』 バッドエンド ――`
          }
        },
        en: {
          s: {
            title: "【Beyond Despair — The Holy Savior】",
            content: `Silence settles over the "Village of Despair," where suspicion once consumed twenty souls.\n\nThe illusory tricks of the Specter Fox were shattered, and all four monsters fell before the sword of judgment. In that moment, the ominous clouds cloaking the village tore open to reveal radiant light.\nNot a single shadow of misjudgment remains. The Hero's divine sight never wavered, condemning the evil while keeping every innocent soul safe.\n\nA gentle beam of morning sun bathes the surviving villagers and the Hero in warmth. Weeping tears of profound relief, the people kneel and offer prayers of sincere gratitude and praise.\n\n"Praise be to the true Savior! His blade severed falsehood and brought eternal peace to the realm."\n\nAt the very peak of the kingdom's history, a legendary chronicle worthy of myth was carved into eternity.\n\n— Solo Werewolf: The Judgment of the Hero (True Ending) —`
          },
          a: {
            title: "【In the Village After the Storm】",
            content: `Overcoming fierce suspicion and a few painful misjudgments, the final monster has at last been condemned.\n\nThe nightmare of beasts has lifted, and soft sunlight streams through gaps in the clouds. Yet, there is no unbridled jubilation. The memory of innocent blood shed during judgment casts a heavy shadow upon the hearts of the living.\n\nThough relieved to have survived, the villagers gaze upon the Hero's back with a touch of trembling awe.\n\n"...The monsters are defeated. We have survived..."\n\nA quiet morning in a wounded village. With few words, the Hero sheathes their sword and sets forth onto the next path, bearing the sorrow of salvation's price.\n\n— Solo Werewolf: The Judgment of the Hero (Normal Ending) —`
          },
          c: {
            title: "【A Sunbreak with No One Left】",
            content: `Through repeated wrongful executions of innocent villagers, the final monster was slain by a thread on this bleak final morning.\n\nA cold sunrise spreads across the village sky, but not a shred of its former vitality remains. Smashed dwellings, a bloodstained executioner's platform, and dead silent alleys without a soul in sight. Terrified of the Hero whose fanatical trials brought a tempest of wrongful deaths, the survivors abandoned their homes and fled into the dark.\n\nNo words of gratitude. No prayers of praise. The solitary executioner stands alone in the freezing wind, gripping a bloodstained blade with trembling fingers.\n\n"...Is this the true outcome of the 'salvation' granted to me?"\n\nLoved by none, seen off by no one, the lonely bell of victory tolls hollowly across the wasteland.\n\n— Solo Werewolf: The Judgment of the Hero (Bad Ending) —`
          }
        },
        zh: {
          s: {
            title: "【跨越绝望 ―― 神圣的救世主】",
            content: `20人疑心弥漫的“绝望之村”，迎来了久违的静谧。\n\n破除妖狐的幻术，将4只魔物悉数以审判之剑斩灭的瞬间，笼罩村庄的不祥阴云缓缓散开。\n没有任何误判的阴影。勇者的神眼至始至终澄澈明晰，未曾伤及无辜黎民分毫，彻底斩灭了所有恶魔。\n\n穿透云层的晨曦，温暖地包裹着幸存的村民与勇者。人们热泪盈眶地单膝跪地，向绝对的审判者献上发自内心的感激与崇高的赞美。\n\n“赞美吧，真正的救世主。其神剑断绝了一切虚妄，为雷姆王国迎来了永恒的光明。”\n\n在王国史册的最顶峰，一段神话般的全新传奇史诗于此刻永恒铭刻——。\n\n―― 《独行人狼 ～审判之勇者～》 真正完结 ――`
          },
          a: {
            title: "【暴风骤雨后的村落】",
            content: `跨越了剧烈的疑心暗鬼与数次痛心的误判，最后一只魔物终于伏诛断罪。\n\n笼罩村落的魔物威胁已然远去，暗云的缝隙间倾泻下柔和的日光。然而，那里并未洋溢着纯粹的欢欣。审判过程中流淌的无辜鲜血，在幸存者心头投下了沉重的阴影。\n\n幸存的村民们流露出劫后余生的释怀，却也带着几分敬畏与怯意凝望着勇者的背影。\n\n“……魔物被消灭了。我们终于活下来了……”\n\n伤痕累累的村庄迎来静寂的清晨。勇者沉默寡言地收剑入鞘，将救赎带来的阵痛铭刻心底，默默迈向下一段旅途——。\n\n―― 《独行人狼 ～审判之勇者～》 普通完结 ――`
          },
          c: {
            title: "【空无一人的黎明】",
            content: `数次因误判将无辜村民送上断头台，最终在凄凉的终焉之晨险胜诛灭了最后的魔物。\n\n村落的天空泛起冰冷的黎明曙光，但往日的生机荡然无存。断壁残垣、染血的刑台，以及不见一人的死寂街巷。居民们畏惧这名带来“误判风暴”的冷酷勇者，纷纷弃家而逃，隐入黑暗的远方。\n\n听不到任何感激之言，亦无称颂的祷告。幸存下来的冷酷行刑者紧握染血的利刃，独自伫立在刺骨的寒风之中。\n\n“……这就是，赋予我的‘救赎’最终的结局吗？”\n\n无人挂念，亦无人送别。孤独胜利的钟声，凄凉地回荡在荒野之中——。\n\n―― 《独行人狼 ～审判之勇者～》 坏结局 ――`
          }
        },
        ko: {
          s: {
            title: "【절망을 넘어 ―― 성스러운 구세주】",
            content: `20인의 의혹이 소용돌이치던 「절망의 마을」에 고요한 평화가 찾아온다.\n\n요호의 환영을 깨뜨리고, 4마리의 마물을 모두 심판의 검으로 처단한 순간 마을을 덮고 있던 불길한 먹구름이 서서히 걷혀 갔다.\n오심의 그림자는 전혀 없다. 용사의 신안은 마지막까지 흐려짐 없이, 무고한 백성을 단 한 명도 다치게 하지 않고 악마만을 온전히 단죄한 것이다.\n\n구름 사이로 비치는 아침 햇살이 살아남은 주민들과 용사를 따스하게 감싼다. 사람들은 눈물을 흘리며 무릎을 꿇고 절대적인 심판자에게 마음 깊은 감사와 찬미의 기도를 올렸다.\n\n“찬양하라, 진정한 구세주를. 그 검은 거짓을 완전히 베어내고 렘 왕국에 영원한 빛을 가져왔도다.”\n\n왕국 역사의 가장 높은 자리에 신화와 같은 새로운 전설이 지금 영원히 새겨진 것이다――.\n\n―― 『나홀로 늑대인간 〜심판의 용사〜』 진 완결 ――`
          },
          a: {
            title: "【폭풍이 지나간 마을에서】",
            content: `격렬한 의심 암귀와 몇 차례의 뼈아픈 오심을 딛고, 마침내 마지막 마물이 단죄되었다.\n\n마을을 뒤덮고 있던 마물의 위협은 사라지고, 먹구름 틈새로 부드러운 햇살이 스며든다. 그러나 그곳에 완전한 환희만이 있는 것은 아니다. 심판 과정에서 흘린 무고한 피의 기억이 생존자들의 가슴에 무거운 그림자를 드리우고 있었다.\n\n살아남은 마을 사람들은 구원받은 안도의 표정을 지으면서도, 어딘가 두려워하는 눈빛으로 용사의 뒷모습을 바라본다.\n\n“……마물은 멸망했다. 우리는 살아남은 거야……”\n\n상처투성이 마을에 찾아온 고요한 아침. 용사는 말없이 검을 거두고, 구원의 대가로 남은 아픔을 가슴에 새기며 조용히 다음 여정으로 발걸음을 옮긴다――.\n\n―― 『나홀로 늑대인간 〜심판의 용사〜』 통상 완결 ――`
          },
          c: {
            title: "【아무도 없는 아침노을】",
            content: `거듭된 오심으로 무고한 마을 사람들을 처형한 끝에, 간신히 마지막 마물을 토벌한 종언의 아침.\n\n마을 하늘에는 차가운 아침노을이 번져가지만, 예전의 활기는 티끌만큼도 남아있지 않다. 부서진 가옥, 피로 물든 처형대, 그리고 단 한 사람도 보이지 않는 적막한 거리. 주민들은 광기의 ‘오심 폭풍’을 몰고 온 용사를 두려워하며 집을 버리고 어둠 저편으로 자취を 감추고 말았다.\n\n감사의 목소리는 들리지 않는다. 찬양의 기도도 없다. 오직 홀로 살아남은 냉혹한 처형인은 피 묻은 검을 굳게 쥔 채 얼어붙은 바람 속에 우두커니 서 있었다.\n\n“……이것이 내게 주어진 ‘구원’의 결말인가.”\n\n누구에게도 사랑받지 못하고, 누구의 배웅도 받지 못한 고독한 승리의 종소리가 쓸쓸히 황야에 울려 퍼진다――.\n\n―― 『나홀로 늑대인간 〜심판의 용사〜』 배드엔딩 ――`
          }
        }
      };

      const langPack = ENDING_TEXTS[lang] || ENDING_TEXTS.ja;

      if (trust >= 90) {
        endingRankType = "S";
        endingTitle = langPack.s.title;
        endingContent = langPack.s.content;
      } else if (trust >= 40) {
        endingRankType = "A";
        endingTitle = langPack.a.title;
        endingContent = langPack.a.content;
      } else {
        endingRankType = "C";
        endingTitle = langPack.c.title;
        endingContent = langPack.c.content;
      }

      const titleEl = document.getElementById('grand-ending-title');
      const contentEl = document.getElementById('grand-ending-content');
      if (titleEl) titleEl.textContent = endingTitle;
      if (contentEl) contentEl.textContent = endingContent;

      const statsEl = document.getElementById('grand-ending-stats');
      if (statsEl) {
        const saveData = loadGameData(activeSaveSlot) || {};
        const defaultHero = lang === 'en' ? 'Hero' : (lang === 'zh' ? '勇者' : (lang === 'ko' ? '용사' : '勇者'));
        const heroName = saveData.heroName || defaultHero;
        const heroIQ = (typeof finalIQ === 'number') ? finalIQ : (saveData.heroIQ || 100);
        const scoreVal = (typeof totalScore === 'number') ? totalScore : (saveData.totalScore || 0);
        const rawRank = rankTitle || saveData.rankTitle || getRankTitle(heroIQ, scoreVal);
        const rank = translateRankTitle(rawRank, lang);

        const headingLabel = lang === 'en' ? `📜 Great Journey of <strong>${heroName}</strong>` :
          (lang === 'zh' ? `📜 <strong>${heroName}</strong> 的伟大足迹` :
          (lang === 'ko' ? `📜 <strong>${heroName}</strong>의 위대한 발자취` :
          `📜 <strong>${heroName}</strong> の偉大なる足跡`));

        const trustLabel = lang === 'en' ? 'Final Trust' : (lang === 'zh' ? '最终信任度' : (lang === 'ko' ? '최종 신뢰도' : '最終信頼度'));
        const rankLabel = lang === 'en' ? 'Rank Reached' : (lang === 'zh' ? '到达称号' : (lang === 'ko' ? '도달 칭호' : '到達ランク'));
        const iqLabel = lang === 'en' ? 'Peak IQ' : (lang === 'zh' ? '最高IQ' : (lang === 'ko' ? '최고 IQ' : '最高IQ'));
        const scoreLabel = lang === 'en' ? 'Total Score' : (lang === 'zh' ? '累计分数' : (lang === 'ko' ? '누적 스코어' : '累計スコア'));
        const allClearLabel = lang === 'en' ? '🎉 All 5 Chapters Completely Cleared!' :
          (lang === 'zh' ? '🎉 全5章完全通关达成' :
          (lang === 'ko' ? '🎉 전 5장 완전 클리어 달성' :
          '🎉 全5章完全クリア達成'));

        statsEl.innerHTML = `
          <div>${headingLabel}</div>
          <div>${trustLabel}: <strong style="color:${trust>=60?'#10b981':(trust>=30?'#fbbf24':'#ef4444')};">${trust}%</strong> | ${rankLabel}: <strong style="color:#fbbf24;">【${rank}】</strong></div>
          <div>${iqLabel}: <strong style="color:#60a5fa;">${heroIQ}</strong> | ${scoreLabel}: <strong style="color:#34d399;">${scoreVal.toLocaleString()} pt</strong></div>
          <div style="color:#34d399; font-weight:bold; margin-top:0.25rem;">${allClearLabel}</div>
        `;
      }

      const returnBtn = document.querySelector('#grand-ending-modal .btn-start-game');
      if (returnBtn) {
        returnBtn.textContent = lang === 'en' ? '📜 Engrave Glory in Chronicle & Return to Title' :
          (lang === 'zh' ? '📜 将荣耀铭刻入冒险之书并返回标题' :
          (lang === 'ko' ? '📜 모험의 서에 영광을 새기고 타이틀로' :
          '📜 冒険の書に栄光を刻み、タイトルへ'));
      }

      openModal('grand-ending-modal');
      playEndingBgm(endingRankType);
    }

    // グランドエンディング画面からタイトルへ戻る処理
    function returnToTitleFromGrandEnding() {
      stopEndingBgm();
      closeModal('grand-ending-modal');
      closeModal('modal-overlay');
      showTitleScreen();
    }

    // 依頼仕様互換用エイリアス
    function triggerEndingByTrust() {
      showGrandEndingModal();
    }

    // グローバル関数公開
    window.toggleDebugMenu = toggleDebugMenu;
    window.setDebugAIMode = setDebugAIMode;
    window.unlockAllChapters = unlockAllChapters;
    window.triggerGrandEndingTest = triggerGrandEndingTest;
    window.showGrandEndingModal = showGrandEndingModal;
    window.triggerEndingByTrust = triggerEndingByTrust;
    window.playEndingBgm = playEndingBgm;
    window.stopEndingBgm = stopEndingBgm;
    window.returnToTitleFromGrandEnding = returnToTitleFromGrandEnding;

    // Initial setup
    window.onload = () => {
      initVoice();
      resetGameState();
      renderVillageStats();
      updateMainMenuUI();
      updateTitleSaveSlotUI();
      playBgm('title');

      // ユーザーの最初の操作（タップまたはクリック）で全画面化を実行（1回のみ）
      document.addEventListener('touchstart', function initFullScreen() {
        requestFullScreen();
        document.removeEventListener('touchstart', initFullScreen);
      }, { once: true });

      document.addEventListener('click', function initFullScreenClick() {
        requestFullScreen();
        document.removeEventListener('click', initFullScreenClick);
      }, { once: true });
    };
  </script>
</body>
</html>
