    function getStoryChapterInfo(chId, lang) {
      const currentLang = lang || currentAppLanguage || 'ja';
      const base = STORY_CHAPTERS_I18N[chId] || STORY_CHAPTERS_I18N[1];
      const localized = base[currentLang] || base.ja;
      return {
        id: base.id,
        size: base.size,
        roles: base.roles,
        name: localized.name,
        difficulty: localized.difficulty,
        desc: localized.desc,
        unlockReq: localized.unlockReq
      };
    }

    /**
     * 「はじめから（新たな旅立ち）」をクリックした時の処理
     * 1. 冒険の書（スロット）選択モーダルを開く
     */
    function onStartNewGameClick() {
      openSaveModal();
    }

    /**
     * 冒険の書スロット選択後、モード選択ダイアログを表示
     */
    function openModeSelectModal(slotId) {
      if (slotId) selectActiveSaveSlot(slotId);

      // 新規スロットの場合、初期データを自動生成して保存
      const existingData = loadGameData(activeSaveSlot);
      if (!existingData || typeof existingData !== 'object' || Object.keys(existingData).length === 0) {
        saveGameData(activeSaveSlot, {
          heroName: "勇者",
          currentChapter: 1,
          unlockChapter: 1,
          heroIQ: 100,
          totalScore: 0,
          rankTitle: "新米審判者",
          clearedVillages: 0,
          monstersDefeated: 0,
          innocentVictims: 0,
          chapterRecords: {
            ch1: { cleared: false, highScore: 0 }
          }
        });
      } else if (typeof existingData.unlockChapter !== 'number') {
        // 既存データの補正：clearedVillages や chapterRecords から解放章を自動判定
        let maxUnlocked = 1;
        if (existingData.chapterRecords) {
          for (let i = 1; i <= 5; i++) {
            if (existingData.chapterRecords[`ch${i}`] && existingData.chapterRecords[`ch${i}`].cleared) {
              maxUnlocked = Math.max(maxUnlocked, Math.min(5, i + 1));
            }
          }
        }
        if (maxUnlocked === 1 && (existingData.clearedVillages || 0) > 0) {
          maxUnlocked = Math.min(5, (existingData.clearedVillages || 0) + 1);
        }
        existingData.unlockChapter = maxUnlocked;
        saveGameData(activeSaveSlot, existingData);
      }

      closeModal('save-slot-modal');
      openModal('mode-select-modal');
    }

    /**
     * モード選択（'story' または 'free'）
     */
    function selectPlayMode(mode) {
      currentPlayMode = mode;
      closeModal('mode-select-modal');
      closeModal('save-slot-modal');

      const titleBox = document.getElementById('title-box-container');
      const freeSection = document.getElementById('free-mode-selection-section');
      const mainBtns = document.querySelector('.title-main-menu-buttons');

      if (mode === 'story') {
        if (titleBox) titleBox.style.display = 'none';
        if (freeSection) freeSection.style.display = 'none';
        if (mainBtns) mainBtns.style.display = 'flex';
        openStoryChapterModal();
      } else {
        // フリーモード選択時：タイトル画面パネルを表示し「はじめから」「冒険の書を開く」ボタンを非表示にする
        renderNormalModeButtons();
        if (titleBox) titleBox.style.display = 'block';
        if (freeSection) freeSection.style.display = 'block';
        if (mainBtns) mainBtns.style.display = 'none';
        showNotification("🛡️ フリーモード（審判の模擬戦）を選択しました。村の規模を選んで出撃してください。");
        setTimeout(() => {
          if (freeSection) freeSection.scrollIntoView({ behavior: 'smooth' });
        }, 100);
      }
    }

    /**
     * ストーリー章選択モーダルを開く
     */
    function openStoryChapterModal() {
      renderStoryChapterModalContent();
      openModal('story-chapter-modal');
    }

    /**
     * 章選択モーダルコンテンツの描画
     */
    function renderStoryChapterModalContent() {
      const headerEl = document.getElementById('story-book-status-header');
      const container = document.getElementById('story-chapters-list-container');
      if (!container) return;

      const lang = currentAppLanguage || 'ja';
      const t = I18N_TRANSLATIONS[lang] || I18N_TRANSLATIONS.ja;

      const saveData = loadGameData(activeSaveSlot) || {};
      const rawCh = typeof saveData.unlockChapter === 'number' ? saveData.unlockChapter : (typeof saveData.currentChapter === 'number' ? saveData.currentChapter : 1);
      const currentUnlockedChapter = Math.min(5, Math.max(1, rawCh));
      const heroIQ = typeof saveData.heroIQ === 'number' ? saveData.heroIQ : 100;
      const score = typeof saveData.totalScore === 'number' ? saveData.totalScore.toLocaleString() : "0";
      const rankTitle = translateRankTitle(saveData.rankTitle || getRankTitle(heroIQ, saveData.totalScore || 0), lang);

      const currentTrust = typeof saveData.playerTrust === 'number' ? saveData.playerTrust : 100;

      const getBookTitle = (id) => {
        if (lang === 'en') return `Adventure Log Vol.${id}`;
        if (lang === 'zh') return `冒险之书 第${id}卷`;
        if (lang === 'ko') return `모험의 서 제${id}권`;
        return (BOOK_NAMES && BOOK_NAMES[id]) || `冒険の書 第${id}巻`;
      };
      const bookName = getBookTitle(activeSaveSlot);
      const heroLabel = lang === 'en' ? 'Hero Name' : (lang === 'zh' ? '勇者名' : (lang === 'ko' ? '용사명' : '勇者名'));
      const defaultHero = lang === 'en' ? 'Hero' : (lang === 'zh' ? '勇者' : (lang === 'ko' ? '용사' : '勇者'));
      const trustLabel = lang === 'en' ? 'Trust' : (lang === 'zh' ? '信任度' : (lang === 'ko' ? '신뢰도' : '信頼度'));
      const scoreLabel = lang === 'en' ? 'Score' : (lang === 'zh' ? '分数' : (lang === 'ko' ? '스코어' : 'スコア'));
      const heroIqLabel = lang === 'en' ? 'Hero IQ' : (lang === 'zh' ? '勇者IQ' : (lang === 'ko' ? '용사 IQ' : '勇者IQ'));

      if (headerEl) {
        headerEl.innerHTML = `
          <div>📜 <strong>${bookName}</strong> | ${heroLabel}: <strong>${saveData.heroName || defaultHero}</strong></div>
          <div>【${rankTitle}】 ${trustLabel}: <strong style="color:${currentTrust>=60?'#10b981':(currentTrust>=30?'#fbbf24':'#ef4444')};">${currentTrust}%</strong> | ${heroIqLabel}: <strong style="color:#60a5fa;">${heroIQ}</strong> | ${scoreLabel}: <strong style="color:#34d399;">${score} pt</strong></div>
        `;
      }

      container.innerHTML = '';

      for (let chId = 1; chId <= 5; chId++) {
        const ch = getStoryChapterInfo(chId, lang);
        const isUnlocked = (chId <= currentUnlockedChapter);
        const isCleared = (saveData.chapterRecords && saveData.chapterRecords[`ch${chId}`] && saveData.chapterRecords[`ch${chId}`].cleared);
        
        const card = document.createElement('div');
        card.style.background = isUnlocked ? 'linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.9))' : 'rgba(15, 23, 42, 0.5)';
        card.style.border = isUnlocked ? (isCleared ? '2px solid #34d399' : '2px solid #fbbf24') : '1px dashed #64748b';
        card.style.borderRadius = '10px';
        card.style.padding = '0.9rem';
        card.style.opacity = isUnlocked ? '1' : '0.6';
        card.style.display = 'flex';
        card.style.justifyContent = 'space-between';
        card.style.alignItems = 'center';

        const titleColor = isUnlocked ? (isCleared ? '#34d399' : '#fbbf24') : '#94a3b8';
        const badgeText = isCleared 
          ? (lang === 'en' ? '✅ Cleared' : (lang === 'zh' ? '✅ 完成' : (lang === 'ko' ? '✅ 완료' : '✅ 完了')))
          : (isUnlocked 
              ? (lang === 'en' ? '⚔️ Available' : (lang === 'zh' ? '⚔️ 可挑战' : (lang === 'ko' ? '⚔️ 도전 가능' : '⚔️ 挑戦可能')))
              : (lang === 'en' ? '🔒 Locked' : (lang === 'zh' ? '🔒 未解锁' : (lang === 'ko' ? '🔒 미해금' : '🔒 未解放'))));

        const chPrefix = lang === 'en' ? `Ch.${chId}` : (lang === 'zh' ? `第${chId}章` : (lang === 'ko' ? `제${chId}장` : `第${chId}章`));
        const playersUnit = lang === 'en' ? 'players' : (lang === 'zh' ? '人' : (lang === 'ko' ? '인' : '名'));
        const rolesLabel = lang === 'en' ? 'Roles' : (lang === 'zh' ? '角色' : (lang === 'ko' ? '역할' : '役職'));
        const reqLabel = lang === 'en' ? 'Condition' : (lang === 'zh' ? '条件' : (lang === 'ko' ? '조건' : '条件'));
        const deployBtnText = lang === 'en' ? 'Deploy' : (lang === 'zh' ? '出击' : (lang === 'ko' ? '출격' : '出撃'));
        const sealedBtnText = lang === 'en' ? '🔒 Sealed' : (lang === 'zh' ? '🔒 封印' : (lang === 'ko' ? '🔒 봉인' : '🔒 封印'));

        card.innerHTML = `
          <div style="text-align: left;">
            <div style="font-size: 1.05rem; font-weight: bold; color: ${titleColor};">
              ${chPrefix}：${ch.name} <span style="font-size: 0.78rem; font-weight: normal; color: #cbd5e1;">(${ch.difficulty} / ${ch.size}${playersUnit})</span>
              <span style="font-size: 0.75rem; background: rgba(0,0,0,0.4); color: ${titleColor}; padding: 0.15rem 0.4rem; border-radius: 6px; margin-left: 0.4rem;">${badgeText}</span>
            </div>
            <div style="font-size: 0.8rem; color: #e2e8f0; margin-top: 0.3rem;">
              👥 ${rolesLabel}: <strong>${ch.desc}</strong>
            </div>
            <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 0.2rem;">
              ${reqLabel}: ${ch.unlockReq}
            </div>
          </div>
          <div>
            ${isUnlocked 
              ? `<button class="btn btn-primary" style="padding: 0.5rem 0.9rem; font-weight: bold;" onclick="startStoryChapter(${chId})">${deployBtnText}</button>`
              : `<button class="btn btn-secondary" style="padding: 0.5rem 0.9rem;" disabled>${sealedBtnText}</button>`
            }
          </div>
        `;

        container.appendChild(card);
      }
    }

    /**
     * ストーリー全リセット確認ダイアログ
     */
    function confirmStoryReset() {
      const lang = currentAppLanguage || 'ja';
      const confirmMsg = lang === 'en' 
        ? '⚠️ Full Reset Confirmation\n\nThis will reset all story progression, trust, IQ, and scores in this save slot to initial state.\n\nThis action cannot be undone. Are you sure you want to reset?'
        : (lang === 'zh'
            ? '⚠️ 全面重置确认\n\n该操作将重置此冒险之书中所有的剧情进度、信任度、勇者IQ和总分，恢复为初始状态。\n\n该操作不可撤销，确定要重置吗？'
            : (lang === 'ko'
                ? '⚠️ 전체 리셋 확인\n\n이 모험의 서의 스토리 진행, 신뢰도, 용사 IQ, 점수를 모두 초기 상태로 리셋합니다.\n\n이 작업은 취소할 수 없습니다. 정말 리셋하시겠습니까?'
                : '⚠️ 全リセット確認\n\nこの冒険の書のストーリー進行・信頼度・勇者IQ・スコアを全てリセットして初期状態に戻します。\n\nこの操作は取り消せません。本当にリセットしますか？'));

      showCustomConfirmModal(
        confirmMsg,
        (confirmed) => {
          if (confirmed) executeStoryReset();
        }
      );
    }

    /**
     * ストーリー全リセット実行
     * 信頼度100, IQ100, スコア0, 全章ロック, 進行記録クリア
     */
    function executeStoryReset() {
      if (!activeSaveSlot) return;

      const saveData = loadGameData(activeSaveSlot) || {};
      
      // リセット対象パラメータ
      saveData.playerTrust = 100;
      saveData.heroIQ = 100;
      saveData.totalScore = 0;
      saveData.unlockChapter = 1;
      saveData.chapterRecords = {};
      saveData.isStoryCleared = false;
      saveData.rankTitle = getRankTitle(100, 0);
      saveData.updatedAt = new Date().toLocaleString("ja-JP");

      // 保存
      try {
        localStorage.setItem(BOOK_KEY_PREFIX + activeSaveSlot, JSON.stringify(saveData));
      } catch (e) {
        console.error("リセット保存失敗:", e);
      }

      // 現在のゲーム状態もリセット
      if (typeof gameState !== 'undefined') {
        gameState.playerTrust = 100;
      }

      // UIを再描画
      renderStoryChapterModalContent();
      updateTitleSaveSlotUI();
      showNotification('🔄 冒険の書をリセットしました。信頼度・IQ・進行状況が初期化されました。');
    }

    // =====================================================
    // 🎵 ストーリーモード章別BGM管理（BGM2/jyosyou, 2syou〜5syou）
    // =====================================================
    let currentStoryBgm = null;
    let currentStoryBgmKey = null;

    function playStoryBgm(chapterKey) {
      // 既存のストーリーBGMが同じキーで再生中ならそのまま継続
      if (currentStoryBgmKey === chapterKey && currentStoryBgm && !currentStoryBgm.paused) {
        return;
      }

      stopStoryBgm();

      // 通常ゲームBGM（タイトルBGM等）を一時停止
      if (currentBgm && !currentBgm.paused) {
        currentBgm.pause();
      }

      let fileName = "";
      switch (chapterKey) {
        case "prologue":
        case "ch1":
          fileName = "jyosyou";
          break;
        case "ch2":
          fileName = "2syou";
          break;
        case "ch3":
          fileName = "3syou";
          break;
        case "ch4":
          fileName = "4syou";
          break;
        case "ch5":
          fileName = "5syou";
          break;
        default:
          return;
      }

      currentStoryBgmKey = chapterKey;
      currentStoryBgm = new Audio(`BGM2/${fileName}.mp3`);
      currentStoryBgm.loop = true;
      const volRate = (typeof bgmVolume === 'number' ? bgmVolume : 100) / 100;
      currentStoryBgm.volume = 0.5 * volRate;

      currentStoryBgm.play().catch(e => {
        console.log("ストーリーBGM自動再生待機（ユーザー操作待ち）:", e);
      });
    }

    function stopStoryBgm() {
      if (currentStoryBgm) {
        currentStoryBgm.pause();
        currentStoryBgm.currentTime = 0;
        currentStoryBgm = null;
      }
      currentStoryBgmKey = null;
    }

    // ストーリー導入ページのステップ管理
    let storyPages = [];
    let currentStoryPageIndex = 0;

    /**
     * ストーリー章出撃開始
     * 1章の場合: 序章 ➔ 1章の物語 ➔ 村の詳細情報（3ページ構成）
     * 2章〜5章の場合: 章の物語 ➔ 村の詳細情報（2ページ構成）
     */
    function startStoryChapter(chId) {
      currentStoryChapter = chId;
      currentPlayMode = 'story';
      closeModal('story-chapter-modal');

      const lang = currentAppLanguage || 'ja';
      const dataKey = `ch${chId}`;
      const storyObj = getStoryData(dataKey, lang);
      const chapterConfig = getStoryChapterInfo(chId, lang);
      const prologueObj = getStoryData('prologue', lang);

      // 該当章のストーリーBGMを自動再生
      playStoryBgm(dataKey);

      // 物語テキストと村の詳細情報（区切り線以降）を分離
      const rawContent = storyObj.content || '';
      const splitIdx = rawContent.indexOf('━━━━━━━━━━━━━━━━━━━');
      let narrativeText = rawContent;
      let villageDetailsText = '';

      if (splitIdx !== -1) {
        narrativeText = rawContent.slice(0, splitIdx).trim();
        villageDetailsText = rawContent.slice(splitIdx).trim();
      } else {
        const villageScaleLabel = lang === 'en' ? 'Village Scale' : (lang === 'zh' ? '村庄规模' : (lang === 'ko' ? '마을 규모' : '村の規模'));
        const membersLabel = lang === 'en' ? 'Members' : (lang === 'zh' ? '人' : (lang === 'ko' ? '명' : '名'));
        const victoryConditionLabel = lang === 'en' ? 'Victory Condition' : (lang === 'zh' ? '胜利条件' : (lang === 'ko' ? '승리 조건' : '勝利条件'));
        const victoryConditionText = lang === 'en' ? 'Purge all hiding monsters and restore light to the village!' : (lang === 'zh' ? '审判铲除所有潜伏魔物，为村落夺回光明！' : (lang === 'ko' ? '잠복한 마물을 모두 심판하여 마을에 빛을 되찾아라!' : '潜伏する魔物を全て審判し、村に光を取り戻せ！'));
        villageDetailsText = `━━━━━━━━━━━━━━━━━━━\n【${villageScaleLabel} (${chapterConfig.size} ${membersLabel})】\n${chapterConfig.desc}\n\n【${victoryConditionLabel}】\n${victoryConditionText}\n━━━━━━━━━━━━━━━━━━━`;
      }

      storyPages = [];

      // 序章ボタン文
      const advancePrologueBtn = lang === 'en' ? 'Advance to Chapter 1 ▶' :
        (lang === 'zh' ? '前往第1章 ▶' :
        (lang === 'ko' ? '제1장으로 ▶' :
        '次へ進む（第1章へ） ▶'));

      // 詳細情報へのボタン文
      const advanceDetailBtn = lang === 'en' ? 'Next (Village Intel) ▶' :
        (lang === 'zh' ? '下一步（村庄情报） ▶' :
        (lang === 'ko' ? '다음으로（마을 상세 정보） ▶' :
        '次へ進む（村の詳細情報） ▶'));

      // 村の詳細情報タイトル
      const villageIntelSuffix = lang === 'en' ? 'Village Intel' :
        (lang === 'zh' ? '村庄情报' :
        (lang === 'ko' ? '마을 상세 정보' :
        '村の詳細情報'));

      // 最終出撃ボタン文
      const defaultStartBtn = lang === 'en' ? 'Commence Judgment ⚔️' :
        (lang === 'zh' ? '开始审判 ⚔️' :
        (lang === 'ko' ? '심판을 개시한다 ⚔️' :
        '審判を開始する ⚔️'));

      // 第1章の場合、まず「序章」を第1ページとして追加
      if (chId === 1 && prologueObj && prologueObj.title) {
        storyPages.push({
          title: `📜 ${prologueObj.title}`,
          content: prologueObj.content,
          btnText: advancePrologueBtn
        });
      }

      // 章の物語ページ
      storyPages.push({
        title: `📜 ${storyObj.title}`,
        content: narrativeText,
        btnText: advanceDetailBtn
      });

      // 村の詳細情報ページ
      storyPages.push({
        title: `📜 ${storyObj.title} - ${villageIntelSuffix}`,
        content: villageDetailsText,
        btnText: storyObj.btnText ? `${storyObj.btnText} ⚔️` : defaultStartBtn
      });

      currentStoryPageIndex = 0;
      renderStoryPage();
      openModal('opening-story-modal');
    }

    /**
     * 現在のストーリーページを描画
     */
    function renderStoryPage() {
      if (!storyPages || storyPages.length === 0) return;
      const page = storyPages[currentStoryPageIndex];
      if (!page) return;

      const lang = currentAppLanguage || 'ja';
      const titleEl = document.getElementById('opening-story-title');
      const contentEl = document.getElementById('opening-story-content');
      const btnEl = document.getElementById('opening-story-btn');
      const prevBtnEl = document.getElementById('opening-story-prev-btn');

      if (titleEl) titleEl.textContent = page.title;
      if (contentEl) {
        contentEl.textContent = page.content;
        contentEl.scrollTop = 0;
      }
      if (btnEl) btnEl.textContent = page.btnText;

      if (prevBtnEl) {
        prevBtnEl.textContent = lang === 'en' ? '◀ Back' :
          (lang === 'zh' ? '◀ 上一步' :
          (lang === 'ko' ? '◀ 이전' :
          '◀ 前へ戻る'));
        prevBtnEl.style.display = currentStoryPageIndex > 0 ? 'inline-block' : 'none';
      }
    }

    /**
     * 次のストーリーページへ進む（最後のページならゲーム開始）
     */
    function nextStoryStep() {
      if (currentStoryPageIndex < storyPages.length - 1) {
        currentStoryPageIndex++;
        renderStoryPage();
      } else {
        finishOpeningStory();
      }
    }

    /**
     * 前のストーリーページへ戻る
     */
    function prevStoryStep() {
      if (currentStoryPageIndex > 0) {
        currentStoryPageIndex--;
        renderStoryPage();
      }
    }

    /**
     * リザルト画面から直接次の章へ進む
     */
    function proceedNextStoryChapter() {
      closeModal('modal-overlay');
      const nextCh = Math.min(5, currentStoryChapter + 1);

      if (activeSaveSlot) {
        const saveData = loadGameData(activeSaveSlot) || {};
        saveData.unlockChapter = Math.max(saveData.unlockChapter || 1, nextCh);
        saveData.currentChapter = nextCh;
        saveData.playerTrust = typeof gameState.playerTrust === 'number' ? gameState.playerTrust : 100;
        saveGameData(activeSaveSlot, saveData);
      }

      startStoryChapter(nextCh);
    }

    /**
     * オープニング物語の完了・スキップ処理
     */
    function finishOpeningStory() {
      localStorage.setItem("has_seen_opening", "true");
      stopStoryBgm();
      closeModal('opening-story-modal');
      startGame();
    }

    // Global exports
    window.onStartNewGameClick = onStartNewGameClick;
    window.openModeSelectModal = openModeSelectModal;
    window.selectPlayMode = selectPlayMode;
    window.openStoryChapterModal = openStoryChapterModal;
    window.startStoryChapter = startStoryChapter;
    window.proceedNextStoryChapter = proceedNextStoryChapter;
    window.finishOpeningStory = finishOpeningStory;
    window.nextStoryStep = nextStoryStep;
    window.prevStoryStep = prevStoryStep;
    window.playStoryBgm = playStoryBgm;
    window.stopStoryBgm = stopStoryBgm;

    // Start Game
    function startGame() {
      requestFullScreen(); // ゲーム開始時にフルスクリーン化を試行
      unlockAudioOnInteraction();
      initAudio();
      initVoice();

      // 完全初期化（リセット）実行
      resetGameState();

      document.getElementById('title-screen').classList.add('hidden');
      document.getElementById('game-screen').classList.remove('hidden');
      document.getElementById('modal-overlay').classList.add('hidden');
      document.getElementById('seamless-overlay').classList.remove('active');

      let size = selectedVillageSize;
      let targetWolves = 2;
      let maxMistakes = 2;
      let roleDistribution = [];

      if (currentPlayMode === 'story') {
        // ★ ストーリーモード: 冒険の書（セーブデータ）から前章までの信頼度を引き継ぐ
        const saveData = loadGameData(activeSaveSlot) || {};
        if (typeof saveData.playerTrust === 'number') {
          gameState.playerTrust = saveData.playerTrust;
        } else {
          gameState.playerTrust = 100;
        }
        renderTrustUI();

        const ch = STORY_CHAPTERS[currentStoryChapter] || STORY_CHAPTERS[1];
        size = ch.size;
        targetWolves = ch.roles.wolf || 1;
        maxMistakes = size >= 20 ? 5 : (size >= 12 ? 4 : (size >= 9 ? 3 : 2));

        const rolesObj = ch.roles;
        for (let r in rolesObj) {
          for (let i = 0; i < rolesObj[r]; i++) {
            roleDistribution.push(r);
          }
        }
      } else if (selectedGameCategory === 'daily') {
        const todayStr = new Date().toISOString().split('T')[0];
        if (!currentDailyConfig) currentDailyConfig = generateDailyVillage(todayStr);

        size = currentDailyConfig.size;
        targetWolves = currentDailyConfig.wolvesCount;
        maxMistakes = size >= 10 ? 3 : 2;

        // Build role list from daily config
        const rolesObj = currentDailyConfig.roles;
        for (let r in rolesObj) {
          for (let i = 0; i < rolesObj[r]; i++) {
            roleDistribution.push(r);
          }
        }
      } else if (selectedGameCategory === 'custom') {
        size = customSettings.players;
        targetWolves = customSettings.roles.wolf || 1;
        maxMistakes = size >= 10 ? 3 : 2;

        const rolesObj = customSettings.roles;
        let countSpecial = 0;
        for (let r in rolesObj) {
          for (let i = 0; i < rolesObj[r]; i++) {
            roleDistribution.push(r);
            countSpecial++;
          }
        }
        const citizensNeeded = Math.max(0, size - countSpecial);
        for (let i = 0; i < citizensNeeded; i++) {
          roleDistribution.push('citizen');
        }
      } else {
        // Normal Mode
        size = selectedVillageSize;
        if (size === 30) {
          maxMistakes = 6;
          targetWolves = 6;
        } else if (size === 15) {
          maxMistakes = 4;
          targetWolves = 3;
        } else if (size === 10) {
          maxMistakes = 3;
          targetWolves = 2;
        } else if (size === 6) {
          targetWolves = 1;
        } else {
          targetWolves = 2;
        }

        if (size === 6) {
          roleDistribution = ['wolf', 'seer', 'medium', 'citizen', 'citizen', 'citizen'];
        } else if (size === 8) {
          roleDistribution = ['wolf', 'wolf', 'seer', 'medium', 'knight', 'madman', 'citizen', 'citizen'];
        } else if (size === 10) {
          roleDistribution = ['wolf', 'wolf', 'seer', 'medium', 'knight', 'madman', 'baker', 'citizen', 'citizen', 'citizen'];
        } else if (size === 15) {
          roleDistribution = ['wolf', 'wolf', 'wolf', 'seer', 'medium', 'knight', 'madman', 'baker', 'freemason', 'freemason', 'fox', 'citizen', 'citizen', 'citizen', 'citizen'];
        } else if (size === 30) {
          roleDistribution = [
            'wolf', 'wolf', 'wolf', 'wolf', 'wolf', 'wolf',
            'seer', 'seer',
            'medium', 'medium',
            'knight', 'knight',
            'madman', 'madman',
            'baker',
            'freemason', 'freemason',
            'nekomata',
            'bodyguard',
            'cakeShop',
            'fox',
            'citizen', 'citizen', 'citizen', 'citizen', 'citizen', 'citizen', 'citizen', 'citizen', 'citizen'
          ];
        }
      }

      const chars = CHAR_NAMES_15.slice(0, size);
      gameState.villageSize = size;
      gameState.targetWolvesCount = targetWolves;
      gameState.charList = chars;
      gameState.mistakesLeft = maxMistakes;
      gameState.initialMistakesLeft = maxMistakes;
      gameState.gameCategory = selectedGameCategory;

      // AI性格プロファイルの割り当て
      assignProfilesToPlayers(chars);

      // --- 村に存在する役職一覧を取得するヘルパー（偽CO時に村にない役職を名乗らないため） ---
      function getExistingRolesInVillage() {
        const rolesInVillage = new Set(roleDistribution);
        return rolesInVillage;
      }
      // gameStateに保存して他の関数からもアクセスできるようにする
      gameState.roleDistribution = [...roleDistribution];

      // Role Assignment
      const shuffledChars = [...chars].sort(() => 0.5 - Math.random());
      roleDistribution.forEach((role, idx) => {
        if (shuffledChars[idx]) {
          gameState.roles[shuffledChars[idx]] = role;
        }
      });

      chars.forEach(c => {
        gameState.status[c] = 'alive';
        gameState.coRoles[c] = 'grey';
        gameState.memoRoles[c] = 'none';
        gameState.claimedRoleTypes[c] = null;
        gameState.isStealthing[c] = false;
        gameState.seerHistory[c] = [];
        gameState.mediumHistory[c] = [];
      });

      // Setup Role Intentions & Stealth Choices
      // 1. 賢者（真賢者）: 1日目議論中に原則即時CO
      const seerChar = chars.find(c => gameState.roles[c] === 'seer');
      if (seerChar) {
        gameState.claimedRoleTypes[seerChar] = 'seer';
        gameState.isStealthing[seerChar] = false;
        gameState.coRoles[seerChar] = 'seer';
      }

      // 2. 聖職者（真聖職者）: 1日目は必ず潜伏し、2日目の朝に昨夜の処刑結果とともにCO
      const mediumChar = chars.find(c => gameState.roles[c] === 'medium');
      if (mediumChar) {
        gameState.claimedRoleTypes[mediumChar] = 'medium';
        gameState.isStealthing[mediumChar] = true; // 初日潜伏セオリー徹底
        gameState.coRoles[mediumChar] = 'grey';
      }

      // 狩人 (護衛手)
      const hunterChar = chars.find(c => gameState.roles[c] === 'hunter');
      if (hunterChar) {
        gameState.claimedRoleTypes[hunterChar] = 'knight';
        gameState.isStealthing[hunterChar] = true;
        gameState.coRoles[hunterChar] = 'grey';
      }

      // 黒服（身代わり護衛）
      const bgChar = chars.find(c => gameState.roles[c] === 'bodyguard');
      if (bgChar) {
        gameState.claimedRoleTypes[bgChar] = 'knight';
        gameState.isStealthing[bgChar] = true;
        gameState.coRoles[bgChar] = 'grey';
      }

      // 3. 騎士 (真騎士): 終盤まで絶対潜伏
      const knightChar = chars.find(c => gameState.roles[c] === 'knight');
      if (knightChar) {
        gameState.claimedRoleTypes[knightChar] = 'knight';
        gameState.isStealthing[knightChar] = true; // 終盤まで絶対潜伏セオリー徹底
        gameState.coRoles[knightChar] = 'grey';
      }

      // 4. 共有者: 1日目議論中に即時CO（村の確定白枠作成）
      const masons = chars.filter(c => gameState.roles[c] === 'freemason');
      if (masons.length === 2) {
        masons.forEach(m => {
          gameState.coRoles[m] = 'freemason';
          gameState.isStealthing[m] = false;
        });
      }

      // 5. 騙り役職（擬態モンスター・魔教徒）の騙り役職設定
      const fakeCandidates = chars.filter(c => gameState.roles[c] === 'wolf' || gameState.roles[c] === 'madman');
      if (fakeCandidates.length > 0 && Math.random() < 0.85) {
        const fake1 = pickRandom(fakeCandidates);
        // 村に存在する役職のみを騙り候補にする
        const villageRoles = new Set(roleDistribution);
        const fakeCOOptions = ['seer', 'medium'].filter(r => villageRoles.has(r));
        if (fakeCOOptions.length === 0) fakeCOOptions.push('seer'); // 最低限seerは騙れる
        const fakeType = pickRandom(fakeCOOptions);
        gameState.claimedRoleTypes[fake1] = fakeType;

        if (fakeType === 'seer') {
          // 騙り賢者は1日目即時CO
          gameState.isStealthing[fake1] = false;
          gameState.coRoles[fake1] = 'seer';
        } else if (fakeType === 'medium') {
          // 騙り聖職者は1日目潜伏し2日目朝に結果発表CO
          gameState.isStealthing[fake1] = true;
          gameState.coRoles[fake1] = 'grey';
        }
      }

      // Setup Alibis
      const placeShuffled = [...PLACES].sort(() => 0.5 - Math.random());
      chars.forEach((c, idx) => gameState.alibis[c] = placeShuffled[idx % placeShuffled.length]);

      // 配役集計テキストの生成 (例: 8人村 (魔物2/賢者1/聖職者1/聖騎士1/魔教徒1/村人2))
      const ROLE_LABELS = {
        wolf: '魔物', seer: '賢者', medium: '聖職者', knight: '聖騎士', madman: '魔教徒',
        baker: 'パン', cakeShop: 'ケーキ', freemason: '共有', hunter: '狩人',
        nekomata: '猫又', fanatic: '狂信', bodyguard: '黒服', immoral: '背徳', fox: '妖狐', citizen: '村人', villager: '村人'
      };
      const roleCounts = {};
      Object.values(gameState.roles).forEach(r => {
        roleCounts[r] = (roleCounts[r] || 0) + 1;
      });
      const roleOrder = ['wolf', 'seer', 'medium', 'knight', 'hunter', 'bodyguard', 'madman', 'fanatic', 'baker', 'cakeShop', 'freemason', 'nekomata', 'immoral', 'fox', 'citizen'];
      const roleParts = [];
      roleOrder.forEach(r => {
        if (roleCounts[r]) {
          roleParts.push(`${ROLE_LABELS[r] || r}${roleCounts[r]}`);
        }
      });
      const roleSummaryText = roleParts.join('/');

      updateVillageSizeDisplay();

      switchView(1);
      setupDayOneDirectly();
    }

    // 村の規模表示（配役サマリー含む）の多言語対応描画
    function updateVillageSizeDisplay() {
      const sizeEl = document.getElementById('village-size-display');
      if (!sizeEl || !gameState.charList || gameState.charList.length === 0) return;

      const size = gameState.villageSize || selectedVillageSize || 6;
      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;

      const ROLE_LABELS = {
        ja: { wolf: '魔物', seer: '賢者', medium: '聖職者', knight: '聖騎士', madman: '魔教徒', baker: 'パン', cakeShop: 'ケーキ', freemason: '共有', hunter: '狩人', nekomata: '猫又', fanatic: '狂信', bodyguard: '黒服', immoral: '背徳', fox: '妖狐', citizen: '村人', villager: '村人' },
        en: { wolf: 'Wolf', seer: 'Seer', medium: 'Medium', knight: 'Knight', madman: 'Madman', baker: 'Baker', cakeShop: 'Cake', freemason: 'Mason', hunter: 'Hunter', nekomata: 'Cat', fanatic: 'Fanatic', bodyguard: 'Bodyguard', immoral: 'Immoral', fox: 'Fox', citizen: 'Villager', villager: 'Villager' },
        zh: { wolf: '狼人', seer: '预言', medium: '通灵', knight: '骑士', madman: '狂人', baker: '面包', cakeShop: '蛋糕', freemason: '共有', hunter: '猎人', nekomata: '猫又', fanatic: '狂信', bodyguard: '保镖', immoral: '背德', fox: '妖狐', citizen: '村民', villager: '村民' },
        ko: { wolf: '늑대', seer: '예언', medium: '영매', knight: '기사', madman: '광인', baker: '제빵', cakeShop: '케이크', freemason: '공유', hunter: '사냥', nekomata: '고양이', fanatic: '광신', bodyguard: '경호', immoral: '배덕', fox: '여우', citizen: '주민', villager: '주민' }
      };

      const langLabels = ROLE_LABELS[currentAppLanguage] || ROLE_LABELS.en;
      const roleCounts = {};
      Object.values(gameState.roles || {}).forEach(r => {
        roleCounts[r] = (roleCounts[r] || 0) + 1;
      });
      const roleOrder = ['wolf', 'seer', 'medium', 'knight', 'hunter', 'bodyguard', 'madman', 'fanatic', 'baker', 'cakeShop', 'freemason', 'nekomata', 'immoral', 'fox', 'citizen'];
      const roleParts = [];
      roleOrder.forEach(r => {
        if (roleCounts[r]) {
          roleParts.push(`${langLabels[r] || r}${roleCounts[r]}`);
        }
      });
      const roleSummaryText = roleParts.join('/');
      const sizeText = (t.village_size_fmt || '{size}人村').replace('{size}', size);
      sizeEl.innerHTML = `<strong>${sizeText}</strong> <span style="font-size: 0.74rem; font-weight: normal; color: rgba(255, 255, 255, 0.78); margin-left: 0.25rem;">(${roleSummaryText})</span>`;
    }

    // 議論制限時間の多言語アナウンス文字列を取得
    function getFormattedDiscussionTimeText() {
      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;
      if (discussionTimeSetting < 0) {
        return t.role_unlimited || '無制限';
      }
      const mins = Math.floor(discussionTimeSetting / 60);
      const secs = discussionTimeSetting % 60;
      if (mins > 0 && secs > 0) {
        return (t.min_sec_fmt || '{m}分{s}秒').replace('{m}', mins).replace('{s}', secs);
      } else if (mins > 0) {
        return (t.min_fmt || '{m}分').replace('{m}', mins);
      } else {
        return (t.sec_fmt || '{s}秒').replace('{s}', discussionTimeSetting);
      }
    }

    // Direct Initial Morning Setup for Day 1
    async function setupDayOneDirectly() {
      playBgm('asa');
      setGamePhaseBg('morning');
      gameState.phase = '朝';
      gameState.subPhase = 'discussion';
      gameState.executedToday = false;
      gameState.dailySeerReports = {};
      gameState.dailyMediumReports = {};
      gameState.morningComments = {};

      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;
      const timeLimitText = getFormattedDiscussionTimeText();
      const morningNewsText = (t.morning_day1_news || '初日の朝、昨夜の犠牲者は居ませんでした。全員無事です。これより1日目の議論を開始します。制限時間は{time}です。自由に対象へ質問を行ってください。').replace('{time}', timeLimitText);
      addLogItem(t.narration_speaker || 'ナレーション', '', morningNewsText, 'narration', null, false);
      await playSpeechAsync(`${getDaySpeechText(1)}…… ${morningNewsText}`);

      // Baker Report
      const bakerChar = gameState.charList.find(c => gameState.roles[c] === 'baker');
      if (bakerChar && gameState.status[bakerChar] === 'alive') {
        const bakerText = t.morning_baker || '「今朝もおいしい焼きたてパンが焼き上がりました！」';
        addLogItem(t.baker_title || '🍞 パン屋より', '', bakerText, 'baker', null, false);
        await playSpeechAsync(`${getDaySpeechText(1)}…… ${bakerText}`);
      }

      // CakeShop Report
      const cakeChar = gameState.charList.find(c => gameState.roles[c] === 'cakeShop');
      if (cakeChar && gameState.status[cakeChar] === 'alive') {
        const cakeText = '「今朝もおいしい焼きたてケーキが焼き上がりました！」';
        addLogItem('🍰 ケーキ屋より', '', cakeText, 'baker', null, false);
        await playSpeechAsync(`${getDaySpeechText(1)}…… ${cakeText}`);
      }

      performNightAbilities();
      evaluateStealthCOTriggers();
      generateMorningComments();
      await triggerMorningRoleReports();

      renderBulletinBoard();
      renderMorningCommentsBox();

      gameState.phase = '昼';
      calculateVirtualVotes();
      const morningStrD1 = { ja: '朝', en: 'Morning', zh: '清晨', ko: '아침' }[currentAppLanguage] || '朝';
      recordVirtualVoteHistory(`${formatDay(1)} ${morningStrD1}`);
      renderVoteHistoryPage();
      renderStatus();
      renderCharacters();
      selectCharacter(null);

      // ★ 初日開戦時のオートセーブ
      autoSaveCurrentGame();

      startDiscussionTimer();
    }

    // =====================================================
    // 🩸 誤処刑演出システム（Mislynch Consequences）
    // =====================================================

    // 誤審バナー表示（赤い禍々しいテロップ）
    function showMislynchBanner() {
      return new Promise(resolve => {
        const overlay = document.getElementById('mislynch-banner-overlay');
        if (!overlay) { resolve(); return; }
        overlay.classList.add('active');
        setTimeout(() => {
          overlay.classList.remove('active');
          setTimeout(resolve, 600); // フェードアウト完了待ち
        }, 2500);
      });
    }

    // ★ 誤処刑発覚時NPC発言テンプレート（5カテゴリ×4パターン = 全20パターン）
    // {executedName} = 処刑された人物名, {npcName} = 発言中に言及する別NPC名
    const MIS_EXECUTION_DIALOGUES = {
      criticism: [
        "お告げだの神眼だのと言いながら、結果はどうだ！ 勇者様、あんたが指図したから無実の者が死んだんだぞ！",
        "私たちの命を預かっているはずの勇者様が、一番最初に村人を殺してどうするんです！ 次も外したら、もうあんたの言うことは信じないからな！",
        "……なあ。勇者ってのは本当に村を守るために来たのか？ それとも、私たちを面白半分で処刑台に送って楽しんでるだけなんじゃないのか……？",
        "血の匂いが鼻をつく……昨日の処刑は完全な誤りだった。勇者様、あんたのその剣、本当に魔物を斬るためにあるのか？"
      ],
      despair: [
        "嘘だと言ってくれ……{executedName}は昨日まで笑って畑を手伝ってくれてたんだぞ……！ なんで、なんでそんな人が魔物として殺されなきゃいけないんだよ……！",
        "父さんは……私の父さんはただの村人だったんだ！ それなのに、勇者様のせいで……もう二度と帰ってこないんだ……！",
        "{executedName}殿は村で一番親切な人だった。そんな人が魔物なわけなかったんだ……。私のせいで、私があの時庇ってやれなかったから……！",
        "誰も信じない。誰が味方で、誰が私を裏切って処刑台送りにしようとしているのか……もうこの村には誰も信用できる人間なんていない！"
      ],
      fear: [
        "次は私だ……！ 次は私の番だ！ 何も喋ってないのに、適当な理由をつけられて明日には首を撥ねられるんだ……いやだ、殺されたくない！",
        "もう怖くて発言なんてできない……！ 下手に意見を言うと『怪しい』って言われて勇者様に処刑される。黙っていた方が生き残れるのか……？",
        "狂ってる、この村は全員狂っちまったんだ！ 無実の人間を生贄にして、次は誰を差し出すかって怯えながら暮らすなんて……もう地獄だ！",
        "門を開けてくれ！ ここにいたら魔物に喰われる前に、勇者様の誤審で全員殺される！ 外の森の方がよっぽど安全だ！"
      ],
      conflict: [
        "おい{npcName}！ お前、昨日しきりに『あいつが怪しい』って誘導してたろ！ お前が勇者様を騙したから、あんな間違いが起きたんだ！",
        "なんだと！？ 私を疑うのか！ それならお前だって、昨日の議論の時妙に静かだったじゃないか！ お前こそ魔物の手先なんじゃないのかよ！",
        "やめろ！ こうやって仲間同士で疑い合って言い争うのが、魔物の思う壺なんだよ！ ……でも、お前らの目をみていると、もう誰も人間には見えない……！",
        "昨日の誤審で無実の人が死んだんだ。だったら、次の処刑は『誤った情報を流した奴』を全員で選んで責任を取らせるべきだ！"
      ],
      provoke: [
        "おや、おや……。昨日の威勢はどこへ行ったんです？ 勇者様を信じた結果がこれですか。無残なものですね",
        "勇者様、責任重大ですね。あなたのその『神眼』とやらは、もう完全に曇っちまったみたいだ。次の審判も外したら、村人全員があんたに牙を剥きますよ",
        "みんな落ち着けって……！ ほら、そうやって怯えて疑い合ってる隙に、本当の魔物が後ろで笑ってるんだぜ？ ……まあ、それが誰だかは言わないでおくがな",
        "もう手遅れさ。間違えて人間を殺した瞬間から、この村の絆は二度と元には戻らない。さあ、次は誰を血祭りにあげて安心する気だ？"
      ]
    };

    // カテゴリ別の絵文字・CSSクラス設定
    const MISLYNCH_CATEGORY_META = {
      criticism: { emoji: '💢', cssClass: 'mislynch-critic' },
      despair:   { emoji: '😭', cssClass: 'mislynch-despair' },
      fear:      { emoji: '😨', cssClass: 'mislynch-fear' },
      conflict:  { emoji: '🔥', cssClass: 'mislynch-conflict' },
      provoke:   { emoji: '🃏', cssClass: 'mislynch-provoke' }
    };

    // 誤処刑発覚時のNPC多角的批判・恐怖・ギスギス会話と内部処理
    async function processMislynchConsequences() {
      // 誤処刑判定条件チェック
      if (!gameState.lastExecutedChar || !gameState.lastExecutedRole) return;
      if (gameState.lastExecutedRole === 'wolf' || gameState.lastExecutedRole === 'fox') return;
      if (gameState.mislynchProcessedDay >= gameState.day) return;

      // 魔物がまだ生存しているか確認
      const aliveWolves = gameState.charList.filter(c => gameState.roles[c] === 'wolf' && gameState.status[c] === 'alive');
      if (aliveWolves.length === 0) return;

      // 誤処刑イベント発動
      gameState.mislynchProcessedDay = gameState.day;

      // ★ UI演出: 赤いバナー表示
      await showMislynchBanner();

      const executedName = getCharDisplayName(gameState.lastExecutedChar);
      const aliveNPCs = gameState.charList.filter(c => gameState.status[c] === 'alive');
      if (aliveNPCs.length === 0) return;

      // テンプレート変数置換ヘルパー
      function resolveTemplate(template, speakerChar) {
        let text = template.replace(/\{executedName\}/g, executedName);
        // {npcName} は発言者以外のランダムな生存NPCの名前に置換
        const othersForMention = aliveNPCs.filter(c => c !== speakerChar);
        const mentionTarget = othersForMention.length > 0 ? pickRandom(othersForMention) : null;
        text = text.replace(/\{npcName\}/g, mentionTarget ? getCharDisplayName(mentionTarget) : '誰か');
        return text;
      }

      // スピーカー選定（ランダムに3〜4人のNPCを選出、人数が少ない場合は調整）
      const shuffledNPCs = [...aliveNPCs].sort(() => Math.random() - 0.5);
      const speakerCount = Math.min(shuffledNPCs.length, aliveNPCs.length >= 6 ? 4 : 3);
      const speakers = shuffledNPCs.slice(0, speakerCount);

      // 各スピーカーにカテゴリを割り当て
      // ルール: 1人目=criticism(糾弾), 2人目=despair or fear, 3人目=conflict
      //         4人目=魔物NPCなら provoke を優先、それ以外は残りカテゴリからランダム
      const humanCategories = ['criticism', 'despair', 'fear', 'conflict'];
      const assignments = [];

      // 1人目: 必ず criticism（勇者糾弾）
      assignments.push('criticism');

      // 2人目: despair か fear をランダム選択
      if (speakers.length >= 2) {
        assignments.push(Math.random() < 0.5 ? 'despair' : 'fear');
      }

      // 3人目: conflict（ギスギス）
      if (speakers.length >= 3) {
        assignments.push('conflict');
      }

      // 4人目: 魔物（wolf/madman/fanatic）なら provoke を優先、それ以外は未使用カテゴリから選択
      if (speakers.length >= 4) {
        const fourthRole = gameState.roles[speakers[3]];
        const isEvil = (fourthRole === 'wolf' || fourthRole === 'madman' || fourthRole === 'fanatic');
        if (isEvil) {
          assignments.push('provoke');
        } else {
          // 未使用のカテゴリからランダム選択
          const usedCategories = assignments.slice();
          const remaining = humanCategories.filter(c => !usedCategories.includes(c));
          assignments.push(remaining.length > 0 ? pickRandom(remaining) : pickRandom(humanCategories));
        }
      }

      // 使用済みセリフ追跡（重複防止）
      const usedLines = new Set();

      for (let i = 0; i < speakers.length; i++) {
        const speaker = speakers[i];
        const speakerName = getCharDisplayName(speaker);
        const category = assignments[i];
        const pool = MIS_EXECUTION_DIALOGUES[category];
        const meta = MISLYNCH_CATEGORY_META[category];

        // 重複しないセリフを選択
        let chosenLine;
        let attempts = 0;
        do {
          chosenLine = pickRandom(pool);
          attempts++;
        } while (usedLines.has(chosenLine) && attempts < pool.length * 2);
        usedLines.add(chosenLine);

        // テンプレート変数を実際の名前に置換
        const resolvedLine = resolveTemplate(chosenLine, speaker);

        addLogItem(`${meta.emoji} ${speakerName}`, '', `「${resolvedLine}」`, meta.cssClass, speaker, false);
        await playSpeechAsync(resolvedLine, speaker);
      }

      // ★ 内部処理: 勇者不信度上昇＆表面的判明による信頼度減算反映
      gameState.heroDistrustLevel++;
      resolvePendingTrustForChar(gameState.lastExecutedChar);

      // ★ 通知表示
      showNotification('⚠️ 誤審により村人の信頼が低下しました……');
    }

    // Step 2: Post-Unblind Morning Phase Process
    async function startMorningPostUnblind() {
      playBgm('asa');
      setGamePhaseBg('morning');
      gameState.phase = '朝';
      gameState.subPhase = 'discussion';
      gameState.executedToday = false;
      gameState.dailySeerReports = {};
      gameState.dailyMediumReports = {};
      gameState.morningComments = {};

      const victims = gameState.lastNightVictims || [];
      let victimText = '';
      if (victims.length === 0) {
        victimText = `${formatDay(gameState.day)}の朝…… 昨夜の魔物の襲撃被害はありませんでした。全員無事です。`;
      } else if (victims.length === 1) {
        const victimName = getCharDisplayName(victims[0]);
        victimText = `${formatDay(gameState.day)}の朝…… 悲鳴が響き渡った…… ${victimName} が魔物の犠牲となった。`;
      } else if (victims.length >= 2) {
        const victimNames = victims.map(v => getCharDisplayName(v)).join(' と ');
        victimText = `${formatDay(gameState.day)}の朝…… 悲鳴が響き渡った…… ${victimNames} が魔物の犠牲となった。`;
      }

      const timeLimitText = getFormattedDiscussionTimeText();
      const dateText = `${formatDay(gameState.day)} (${gameState.phase})`;
      const morningNewsText = `${victimText} 審判会議を開始します。村の中に潜む『擬態モンスター』の発言の矛盾を見抜いてください。制限時間は${timeLimitText}です。`;

      addLogItem('ナレーション', '', morningNewsText, 'narration', null, false);
      


      await playSpeechAsync(`${getDaySpeechText(gameState.day)}…… ${morningNewsText}`);

      // Baker Report
      const bakerChar = gameState.charList.find(c => gameState.roles[c] === 'baker');
      if (bakerChar && gameState.status[bakerChar] === 'alive') {
        const bakerText = '「今朝もおいしい焼きたてパンが焼き上がりました！」';
        addLogItem('🍞 パン屋より', '', bakerText, 'baker', null, false);
        await playSpeechAsync(`${getDaySpeechText(gameState.day)}…… ${bakerText}`);
      }

      // CakeShop Report
      const cakeChar = gameState.charList.find(c => gameState.roles[c] === 'cakeShop');
      if (cakeChar && gameState.status[cakeChar] === 'alive') {
        const cakeText = '「今朝もおいしい焼きたてケーキが焼き上がりました！」';
        addLogItem('🍰 ケーキ屋より', '', cakeText, 'baker', null, false);
        await playSpeechAsync(`${getDaySpeechText(gameState.day)}…… ${cakeText}`);
      }

      performNightAbilities();
      evaluateStealthCOTriggers();
      generateMorningComments();
      await triggerMorningRoleReports();

      // ★ 誤処刑演出（2日目以降、前日に人間を処刑していた場合に発動）
      if (gameState.day >= 2) {
        await processMislynchConsequences();
      }

      // ★ 朝の報告から昼の議論への遷移（フェードなしで即座にUIを更新）
      renderBulletinBoard();
      renderMorningCommentsBox();

      gameState.phase = '昼';
      calculateVirtualVotes();
      const morningStrDX = { ja: '朝', en: 'Morning', zh: '清晨', ko: '아침' }[currentAppLanguage] || '朝';
      recordVirtualVoteHistory(`${formatDay(gameState.day)} ${morningStrDX}`);
      renderVoteHistoryPage();
      renderStatus();
      renderCharacters();
      selectCharacter(null);

      // ★ 毎朝開戦時のオートセーブ
      autoSaveCurrentGame();

      startDiscussionTimer();
    }

    // Ability Calculations & History Archive
    function performNightAbilities() {
      const seerClaimants = gameState.charList.filter(c => gameState.claimedRoleTypes[c] === 'seer' && gameState.status[c] === 'alive');
      
      seerClaimants.forEach(char => {
        const realRole = gameState.roles[char];
        const aliveOthers = gameState.charList.filter(c => c !== char && gameState.status[c] === 'alive');
        if (aliveOthers.length > 0) {
          const history = gameState.seerHistory[char] || [];
          const alreadyInspected = history.map(h => h.target);
          const freshCandidates = aliveOthers.filter(c => !alreadyInspected.includes(c));
          const candidates = freshCandidates.length > 0 ? freshCandidates : aliveOthers;

          let target = candidates[0];
          let result = '人間';

          if (realRole === 'seer') {
            // 真賢者: グレー優先・白確定者除外ロジック
            // 1. 他の真・偽賢者からの白出し結果、および共有者など確白対象の収集
            const whiteResults = typeof getSeerWhiteResults === 'function' ? getSeerWhiteResults() : [];
            const whiteTargets = whiteResults.map(w => w.target);

            // 2. 完全なグレー（未判定かつ役職COなし/村人CO）の候補を抽出
            const grayCandidates = candidates.filter(c => {
              const isWhiteOut = whiteTargets.includes(c) || gameState.coRoles[c] === 'freemason';
              const hasCoRole = gameState.coRoles[c] && gameState.coRoles[c] !== 'villager';
              return !isWhiteOut && !hasCoRole;
            });

            // 3. 対象プールの決定（グレー候補があれば優先、なければ白出し以外、最終フォールバックはcandidates）
            let targetPool = grayCandidates;
            if (targetPool.length === 0) {
              const nonWhiteCandidates = candidates.filter(c => !whiteTargets.includes(c) && gameState.coRoles[c] !== 'freemason');
              targetPool = nonWhiteCandidates.length > 0 ? nonWhiteCandidates : candidates;
            }

            // 4. プール内から疑われ度（仮想投票の疑心度や妖狐呪殺狙い）を加味して最高スコアの対象を選択
            let bestTarget = targetPool[0];
            let maxScore = -999;
            targetPool.forEach(c => {
              let score = Math.random() * 10;
              // 仮想投票での疑われ度（suspicionScore）があれば加算して怪しいグレーを優先
              if (gameState.virtualVotes && gameState.virtualVotes[c] && gameState.virtualVotes[c].suspicionScore) {
                score += (gameState.virtualVotes[c].suspicionScore / 2);
              }
              if (gameState.roles[c] === 'fox') score += 40; // 呪殺狙い
              if (score > maxScore) {
                maxScore = score;
                bestTarget = c;
              }
            });

            target = bestTarget;
            result = gameState.roles[target] === 'wolf' ? '人狼' : '人間';

          } else if (realRole === 'wolf') {
            // 偽賢者(擬態モンスター): 「囲い(仲間に白)」または「対立村人に黒打ち」戦術
            const fellowWolves = candidates.filter(c => gameState.roles[c] === 'wolf');
            const nonWolves = candidates.filter(c => gameState.roles[c] !== 'wolf');

            // 40%で仲間を白で囲う、60%で村人に白/黒を打つ
            if (fellowWolves.length > 0 && Math.random() < 0.4) {
              target = pickRandom(fellowWolves);
              result = '人間'; // 囲い白
            } else if (nonWolves.length > 0) {
              target = pickRandom(nonWolves);
              // 30%で黒打ちブラフ、70%で白出し信用稼ぎ
              result = Math.random() < 0.3 ? '人狼' : '人間';
            } else {
              target = candidates[0];
              result = '人間';
            }

          } else if (realRole === 'madman') {
            // 偽賢者(魔教徒): グレー中心に占う（擬態モンスター誤黒出しを避けるため慎重）
            const greys = candidates.filter(c => !gameState.coRoles[c] || gameState.coRoles[c] === 'villager');
            target = greys.length > 0 ? pickRandom(greys) : pickRandom(candidates);
            // 70%で白出し（狼囲いを狙う）、30%で村人黒打ち乱立
            result = Math.random() < 0.3 ? '人狼' : '人間';
          }

          // 真賢者が妖狐を占った場合：即座に呪殺（即死）が発生
          if (realRole === 'seer' && target && gameState.roles[target] === 'fox' && gameState.status[target] === 'alive') {
            gameState.status[target] = 'cursed';
            if (!gameState.curseHistory) gameState.curseHistory = [];
            gameState.curseHistory.push({ day: gameState.day, target });
          }

          const report = { day: gameState.day, target, result };
          gameState.dailySeerReports[char] = report;
          if (!gameState.seerHistory[char]) gameState.seerHistory[char] = [];
          gameState.seerHistory[char].push(report);
        }
      });

      const mediumClaimants = gameState.charList.filter(c => gameState.claimedRoleTypes[c] === 'medium' && gameState.status[c] === 'alive');
      const lastExec = gameState.lastExecutedChar;

      mediumClaimants.forEach(char => {
        const realRole = gameState.roles[char];
        if (!lastExec) return;

        let result = '人間';
        if (realRole === 'medium') {
          const execRole = gameState.roles[lastExec];
          if (execRole === 'wolf') result = '人狼';
          else if (execRole === 'fox') result = '妖狐';
          else result = '人間';
          // ★ 本物聖職者の鑑定報告により処刑者の正体が公表され信頼度が表面的に確定
          resolvePendingTrustForChar(lastExec);
        } else {
          // 偽聖職者（擬態モンスター・魔教徒）の騙り霊媒結果生成
          result = pickRandom(['人狼', '人間']);
        }

        const report = { day: gameState.day, target: lastExec, result };
        gameState.dailyMediumReports[char] = report;
        if (!gameState.mediumHistory[char]) gameState.mediumHistory[char] = [];
        gameState.mediumHistory[char].push(report);
      });
    }

    // Stealth CO Decision Logic (Enforcing strict role CO theories)
    function evaluateStealthCOTriggers() {
      gameState.charList.forEach(char => {
        if (!gameState.isStealthing[char] || gameState.status[char] !== 'alive') return;

        const roleType = gameState.claimedRoleTypes[char];
        let shouldCO = false;

        // 1. 聖職者（真聖職者・偽聖職者）: 2日目の朝、昨夜の処刑結果が存在する場合に一斉潜伏解除CO！
        if (roleType === 'medium' && gameState.day >= 2 && gameState.lastExecutedChar) {
          shouldCO = true;
        }

        // 2. 例外（初日対抗聖職者COトリガー）: 1日目に他のNPC/プレイヤーが聖職者COした場合、乗っ取り防止のため対抗初日CO
        if (roleType === 'medium' && gameState.day === 1) {
          const activeMediumCOs = gameState.charList.filter(c => c !== char && gameState.coRoles[c] === 'medium' && gameState.status[c] === 'alive');
          if (activeMediumCOs.length > 0) {
            shouldCO = true; // 乗っ取り防止対抗初日CO
          }
        }

        // 3. 賢者（潜伏中の場合）: 魔物判定を発見したか、2日目以降に一斉CO
        if (roleType === 'seer') {
          const lastRep = gameState.dailySeerReports[char];
          if ((lastRep && lastRep.result === '人狼') || gameState.day >= 2) {
            shouldCO = true;
          }
        }

        // 4. 聖騎士 (真聖騎士): 終盤（生存人数3人以下）に到達した場合のみCO
        if (roleType === 'knight') {
          const aliveTotal = gameState.charList.filter(c => gameState.status[c] === 'alive').length;
          if (aliveTotal <= 3) {
            shouldCO = true;
          }
        }

        if (shouldCO) {
          triggerCO(char);
        }
      });
    }

    // Helper function to unify speaker introduction prefix ("〇〇です。" / "〇〇（賢者CO）です。")
    function formatSpeechMessage(speakerChar, rawMessage) {
      const displayName = getCharDisplayName(speakerChar);
      const coRole = gameState.coRoles[speakerChar];
      
      const roleCoLabels = {
        ja: { seer: '（賢者CO）', medium: '（聖職者CO）', knight: '（聖騎士CO）', freemason: '（共有CO）' },
        en: { seer: ' (Seer Claim)', medium: ' (Medium Claim)', knight: ' (Knight Claim)', freemason: ' (Mason Claim)' },
        zh: { seer: '（预言家CO）', medium: '（通灵师CO）', knight: '（圣骑士CO）', freemason: '（共有CO）' },
        ko: { seer: ' (현자 CO)', medium: ' (성직자 CO)', knight: ' (성기사 CO)', freemason: ' (공유 CO)' }
      };

      const langLabels = roleCoLabels[currentAppLanguage] || roleCoLabels.ja;
      const coTag = coRole && langLabels[coRole] ? langLabels[coRole] : '';

      let fullPrefix = '';
      if (currentAppLanguage === 'en') {
        fullPrefix = `This is ${displayName}${coTag}. `;
      } else if (currentAppLanguage === 'zh') {
        fullPrefix = `我是${displayName}${coTag}。`;
      } else if (currentAppLanguage === 'ko') {
        fullPrefix = `${displayName}${coTag}입니다. `;
      } else {
        fullPrefix = `${displayName}${coTag}です。`;
      }

      // 既存プレフィックスの重複付与を防止
      if (rawMessage.startsWith(fullPrefix) || rawMessage.startsWith(displayName) || rawMessage.startsWith(`This is ${displayName}`) || rawMessage.startsWith(`我是${displayName}`)) {
        return rawMessage;
      }

      return `${fullPrefix}${rawMessage}`;
    }

    // Helper to fetch today's black (Wolf) investigation results from living seers
    function getTodayBlackResults() {
      const results = [];
      Object.keys(gameState.dailySeerReports || {}).forEach(seerChar => {
        const rep = gameState.dailySeerReports[seerChar];
        if (rep && rep.day === gameState.day && rep.result === '人狼' && gameState.status[rep.target] === 'alive') {
          results.push({ seer: seerChar, target: rep.target });
        }
      });
      return results;
    }

    // Generate urgent rebuttal speech for black-result accused player
    function generateBlackAccusedRebuttal(accusedChar, seerChar) {
      const lang = currentAppLanguage || 'ja';
      const seerName = getCharDisplayName(seerChar);
      const rand = Math.random();
      const realRole = gameState.roles[accusedChar];
      const existingCO = gameState.coRoles[accusedChar] || 'grey';

      const roleMapI18n = {
        seer: { ja: '賢者', en: 'Sage', zh: '贤者', ko: '현자' },
        medium: { ja: '聖職者', en: 'Cleric', zh: '圣职者', ko: '성직자' },
        knight: { ja: '聖騎士', en: 'Holy Knight', zh: '圣骑士', ko: '성기사' },
        freemason: { ja: '共有者', en: 'Freemason', zh: '共有者', ko: '공유자' }
      };
      const getRoleName = (roleKey) => (roleMapI18n[roleKey] && roleMapI18n[roleKey][lang]) || roleMapI18n[roleKey]?.ja || roleKey;

      let msg = '';

      // ① 既に役職CO済みのキャラは、自身のCO役職を絶対に撤回・変更せず主張を維持
      if (existingCO && existingCO !== 'grey' && existingCO !== 'villager') {
        const roleName = getRoleName(existingCO);
        const dict = {
          ja: `嘘をつかないでください！私は【${roleName}】として公言して行動しています！${seerName}さんは村を騙す偽物（魔物）です！真の鑑定・ログと照らし合わせればどちらが本物か明白です！`,
          en: `Cease your lies! I have publicly declared myself the [${roleName}] and acted accordingly! ${seerName} is an impostor deceiving this village! Compare the true records and it shall be clear who speaks truth!`,
          zh: `休得胡言！吾已公开以【${roleName}】之身行事！${seerName}分明是欺瞒全村的假冒妖邪！且以真实鉴定记录对质，孰真孰伪一目了然！`,
          ko: `거짓말 마시오! 저는 【${roleName}】으로서 공언하고 행동해 왔습니다! ${seerName}은(는) 마을을 속이는 가짜(마물)입니다! 진정한 감정 기록과 대조하면 누가 진짜인지 명백하오!`
        };
        msg = dict[lang] || dict.ja;
      }
      // ② 真役職者（真賢者・真聖職者・真聖騎士・共有等）が黒出しされた場合
      else if (realRole === 'seer' || realRole === 'medium' || realRole === 'knight' || realRole === 'freemason') {
        // 自身の真役職を即座に正しくCO（嘘役職の騙りは絶対にしない）
        gameState.isStealthing[accusedChar] = false;
        gameState.coRoles[accusedChar] = realRole;
        gameState.claimedRoleTypes[accusedChar] = realRole;

        const roleName = getRoleName(realRole);
        if (realRole === 'seer') {
          const dict = {
            ja: `嘘をつかないでください！私こそが本物の【賢者】です！${seerName}さんは村を騙す偽物（魔物）です！真の鑑定結果を述べて対抗します！`,
            en: `Cease your falsehoods! I am the true [Sage]! ${seerName} is an impostor deceiving our village! I shall counter with my genuine divination results!`,
            zh: `休要诬赖！在下才是真正的【贤者】！${seerName}才是蒙蔽全村的冒牌妖邪！且待某以真实鉴定结果予以对抗！`,
            ko: `거짓말 마시오! 제가 바로 진짜 【현자】입니다! ${seerName}은(는) 마을을 속이는 가짜(마물)입니다! 진정한 감정 결과로 대항하겠습니다!`
          };
          msg = dict[lang] || dict.ja;
        } else if (realRole === 'medium') {
          const dict = {
            ja: `デタラメな占いです！私は本物の【聖職者】です！今夜処刑者の判定を行う重要役職なのに、なぜ偽賢者に黒出しされなきゃいけないんですか！私を吊ったら村の情報源が途絶えます！`,
            en: `That divination is utter nonsense! I am the true [Cleric]! I bear the sacred duty of judging the executed this very night, yet the false Sage brands me a monster! Hang me, and the village loses its source of truth!`,
            zh: `一派胡言的占验！在下才是真正的【圣职者】！身负今夜审判被处决者之重任，缘何要被假贤者诬为妖邪！若将某处死，全村情报来源必将断绝！`,
            ko: `엉터리 점술입니다! 저는 진짜 【성직자】입니다! 오늘 밤 처형자를 판정할 중요 직책인데, 왜 가짜 현자에게 흑판정을 받아야 합니까! 저를 처형하면 마을의 정보원이 끊어집니다!`
          };
          msg = dict[lang] || dict.ja;
        } else if (realRole === 'knight') {
          const dict = {
            ja: `デタラメな占いです！私は本物の【聖騎士】です！今夜守るべき重要な役職なのに、なぜ偽賢者に黒出しされなきゃいけないんですか！私を吊ったら村の防衛線が崩壊します！`,
            en: `That divination is sheer madness! I am the true [Holy Knight]! I am the shield that guards this village through the night, yet the false Sage calls me a beast! Execute me, and our defenses crumble to dust!`,
            zh: `一派胡言的占验！在下才是真正的【圣骑士】！身肩今夜守护要务之重职，缘何要遭假贤者诬陷！若将某处决，全村防线必将彻底崩溃！`,
            ko: `엉터리 점술입니다! 저는 진짜 【성기사】입니다! 오늘 밤 지켜야 할 중요한 직책인데, 왜 가짜 현자에게 흑판정을 받아야 합니까! 저를 처형하면 마을의 방어선이 무너집니다!`
          };
          msg = dict[lang] || dict.ja;
        } else {
          const dict = {
            ja: `デタラメな占いです！私は【共有者】です！確定白の人間に対して黒出しするとは、${seerName}さんの偽物が確定しました！`,
            en: `That divination is utter rubbish! I am a [Freemason]! To brand a confirmed innocent as a monster proves beyond doubt that ${seerName} is the impostor!`,
            zh: `一派胡言！在下乃是【共有者】！竟敢对确凿无疑的清白之人诬以黑名，${seerName}的冒牌身份已然铁证如山！`,
            ko: `엉터리 점술입니다! 저는 【공유자】입니다! 확정 결백한 인간에게 흑판정을 내리다니, ${seerName}의 가짜 정체가 확정되었습니다!`
          };
          msg = dict[lang] || dict.ja;
        }
      }
      // ③ 真村人の場合：嘘の役職騙りは行わず、論理的反論または潔白主張
      else if (realRole === 'villager') {
        const dict = {
          ja: `急な黒出しですね。${seerName}さんはあからさまな偽賢者で、無実の村人である私を濡れ衣で吊らせようとしています！村の皆さん、この偽賢者の破綻を精査してください！`,
          en: `A sudden accusation of darkness! ${seerName} is clearly a false Sage, seeking to frame an innocent villager such as myself! Good people of the village, scrutinize the contradictions of this impostor!`,
          zh: `如此唐突的黑名指控！${seerName}分明是假冒贤者，企图以莫须有的罪名将无辜村民逼上绝路！恳请诸位同乡彻查此伪贤者的破绽！`,
          ko: `갑작스러운 흑판정이군요. ${seerName}은(는) 노골적인 가짜 현자로, 무고한 마을 주민인 저를 누명 씌워 처형하려 하고 있습니다! 마을 여러분, 이 가짜 현자의 모순을 철저히 따져 주십시오!`
        };
        msg = dict[lang] || dict.ja;
      }
      // ④ 擬態モンスター・魔教徒の場合：一定確率で対抗役職騙り（偽賢者/偽聖騎士/偽聖職者）または論理反論
      else {
        if (rand < 0.50) {
          const villageRoles = new Set(gameState.roleDistribution || []);
          const validFakeRoles = ['seer', 'knight', 'medium'].filter(r => villageRoles.has(r));
          const fakeRole = validFakeRoles.length > 0 ? pickRandom(validFakeRoles) : 'seer';
          gameState.isStealthing[accusedChar] = false;
          gameState.coRoles[accusedChar] = fakeRole;
          gameState.claimedRoleTypes[accusedChar] = fakeRole;

          const fakeRoleName = getRoleName(fakeRole);
          if (fakeRole === 'seer') {
            const dict = {
              ja: `嘘をつかないでください！私こそが本物の【賢者】です！${seerName}さんは村を騙す偽物（魔物）です！真の鑑定結果を述べて対抗します！`,
              en: `Cease your falsehoods! I am the true [Sage]! ${seerName} is an impostor deceiving our village! I shall counter with my genuine divination results!`,
              zh: `休要诬赖！在下才是真正的【贤者】！${seerName}才是蒙蔽全村的冒牌妖邪！且待某以真实鉴定结果予以对抗！`,
              ko: `거짓말 마시오! 제가 바로 진짜 【현자】입니다! ${seerName}은(는) 마을을 속이는 가짜(마물)입니다! 진정한 감정 결과로 대항하겠습니다!`
            };
            msg = dict[lang] || dict.ja;
          } else if (fakeRole === 'medium') {
            const dict = {
              ja: `デタラメな占いです！私こそが本物の【聖職者】です！私を処刑すれば村の情報源が途絶えますよ！`,
              en: `That divination is utter nonsense! I am the true [Cleric]! Execute me, and the village shall lose its source of sacred judgment!`,
              zh: `一派胡言的占验！在下才是真正的【圣职者】！若将某处死，全村情报来源必将断绝！`,
              ko: `엉터리 점술입니다! 제가 바로 진짜 【성직자】입니다! 저를 처형하면 마을의 정보원이 끊어지고 말 것이오!`
            };
            msg = dict[lang] || dict.ja;
          } else {
            const dict = {
              ja: `デタラメな占いです！私は【聖騎士】です！今夜守るべき重要な役職なのに、なぜ偽賢者に黒出しされなきゃいけないんですか！私を吊ったら村の防衛線が崩壊します！`,
              en: `That divination is sheer madness! I am the [Holy Knight]! I bear the sacred shield this night, yet the false Sage brands me a beast! Execute me, and our defenses crumble!`,
              zh: `一派胡言的占验！在下乃【圣骑士】！身肩今夜守护要务，缘何遭假贤者诬陷！若将某处决，全村防线必将彻底崩溃！`,
              ko: `엉터리 점술입니다! 저는 【성기사】입니다! 오늘 밤 지켜야 할 중요한 직책인데, 왜 가짜 현자에게 흑판정을 받아야 합니까! 저를 처형하면 마을의 방어선이 무너집니다!`
            };
            msg = dict[lang] || dict.ja;
          }
        } else {
          const dict = {
            ja: `急な黒出しですね。${seerName}さんは昨日から誘導があからさまですし、あからさまな偽賢者の擦り付けです！私の潔白を証明するために、この偽賢者の破綻を精査してください！`,
            en: `A sudden accusation of darkness! ${seerName}'s manipulations have been blatant since yesterday — a transparent attempt by a false Sage to pin blame! Examine the impostor's contradictions to prove my innocence!`,
            zh: `如此唐突的黑名指控！${seerName}从昨日起便诱导明显，不过是假冒贤者的嫁祸之计！请诸位彻查此伪贤者的破绽以证某之清白！`,
            ko: `갑작스러운 흑판정이군요. ${seerName}은(는) 어제부터 유도가 노골적이었으며, 가짜 현자의 뻔한 누명 씌우기입니다! 저의 결백을 증명하기 위해, 이 가짜 현자의 모순을 철저히 검증해 주십시오!`
          };
          msg = dict[lang] || dict.ja;
        }
      }

      return msg;
    }

    // Trigger Morning Role Reports (Seer & Medium COs post results first in morning)
    async function triggerMorningRoleReports() {
      if (gameState.gameOver) return;

      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      for (let char of aliveChars) {
        const coRole = gameState.coRoles[char];
        const displayName = getCharDisplayName(char);

        if (coRole === 'seer') {
          const rep = gameState.dailySeerReports[char];
          if (rep && rep.target) {
            const targetName = getCharDisplayName(rep.target);
            const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;
            const displayResult = rep.result === '人狼' ? (t.role_wolf || '魔物') : (t.role_human || '人間');
            const rawMsg = (t.seer_report_log || '昨夜は{target}さんを占って【{result}】でした。').replace('{target}', targetName).replace('{result}', displayResult);
            const speakMsg = (t.seer_report_speech || '{name}（賢者CO）です。昨夜は{target}さんを占って【{result}】でした。').replace('{name}', displayName).replace('{target}', targetName).replace('{result}', displayResult);
            const formattedMsg = formatSpeechMessage(char, rawMsg);
            
            addLogItem(`💬 ${displayName}`, '', formattedMsg, 'ai-discussion', char, false);
            await playSpeechAsync(speakMsg, getCharVoiceProfileKey(char));

            // ★ 占い黒出し（魔物判定）時の即時反論・必死の弁明の最優先割り込み
            if (rep.result === '人狼' && gameState.status[rep.target] === 'alive') {
              const accused = rep.target;
              const accusedDisplayName = getCharDisplayName(accused);
              const rawRebuttal = generateBlackAccusedRebuttal(accused, char);
              const localizedRebuttal = translateDiscussionMessage(rawRebuttal, currentAppLanguage);
              const formattedRebuttal = formatSpeechMessage(accused, localizedRebuttal);

              // 記憶・保存
              if (!gameState.aiStatements) gameState.aiStatements = {};
              gameState.aiStatements[accused] = localizedRebuttal;

              if (!gameState.aiDiscussionHistory) gameState.aiDiscussionHistory = [];
              gameState.aiDiscussionHistory.push({
                day: gameState.day,
                char: accused,
                text: localizedRebuttal,
                isCO: true,
                coRole: gameState.coRoles[accused],
                isBlackRebuttal: true,
                seerChar: char,
                timestamp: Date.now()
              });

              lastAISpeaker = accused;
              addLogItem(`💬 ${accusedDisplayName}`, '', formattedRebuttal, 'ai-discussion', accused, false);
              await playSpeechAsync(formattedRebuttal, getCharVoiceProfileKey(accused));
            }
          }
        } else if (coRole === 'medium') {
          const rep = gameState.dailyMediumReports[char];
          if (rep && rep.target) {
            const targetName = getCharDisplayName(rep.target);
            const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;
            const displayResult = rep.result === '人狼' ? (t.role_wolf || '魔物') : (t.role_human || '人間');
            const rawMsg = (t.medium_report_log || '昨日処刑された{target}さんは【{result}】でした。').replace('{target}', targetName).replace('{result}', displayResult);
            const speakMsg = (t.medium_report_speech || '{name}（聖職者CO）です。昨日処刑された{target}さんは【{result}】でした。').replace('{name}', displayName).replace('{target}', targetName).replace('{result}', displayResult);
            const formattedMsg = formatSpeechMessage(char, rawMsg);
            
            addLogItem(`💬 ${displayName}`, '', formattedMsg, 'ai-discussion', char, false);
            await playSpeechAsync(speakMsg, getCharVoiceProfileKey(char));
          }
        }
      }
    }

    // Execute CO Action & Unveil Complete Past Investigation History
    function triggerCO(char) {
      const roleType = gameState.claimedRoleTypes[char];
      if (!roleType) return;

      gameState.isStealthing[char] = false;
      gameState.coRoles[char] = roleType;
      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';

      let coText = '';
      if (roleType === 'seer') {
        const history = gameState.seerHistory[char] || [];
        const historyStr = history.map(h => `${formatDay(h.day)}: ${getCharDisplayName(h.target)}【${h.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))}】`).join('、 ');
        const coDict = {
          ja: `「私は賢者です！これまでの全鑑定結果を開示します。 ${historyStr}」`,
          en: `"I am the true Sage! I reveal all my inspection results thus far: ${historyStr}"`,
          zh: `“吾乃真正的贤者！特此公布迄今所有查验结果：${historyStr}”`,
          ko: `「제가 바로 진짜 현자입니다! 지금까지의 모든 감정 결과를 공개합니다. ${historyStr}」`
        };
        coText = coDict[lang] || coDict.ja;
      } else if (roleType === 'medium') {
        const rep = gameState.dailyMediumReports[char];
        if (rep && rep.target) {
          const resStr = rep.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')));
          const coDict = {
            ja: `「【聖職者CO】昨日処刑された ${getCharDisplayName(rep.target)} さんの鑑定結果は【${resStr}】でした！」`,
            en: `"[Cleric Claim] The inspection result for yesterday's executed ${getCharDisplayName(rep.target)} was [${resStr}]!"`,
            zh: `“【圣职者现身】昨日被处决的 ${getCharDisplayName(rep.target)} 之真身乃是【${resStr}】！”`,
            ko: `「【성직자 선언】어제 처형된 ${getCharDisplayName(rep.target)} 님의 영매 결과는 【${resStr}】이었습니다!」`
          };
          coText = coDict[lang] || coDict.ja;
        } else {
          const history = gameState.mediumHistory[char] || [];
          const historyStr = history.map(h => `${formatDay(h.day)}: ${getCharDisplayName(h.target)}【${h.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))}】`).join('、 ');
          const coDict = {
            ja: `「私は聖職者です！過去の全鑑定結果を一括報告します。 ${historyStr}」`,
            en: `"I am the Cleric! I hereby report all past spiritual results: ${historyStr}"`,
            zh: `“在下乃圣职者！特此呈报过往所有灵媒结果：${historyStr}”`,
            ko: `「저는 성직자입니다! 과거의 모든 영매 결과를 일괄 보고합니다. ${historyStr}」`
          };
          coText = coDict[lang] || coDict.ja;
        }
      } else if (roleType === 'knight') {
        const coDict = {
          ja: `「【聖騎士CO】私は本物の【聖騎士】です！魔物の襲撃から村人を防衛していました。私を処刑しないでください！」`,
          en: `"[Holy Knight Claim] I am the true Holy Knight! I have shielded villagers from demonic strikes. Condemn me not!"`,
          zh: `“【圣骑士现身】吾乃如假包换的圣骑士！一直在暗中护卫村民免遭魔物毒手。切莫处决于我！”`,
          ko: `「【성기사 선언】제가 진짜 성기사입니다! 마물의 습격으로부터 마을 사람들을 지키고 있었습니다. 저를 처형하지 마십시오!」`
        };
        coText = coDict[lang] || coDict.ja;
      }

      const logPrefix = { ja: '📢 役職CO: ', en: '📢 Role Claim: ', zh: '📢 声明身份: ', ko: '📢 직업 선언: ' }[lang] || '📢 役職CO: ';
      addLogItem(`${logPrefix}${getCharDisplayName(char)}`, '', coText, 'narration', char, false);
    }

    // Self-Preservation CO Trigger (When Interrogated / Under Suspicion)
    function checkSelfPreservationCO(char) {
      if (gameState.isStealthing[char] && gameState.status[char] === 'alive') {
        triggerCO(char);
        renderBulletinBoard();
        renderMorningCommentsBox();
        renderCharacters();
      }
    }

    // =====================================================
    // 📢 一斉質問: 対抗CO・役職名乗り出システム
    // =====================================================

    // Helper: 指定役職の偽CO者が既に存在するか判定
    function hasFakeCoExists(requestedRole) {
      return gameState.charList.some(c =>
        gameState.status[c] === 'alive' &&
        (gameState.coRoles[c] === requestedRole || gameState.claimedRoleTypes[c] === requestedRole) &&
        gameState.roles[c] !== requestedRole
      );
    }

    // NPC個別判定: 一斉質問に対して名乗り出るかどうかを判断
    function evaluateCounterCo(char, requestedRole) {
      let willCo = false;
      let dialogue = '';
      const displayName = getCharDisplayName(char);
      const realRole = gameState.roles[char];
      const alignment = (realRole === 'wolf' || realRole === 'madman') ? 'evil' : 'village';
      const existingCO = gameState.coRoles[char] || 'grey';
      const isAccused = gameState.virtualVotes && gameState.virtualVotes[char] &&
                        gameState.virtualVotes[char].suspicionScore >= 50;
      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';

      // 既にその役職でCO済みの場合はスキップ（重複発言防止）
      if (existingCO === requestedRole) {
        return { willCo: false, dialogue: '', reason: 'already_co' };
      }

      // 既に別の役職でCO済みの場合は上書きしない
      if (existingCO !== 'grey' && existingCO !== 'villager') {
        return { willCo: false, dialogue: '', reason: 'other_co' };
      }

      const roleNamesI18n = {
        seer: { ja: '賢者', en: 'Sage', zh: '贤者', ko: '현자' },
        medium: { ja: '聖職者', en: 'Cleric', zh: '圣职者', ko: '성직자' },
        knight: { ja: '聖騎士', en: 'Holy Knight', zh: '圣骑士', ko: '성기사' }
      };
      const rName = (roleNamesI18n[requestedRole] && roleNamesI18n[requestedRole][lang]) || requestedRole;

      // ケースA: 本人がその「本当の役職」を持っている場合
      if (realRole === requestedRole) {
        if (isAccused || hasFakeCoExists(requestedRole)) {
          // 疑われている or 偽物がいる → 85%で名乗り出る
          willCo = Math.random() < 0.85;
          if (requestedRole === 'seer') {
            const history = gameState.seerHistory[char] || [];
            const historyStr = history.map(h => `${formatDay(h.day)}: ${getCharDisplayName(h.target)}【${h.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))}】`).join('、');
            const dMap = {
              ja: `「……待ってください。それなら私が本物の【賢者】です。これまでの鑑定結果: ${historyStr || 'まだなし'}」`,
              en: `"...Hold! In that case, I am the true [Sage]! Past inspections: ${historyStr || 'None yet'}"`,
              zh: `“……且慢！既然如此，我才是真正的【贤者】！过往查验结果：${historyStr || '尚无'}”`,
              ko: `「……잠깐 기다려 주십시오. 그렇다면 제가 진짜 【현자】입니다. 지금까지의 감정 결과: ${historyStr || '아직 없음'}」`
            };
            dialogue = dMap[lang] || dMap.ja;
          } else if (requestedRole === 'medium') {
            const history = gameState.mediumHistory[char] || [];
            const historyStr = history.map(h => `${formatDay(h.day)}: ${getCharDisplayName(h.target)}【${h.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))}】`).join('、');
            const dMap = {
              ja: `「……待ってください。私こそが本物の【聖職者】です！過去の判定: ${historyStr || '処刑者の判定はまだありません'}」`,
              en: `"...Hold! I alone am the genuine [Cleric]! Past judgment: ${historyStr || 'No executed souls examined yet'}"`,
              zh: `“……且慢！在下才是真正的【圣职者】！过往判定：${historyStr || '尚无处决者判定'}”`,
              ko: `「……잠깐 기다리시오. 저야말로 진짜 【성직자】입니다! 과거 판정: ${historyStr || '처형자의 판정은 아직 없음'}」`
            };
            dialogue = dMap[lang] || dMap.ja;
          } else if (requestedRole === 'knight') {
            const dMap = {
              ja: `「……これ以上隠す必要はないでしょう。私が本物の【聖騎士】です。密かに護衛を続けてきました」`,
              en: `"...There is no further need to hide. I am the true [Holy Knight]. I have protected our brethren from the shadows."`,
              zh: `“……已无需再行隐匿。吾乃真正的【圣骑士】。始终在暗处默默守卫村民。”`,
              ko: `「……더 이상 숨길 필요가 없겠군요. 제가 진짜 【성기사】입니다. 은밀히 호위를 계속해 왔습니다」`
            };
            dialogue = dMap[lang] || dMap.ja;
          }
        } else {
          // 平穏な場合 → 30%で潜伏解除
          willCo = Math.random() < 0.30;
          if (willCo) {
            const dMap = {
              ja: `「ふむ、私からは特に……いや、これ以上隠す必要もないか。実は私が【${rName}】です」`,
              en: `"Hm, I had naught to say... but no, there is no need to keep secrets. In truth, I am the [${rName}]."`,
              zh: `“唔，某本无多言……不过，此时亦无需隐瞒。实不相瞒，我便是【${rName}】。”`,
              ko: `「흠, 저는 딱히…… 아니, 더 숨길 이유도 없겠군요. 사실 제가 【${rName}】입니다」`
            };
            dialogue = dMap[lang] || dMap.ja;
          }
        }
      }
      // ケースB: 魔物・魔教徒の場合（嘘の対抗CO・ブラフ）
      else if (realRole === 'wolf' || realRole === 'madman') {
        // 自分が疑われている場合に60%で嘘COする
        if (isAccused && Math.random() < 0.60) {
          willCo = true;
          const dMap = {
            ja: `「ちょっと待ってください！ それなら私も【${rName}】です！ 対抗CO・報告をここに開示します！」`,
            en: `"Wait a moment! If so, then I too am the [${rName}]! Here is my counter-claim and revelation!"`,
            zh: `“且慢！既然如此，我也是【${rName}】！在此提出对立声明与汇报！”`,
            ko: `「잠깐 기다리시오! 그렇다면 나 역시 【${rName}】이오! 대항 선언과 보고를 여기에 밝히겠소!」`
          };
          dialogue = dMap[lang] || dMap.ja;
        }
        // 疑われていなくても場を混乱させたい場合、15%で嘘CO
        else if (!isAccused && Math.random() < 0.15) {
          willCo = true;
          const dMap = {
            ja: `「……実は黙っていましたが、私こそが【${rName}】です。これまでの結果をお伝えします」`,
            en: `"...I held my tongue until now, but I am the [${rName}]. Let me share what I have seen."`,
            zh: `“……此前某隐忍不发，实则我才是【${rName}】。容我道出迄今所得结果。”`,
            ko: `「……사실 입을 다물고 있었으나, 저야말로 【${rName}】입니다. 지금까지의 결과를 전해 드리지요」`
          };
          dialogue = dMap[lang] || dMap.ja;
        }
      }
      // ケースC: 一般村人 → 基本沈黙
      else {
        willCo = false;
      }

      return { willCo, dialogue, reason: willCo ? 'co_decided' : 'silent' };
    }

    // 一斉質問ハンドラ: プレイヤーが「ほかに〇〇の対抗やCOはいませんか？」を発動
    async function triggerMassRoleCall(requestedRole) {
      if (gameState.gameOver || gameState.phase !== '昼') return;

      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';
      const roleNamesI18n = {
        seer: { ja: '賢者', en: 'Sage', zh: '贤者', ko: '현자' },
        medium: { ja: '聖職者', en: 'Cleric', zh: '圣职者', ko: '성직자' },
        knight: { ja: '聖騎士', en: 'Holy Knight', zh: '圣骑士', ko: '성기사' }
      };
      const roleName = (roleNamesI18n[requestedRole] && roleNamesI18n[requestedRole][lang]) || requestedRole;

      // ボタン一時無効化（連打防止）
      const massButtons = document.querySelectorAll('.btn-mass-call');
      massButtons.forEach(b => b.disabled = true);

      // 進行中の音声・AI議論を一時停止
      const prevInterrogating = isInterrogatingActive;
      isInterrogatingActive = true;
      cancelSpeech();

      // プレイヤーの一斉質問発言をログに記録
      const callTextMap = {
        ja: `「ほかに【${roleName}】の対抗やCOの者はいませんか？ 名乗り出てください！」`,
        en: `"Is there anyone else claiming to be the [${roleName}]? Step forward and speak!"`,
        zh: `“可还有其他人自认是【${roleName}】并出面指认？速速现身言明！”`,
        ko: `「혹시 다른 【${roleName}】 대항자나 나설 자는 없습니까? 앞으로 나와 밝히십시오!」`
      };
      const callText = callTextMap[lang] || callTextMap.ja;
      const massLogTitle = { ja: '📢 勇者の一斉質問', en: "📢 Hero's Inquest", zh: '📢 勇者之全员质询', ko: '📢 용사의 일제 질문' }[lang] || '📢 勇者の一斉質問';
      addLogItem(massLogTitle, '', callText, 'narration', null, false);

      // 読み上げ
      try {
        const speechCallMap = {
          ja: `ほかに${roleName}の対抗やCOの者はいませんか？名乗り出てください！`,
          en: `Is there anyone else claiming to be the ${roleName}? Step forward and speak!`,
          zh: `可还有其他人自认是${roleName}？速速现身言明！`,
          ko: `혹시 다른 ${roleName} 대항자는 없습니까? 앞으로 나와 밝히십시오!`
        };
        await playSpeechAsync(speechCallMap[lang] || speechCallMap.ja, null);
      } catch(e) { console.warn('Mass call speech warn:', e); }

      // 短い間合い
      await new Promise(resolve => setTimeout(resolve, 800));

      // 全生存NPCを順に判定
      const aliveNPCs = gameState.charList.filter(c => gameState.status[c] === 'alive');
      const respondents = []; // 名乗り出たNPCリスト

      for (const char of aliveNPCs) {
        const result = evaluateCounterCo(char, requestedRole);
        if (result.willCo && result.dialogue) {
          respondents.push({ char, dialogue: result.dialogue });
        }
      }

      if (respondents.length > 0) {
        // 名乗り出たNPCの処理
        for (const resp of respondents) {
          const char = resp.char;
          const displayName = getCharDisplayName(char);
          const realRole = gameState.roles[char];

          // CO状態を更新
          gameState.isStealthing[char] = false;

          if (realRole === requestedRole) {
            // 真役職者の場合: 正しい役職でCO
            gameState.coRoles[char] = requestedRole;
            gameState.claimedRoleTypes[char] = requestedRole;
          } else if (realRole === 'wolf' || realRole === 'madman') {
            // 魔物・魔教徒の場合: 偽りの役職でCO
            gameState.coRoles[char] = requestedRole;
            gameState.claimedRoleTypes[char] = requestedRole;

            // 偽の報告データ補填
            if (requestedRole === 'seer' && (!gameState.seerHistory[char] || gameState.seerHistory[char].length === 0)) {
              const aliveOthers = gameState.charList.filter(c => c !== char && gameState.status[c] === 'alive');
              const target = pickRandom(aliveOthers) || 'A';
              const fakeResult = (realRole === 'wolf') ? '人間' : pickRandom(['人間', '人狼']);
              gameState.seerHistory[char] = [{ day: gameState.day, target, result: fakeResult }];
              gameState.dailySeerReports[char] = { day: gameState.day, target, result: fakeResult };
            } else if (requestedRole === 'medium' && (!gameState.mediumHistory[char] || gameState.mediumHistory[char].length === 0)) {
              if (gameState.lastExecutedChar) {
                const fakeResult = pickRandom(['人間', '人狼']);
                gameState.mediumHistory[char] = [{ day: gameState.day, target: gameState.lastExecutedChar, result: fakeResult }];
                gameState.dailyMediumReports[char] = { day: gameState.day, target: gameState.lastExecutedChar, result: fakeResult };
              }
            }
          }

          // ログ出力
          const counterCoTitle = { ja: `📢 対抗CO: ${displayName}`, en: `📢 Counter Claim: ${displayName}`, zh: `📢 对抗声明: ${displayName}`, ko: `📢 대항 선언: ${displayName}` }[lang] || `📢 対抗CO: ${displayName}`;
          addLogItem(counterCoTitle, '', resp.dialogue, 'narration', char, false);

          // 読み上げ（1人ずつ）
          try {
            await playSpeechAsync(`${displayName}。${resp.dialogue}`, getCharVoiceProfileKey(char));
          } catch(e) { console.warn('CO speech warn:', e); }

          // 次のNPCとの間合い
          await new Promise(resolve => setTimeout(resolve, 500));
        }

        // 複数名乗り出た場合: 対抗発生の混乱演出
        if (respondents.length >= 2) {
          const chaosMap = {
            ja: [
              `おい……${roleName}が${respondents.length}人も出たぞ！？ どちらが本物なんだ！`,
              `これは一体……！ 本物の${roleName}は一人のはず、偽者が混じっている！`,
              `勇者様、これは重大な手がかりです！ ${roleName}対抗が${respondents.length}人……必ず偽物がいます！`
            ],
            en: [
              `Heavens... as many as ${respondents.length} claim to be the ${roleName}!? Which one is true?`,
              `What treachery is this...?! There can be but one true ${roleName}; impostors lurk among them!`,
              `Lord Hero, here lies a critical clue! ${respondents.length} claim the role of ${roleName}... false fiends are surely here!`
            ],
            zh: [
              `天哪……竟有${respondents.length}人自称是【${roleName}】？！究竟孰真孰假！`,
              `这到底是何情形……！真正的【${roleName}】理应仅有一位，必有妖孽混迹其中！`,
              `勇者大人，此乃关键线索！【${roleName}】竟冒出${respondents.length}位对立者……定有虚妄伪装之徒！`
            ],
            ko: [
              `어이…… 【${roleName}】이(가) 무려 ${respondents.length}명이나 나왔다고!? 어느 쪽이 진짜란 말인가!`,
              `이게 대체 무슨 일이오……! 진짜 【${roleName}】은 한 명뿐일 터, 가짜가 섞여 있소!`,
              `용사님, 이것은 중대한 단서입니다! 【${roleName}】 대항자가 ${respondents.length}명…… 반드시 위선자가 숨어 있습니다!`
            ]
          };
          const chaosMessages = chaosMap[lang] || chaosMap.ja;

          await new Promise(resolve => setTimeout(resolve, 600));

          // ランダムな村人がリアクション発言
          const reactors = aliveNPCs.filter(c => !respondents.some(r => r.char === c));
          const reactor = reactors.length > 0 ? pickRandom(reactors) : aliveNPCs[0];
          const chaosMsg = pickRandom(chaosMessages);
          const reactorName = getCharDisplayName(reactor);

          addLogItem(`💬 ${reactorName}`, '', `「${chaosMsg}」`, 'ai-discussion', reactor, false);

          try {
            await playSpeechAsync(`${reactorName}。${chaosMsg}`, getCharVoiceProfileKey(reactor));
          } catch(e) { console.warn('Reaction speech warn:', e); }
        }

        // UI更新
        renderBulletinBoard();
        renderMorningCommentsBox();
        renderCharacters();

        // 仮想投票再計算
        if (typeof calculateVirtualVotes === 'function') calculateVirtualVotes();
        if (typeof recordVirtualVoteHistory === 'function') {
          const massInquestLabel = { ja: '一斉質問後', en: 'Post Inquest', zh: '质询之后', ko: '일제 질문 후' }[currentAppLanguage] || '一斉質問後';
          recordVirtualVoteHistory(`${formatDay(gameState.day)} ${massInquestLabel} (${roleName})`);
        }
        if (typeof renderVoteHistoryPage === 'function') renderVoteHistoryPage();

      } else {
        // 誰も名乗り出なかった場合
        const silenceMap = {
          ja: `……村人たちは静まり返り、【${roleName}】を名乗り出る者は現れなかった。`,
          en: `...The villagers fell completely silent, and not a single soul came forward as the [${roleName}].`,
          zh: `……村民们面面相觑、鸦雀无声，无人出面承认自己是【${roleName}】。`,
          ko: `……마을 사람들은 침묵에 휩싸였고, 【${roleName}】(으)로 나서는 자는 아무도 없었다.`
        };
        const silenceMsg = silenceMap[lang] || silenceMap.ja;
        const silenceLogTitle = { ja: '📢 一斉質問結果', en: '📢 Inquest Result', zh: '📢 质询结果', ko: '📢 일제 질문 결과' }[lang] || '📢 一斉質問結果';
        addLogItem(silenceLogTitle, '', silenceMsg, 'narration', null, false);

        try {
          await playSpeechAsync(silenceMsg, null);
        } catch(e) { console.warn('Silence speech warn:', e); }
      }

      // ボタン再有効化 & 尋問フラグ解除
      isInterrogatingActive = prevInterrogating ? true : false;
      updateMassCallButtons();
    }

    // 一斉質問ボタンの有効/無効を更新
    function updateMassCallButtons() {
      const isDiscussion = gameState.subPhase === 'discussion' && !gameState.executedToday && !gameState.gameOver;
      const btnMassSeer = document.getElementById('btn-mass-seer');
      const btnMassMedium = document.getElementById('btn-mass-medium');
      const btnMassKnight = document.getElementById('btn-mass-knight');

      if (btnMassSeer) btnMassSeer.disabled = !isDiscussion;
      if (btnMassMedium) btnMassMedium.disabled = !isDiscussion;
      if (btnMassKnight) btnMassKnight.disabled = !isDiscussion;
    }

    // =====================================================
    // 🧱 パーツ合成方式によるローカルAI会話ログ動的生成エンジン
    // =====================================================

    const COMPOSITE_MESSAGE_PARTS = {
      // Block A: 前置き (Intro)
      intro: {
        normal: {
          ja: [
            "待たれよ。",
            "……余の考えを述べさせてもらおう。",
            "その主張には大きな疑問が残るな。",
            "ふむ、議論の流れを見させてもらったが……",
            "冷静に状況を整理させてくれ。",
            "皆様、少々耳を傾けていただきたい。"
          ],
          en: [
            "Halt.",
            "...Allow me to speak my mind.",
            "A grave doubt lingers upon that claim.",
            "Hmm, I have observed the tide of this counsel, and yet...",
            "Let us calmly weigh our circumstances.",
            "Good people, lend me thine ears for a moment."
          ],
          zh: [
            "且慢。",
            "……容吾道出心中所想。",
            "此番言论疑窦丛生。",
            "嗯，方才静观诸位辩驳，然而……",
            "且容我等静心梳理局势。",
            "诸位，请容吾多言几句。"
          ],
          ko: [
            "잠깐.",
            "……소견을 말씀드리겠습니다.",
            "그 주장에는 커다란 의문이 남는군요.",
            "흠, 논의의 흐름을 지켜보았습니다만……",
            "냉정하게 상황을 정리해 봅시다.",
            "여러분, 잠시 제 말에 귀를 기울여 주십시오."
          ]
        },
        cautious: {
          ja: [
            "軽率な判断は禁物だ……。",
            "少し待ってほしい、違和感を感じている。",
            "審判を下す前に、この点を確認させてくれ。",
            "焦って誤審を重ねるわけにはいかない。"
          ],
          en: [
            "Rash judgment must not be tolerated...",
            "Hold a moment; something amiss weighs upon my spirit.",
            "Ere the verdict is cast, let us verify this matter.",
            "We cannot afford another misguided judgment in our haste."
          ],
          zh: [
            "万不可轻率断决……",
            "且慢行事，吾觉此事大有蹊跷。",
            "在降下审判前，且容我查验此节。",
            "焦躁之下，断不能再添冤狱。"
          ],
          ko: [
            "경솔한 판단은 금물입니다…….",
            "잠시 멈춰 주십시오, 무언가 석연치 않습니다.",
            "심판을 내리기 전에, 이 점을 먼저 짚고 넘어가야 합니다.",
            "조급함에 그릇된 심판을 되풀이할 수는 없습니다."
          ]
        },
        aggressive: {
          ja: [
            "見苦しい言い逃れはやめよ！",
            "ハッキリ言わせてもらうぞ。",
            "真実を隠そうとしても無駄だ！",
            "そこまで言うなら白黒つけようじゃないか。"
          ],
          en: [
            "Cease this shameful evasiveness!",
            "I shall speak plainly and without mercy.",
            "'Tis futile to shroud the truth in falsehoods!",
            "If thou wouldst press so far, let judgment be rendered here and now!"
          ],
          zh: [
            "休得再作丑态百出的推诿！",
            "直言相告，吾不再留情面。",
            "欲掩盖真相，不过是徒劳无功！",
            "既已至此，便在此分个清白黑白！"
          ],
          ko: [
            "구차한 변명은 집어치우시오!",
            "단도직입적으로 밝히겠소.",
            "진실을 감추려 해도 소용없다!",
            "그토록 당당하다면 흑백을 가려보지 않겠소."
          ]
        }
      },

      // Block B: 状況根拠 (Reason) ※ゲーム状態の変数と厳格連動
      reason: {
        // 1. 賢者CO者からの【魔物判定（黒出し）】
        seerBlack: {
          ja: [
            "賢者より『魔物』と告げられた {targetName} 殿の影はあまりにも濃い。",
            "賢者からの魔物判定が出ている {targetName} 殿を放置することはできぬ。",
            "『魔物』と看破された {targetName} 殿の弁明には一切の説得力がない。"
          ],
          en: [
            "The shadow that clings to {targetName}, proclaimed a 'Monster' by the Seer, is dark indeed.",
            "We cannot leave {targetName} unheeded, marked as a beast of darkness by the Seer.",
            "Pierced through as a 'Monster', {targetName}'s hollow pleas carry no weight."
          ],
          zh: [
            "既被先知断定为『魔物』，{targetName} 阁下身上的阴霾已昭然若揭。",
            "先知既已指认 {targetName} 阁下为魔物，万万不可放任自流。",
            "既已被看破为『魔物』，{targetName} 阁下的辩解便再无分毫说服力。"
          ],
          ko: [
            "현자로부터 『마물』이라 지목당한 {targetName} 공의 그림자는 실로 짙소.",
            "현자의 마물 판정을 받은 {targetName} 공을 이대로 방치할 수는 없소.",
            "『마물』로 간파당한 {targetName} 공의 변명 따위엔 일말의 설득력도 없소."
          ]
        },
        // 2. 賢者CO者からの【人間判定（白出し）】
        seerWhite: {
          ja: [
            "賢者によって『人間』と証明された {targetName} 殿に疑いを向けるのは筋違いだ。",
            "{targetName} 殿は既に賢者から人間のお墨付きを得ている。",
            "賢者の鑑定で潔白と出た {targetName} 殿を疑う余地はない。"
          ],
          en: [
            "'Tis folly to cast suspicion upon {targetName}, whom the Seer hath proven to be mortal.",
            "{targetName} hath already received the sacred seal of innocence from the Seer.",
            "Having been deemed pure by the Seer's divinations, there is no cause to doubt {targetName}."
          ],
          zh: [
            "先知已明示 {targetName} 阁下乃是『人族』，对其妄加揣测实非明智之举。",
            "{targetName} 阁下已得先知的清白印证。",
            "先知占验昭示其心如冰雪，绝无怀疑 {targetName} 阁下的余地。"
          ],
          ko: [
            "현자에 의해 『인간』임이 증명된 {targetName} 공에게 의심을 품는 것은 이치에 맞지 않소.",
            "{targetName} 공은 이미 현자로부터 결백함을 보증받았소.",
            "현자의 감정으로 결백이 밝혀진 {targetName} 공을 의심할 여지는 없소."
          ]
        },
        // 3. 前日の誤審で誤処刑対象に投票していた場合
        mislynchVoter: {
          ja: [
            "昨日の審判で {targetName} 殿が無実の者に票を投じていた点は見過ごせぬ。",
            "無実の人間が処刑された昨日の誤審……その流れを作った {targetName} 殿の動きは極めて疑わしい。",
            "昨日の間違った審判へと誘導した {targetName} 殿の言葉を鵜呑みにはできぬ。"
          ],
          en: [
            "We cannot overlook that {targetName} cast a ballot against the innocent in yesterday's trial.",
            "Yesterday's execution condemned an innocent soul... and {targetName}'s hand in steering that course is deeply suspect.",
            "One cannot heed the counsel of {targetName}, who led us astray into yesterday's tragic misjudgment."
          ],
          zh: [
            "昨日审判中，{targetName} 阁下曾将票投予无辜之人，此事断不能等闲视之。",
            "昨日错判令无辜者饮恨受刑……推波助澜的 {targetName} 阁下行迹实属可疑。",
            "将众人引向昨日那场冤狱的 {targetName} 阁下，其言辞岂能轻信。"
          ],
          ko: [
            "어제의 심판에서 {targetName} 공이 무고한 자에게 표를 던진 점은 결코 묵과할 수 없소.",
            "무고한 사람이 처형된 어제의 오심…… 그 흐름을 주도한 {targetName} 공의 거동은 지극히 수상하오.",
            "어제의 잘못된 심판으로 유도했던 {targetName} 공의 말을 곧이곧대로 믿을 수는 없소."
          ]
        },
        // 4. 同一役職でCOが対立している場合
        coConflict: {
          ja: [
            "{targetNameA} 殿と {targetNameB} 殿の主張は完全に噛み合っておらず、どちらかが偽りだ。",
            "同じ役職を名乗る {targetNameA} 殿と {targetNameB} 殿……二人のうち一人は確実に皮を被った魔物だ。",
            "{targetNameA} 殿と {targetNameB} 殿の対立 CO により、議論の焦点は明確になっている。"
          ],
          en: [
            "The testimonies of {targetNameA} and {targetNameB} are utterly at odds; one of them speaketh false.",
            "Claiming the very same sacred mantle, one among {targetNameA} and {targetNameB} is surely a beast wearing mortal skin.",
            "With {targetNameA} and {targetNameB} locked in rivalry, the heart of our debate hath become crystal clear."
          ],
          zh: [
            "{targetNameA} 阁下与 {targetNameB} 阁下的供词水火不容，其中定有一人捏造伪言。",
            "同以一职自居的 {targetNameA} 与 {targetNameB} 阁下……二人之中必有一人乃披皮恶魔。",
            "因 {targetNameA} 阁下与 {targetNameB} 阁下的针锋相对，辩驳之焦点已然明朗。"
          ],
          ko: [
            "{targetNameA} 공과 {targetNameB} 공의 주장은 정면으로 대립하고 있으니, 둘 중 하나는 필시 거짓이오.",
            "같은 직책을 자처하는 {targetNameA} 공과 {targetNameB} 공…… 둘 중 한 명은 분명 가죽을 뒤집어쓴 마물이오.",
            "{targetNameA} 공과 {targetNameB} 공의 대립으로 인해, 논의의 초점은 분명해졌소."
          ]
        },
        // 5. 仮投票で最も不審度が高く集中的に疑われている場合
        highSuspicion: {
          ja: [
            "ログの言動と辻褄が合わず、不審感が集中している {targetName} 殿の影は見逃せぬ。",
            "視点の不自然さと発言の揺らぎから、{targetName} 殿への疑念は拭いきれない。",
            "皆の視点が集中している通り、{targetName} 殿の主張には致命的な矛盾が存在する。"
          ],
          en: [
            "Contradicting past words and drawing widespread suspicion, {targetName}'s dark intent cannot be ignored.",
            "Between twisted reasoning and wavering words, the shadow upon {targetName} cannot be dispelled.",
            "As all eyes bear witness, a fatal flaw lieth at the heart of {targetName}'s arguments."
          ],
          zh: [
            "前后辞色矛盾、惹得众人生疑的 {targetName} 阁下，其行径断难令人释怀。",
            "视点违和、辞意闪烁，落在 {targetName} 阁下身上的疑云实难消散。",
            "正如万目所注，{targetName} 阁下的陈词中有着不可弥合的破绽。"
          ],
          ko: [
            "지난 언행과 앞뒤가 맞지 않아 의혹이 집중되고 있는 {targetName} 공의 수상함을 지나칠 수는 없소.",
            "부자연스러운 시선과 흔들리는 발언으로 볼 때, {targetName} 공에 대한 의구심을 지울 수 없소.",
            "모두의 이목이 쏠린 대로, {targetName} 공의 주장에는 치명적인 모순이 존재하오."
          ]
        },
        // 6. デフォルト（手掛かり調査中）
        general: {
          ja: [
            "{targetName} 殿のこれまでの発言ログと視点の置き方には、どこか解せない点がある。",
            "{targetName} 殿の主張の整合性について、もう一度精査する必要があるな。",
            "擬態モンスターの甘言に惑わされぬよう、{targetName} 殿の動向を注視すべきだ。"
          ],
          en: [
            "There is something unfathomable in how {targetName} hath conducted discourse and directed scrutiny.",
            "We must scrutinize once more the truth and consistency of {targetName}'s claims.",
            "Lest we be deceived by honeyed monstrous guile, we must keep watchful guard on {targetName}."
          ],
          zh: [
            "细思 {targetName} 阁下迄今的言行轨迹与立场，颇有令人费解之处。",
            "关于 {targetName} 阁下之论述是否周全自洽，当需再行详察。",
            "为防堕入拟态妖物之巧言令色，理当密切注视 {targetName} 阁下之动向。"
          ],
          ko: [
            "{targetName} 공의 지금까지의 발언과 시선 처리에는 어딘가 납득하기 어려운 점이 있소.",
            "{targetName} 공의 주장에 일관성이 있는지 다시 한번 면밀히 검토해 볼 필요가 있소.",
            "위장한 마물의 감언이설에 현혹되지 않도록, {targetName} 공의 동태를 주시해야 하오."
          ]
        }
      },

      // Block C: 結論 (Conclusion)
      conclusion: {
        doubt: {
          ja: [
            "故に、本日の審判では {targetName} 殿に剣を向けるべきだ！",
            "真実を解き明かすため、{targetName} 殿への処刑審判を提案する！",
            "迷う必要はない。{targetName} 殿を審判台へ送るのが最善の選択だ！"
          ],
          en: [
            "Hence, in this day's trial, our blades must be pointed at {targetName}!",
            "To unmask the truth, I propose that {targetName} be led to the block!",
            "Waver not. Committing {targetName} unto the judgment altar is our surest path!"
          ],
          zh: [
            "为此，今日之裁决理当剑指 {targetName} 阁下！",
            "为揭开真相，吾提议将 {targetName} 阁下送上处刑之台！",
            "无需迟疑，引 {targetName} 阁下立于审判台上乃是上策！"
          ],
          ko: [
            "그러므로 오늘 심판에서는 {targetName} 공에게 검끝을 겨눠야 하오!",
            "진실을 밝혀내기 위해, {targetName} 공의 처형 심판을 제안하오!",
            "망설일 것 없소. {targetName} 공을 심판대로 보내는 것이 최선의 선택이오!"
          ]
        },
        warn: {
          ja: [
            "勇者様、どうかあの者の甘言に騙されぬよう注意されたし！",
            "皆様、誘導に乗りやすくなっている今こそ、冷静に真偽を見極めていただきたい！",
            "軽はずみな投票は危険だ。慎重に考察を重ねて真犯人を追い詰めるべきだ！"
          ],
          en: [
            "Brave Champion, be thou not led astray by that one's poisoned honey!",
            "Hear me, all! In this hour when minds are so easily swayed, weigh the truth with sober eyes!",
            "A hasty vote courteth disaster. We must corner the true culprit through deliberate counsel!"
          ],
          zh: [
            "勇者大人，切莫被那厮的甜言蜜语所蒙蔽！",
            "诸位，值此极易受人摆布之刻，更当冷静明辨虚实！",
            "草率投票险象环生。当反复深思，以揪出真凶！"
          ],
          ko: [
            "용사님, 부디 저 자의 감언이설에 속아 넘어가지 않도록 유의하십시오!",
            "여러분, 선동에 휩쓸리기 쉬운 지금이야말로 냉정하게 진위를 가려내야 합니다!",
            "경솔한 투표는 위험하오. 신중한 고찰을 거듭하여 진범을 몰아넣어야 하오!"
          ]
        },
        defend: {
          ja: [
            "余を疑う時間があるのなら、真の悪魔を探すことに目を向けるべきだ！",
            "私への疑いは無意味だ。真の擬態モンスターは別の場所で笑っているぞ！",
            "私を処刑すれば、昨日のような過ちを再び繰り返すことになるぞ！"
          ],
          en: [
            "If thou hast time to cast doubt upon me, turn thine eyes to seeking the true fiend!",
            "Suspicion against me is utterly in vain. The genuine lurking beast smileth from the shadows elsewhere!",
            "Shouldst thou condemn me to death, thou shalt repeat yesterday's tragic folly once more!"
          ],
          zh: [
            "若有闲暇猜忌于吾，倒不如睁眼看清何处才是真正的妖孽！",
            "疑我实乃徒劳。真正的伪装妖物此刻正在暗处狞笑！",
            "若在此将我处决，昨日之覆辙必将重蹈！"
          ],
          ko: [
            "나를 의심할 시간이 있다면, 진정한 악마를 찾는 데 시선을 돌려야 하오!",
            "나를 향한 의심은 무의미하오. 진짜 위장 마물은 딴 곳에서 비웃고 있소!",
            "나를 처형한다면, 어제와 같은 과오를 또다시 되풀이하게 될 뿐이오!"
          ]
        }
      }
    };

    // パーツ合成メッセージ生成エンジン本体
    function buildCompositeAIDiscussionMessage(speakerChar, targetChar = null, forceMode = null) {
      // ★ 信頼度ペナルティ: 20% 以下の場合、30%の確率で証言拒否テキストを出力
      const currentTrust = typeof gameState.playerTrust === 'number' ? gameState.playerTrust : 100;
      if (currentTrust <= 20 && Math.random() < 0.3 && typeof getTrustRefusalMessage === 'function') {
        return getTrustRefusalMessage();
      }

      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';
      const personality = getCharPersonality(speakerChar) || 'logical';
      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      const aliveOthers = aliveChars.filter(c => c !== speakerChar);

      // ターゲットの自動決定（指定がなければ仮投票先または不審度最高者）
      if (!targetChar) {
        const myVote = gameState.virtualVotes && gameState.virtualVotes[speakerChar];
        if (myVote && myVote.target && aliveOthers.includes(myVote.target)) {
          targetChar = myVote.target;
        } else {
          targetChar = pickRandom(aliveOthers) || speakerChar;
        }
      }
      const targetName = getCharDisplayName(targetChar);

      // --- Block A: 前置き選択 ---
      let introCategory = 'normal';
      if (personality === 'cautious') introCategory = 'cautious';
      if (personality === 'aggressive') introCategory = 'aggressive';
      const introPool = COMPOSITE_MESSAGE_PARTS.intro[introCategory] || COMPOSITE_MESSAGE_PARTS.intro.normal;
      const introText = pickRandom(introPool[lang] || introPool['ja']);

      // --- Block B: 状況根拠の精密判定 ---
      let reasonPool = COMPOSITE_MESSAGE_PARTS.reason.general;
      const seerReports = Object.values(gameState.dailySeerReports || {});
      const seerBlackReport = seerReports.find(r => r.target === targetChar && r.result === '人狼');
      const seerWhiteReport = seerReports.find(r => r.target === targetChar && r.result === '人間');

      // 対立CO検出
      const seerCOs = aliveChars.filter(c => gameState.coRoles[c] === 'seer');
      const mediumCOs = aliveChars.filter(c => gameState.coRoles[c] === 'medium');
      let conflictPair = null;
      if (seerCOs.length >= 2) conflictPair = seerCOs;
      else if (mediumCOs.length >= 2) conflictPair = mediumCOs;

      // 前日誤審投票チェック
      const lastHistory = gameState.virtualVoteHistory && gameState.virtualVoteHistory[0];
      const votedForMislynch = (gameState.lastExecutedRole && gameState.lastExecutedRole !== 'wolf' && gameState.lastExecutedRole !== 'fox' &&
        lastHistory && lastHistory.votes && lastHistory.votes[targetChar] && lastHistory.votes[targetChar].target === gameState.lastExecutedChar);

      if (seerBlackReport) {
        reasonPool = COMPOSITE_MESSAGE_PARTS.reason.seerBlack;
      } else if (seerWhiteReport) {
        reasonPool = COMPOSITE_MESSAGE_PARTS.reason.seerWhite;
      } else if (votedForMislynch) {
        reasonPool = COMPOSITE_MESSAGE_PARTS.reason.mislynchVoter;
      } else if (conflictPair && (targetChar === conflictPair[0] || targetChar === conflictPair[1])) {
        reasonPool = COMPOSITE_MESSAGE_PARTS.reason.coConflict;
      } else if (gameState.virtualVotes && gameState.virtualVotes[targetChar] && gameState.virtualVotes[targetChar].suspicionScore >= 60) {
        reasonPool = COMPOSITE_MESSAGE_PARTS.reason.highSuspicion;
      } else {
        reasonPool = COMPOSITE_MESSAGE_PARTS.reason.general;
      }

      let reasonText = pickRandom(reasonPool[lang] || reasonPool['ja']);
      if (conflictPair && (targetChar === conflictPair[0] || targetChar === conflictPair[1])) {
        reasonText = reasonText.replace(/\{targetNameA\}/g, getCharDisplayName(conflictPair[0])).replace(/\{targetNameB\}/g, getCharDisplayName(conflictPair[1]));
      }
      reasonText = reasonText.replace(/\{targetName\}/g, targetName);

      // --- Block C: 結論選択 ---
      let conclusionCategory = 'doubt';
      if (forceMode === 'defend' || (gameState.virtualVotes[speakerChar] && gameState.virtualVotes[speakerChar].target === speakerChar)) {
        conclusionCategory = 'defend';
      } else if (forceMode === 'warn' || seerWhiteReport) {
        conclusionCategory = 'warn';
      }
      const conclusionPool = COMPOSITE_MESSAGE_PARTS.conclusion[conclusionCategory] || COMPOSITE_MESSAGE_PARTS.conclusion.doubt;
      const conclusionTemplate = pickRandom(conclusionPool[lang] || conclusionPool['ja']);
      const conclusionText = conclusionTemplate.replace(/\{targetName\}/g, targetName);

      // 3ブロックを結合
      return `${introText} ${reasonText} ${conclusionText}`;
    }

    // Generate Morning Comments (Highly Dynamic & Context-Aware)
    function generateMorningComments() {
      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      const isDayOne = gameState.day === 1;
      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';

      aliveChars.forEach(char => {
        const coRole = gameState.coRoles[char];
        const realRole = gameState.roles[char];
        const aliveOthers = aliveChars.filter(c => c !== char);
        const target = pickRandom(aliveOthers) || 'A';
        const targetName = getCharDisplayName(target);

        if (coRole === 'seer') {
          const history = gameState.seerHistory[char] || [];
          if (history.length > 1) {
            const historyStr = history.map(h => `${formatDay(h.day)}: ${getCharDisplayName(h.target)}【${h.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))}】`).join('、 ');
            const mDict = {
              ja: `「賢者CO。これまでの全鑑定結果です。【 ${historyStr} 】」`,
              en: `"[Sage Claim] Here are all my inspection results so far: [ ${historyStr} ]"`,
              zh: `“【贤者现身】此乃迄今所有查验结果：【 ${historyStr} 】”`,
              ko: `「현자 선언. 지금까지의 모든 감정 결과입니다. 【 ${historyStr} 】」`
            };
            gameState.morningComments[char] = mDict[lang] || mDict.ja;
          } else {
            const rep = gameState.dailySeerReports[char];
            if (rep) {
              const resStr = rep.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')));
              const mDict = {
                ja: `「真の賢者として報告します。昨夜は ${getCharDisplayName(rep.target)} さんを鑑定し、結果は【${resStr}】でした。」`,
                en: `"As the true Sage, I report: last night I inspected ${getCharDisplayName(rep.target)}, and the result was [${resStr}]."`,
                zh: `“吾作为真贤者特此汇报：昨夜查验了 ${getCharDisplayName(rep.target)}，结果为【${resStr}】。”`,
                ko: `「진짜 현자로서 보고합니다. 지난밤 ${getCharDisplayName(rep.target)} 님을 감정하였고, 결과는 【${resStr}】이었습니다.」`
              };
              gameState.morningComments[char] = mDict[lang] || mDict.ja;
            } else {
              const mDict = {
                ja: `「私は本物の賢者です。村を誤処刑から守るため、全力を尽くして真偽を確かめます。」`,
                en: `"I am the true Sage. To shield our village from wrongful execution, I shall unveil the truth with all my strength."`,
                zh: `“吾乃真正的贤者。为保村庄免遭误处决，定将竭力验明真伪。”`,
                ko: `「저는 진짜 현자입니다. 마을이 오처형에 휘둘리지 않도록 전력을 다해 진위를 가리겠습니다.」`
              };
              gameState.morningComments[char] = mDict[lang] || mDict.ja;
            }
          }
        } else if (coRole === 'medium') {
          const history = gameState.mediumHistory[char] || [];
          const rep = gameState.dailyMediumReports[char];
          
          if (rep && rep.target) {
            const resStr = rep.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')));
            if (history.length > 1) {
              const historyStr = history.map(h => `${formatDay(h.day)}: ${getCharDisplayName(h.target)}【${h.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))}】`).join('、 ');
              const mDict = {
                ja: `「聖職結果の報告です！昨日浄化された ${getCharDisplayName(rep.target)} さんの正体は【${resStr}】でした。（全聖職履歴: ${historyStr}）」`,
                en: `"[Cleric Report] The true nature of ${getCharDisplayName(rep.target)}, purified yesterday, was [${resStr}]! (Full history: ${historyStr})"`,
                zh: `“圣职查验汇报！昨日被净化的 ${getCharDisplayName(rep.target)} 之真身乃是【${resStr}】！（全灵媒记录：${historyStr}）”`,
                ko: `「성직 결과 보고입니다! 어제 정화된 ${getCharDisplayName(rep.target)} 님의 정체는 【${resStr}】이었습니다! (전체 영매 이력: ${historyStr})」`
              };
              gameState.morningComments[char] = mDict[lang] || mDict.ja;
            } else {
              const mDict = {
                ja: `「聖職結果を報告します！昨日浄化された ${getCharDisplayName(rep.target)} さんの正体は【${resStr}】でした。」`,
                en: `"[Cleric Report] The true identity of ${getCharDisplayName(rep.target)}, purified yesterday, was [${resStr}]."`,
                zh: `“汇报圣职结果！昨日被净化的 ${getCharDisplayName(rep.target)} 之真身乃是【${resStr}】。”`,
                ko: `「성직 결과를 보고합니다! 어제 정화된 ${getCharDisplayName(rep.target)} 님의 정체는 【${resStr}】이었습니다.」`
              };
              gameState.morningComments[char] = mDict[lang] || mDict.ja;
            }
          } else if (history.length > 0) {
            const historyStr = history.map(h => `${formatDay(h.day)}: ${getCharDisplayName(h.target)}【${h.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마物' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))}】`).join('、 ');
            const mDict = {
              ja: `「聖職者CO。これまでの聖職結果一覧です。【 ${historyStr} 】」`,
              en: `"[Cleric Claim] All spiritual inquest results to date: [ ${historyStr} ]"`,
              zh: `“【圣职者现身】迄今所有圣职验尸结果一览：【 ${historyStr} 】”`,
              ko: `「성직자 선언. 지금까지의 성직 결과 목록입니다. 【 ${historyStr} 】」`
            };
            gameState.morningComments[char] = mDict[lang] || mDict.ja;
          } else {
            const mDict = {
              ja: `「私は聖職者です。浄化された人物の真の姿を明らかにしていきます。」`,
              en: `"I am the Cleric. I shall reveal the true forms of those who are purified."`,
              zh: `“在下乃圣职者。定会查明每一位被净化之人的真身。”`,
              ko: `「저는 성직자입니다. 정화된 자의 참모습을 낱낱이 밝혀내겠습니다.」`
            };
            gameState.morningComments[char] = mDict[lang] || mDict.ja;
          }
        } else if (coRole === 'freemason') {
          const partnerMason = gameState.charList.find(c => c !== char && gameState.roles[c] === 'freemason');
          const pName = getCharDisplayName(partnerMason);
          const mDict = {
            ja: `「私たちは【共有者】です（パートナー: ${pName}）。二人とも絶対に人間であることを保証します。」`,
            en: `"We are the [Freemasons] (Partner: ${pName}). I guarantee that both of us are purely human."`,
            zh: `“我们二人乃是【共有者】（同伴：${pName}）。在此断言我等两人皆是纯正人类。”`,
            ko: `「저희는 【공유자】입니다 (파트너: ${pName}). 두 사람 모두 틀림없는 인간임을 보증합니다.」`
          };
          gameState.morningComments[char] = mDict[lang] || mDict.ja;
        } else {
          // ★ パーツ合成エンジンによる動的コメント生成
          gameState.morningComments[char] = buildCompositeAIDiscussionMessage(char, target);
        }

        const coTextDict = {
          grey: { ja: 'グレー', en: 'Grey', zh: '嫌疑中', ko: '회색' },
          seer: { ja: '賢者CO', en: 'Sage Claim', zh: '声明贤者', ko: '현자 선언' },
          medium: { ja: '聖職者CO', en: 'Cleric Claim', zh: '声明圣职者', ko: '성직자 선언' },
          freemason: { ja: '共有CO', en: 'Mason Claim', zh: '声明共有者', ko: '공유자 선언' }
        };
        const coKey = coRole || 'grey';
        const coText = (coTextDict[coKey] && coTextDict[coKey][lang]) || coTextDict[coKey]?.ja || 'グレー';

        if (!gameState.morningCommentsHistory) gameState.morningCommentsHistory = [];
        gameState.morningCommentsHistory.push({
          day: gameState.day,
          char: char,
          comment: gameState.morningComments[char],
          coText: coText
        });
      });
    }

    // --- AI同士の自動リアルタイム議論（会話生成）エンジン ---
    let lastAISpeaker = null;

    // AI発言時の緊急防衛CO / 偽COチェックロジック
    function checkAndGenerateDefensiveCO(speaker) {
      // 生存チェック
      if (gameState.status[speaker] !== 'alive') return null;

      // 自身の被疑心度（他者からの仮投票集中状況）を測定
      calculateVirtualVotes();
      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      const aliveTotal = aliveChars.length;
      let votesAgainstSpeaker = 0;
      Object.keys(gameState.virtualVotes || {}).forEach(voter => {
        if (voter !== speaker && gameState.virtualVotes[voter] && gameState.virtualVotes[voter].target === speaker) {
          votesAgainstSpeaker++;
        }
      });

      // 危機的状況の判定（仮投票で最多票が集中している、かつ被疑心が非常に高い危機状態）
      const sortedByVotes = aliveChars.map(c => {
        let count = 0;
        Object.keys(gameState.virtualVotes || {}).forEach(voter => {
          if (voter !== c && gameState.virtualVotes[voter] && gameState.virtualVotes[voter].target === c) count++;
        });
        return { char: c, count };
      }).sort((a, b) => b.count - a.count);

      const topVotedChar = sortedByVotes.length > 0 ? sortedByVotes[0].char : null;
      const myVoteCount = votesAgainstSpeaker;

      // 「自身が最多票を集めている」かつ「2票以上または過半数の票が集まっている」、かつ「疑心度が80以上」の場合のみ処刑危機とみなす
      const isUnderAttack = (speaker === topVotedChar && myVoteCount >= 2 && myVoteCount >= Math.floor(aliveTotal * 0.4)) ||
                            (gameState.virtualVotes[speaker] && gameState.virtualVotes[speaker].suspicionScore >= 80);

      if (!isUnderAttack) return null;

      const realRole = gameState.roles[speaker];
      const coRole = gameState.coRoles[speaker] || 'grey';

      // 既にいずれかの役職COを行っている場合は役職の変更（上書きCO）を行わない
      if (coRole !== 'grey' && coRole !== 'villager') {
        return null;
      }

      // --- 1. 潜伏役職者（真役職）の緊急防衛CO ---
      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';
      if (gameState.isStealthing[speaker] && (realRole === 'seer' || realRole === 'medium' || realRole === 'knight' || realRole === 'freemason')) {
        // CO登録
        gameState.isStealthing[speaker] = false;
        gameState.coRoles[speaker] = realRole;
        gameState.claimedRoleTypes[speaker] = realRole;

        let coMsg = '';
        if (realRole === 'seer') {
          const history = gameState.seerHistory[speaker] || [];
          const historyStr = history.map(h => `${formatDay(h.day)}: ${getCharDisplayName(h.target)}【${h.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))}】`).join('、 ');
          const defSeerDict = {
            ja: `「待ってください、私への疑いは完全な誤解です！実は【賢者】です！これまでの鑑定結果は（${historyStr || 'まだありません'}）です！私を吊ると村が負けます！」`,
            en: `"Wait, please! Suspecting me is a fatal mistake! In truth, I am the [Sage]! My inspection results thus far are (${historyStr || 'None yet'})! If you execute me, the village falls!"`,
            zh: `“且慢！怀疑我乃是大错特错！实不相瞒，我才是真正的【贤者】！迄今查验结果为（${historyStr || '尚无'}）！若处决于我，村落必将万劫不复！”`,
            ko: `「잠깐 기다리세요, 저를 향한 의심은 완전한 오해입니다! 사실 저는 【현자】입니다! 지금까지의 감정 결과는 (${historyStr || '아직 없음'})입니다! 저를 처형하면 마을이 패배합니다!」`
          };
          coMsg = defSeerDict[lang] || defSeerDict.ja;
        } else if (realRole === 'medium') {
          const rep = gameState.dailyMediumReports[speaker];
          const resStr = rep && rep.result ? (rep.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))) : '';
          const defMedDict = {
            ja: `「ちょっと待って！私を処刑するのは危険すぎます！実は【聖職者】です！${rep && rep.target ? `昨日処刑された ${getCharDisplayName(rep.target)} は【${resStr}】でした！` : ''} 私を吊らないでください！」`,
            en: `"Hold, I beg of you! Executing me is far too perilous! In truth, I am the [Cleric]! ${rep && rep.target ? `Yesterday's executed ${getCharDisplayName(rep.target)} was [${resStr}]!` : ''} Do not execute me!"`,
            zh: `“请稍等！处决我凶险至极！实不相瞒，在下乃是【圣职者】！${rep && rep.target ? `昨日被处决的 ${getCharDisplayName(rep.target)} 实为【${resStr}】！` : ''} 绝不可将我处决！”`,
            ko: `「잠깐만요! 저를 처형하는 것은 너무 위험합니다! 사실 저는 【성직자】입니다! ${rep && rep.target ? `어제 처형된 ${getCharDisplayName(rep.target)} 님은 【${resStr}】이었습니다!` : ''} 저를 처형하지 마십시오!」`
          };
          coMsg = defMedDict[lang] || defMedDict.ja;
        } else if (realRole === 'knight') {
          const defKniDict = {
            ja: `「待ってください！私に票を集めるのは村の破滅です！実は【聖騎士】です！昨夜も密かに護衛を行っていました！私を処刑しないでください！」`,
            en: `"Wait! Casting your votes upon me spells ruin for our village! I am the [Holy Knight]! I stood secret guard through last night's shadows! Do not execute me!"`,
            zh: `“住手！将选票投向我只会招致村庄覆灭！吾实乃【圣骑士】！昨夜亦在暗中护卫村民！万万不可处决我！”`,
            ko: `「기다려 주십시오! 제게 표를 모으는 것은 마을의 파멸입니다! 사실 저는 【성기사】입니다! 지난밤에도 은밀히 호위를 펼쳤습니다! 저를 처형하지 마십시오!」`
          };
          coMsg = defKniDict[lang] || defKniDict.ja;
        } else if (realRole === 'freemason') {
          const defMasDict = {
            ja: `「落ち着いてください！私は【共有者】です！人間であることが確定しています！私を処刑するのは無駄吊りです！」`,
            en: `"Calm yourselves! I am a [Freemason]! My humanity is beyond doubt! Executing me is a squandered sacrifice!"`,
            zh: `“诸位冷静！在下乃是【共有者】！身份铁定为清白人类！处决我不过是白白断送性命！”`,
            ko: `「진정하십시오! 저는 【공유자】입니다! 인간임이 확실합니다! 저를 처형하는 것은 헛된 희생일 뿐입니다!」`
          };
          coMsg = defMasDict[lang] || defMasDict.ja;
        }

        renderBulletinBoard();
        renderMorningCommentsBox();
        renderCharacters();

        return { type: 'defensive-co', role: realRole, text: coMsg };
      }

      // --- 2. 魔物・魔教徒の緊急偽CO（coPreferenceプロファイルパラメータに基づいて偽CO判断） ---
      const prof = (gameState.charProfiles && gameState.charProfiles[speaker]) || null;
      const fakeCoProb = prof ? (prof.coPreference * 0.5 + 0.1) : 0.30; // coPrefが高いと最大60%, 低いと10%で偽CO
      if ((coRole === 'grey' || coRole === 'villager') && (realRole === 'wolf' || realRole === 'madman') && Math.random() < fakeCoProb) {
        // 騙る役職の戦略的選定（村に存在する役職から選ぶ）
        const villageRoles = new Set(gameState.roleDistribution || []);
        const validFakeRoles = ['seer', 'medium', 'knight'].filter(r => villageRoles.has(r));
        
        const existingCOs = Object.values(gameState.coRoles);
        let fakeRole = null;

        // まだ誰もCOしていない役職があればそれを最優先
        for (let role of validFakeRoles) {
          if (!existingCOs.includes(role)) {
            fakeRole = role;
            break;
          }
        }
        // なければ存在する役職からランダム選択
        if (!fakeRole) {
          fakeRole = validFakeRoles.length > 0 ? pickRandom(validFakeRoles) : 'seer';
        }

        // CO登録
        gameState.isStealthing[speaker] = false;
        gameState.coRoles[speaker] = fakeRole;
        gameState.claimedRoleTypes[speaker] = fakeRole;

        // 偽の報告データの補填生成
        if (fakeRole === 'seer' && (!gameState.seerHistory[speaker] || gameState.seerHistory[speaker].length === 0)) {
          const aliveOthers = gameState.charList.filter(c => c !== speaker && gameState.status[c] === 'alive');
          const target = pickRandom(aliveOthers) || 'A';
          const fakeResult = (realRole === 'wolf') ? '人間' : pickRandom(['人間', '人狼']);
          gameState.seerHistory[speaker] = [{ day: gameState.day, target, result: fakeResult }];
          gameState.dailySeerReports[speaker] = { day: gameState.day, target, result: fakeResult };
        } else if (fakeRole === 'medium' && (!gameState.mediumHistory[speaker] || gameState.mediumHistory[speaker].length === 0)) {
          if (gameState.lastExecutedChar) {
            const fakeResult = pickRandom(['人間', '人狼']);
            gameState.mediumHistory[speaker] = [{ day: gameState.day, target: gameState.lastExecutedChar, result: fakeResult }];
            gameState.dailyMediumReports[speaker] = { day: gameState.day, target: gameState.lastExecutedChar, result: fakeResult };
          }
        }

        let coMsg = '';
        if (fakeRole === 'seer') {
          const history = gameState.seerHistory[speaker] || [];
          const historyStr = history.map(h => `${formatDay(h.day)}: ${getCharDisplayName(h.target)}【${h.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')))}】`).join('、 ');
          const fakeSeerDict = {
            ja: `「ここまできたら隠せません！私こそが真の【賢者】です！${historyStr ? `鑑定結果: ${historyStr}` : ''} 対抗のCOは全員偽者です！」`,
            en: `"Since matters have reached this brink, I can hide no longer! I alone am the true [Sage]! ${historyStr ? `Inspection results: ${historyStr}` : ''} All rival claims are false impostors!"`,
            zh: `“事已至此无从再隐！在下才是真正的【贤者】！${historyStr ? `查验明细：${historyStr}` : ''} 对立声称者皆是伪造骗子！”`,
            ko: `「이 지경에 이르렀으니 숨길 수 없습니다! 저야말로 진짜 【현자】입니다! ${historyStr ? `감정 결과: ${historyStr}` : ''} 대항 선언자들은 모두 가짜입니다!」`
          };
          coMsg = fakeSeerDict[lang] || fakeSeerDict.ja;
        } else if (fakeRole === 'medium') {
          const fakeMedDict = {
            ja: `「待ちなさい！私を吊るならハッキリ言います、私こそが真の【聖職者】です！私を処分すれば村の聖職者視点が途絶えますよ！」`,
            en: `"Stay thine hand! If you intend to hang me, I must speak: I am the true [Cleric]! If I am banished, our village loses its spiritual sight forever!"`,
            zh: `“住手！若要将我处死，我便明言相告，在下才是真正的【圣职者】！若将我处置，村庄的通灵视界将彻底断绝！”`,
            ko: `「기다리시오! 나를 처형하려 한다면 분명히 말하겠소, 저야말로 진짜 【성직자】요! 나를 처분하면 마을의 성직자 시야가 영영 끊어지고 말 것이오!」`
          };
          coMsg = fakeMedDict[lang] || fakeMedDict.ja;
        } else {
          const fakeKniDict = {
            ja: `「緊急事態なのでCOします！私は【聖騎士】です！今夜私を処刑すれば、今夜魔物の襲撃を誰一人防げなくなりますよ！」`,
            en: `"In this dire crisis, I reveal myself! I am the [Holy Knight]! Execute me today, and no shield shall stand against the monsters' claws tonight!"`,
            zh: `“危急存亡之际不得不言！吾乃【圣骑士】！若今日处决于我，今夜将无人能阻挡魔物的利爪！”`,
            ko: `「비상사태이므로 선언합니다! 저는 【성기사】입니다! 오늘 저를 처형한다면, 오늘 밤 마물의 습격을 아무도 막아내지 못할 것입니다!」`
          };
          coMsg = fakeKniDict[lang] || fakeKniDict.ja;
        }

        renderBulletinBoard();
        renderMorningCommentsBox();
        renderCharacters();

        return { type: 'fake-co', role: fakeRole, text: coMsg };
      }

      return null;
    }

    // --- 役職結果（賢者・聖職者）の矛盾・違和感 自動検知ヘルパー ---
    function detectRoleContradictions() {
      const contradictions = [];
      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';

      // 1. 【黒出し重複・白黒矛盾破綻】同一対象へ異なる結果（黒 vs 白）を出した賢者ペア
      const inspectionsByTarget = {};
      Object.keys(gameState.seerHistory || {}).forEach(seer => {
        if (gameState.status[seer] !== 'alive' && gameState.coRoles[seer] !== 'seer') return;
        const history = gameState.seerHistory[seer] || [];
        history.forEach(rep => {
          if (!inspectionsByTarget[rep.target]) inspectionsByTarget[rep.target] = [];
          inspectionsByTarget[rep.target].push({ seer, result: rep.result, day: rep.day });
        });
      });

      Object.keys(inspectionsByTarget).forEach(target => {
        const reports = inspectionsByTarget[target];
        const blacks = reports.filter(r => r.result === '人狼');
        const whites = reports.filter(r => r.result === '人間');
        if (blacks.length > 0 && whites.length > 0) {
          const bSeer = blacks[0].seer;
          const wSeer = whites[0].seer;
          const tName = getCharDisplayName(target);
          const bsName = getCharDisplayName(bSeer);
          const wsName = getCharDisplayName(wSeer);
          const bwTextMap = {
            ja: `ちょっと待ってください！${tName}さんに対して、${bsName}さんは【魔物】、${wsName}さんは【人間】と判定しています！真と偽で完全な白黒破綻が起きていますよ！`,
            en: `Hold on! Concerning ${tName}, ${bsName} judged them a [Monster], while ${wsName} judged them [Human]! A complete contradiction between light and dark has emerged!`,
            zh: `诸位且慢！针对${tName}，${bsName}断定其为【魔物】，而${wsName}却认定其为【人类】！真伪之间已彻底出现不可调和之黑白破绽！`,
            ko: `잠깐만 기다려 주십시오! ${tName} 님에 대해, ${bsName} 님은 【마물】, ${wsName} 님은 【인간】으로 판정하고 있습니다! 진위 사이에서 완전한 흑백 모순이 일어났습니다!`
          };
          contradictions.push({
            type: 'black_white_conflict',
            target,
            bSeer,
            wSeer,
            text: bwTextMap[lang] || bwTextMap.ja
          });
        }
      });

      // 2. 【聖職者結果とのズレ破綻】前日処刑者の聖職者結果と賢者結果の喰い違い
      if (gameState.lastExecutedChar) {
        const execChar = gameState.lastExecutedChar;
        const mediumClaimants = gameState.charList.filter(c => (gameState.coRoles[c] === 'medium' || gameState.claimedRoleTypes[c] === 'medium') && gameState.status[c] === 'alive');
        mediumClaimants.forEach(med => {
          const medRep = gameState.dailyMediumReports[med];
          if (medRep && medRep.target === execChar) {
            // 過去にexecCharを鑑定した賢者と比較
            Object.keys(gameState.seerHistory || {}).forEach(seer => {
              if (gameState.status[seer] !== 'alive' && gameState.coRoles[seer] !== 'seer') return;
              const seerRep = (gameState.seerHistory[seer] || []).find(r => r.target === execChar);
              if (seerRep && seerRep.result !== medRep.result) {
                const exName = getCharDisplayName(execChar);
                const mName = getCharDisplayName(med);
                const sName = getCharDisplayName(seer);
                const medResStr = medRep.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')));
                const seerResStr = seerRep.result === '人狼' ? (lang === 'en' ? 'Monster' : (lang === 'zh' ? '魔物' : (lang === 'ko' ? '마물' : '魔物'))) : (lang === 'en' ? 'Human' : (lang === 'zh' ? '人类' : (lang === 'ko' ? '인간' : '人間')));
                const msTextMap = {
                  ja: `待ってください！昨日処刑された${exName}さんについて、聖職者の${mName}さんは【${medResStr}】、賢者の${sName}さんは【${seerResStr}】と鑑定しており整合性が崩れています！`,
                  en: `Wait! Concerning ${exName} executed yesterday, Cleric ${mName} reported [${medResStr}], while Sage ${sName} reported [${seerResStr}]! The logic has shattered!`,
                  zh: `且慢！关于昨日被处决的${exName}，圣职者${mName}断定其为【${medResStr}】，先知${sName}却认定其为【${seerResStr}】，前后供词彻底崩溃破裂！`,
                  ko: `잠깐 기다려 주십시오! 어제 처형된 ${exName} 님에 대해, 성직자 ${mName} 님은 【${medResStr}】, 현자 ${sName} 님은 【${seerResStr}】(으)로 감정하여 정합성이 완전히 무너졌습니다!`
                };
                contradictions.push({
                  type: 'medium_seer_conflict',
                  target: execChar,
                  medSeer: med,
                  seerChar: seer,
                  text: msTextMap[lang] || msTextMap.ja
                });
              }
            });
          }
        });
      }

      // 3. 【3人以上賢者COの乱立・破綻盤面】
      const seerCOs = gameState.charList.filter(c => gameState.coRoles[c] === 'seer' && gameState.status[c] === 'alive');
      if (seerCOs.length >= 3) {
        const sep = lang === 'en' ? ', ' : (lang === 'ko' ? ' 님, ' : (lang === 'zh' ? '、' : 'さん、'));
        const suf = lang === 'ko' ? ' 님' : (lang === 'ja' ? 'さん' : '');
        const names = seerCOs.map(c => getCharDisplayName(c) + suf).join(sep);
        const tripleTextMap = {
          ja: `落ち着いて整理しましょう！賢者COが${names}3人も乱立しています！間違いなく2人以上の偽者（魔物・魔教徒）が紛れ込んでいます！`,
          en: `Calm yourselves and heed this! Three rival claims of Sage have emerged: ${names}! Without question, at least two impostors (monsters or cultists) lurk among them!`,
          zh: `诸位稍安勿躁！竟有${names}整整三人同时自称贤者！必有两人以上的假托妖邪（魔物或魔教徒）混迹其中！`,
          ko: `진정하고 정리해 봅시다! 현자 선언이 ${names} 무려 세 명이나 난립하고 있습니다! 틀림없이 두 명 이상의 가짜(마물 혹은 광인)가 숨어 있습니다!`
        };
        contradictions.push({
          type: 'triple_seer_co',
          text: tripleTextMap[lang] || tripleTextMap.ja
        });
      }

      return contradictions;
    }

    // --- 賢者白出し（人間判定）結果の盤面集約ヘルパー ---
    function getSeerWhiteResults() {
      const whiteResults = [];
      Object.keys(gameState.seerHistory || {}).forEach(seerChar => {
        if (gameState.status[seerChar] === 'alive' || gameState.coRoles[seerChar] === 'seer') {
          const history = gameState.seerHistory[seerChar] || [];
          history.forEach(rep => {
            if (rep.result === '人間' && gameState.status[rep.target] === 'alive') {
              whiteResults.push({ seer: seerChar, target: rep.target });
            }
          });
        }
      });
      return whiteResults;
    }

    // --- 直前の発言から「村人X」または「カスタム名」での指名を抽出するヘルパー ---
    function findMentionedChar(lastText) {
      if (!lastText) return null;
      for (let char of gameState.charList) {
        if (gameState.status[char] !== 'alive') continue;
        const customName = getCharDisplayName(char);
        const nameClean = customName.replace(/^村人\s*/, '');
        if (
          lastText.includes(`村人 ${char}`) ||
          lastText.includes(`村人${char}`) ||
          lastText.includes(customName) ||
          (nameClean && lastText.includes(nameClean))
        ) {
          return char;
        }
      }
      return null;
    }

    // --- 直近ログとの重複・無意味な発言の検知フィルター ---
    function isDuplicateOrMeaningless(newText, recentHistory) {
      if (!newText) return true;
      const cleanNew = newText.replace(/「|」|！|？|。|、|\s/g, '');

      for (let item of recentHistory) {
        if (!item || !item.text) continue;
        const cleanOld = item.text.replace(/「|」|！|？|。|、|\s/g, '');
        // 完全一致または前方高確率一致
        if (cleanNew === cleanOld) return true;
        if (cleanNew.length > 10 && cleanOld.length > 10) {
          if (cleanNew.includes(cleanOld.substring(0, 15)) || cleanOld.includes(cleanNew.substring(0, 15))) {
            return true;
          }
        }
      }
      return false;
    }

    // --- フォールバック発言生成（重複検出時に議論を継続させる） ---
    function generateFallbackDiscussion(speaker, aliveChars, recentHistory, prof) {
      const lang = currentAppLanguage || 'ja';
      const aliveOthers = aliveChars.filter(c => c !== speaker);
      const target1 = pickRandom(aliveOthers) || speaker;
      const target2 = pickRandom(aliveOthers.filter(c => c !== target1)) || target1;
      const t1Name = getCharDisplayName(target1);
      const t2Name = getCharDisplayName(target2);
      const speakerName = getCharDisplayName(speaker);
      const day = gameState.day || 1;
      const aliveCount = aliveChars.length;

      // 話題カテゴリをランダムに選択
      const category = Math.floor(Math.random() * 8);
      let msg = '';

      switch (category) {
        case 0: { // 投票意向の表明
          const voteTemplates = {
            ja: [
              `【${t1Name} 殿】の発言にはどうにも偽りを感じる。昨夜の動きといい、魔物の気配が拭えぬ！本日の裁きはあの者に下すべきだ！`,
              `現時点での余の意思を明言しよう。【${t1Name} 殿】に剣を向ける所存だ。具体的な推理を一切示さぬその姿勢、あまりに怪しすぎる！`,
              `投票先についてだが、今は【${t1Name} 殿】と【${t2Name} 殿】の間で思案している。皆の意見を聞き、最終的な審判を下すとしよう。`
            ],
            en: [
              `I sense falsehood in the words of [${t1Name}]. Between last night's stirrings and their demeanor, the foul scent of a beast cannot be denied! Today's judgment must fall upon them!`,
              `Let my intent be known to all: my blade shall point toward [${t1Name}]. Their refusal to offer any tangible reasoning whatsoever reeks of malice!`,
              `As for my vote, I currently weigh [${t1Name}] against [${t2Name}]. Hearken to counsel, and let us deliver final judgment together.`
            ],
            zh: [
              `【${t1Name}】之言辞处处透着虚伪。昨夜行迹可疑，魔物之气已然遮掩不住！今日之审判理当降于此人！`,
              `且听我明言：某之利刃已然指向【${t1Name}】。始终拿不出真凭实据却一味推诿，其形迹何其可疑！`,
              `至于今日所投之人，某正于【${t1Name}】与【${t2Name}】之间权衡。容我兼听诸君之见，再下最终决断。`
            ],
            ko: [
              `【${t1Name} 님】의 발언에는 어딘가 거짓이 느껴집니다. 지난밤의 동태도 그러하거니와, 마물의 기운을 지울 수 없소! 오늘의 심판은 그자에게 내려져야 마땅합니다!`,
              `이 자리에서 저의 뜻을 명확히 밝히겠소. 저는 【${t1Name} 님】을 겨눌 생각입니다. 구체적인 추리는 일절 내놓지 않는 그 태도, 너무나도 수상하오!`,
              `투표처에 관해서는, 현재 【${t1Name} 님】과 【${t2Name} 님】 사이에서 고심하고 있소. 여러분의 고견을 경청한 뒤 최후의 심판을 내리도록 하겠소.`
            ]
          };
          msg = pickRandom(voteTemplates[lang] || voteTemplates.ja);
          break;
        }
        case 1: { // 疑惑の提示 / 仲間庇い
          const suspectTemplates = {
            ja: [
              `【${t1Name} 殿】を疑うのは早計だ。それよりも、矛盾した発言を繰り返す【${t2Name} 殿】の裁きを優先すべきではないか？`,
              `ずっと気になっておったのだが、${t1Name} 殿は他者に疑いが向くたび、巧妙に話題を逸らそうとしておらぬか？`,
              `${t1Name} 殿と ${t2Name} 殿の意見が符節を合わせるがごとく一致しておる。闇のラインが繋がっておる可能性を警戒すべきだ！`
            ],
            en: [
              `To doubt [${t1Name}] now is far too hasty. Should we not rather bring judgment upon [${t2Name}], whose testimony is riddled with contradictions?`,
              `A grave doubt hath troubled my mind: whenever suspicion turneth toward others, does [${t1Name}] not cunningly deflect the conversation?`,
              `The claims of [${t1Name}] and [${t2Name}] align as if carved from the same stone. We must beware a secret pact forged in the shadows!`
            ],
            zh: [
              `此刻怀疑【${t1Name}】为时尚早。与其如此，岂非更应优先审判屡屡自相矛盾的【${t2Name}】？`,
              `某心中早生疑窦：每逢疑云笼罩他人之际，${t1Name} 岂非总在巧妙地转移视线？`,
              `${t1Name} 与 ${t2Name} 竟如出一辙地互相呼应。诸君切莫大意，此二人背后恐有黑暗暗通款曲！`
            ],
            ko: [
              `【${t1Name} 님】을 의심하는 것은 성급하오. 그보다 모순된 발언을 거듭하는 【${t2Name} 님】의 심판을 우선해야 하지 않겠소?`,
              `내내 마음에 걸렸던 바인데, ${t1Name} 님께서는 타인에게 의심이 향할 때마다 교묘히 화제를 돌리려 하지 않으셨소?`,
              `${t1Name} 님과 ${t2Name} 님의 의견이 마치 짜고 친 듯 일치하고 있소. 어둠의 결탁이 이어져 있을 가능성을 경계해야 하오!`
            ]
          };
          msg = pickRandom(suspectTemplates[lang] || suspectTemplates.ja);
          break;
        }
        case 2: { // 自己弁護・潔白主張・絶体絶命の反論
          const defenseTemplates = {
            ja: [
              `余に剣を向けるというのか！？ 人間同士で血を流せば、真の魔物が裏で嘲笑うぞ！`,
              `余の潔白は神々に誓って真実なり！一貫して村の安寧のために言を尽くしてきた余を吊るなど、まさに魔物の思うツボだぞ！`,
              `私を疑う前に、これまで一度も具体的な考察を出さずに潜伏しておる者にこそ審判の光を当てるべきではないか！`
            ],
            en: [
              `Would ye dare draw your steel against me?! If mortals shed one another's blood, the true beasts will mock us from the shadows!`,
              `By the heavens, my innocence is pure! To banish me, who hath labored solely for the safety of our village, is to play straight into the monster's claws!`,
              `Ere ye cast suspicion upon me, should the light of judgment not shine upon those who lurk in silence without offering a shred of insight?!`
            ],
            zh: [
              `竟欲将利刃对准于某？！若我等同族自相残杀，隐于暗处的真正魔物定会抚掌大笑！`,
              `某对天盟誓，一身清白日月可鉴！我始终为村落安宁殚精竭虑，若将我处决，正中魔物下怀！`,
              `在怀疑我之前，诸君岂非更当将审判之光投向那些至今未曾提出任何真知灼见、暗中潜伏之人？！`
            ],
            ko: [
              `나에게 칼끝을 겨눈다는 말이오?! 인간끼리 피를 흘린다면, 진정한 마물이 등 뒤에서 비웃을 뿐이오!`,
              `저의 결백은 신들께 맹세코 진실이오! 줄곧 마을의 안녕을 위해 진언해 온 저를 내친다면, 바로 마물이 바라던 바요!`,
              `나를 의심하기에 앞서, 지금까지 단 한 번도 구체적인 고찰을 내놓지 않은 채 침묵 속에 숨어 있는 자에게 심판의 빛을 비춰야 하지 않겠소!`
            ]
          };
          msg = pickRandom(defenseTemplates[lang] || defenseTemplates.ja);
          break;
        }
        case 3: { // 賢者CO・確定主張
          const sageTemplates = {
            ja: [
              `これ以上の混乱は不要！ 余こそが真の賢者なり！ 昨夜の占いで 【${t1Name} 殿】 は 魔物 であると判明した！`,
              `ここまでの盤面情報を整理しよう。生き残りは${aliveCount}名。誤審を侵せば村の滅亡に直結する。論理と真実のみを刻むのだ！`,
              `確白の者とグレーの者を明確に選別せよ。感情に流されず、矛盾の影が差す者から順に浄化を行わねばならぬ！`
            ],
            en: [
              `Cease this folly at once! I am the true Sage! My scrying last night revealed that [${t1Name}] is indeed a foul Beast!`,
              `Let us assemble the facts before us. Only ${aliveCount} of us remain. A false verdict will bring swift ruin upon our village. Anchor your hearts to logic and truth!`,
              `Separate clearly the proven innocents from those who linger in doubt. Swayed not by emotion, we must purify those cloaked in contradiction one by one!`
            ],
            zh: [
              `休得再起纷扰！某才是真正的贤者！昨夜之占卜已然查明，【${t1Name}】实为潜藏之魔物！`,
              `容我整顿眼下局势。如今幸存者仅剩 ${aliveCount} 人，稍有误判便将万劫不复！唯有依据铁证与条理方能破局！`,
              `当明察秋毫，分清确凿清白者与存疑之人。莫为私情所惑，凡言行生隙者理当依次回溯并予以净化！`
            ],
            ko: [
              `더 이상의 혼란은 무익하오! 나야말로 진정한 현자요! 지난밤의 점괘로 【${t1Name} 님】은 마물임이 밝혀졌소!`,
              `여기까지 드러난 국면을 정리합시다. 생존자는 단 ${aliveCount}명. 한 번의 오판은 곧 마을의 멸망으로 직결되오. 오직 논리와 진실만을 마음에 새기시오!`,
              `결백이 입증된 자와 회색지대의 자를 명확히 구분하시오. 감정에 휘둘리지 말고, 모순의 그림자가 짙은 자부터 차례로 정화해야만 하오!`
            ]
          };
          msg = pickRandom(sageTemplates[lang] || sageTemplates.ja);
          break;
        }
        case 4: { // 夜の出来事への言及
          const nightTemplates = {
            ja: [
              `昨夜の襲撃痕を見よ。なぜあの者が犠牲となったのか…魔物どもの深謀遠慮が透けて見えるようではないか！`,
              `魔物は聖なる能力者を避け、確白の者から順に口封じを行っておる模様。すなわち、いま沈黙を守るグレーの中にこそ魔物が蠢いておる！`,
              `昨夜の暗闇にて、かすかな気配の違和感を察知した…${t1Name} 殿、お主何か心当たりはござらんか？`
            ],
            en: [
              `Behold the bloody traces of last night's strike. Why was that soul chosen as sacrifice?... The cunning schemes of the beasts begin to show through!`,
              `The beasts seem to shun the blessed gifted ones, silencing confirmed innocents first. Thus, within those who keep silent in the gray fog, the monsters must writhe!`,
              `In last night's shroud of darkness, I sensed a disturbing presence... [${t1Name}], dost thou know aught of this?`
            ],
            zh: [
              `观昨夜残余之凶兆，何以偏偏是那位同伴受害……魔物阴险之图谋已然昭然若揭！`,
              `魔物似在避开身负圣能者，由浅入深诛杀确信清白之人。换言之，此刻沉默潜伏之灰疑之人中，必有妖孽作祟！`,
              `昨夜幽暗之中，某曾隐约察觉一丝诡异气息……${t1Name}，你可知晓何等内情？`
            ],
            ko: [
              `지난밤의 습격 흔적을 보시오. 어찌하여 그자가 희생되었는가… 마물들의 흉계가 훤히 들여다보이지 않소!`,
              `마물은 성스러운 능력자를 피하고, 결백한 자부터 순서대로 입막음하고 있는 듯하오. 즉, 지금 침묵을 지키는 회색지대 속에 마물이 도사리고 있는 것이오!`,
              `지난밤의 어둠 속에서 희미한 살기와 위화감을 감지하였소… ${t1Name} 님, 혹 짚이는 바가 없으시오?`
            ]
          };
          msg = pickRandom(nightTemplates[lang] || nightTemplates.ja);
          break;
        }
        case 5: { // 他者への質問
          const questionTemplates = {
            ja: [
              `【${t1Name} 殿】に問う！お主が今最も魔物と睨んでおる者は誰だ？その根拠とともに堂々と述べてみよ！`,
              `${t2Name} 殿、なぜ沈黙を貫く？沈黙は己が身に暗雲を呼び寄せるぞ。率直なる見解を聞かせてもらいたい！`,
              `${t1Name} 殿、先ほどの発言には見過ごせぬ矛盾が含まれておる。その意図を釈明していただけるか？`
            ],
            en: [
              `I demand an answer from [${t1Name}]! Whom dost thou suspect most of being a beast? Declare thy reasoning without hesitation!`,
              `Why dost thou persist in silence, [${t2Name}]? Silence will only gather dark storm clouds above thy head. Pray, share thy candid thoughts!`,
              `[${t1Name}], thy previous remark bore contradictions too glaring to overlook. Prithee, explain thy true intent!`
            ],
            zh: [
              `请教【${t1Name}】！阁下此刻最认定义为魔物者乃是何人？还望堂堂正正言明由衷之由！`,
              `${t2Name}，为何始终噤若寒蝉？沉默只会引火烧身。还请如实道来你的见解！`,
              `${t1Name}，你方才所言大有前后抵触之处，教人无法释怀。可否就此自白一番？`
            ],
            ko: [
              `【${t1Name} 님】께 묻겠소! 귀하께서 지금 가장 마물이라 여기는 자는 누구시오? 그 근거와 함께 당당히 밝혀 보시오!`,
              `${t2Name} 님, 어찌 침묵으로 일관하시오? 침묵은 자신의 머리 위에 먹구름을 불러올 뿐이오. 솔직한 견해를 들려주시길 바라오!`,
              `${t1Name} 님, 조금 전 발언에는 간과할 수 없는 모순이 담겨 있소. 그 진의를 해명해 주시겠소?`
            ]
          };
          msg = pickRandom(questionTemplates[lang] || questionTemplates.ja);
          break;
        }
        case 6: { // 陣営推理
          const factionTemplates = {
            ja: [
              `冷静に省みよ。生存者${aliveCount}名の中に牙を隠した魔物が確実におる。消去法にて推考すれば…【${t1Name} 殿】が最も黒き影を纏っておる！`,
              `魔物の視点に立ちて考えてみよ。この局面で奴らが如何に動くか…その振る舞いに最も符合する者こそ真犯人なり！`,
              `まだ能力者が全員名乗り出ておらぬ可能性もある。潜伏せし聖なる者は、そろそろ真実を語る時意ではないか！`
            ],
            en: [
              `Reflect with cold reason. Among our ${aliveCount} survivors, beasts with bared fangs assuredly lurk. Weighing each by elimination... [${t1Name}] casts the foulest shadow!`,
              `Consider this from the beast's standpoint: how would they strike in our current plight?... Whosoever behaves in accord with that design is the true culprit!`,
              `It may be that not all gifted ones have revealed themselves. Is it not high time for those sacred souls hidden among us to speak truth?`
            ],
            zh: [
              `诸君且静心细想。幸存的 ${aliveCount} 人之中必潜藏着爪牙森森的魔物。若依排除之法推演……【${t1Name}】周身之阴霾最深！`,
              `设身处地以魔物之立场度之：处于此等境地，彼辈将作何举动？举止最为吻合之人，便是祸首！`,
              `或许身负异能者尚未悉数现身。暗自潜伏的圣洁之人，此刻岂非正该吐露实情、以正视听之时！`
            ],
            ko: [
              `냉정하게 되짚어 보시오. 생존자 ${aliveCount}명 가운데 이빨을 숨긴 마물이 분명 존재하오. 소거법으로 추론하건대… 【${t1Name} 님】에게 가장 짙은 그림자가 드리워져 있소!`,
              `마물의 시선에서 헤아려 보시오. 이 국면에서 놈들이 어찌 움직이겠는가… 그 행태에 가장 부합하는 자야말로 진범이오!`,
              `아직 능력자가 모두 정체를 밝히지 않았을 가능성도 있소. 은신하고 있는 성스러운 자여, 이제 진실을 고할 때가 아니겠소!`
            ]
          };
          msg = pickRandom(factionTemplates[lang] || factionTemplates.ja);
          break;
        }
        case 7: { // 議論への感想・態度表明
          const remarkTemplates = {
            ja: [
              `本日の議論を聴く限り、${t1Name} 殿の論理には一本の筋が通っておるが、${t2Name} 殿の主張にはブレが見られるな。`,
              `皆の言を聞き、霧が晴れつつある。勝敗の鍵を握るのは ${t1Name} 殿の正体とその投票行動と確信する！`,
              `議論が堂々巡りに陥りつつある。ここで一度原点に立ち返り、初日の発言ログから不審な点を再検証しようではないか！`
            ],
            en: [
              `Judging from our discourse this day, the logic of [${t1Name}] holds firm, whereas [${t2Name}]'s claims waver with each breath.`,
              `Having heard the council, the mists begin to part. The crux of our fate hinges upon the true nature and vote of [${t1Name}]!`,
              `Our dispute circles endlessly like a serpent. Let us return to where we began, and scrutinize anew the suspicious words uttered upon our very first day!`
            ],
            zh: [
              `依今日诸般商议来看，${t1Name} 之理据尚称严整，而 ${t2Name} 之主张却摇摆不定。`,
              `倾听诸君之言，迷雾渐散。决定胜负之关捩，必系于 ${t1Name} 之真身与其投止！`,
              `辩驳已然陷入循环空谈。何妨重归原点，将首日众人的言辞记录再度细细推敲一番！`
            ],
            ko: [
              `오늘의 논의를 경청하건대, ${t1Name} 님의 논리에는 일관된 심지가 있으나 ${t2Name} 님의 주장에는 흔들림이 엿보이는구려.`,
              `여러분의 말을 들으니 안개가 걷히는 듯하오. 승패를 가를 열쇠는 ${t1Name} 님의 정체와 투표 행방에 달려 있다고 확신하오!`,
              `논의가 쳇바퀴를 돌고 있소. 이쯤에서 초심으로 돌아가, 첫날의 언동부터 미심쩍은 점을 다시금 재검증해 보지 않겠소!`
            ]
          };
          msg = pickRandom(remarkTemplates[lang] || remarkTemplates.ja);
          break;
        }
      }

      // 性格トーン適用（多言語対応）
      const prefixText = typeof getProfileQuotePrefix === 'function' ? getProfileQuotePrefix(prof) : (prof && prof.quotePrefix);
      if (prefixText && Math.random() < 0.35) {
        msg = `${prefixText} ${msg}`;
      }
      if (prof && prof.aggression >= 0.8) {
        if (lang === 'ja') {
          msg = msg.replace(/と思います。/g, 'に決まってるよ！').replace(/考えます。/g, 'で決定だろ！');
        }
      } else if (prof && prof.aggression <= 0.3) {
        if (lang === 'ja') {
          msg = msg.replace(/違和感/g, '少し気になる点').replace(/一択です/g, '有力候補です');
        }
      }

      return msg;
    }

    // --- ③ 敗北危機（「次間違えると村が負ける」PP/過半数）自動検知ヘルパー ---
    function checkMustWinCondition() {
      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      const aliveTotal = aliveChars.length;
      
      // 実際の魔物数（生存中）
      const wolfAliveCount = aliveChars.filter(c => gameState.roles[c] === 'wolf').length;

      // 村人が今日1人処刑され、夜1人襲撃された場合、翌朝生存者は aliveTotal - 2 人。
      // その場合の翌朝の魔物生存数が (aliveTotal - 2) / 2 以上になれば敗北確定。
      if (wolfAliveCount > 0) {
        const nextMorningAlive = aliveTotal - 2;
        if (nextMorningAlive <= 0 || wolfAliveCount >= (nextMorningAlive / 2)) {
          return { isCritical: true, wolfCount: wolfAliveCount, aliveTotal };
        }
      }
      return { isCritical: false, wolfCount: wolfAliveCount, aliveTotal };
    }

    // --- ② 終盤の詰め（名指し告発・消去法推理）ヘルパー ---
    function getDeductionTarget(speakerChar) {
      const lang = currentAppLanguage || 'ja';
      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      const aliveOthers = aliveChars.filter(c => c !== speakerChar);

      // 確白（賢者からの白出し判定者または共有者・本物CO者）
      const whiteResults = getSeerWhiteResults();
      const whiteTargets = whiteResults.map(w => w.target);

      // グレー（非COかつ白出し未実施）の生存人物
      const greys = aliveOthers.filter(c => {
        const co = gameState.coRoles[c];
        return (!co || co === 'grey' || co === 'villager') && !whiteTargets.includes(c);
      });

      if (greys.length > 0) {
        const target = pickRandom(greys);
        const targetName = getCharDisplayName(target);
        const confirmedWhiteNames = aliveOthers.filter(c => whiteTargets.includes(c) || gameState.coRoles[c] === 'freemason').map(c => getCharDisplayName(c));
        let whiteStr, reasonStr;
        if (confirmedWhiteNames.length > 0) {
          const sep = lang === 'en' ? ' and ' : (lang === 'zh' ? '以及' : (lang === 'ko' ? ' 님과 ' : 'さんや'));
          const suf = lang === 'ko' ? ' 님' : (lang === 'ja' ? 'さん' : '');
          whiteStr = confirmedWhiteNames.join(sep) + suf;
        }
        const reasonDict = {
          ja: whiteStr ? `${whiteStr}の白出し結果を整理して確定枠を除外すると、潜伏している魔物は【${targetName}さん】しかあり得ない` : `これまでのCOと賢者結果を整理して確定枠を除外すると、潜伏している魔物は【${targetName}さん】しかあり得ない`,
          en: whiteStr ? `by sorting the confirmed innocents (${whiteStr}) and eliminating the safe, the lurking monster can only be [${targetName}]` : `by reviewing all declarations and Sage results and eliminating the confirmed, the lurking monster can only be [${targetName}]`,
          zh: whiteStr ? `梳理${whiteStr}的验白结果并排除确凿之人，潜伏的魔物只可能是【${targetName}】` : `综合既有声明与贤者结果进行排除，潜伏的魔物只可能是【${targetName}】`,
          ko: whiteStr ? `${whiteStr}의 결백 판정을 정리하고 확정 인원을 제외하면, 잠복 중인 마물은 【${targetName} 님】뿐이오` : `지금까지의 직업 공표와 현자 결과를 정리하여 확정자를 제외하면, 잠복 마물은 【${targetName} 님】뿐이오`
        };
        return {
          target,
          reason: reasonDict[lang] || reasonDict.ja
        };
      } else if (aliveOthers.length > 0) {
        const target = pickRandom(aliveOthers);
        const targetName = getCharDisplayName(target);
        const reasonDict = {
          ja: `発言ログの不整合と仮投票ラインから分析すると【${targetName}さん】に不自然さが集中している`,
          en: `analyzing the inconsistencies in the speech records and provisional vote lines, suspicion concentrates upon [${targetName}]`,
          zh: `综合发言记录的前后矛盾与暂定投票走势来分析，不自然之处集中于【${targetName}】`,
          ko: `발언 기록의 불일치와 가투표 라인을 분석하면 부자연스러움이 【${targetName} 님】께 집중되고 있소`
        };
        return {
          target,
          reason: reasonDict[lang] || reasonDict.ja
        };
      }
      return null;
    }

    // --- ① 序盤〜中盤の定石（セオリー）進行提案ヘルパー ---
    function getTheoryProposal(speakerChar) {
      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      const lang = typeof currentAppLanguage !== 'undefined' ? currentAppLanguage : 'ja';
      
      // 1. 対抗賢者COが2人以上いる場合（ローラー/対抗精査）
      const seerCOs = aliveChars.filter(c => gameState.coRoles[c] === 'seer');
      if (seerCOs.length >= 2 && seerCOs.includes(speakerChar)) {
        const otherSeers = seerCOs.filter(c => c !== speakerChar);
        const sep = lang === 'en' ? ', ' : (lang === 'ko' ? ' 님이나 ' : (lang === 'zh' ? '以及' : 'さんや'));
        const suf = lang === 'ko' ? ' 님' : (lang === 'ja' ? 'さん' : '');
        const otherSeerNames = otherSeers.map(c => getCharDisplayName(c) + suf).join(sep);
        const dict = {
          ja: `私以外にも${otherSeerNames}が賢者COしていて真偽が絞れません。今日は確実に魔物を減らすためにも、セオリー通り【対抗の賢者から処刑】してラインを特定しませんか？`,
          en: `Besides myself, ${otherSeerNames} also claims to be Sage, making truth hard to discern. To ensure we cull a monster today, shall we follow doctrine and [execute among the rival Sages] to expose their lines?`,
          zh: `除我之外，更有${otherSeerNames}声称贤者，真假难辨。为今日稳妥诛灭妖邪，何不依从兵法铁则【从对立贤者中决出处决之人】以验明立场？`,
          ko: `저 외에도 ${otherSeerNames}이(가) 현자 선언을 하여 진위를 가리기 어렵습니다. 오늘 확실히 마물을 줄이기 위해, 정석대로 【대항 현자 중에서 처형】하여 라인을 특정해 보지 않겠습니까?`
        };
        return dict[lang] || dict.ja;
      } else if (seerCOs.length >= 2) {
        const sep = lang === 'en' ? ' and ' : (lang === 'ko' ? ' 님과 ' : (lang === 'zh' ? '与' : 'さんと'));
        const suf = lang === 'ko' ? ' 님' : (lang === 'ja' ? 'さん' : '');
        const seerNames = seerCOs.map(c => getCharDisplayName(c) + suf).join(sep);
        const dict = {
          ja: `賢者が${seerNames}2人以上出ていて真偽が絞れません。今日は確実に魔物を減らすためにも、セオリー通り【対抗の賢者から処刑】してラインを特定しませんか？`,
          en: `Two or more souls (${seerNames}) claim to be Sage, clouding our sight. To guarantee we purge a monster today, shall we follow doctrine and [execute among rival Sages] to expose their lines?`,
          zh: `贤者之位已有${seerNames}两人以上挺身对立，难辨真伪。为求今日必除妖孽，不如依规【自对立贤者中择一处决】以明辨是非？`,
          ko: `현자가 ${seerNames} 두 명 이상 나타나 진위를 가리기 힘듭니다. 오늘 확실하게 마물을 줄이기 위해서라도, 정석대로 【대항 현자 중에서 처형】하여 판도를 밝혀내지 않겠습니까?`
        };
        return dict[lang] || dict.ja;
      }

      // 2. 聖職者COが2人以上いる場合
      const mediumCOs = aliveChars.filter(c => gameState.coRoles[c] === 'medium');
      if (mediumCOs.length >= 2 && mediumCOs.includes(speakerChar)) {
        const otherMeds = mediumCOs.filter(c => c !== speakerChar);
        const sep = lang === 'en' ? ', ' : (lang === 'ko' ? ' 님이나 ' : (lang === 'zh' ? '以及' : 'さんや'));
        const suf = lang === 'ko' ? ' 님' : (lang === 'ja' ? 'さん' : '');
        const otherMedNames = otherMeds.map(c => getCharDisplayName(c) + suf).join(sep);
        const dict = {
          ja: `私以外にも${otherMedNames}が聖職者COして対抗で並んでいます。偽聖職者による情報攪乱を防ぐため、今日は聖職者対抗枠から精査・処刑することを提案します。`,
          en: `Besides myself, ${otherMedNames} stand as rival Cleric claimants. To stop false clerics from poisoning our counsel, I propose we scrutinize and execute from among the rival Cleric pool today.`,
          zh: `除在下外，尚有${otherMedNames}声称为圣职者并列对抗。为防妖孽扰乱视听，我提议今日从对立圣职者中精审并决意处决。`,
          ko: `저 외에도 ${otherMedNames}이(가) 성직자 선언을 하여 대항 구도가 형성되었습니다. 거짓 성직자의 교란을 막기 위해, 오늘은 성직자 대항자 중에서 면밀히 심사하여 처형할 것을 제안합니다.`
        };
        return dict[lang] || dict.ja;
      } else if (mediumCOs.length >= 2) {
        const sep = lang === 'en' ? ' and ' : (lang === 'ko' ? ' 님과 ' : (lang === 'zh' ? '与' : 'さんと'));
        const suf = lang === 'ko' ? ' 님' : (lang === 'ja' ? 'さん' : '');
        const medNames = mediumCOs.map(c => getCharDisplayName(c) + suf).join(sep);
        const dict = {
          ja: `聖職者が${medNames}対抗で並んでいます。偽聖職者による情報攪乱を防ぐため、今日は聖職者対抗枠から精査・処刑することを提案します。`,
          en: `Multiple claimants (${medNames}) stand as rival Clerics. To prevent false reports from sowing discord, I propose we examine and execute from among the rival Clerics today.`,
          zh: `圣职者已有${medNames}并立对抗。为免假托者混淆视听，在下建议今日从圣职者对抗名册中严查并择一处刑。`,
          ko: `성직자가 ${medNames} 대항으로 맞서고 있습니다. 가짜 성직자의 정보 교란을 막기 위해, 오늘은 성직자 대항 후보군 중에서 정밀 조사 및 처형할 것을 제안합니다.`
        };
        return dict[lang] || dict.ja;
      }

      // 3. 役職COが出揃い、グレー吊りを狙う場合
      const greys = aliveChars.filter(c => !gameState.coRoles[c] || gameState.coRoles[c] === 'grey' || gameState.coRoles[c] === 'villager');
      if (greys.length >= 2 && Math.random() < 0.6) {
        const dict = {
          ja: `真役職者を誤保護しつつ潜伏魔物を炙り出すため、今日は役職COしていない【グレーのメンバーの中から選んで】処刑するのが一番安全な進行です。`,
          en: `To shield our true champions while smoking out lurking beasts, executing someone chosen from [the unclaimed Grey pool] is our safest path today.`,
          zh: `既要妥善护卫真正神职，又要揪出潜伏暗处的妖物，今日从尚未声明身份的【灰色疑云人选之中抉择处决】，乃是最为稳妥之策。`,
          ko: `진짜 능력자를 보호하면서 숨은 마물을 밝혀내기 위해, 오늘은 직업을 밝히지 않은 【회색 지대의 인물 중에서 선택하여】 처형하는 것이 가장 안전한 전략입니다.`
        };
        return dict[lang] || dict.ja;
      }

      return null;
    }

    async function generateAIDiscussionStep() {
      if (gameState.subPhase !== 'discussion' || gameState.executedToday || gameState.gameOver) return;

      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      if (aliveChars.length < 2) return;

      // 直近の他AI発言ログを取得
      const recentHistory = (gameState.aiDiscussionHistory || []).slice(-5);
      const lastItem = recentHistory.length > 0 ? recentHistory[recentHistory.length - 1] : null;

      // ★ 指名質問・言及に対する割り込み応答ロジック
      let speaker = null;
      const mentionedChar = lastItem ? findMentionedChar(lastItem.text) : null;
      if (mentionedChar && mentionedChar !== lastItem.char && gameState.status[mentionedChar] === 'alive') {
        speaker = mentionedChar; // 質問・言及されたAIが割り込み応答
      } else {
        let candidates = aliveChars.filter(c => c !== lastAISpeaker);
        if (candidates.length === 0) candidates = aliveChars;
        speaker = pickRandom(candidates);
      }
      lastAISpeaker = speaker;

      const realRole = gameState.roles[speaker];
      const coRole = gameState.coRoles[speaker] || 'grey';
      const aliveOthers = aliveChars.filter(c => c !== speaker);
      const prof = (gameState.charProfiles && gameState.charProfiles[speaker]) || AI_PROFILES[0];

      // ★ 1. 盤面ファクトコンテキストの集計（ハルシネーション・嘘捏造防止）
      const whiteResults = getSeerWhiteResults();
      const whiteTargets = whiteResults.map(w => w.target);
      const nonWhiteOthers = aliveOthers.filter(c => !whiteTargets.includes(c));
      const target = nonWhiteOthers.length > 0 ? pickRandom(nonWhiteOthers) : (pickRandom(aliveOthers) || 'A');

      // 論理推理エンジンの解（破綻者100%確定・消去法）
      const logicalDeduction = getLogicalDeductionTarget(speaker);
      const logicalTargetChar = logicalDeduction ? logicalDeduction.target : target;
      const logicalTargetName = getCharDisplayName(logicalTargetChar);
      const isCertain = logicalDeduction ? logicalDeduction.isCertain : false;

      // 防衛CO・緊急偽CO判定
      const defensiveCO = checkAndGenerateDefensiveCO(speaker);

      const lang = currentAppLanguage || 'ja';
      let msg = '';

      // ----------------------------------------------------
      // STEP 1 & 2: エージェント型・意図と優先度による思考展開
      // ----------------------------------------------------

      // ① 100%確定破綻者がいる場合：絶対にその人物を集中追及（ファクト重視）
      if (isCertain) {
        const certainTemplates = {
          ja: [
            `みなさんログを整理してください！${logicalTargetName}さんは完全に主張が破綻しています！${logicalDeduction.reason}なんだから、本日の処刑は${logicalTargetName}さん一択です！`,
            `落ち着いて客観的データを見てください！${logicalTargetName}さんの言動は矛盾だらけです！${logicalDeduction.reason}以上、他の人を疑う前に${logicalTargetName}さんを処刑すべきです！`
          ],
          en: [
            `Hearken, all of you, and examine the records! The claims of ${logicalTargetName} have fallen into utter ruin! Given that ${logicalDeduction.reason}, our only choice of execution this day is ${logicalTargetName}!`,
            `Pray compose yourselves and look upon the undeniable truth! The words of ${logicalTargetName} are riddled with contradictions! Since ${logicalDeduction.reason}, we must execute ${logicalTargetName} ere we cast doubt on any other!`
          ],
          zh: [
            `诸位请速速查验言行记录！${logicalTargetName}的主张已然彻底破绽百出！既然${logicalDeduction.reason}，今日之公决非${logicalTargetName}莫属！`,
            `且请定神纵观确凿事实！${logicalTargetName}之言行自相矛盾！鉴于${logicalDeduction.reason}，在疑心他人之前，理当先行处决${logicalTargetName}！`
          ],
          ko: [
            `여러분, 지난 기록을 똑똑히 확인하십시오! ${logicalTargetName} 님의 주장은 완전히 파탄 났습니다! ${logicalDeduction.reason}인 이상, 오늘의 처형은 오직 ${logicalTargetName} 님뿐입니다!`,
            `진정하고 객관적인 사실을 직시하십시오! ${logicalTargetName} 님의 언동은 모순투성이입니다! ${logicalDeduction.reason}이 명백한 만큼, 다른 이를 의심하기 전에 ${logicalTargetName} 님을 처형해야 마땅합니다!`
          ]
        };
        msg = pickRandom(certainTemplates[lang] || certainTemplates.ja);
      }
      // ② 緊急防衛CO / 偽CO
      else if (defensiveCO) {
        msg = defensiveCO.text;
      }
      // ③ 敗北危機状況（PP警告・王手）
      else if (checkMustWinCondition().isCritical && Math.random() < 0.85) {
        if (realRole === 'wolf') {
          const wolfCriticalTemplates = {
            ja: `【緊急局面】ここでの間違いは村の即敗北に直結します！怪しさが極めて高い【${logicalTargetName}さん】を吊るしか勝ち筋はありません！`,
            en: `【Crisis】 A misstep here spells the immediate doom of our village! We have no salvation save to execute [${logicalTargetName}], who reeks of utmost suspicion!`,
            zh: `【紧急局面】此刻若有差池必将致全村立时倾覆！唯有处决嫌疑极重的【${logicalTargetName}】，方有一线生机！`,
            ko: `【긴급 국면】여기서의 실책은 마을의 즉각적인 패배로 직결됩니다! 의혹이 극에 달한 【${logicalTargetName} 님】을 처형하는 것만이 유일한 활로입니다!`
          };
          msg = wolfCriticalTemplates[lang] || wolfCriticalTemplates.ja;
        } else {
          const villageWarningTemplates = {
            ja: `【警告】村人の皆さん落ち着いて！今日の処刑で魔物を浄化できないと過半数を握られて敗北が確定します！絶対に【${logicalTargetName}さん】に票を合わせましょう！`,
            en: `【Warning】 Calm yourselves, good villagers! If we fail to cleanse the beast today, the fiends will seize the majority and seal our doom! We must unite our votes upon [${logicalTargetName}]!`,
            zh: `【警告】诸位同乡且慢慌乱！今日若不能净化魔物，妖邪便将占据多数，全村必亡！请务必全力将票集中于【${logicalTargetName}】！`,
            ko: `【경고】마을 주민 여러분, 진정하십시오! 오늘의 처형으로 마물을 정화하지 못하면 과반을 빼앗겨 패배가 확정됩니다! 기필코 【${logicalTargetName} 님】께 표를 모아야 합니다!`
          };
          msg = villageWarningTemplates[lang] || villageWarningTemplates.ja;
        }
      }
      // ④ 役職CO主張矛盾の自動突っ込み
      else if (Math.random() < 0.85 && (detectRoleContradictions().length > 0)) {
        const contradictions = detectRoleContradictions();
        msg = contradictions[0].text;
      }
      // ⑤ 終盤（6人以下）の消去法ロジックを展開
      else if (aliveChars.length <= 6 && Math.random() < 0.75 && logicalDeduction) {
        const deductionTemplates = {
          ja: `これまでの白出し結果とCO盤面を消去法で整理しました。${logicalDeduction.reason}！本日の処刑対象は【${logicalTargetName}さん】で確定させましょう！`,
          en: `I have sifted through the confirmed innocents and all declared roles by process of elimination. ${logicalDeduction.reason}! Let us seal our decision to execute [${logicalTargetName}] this day!`,
          zh: `某以排除之法梳理了过往验白结果与各方明牌局势。${logicalDeduction.reason}！今日处决之目标，理当锁定【${logicalTargetName}】！`,
          ko: `지금까지 드러난 결백 판정과 직업 공표 국면을 소거법으로 정리했습니다. ${logicalDeduction.reason}! 오늘의 처형 대상은 【${logicalTargetName} 님】으로 확정지읍시다!`
        };
        msg = deductionTemplates[lang] || deductionTemplates.ja;
      }
      // ⑥ 定石（セオリー）提案
      else if (getTheoryProposal(speaker) && Math.random() < 0.60) {
        msg = getTheoryProposal(speaker);
      }
      // ⑦ 直前に他AIがCOした場合のアンサー対話
      else if (lastItem && lastItem.isCO && lastItem.char !== speaker) {
        const coChar = lastItem.char;
        const coName = getCharDisplayName(coChar);
        const roleNames = {
          seer: { ja: '賢者', en: 'Sage', zh: '贤者', ko: '현자' },
          medium: { ja: '聖職者', en: 'Cleric', zh: '圣职者', ko: '성직자' },
          knight: { ja: '聖騎士', en: 'Holy Knight', zh: '圣骑士', ko: '성기사' }
        };
        const rKey = lastItem.coRole === 'seer' ? 'seer' : (lastItem.coRole === 'medium' ? 'medium' : 'knight');
        const coRoleName = (roleNames[rKey] && roleNames[rKey][lang]) || roleNames[rKey].ja;
        
        const coAnswerTemplates = {
          ja: [
            `【${coName}さん】が【${coRoleName}】COを宣言されましたね。土壇場での騙りでないか、対抗者の有無とログの整合性を慎重に検証しましょう。`,
            `【${coName}さん】の【${coRoleName}】COによって盤面の計算が変化しました。確定白枠と残るグレー層の範囲を再計算する必要があります。`
          ],
          en: [
            `[${coName}] hath proclaimed themselves to be the [${coRoleName}]. Lest this be an eleventh-hour deception, let us weigh the presence of rivals and the veracity of past records.`,
            `The declaration of [${coRoleName}] by [${coName}] shifteth the entire board. We must recalculate the circle of proven innocents and the remaining gray suspects.`
          ],
          zh: [
            `【${coName}】已然宣示自身为【${coRoleName}】。为防危急关头的虚伪诈称，必须审慎甄别有无对立现身者及过往言行一致性。`,
            `因【${coName}】亮明【${coRoleName}】之位，局势筹算已生变故。须得重新厘定确凿白身与尚存嫌隙之灰疑范围。`
          ],
          ko: [
            `【${coName} 님】께서 【${coRoleName}】임을 선언하셨군요. 막다른 골목에서의 거짓 속임수가 아닌지, 대항자의 유무와 과거 기록의 정합성을 신중히 검증해야 합니다.`,
            `【${coName} 님】의 【${coRoleName}】 공표로 형세 계산이 달라졌습니다. 확정된 결백 인원과 남은 회색지대의 범위를 다시 가늠해야 합니다.`
          ]
        };
        msg = pickRandom(coAnswerTemplates[lang] || coAnswerTemplates.ja);
      }
      // ⑧ 白出し情報を踏まえた考察
      else if (whiteResults.length > 0 && Math.random() < 0.60) {
        const whiteInfo = pickRandom(whiteResults);
        const wTargetName = getCharDisplayName(whiteInfo.target);
        const wSeerName = getCharDisplayName(whiteInfo.seer);

        if (whiteInfo.target === speaker) {
          const selfWhiteTemplates = {
            ja: `賢者の${wSeerName}さんから私は白出しされています。身の潔白は証明されているので、完全グレーの【${logicalTargetName}さん】の発言を精査すべきです。`,
            en: `The Sage ${wSeerName} hath divined my innocence. My purity stands proven, so we must scrutinize the words of [${logicalTargetName}], who remains shrouded in gray doubt.`,
            zh: `贤者${wSeerName}已占验某为清白之身。既然在下清白已明，理当彻底核查浑身疑云的【${logicalTargetName}】之言辞。`,
            ko: `현자이신 ${wSeerName} 님께서 저의 결백을 밝혀 주셨습니다. 저의 무결함은 증명되었으니, 온전히 의혹에 싸인 【${logicalTargetName} 님】의 발언을 면밀히 따져야 합니다.`
          };
          msg = selfWhiteTemplates[lang] || selfWhiteTemplates.ja;
        } else {
          const otherWhiteTemplates = {
            ja: `賢者の${wSeerName}さんから${wTargetName}さんに白判定が出ています。確白枠を除外すると、潜伏する擬態モンスターの位置はグレーの【${logicalTargetName}さん】周辺に絞られます。`,
            en: `The Sage ${wSeerName} hath confirmed ${wTargetName} to be innocent. Excluding the proven innocents, the lurkers in mimicry must dwell among the gray suspects like [${logicalTargetName}].`,
            zh: `贤者${wSeerName}已鉴明${wTargetName}确属良善。排除无可置疑的白身之后，潜藏匿迹之妖魔必在灰疑的【${logicalTargetName}】等人周围。`,
            ko: `현자이신 ${wSeerName} 님께서 ${wTargetName} 님께 결백 판정을 내리셨습니다. 무결한 인원을 제외하면, 숨어든 마물의 위치는 의혹 속의 【${logicalTargetName} 님】 부근으로 좁혀집니다.`
          };
          msg = otherWhiteTemplates[lang] || otherWhiteTemplates.ja;
        }
      }
      // ⑨ 直前発言者へのリアルタイム対話・反論
      else if (lastItem && lastItem.char !== speaker && Math.random() < 0.75) {
        const otherName = getCharDisplayName(lastItem.char);
        const dialogueTemplates = {
          ja: [
            `${otherName}さんのご指摘には一理ありますが、${logicalTargetName}さんの発言ログとの整合性も無視できないと思います。`,
            `${otherName}さんの意見を踏まえると、視点を広げて${logicalTargetName}さんのこれまでの投票ラインに注目すべきだと考えます。`,
            `${otherName}さん、その根拠について客観的なログ事実をもう少し詳しく共有していただけますか？`
          ],
          en: [
            `Thy words carry weight, ${otherName}, yet we cannot turn a blind eye to the contradictions in ${logicalTargetName}'s testimony.`,
            `Hearing ${otherName}'s counsel, methinks we should broaden our gaze and heed the voting history of ${logicalTargetName}.`,
            `I beseech thee, ${otherName}, couldst thou illuminate the tangible facts and records that support thy claim in greater detail?`
          ],
          zh: [
            `${otherName}所言确有一番道理，但${logicalTargetName}言行录中的前后抵触之处亦不容忽视。`,
            `兼听${otherName}之见解，某以为更当拓宽视界，关注${logicalTargetName}迄今为止的投票轨迹。`,
            `${otherName}，敢请将支撑此论的确凿记录与事实，更详尽地告知于诸位？`
          ],
          ko: [
            `${otherName} 님의 지적에도 일리는 있으나, ${logicalTargetName} 님의 언동 기록과의 모순 역시 결코 간과할 수 없다고 봅니다.`,
            `${otherName} 님의 고견을 감안할 때, 시야를 넓혀 ${logicalTargetName} 님의 지금까지의 투표 행적에 주목해야 마땅합니다.`,
            `${otherName} 님, 그 주장의 근거가 되는 객관적 기록과 사실을 조금 더 구체적으로 밝혀 주시겠습니까?`
          ]
        };
        msg = pickRandom(dialogueTemplates[lang] || dialogueTemplates.ja);
      }
      // ⑩ 汎用盤面考察（デフォルト）
      else {
        if (coRole === 'seer') {
          const seerGeneralTemplates = {
            ja: `賢者の立場から主張します。生存しているグレー枠の精査とライン判定を最優先して進めましょう。`,
            en: `Speaking from the sacred mantle of the Sage: our utmost priority must be the scrutiny of living gray suspects and their alliances.`,
            zh: `某以贤者之身立言：当务之急，必是彻查所有尚存之灰疑之人及其暗中关联。`,
            ko: `현자의 입장에서 밝힙니다. 살아남은 회색지대 인물들의 정밀 조사와 결탁 여부 판단을 최우선으로 진행합시다.`
          };
          msg = seerGeneralTemplates[lang] || seerGeneralTemplates.ja;
        } else if (coRole === 'medium') {
          const mediumGeneralTemplates = {
            ja: `聖職者の判定報告を元に、誤処刑を防ぐための着実な議論をつなげていきましょう。`,
            en: `Guided by the divine verdicts of the Cleric, let us forge a steadfast discourse to avert the execution of the innocent.`,
            zh: `依据圣职者降下之通灵断语，我等理当展开周全推论，以杜绝冤杀良善。`,
            ko: `성직자의 영시 보고를 나침반 삼아, 무고한 처형を 막기 위한 건실한 논의를 이어갑시다.`
          };
          msg = mediumGeneralTemplates[lang] || mediumGeneralTemplates.ja;
        } else {
          const generalDiscussionTemplates = {
            ja: `誤処刑を防ぐために客観的なログを再確認しています。【${logicalTargetName}さん】の発言整合性に少し違和感を感じているので意見を聞きたいです。`,
            en: `To safeguard our village against false executions, I am reviewing past records anew. I sense a discordance in the claims of [${logicalTargetName}], and wish to hear thy counsel.`,
            zh: `为免错杀无辜，某正复盘过往言行记录。观【${logicalTargetName}】所言隐有前后不协之处，愿闻诸位高见。`,
            ko: `오심으로 인한 처형을 막고자 지난 기록을 재확인하고 있소. 【${logicalTargetName} 님】의 발언 정합성에 다소 위화감이 느껴져 의견을 묻고자 하오.`
          };
          msg = generalDiscussionTemplates[lang] || generalDiscussionTemplates.ja;
        }
      }

      // ----------------------------------------------------
      // ★ LLMハイブリッド：クリティカルでない発言はLLMで高品質化
      // 防衛CO / 100%確定破綻 / PP警告は即座の反応が必要なためローカルを維持
      // ----------------------------------------------------
      const isCriticalLocal = isCertain || !!defensiveCO || (checkMustWinCondition().isCritical && (msg.includes('【警告】') || msg.includes('【Warning】') || msg.includes('【경고】')));
      let usedLLM = false;

      if (useLLMMode && !isCriticalLocal && msg) {
        try {
          const lastText = lastItem ? lastItem.text : null;
          const lastChar = lastItem ? lastItem.char : null;
          const llmPrompt = buildDiscussionPrompt(speaker, lastText, lastChar);
          const llmResult = await callAIEngine(llmPrompt);
          if (llmResult && llmResult.length > 5) {
            msg = llmResult;
            usedLLM = true;
            console.log(`[LLM] 議論発言をLLMで生成しました (${speaker})`);
          }
        } catch(e) {
          console.warn('[LLM] 議論発言のLLM生成に失敗、ローカル発言を使用:', e.message);
        }
      }

      // ----------------------------------------------------
      // STEP 3: プロファイル性格トーン（攻撃性・論理性・頑固さ・語尾）の自然な統合
      // ※ LLMで生成した発言にはプロファイル補正を適用しない（プロンプト内で性格指示済み）
      // ----------------------------------------------------
      if (msg && !defensiveCO && !usedLLM) {
        // 性格前置きフレーズ（quotePrefix）のランダム挿入（多言語対応）
        const prefixText = typeof getProfileQuotePrefix === 'function' ? getProfileQuotePrefix(prof) : (prof && prof.quotePrefix);
        if (prefixText && Math.random() < 0.35) {
          msg = `${prefixText} ${msg}`;
        }

        // 日本語のみ性格トーン置換
        if (lang === 'ja') {
          // 攻撃性パラメータによる語気補正
          if (prof.aggression >= 0.8) {
            msg = msg.replace(/と思います。/g, 'に決まってるよ！').replace(/考えます。/g, 'で決定だろ！').replace(/でしょうか？/g, 'でしょ！？');
          } else if (prof.aggression <= 0.3) {
            msg = msg.replace(/違和感/g, '少し気になる点').replace(/一択です/g, '有力候補です').replace(/決定です/g, '検討したいです');
          }

          // 論理度パラメータ（直感・雰囲気フレーズの挿入）
          if (prof.logicLevel <= 0.35 && Math.random() < 0.4) {
            msg = msg.replace(/客観的なログ/g, 'なんとなくの雰囲気').replace(/整合性/g, '直感');
          }
        }

        // 頑固さパラメータ（念押しフレーズの文末付与）
        if (prof.stubbornness >= 0.8 && Math.random() < 0.35) {
          const stubbornSfx = {
            ja: ' 私のこの考えはブレません。',
            en: ' My conviction in this shall not waver.',
            zh: ' 某之此念绝不动摇。',
            ko: ' 저의 이 소신은 결코 흔들리지 않소.'
          };
          msg = `${msg}${stubbornSfx[lang] || stubbornSfx.ja}`;
        }
      }

      // 重複・類似発言のフィルタリング → フォールバック発言で議論継続
      if (!defensiveCO && isDuplicateOrMeaningless(msg, recentHistory)) {
        console.log(`[AI議論] 重複発言を検出、フォールバック発言を生成します: (${speaker})`);
        // フォールバック：多様な話題で新しい発言を生成
        msg = generateFallbackDiscussion(speaker, aliveChars, recentHistory, prof);
        // フォールバックも重複なら最終手段のユニーク発言
        if (isDuplicateOrMeaningless(msg, recentHistory)) {
          const timestamp = Math.floor(Date.now() / 1000) % 100;
          const randomOther = pickRandom(aliveChars.filter(c => c !== speaker)) || speaker;
          const randomOtherName = getCharDisplayName(randomOther);
          const finalFallbackTemplates = {
            ja: [
              `…ちょっと待ってください。${randomOtherName}さん、今日ここまでの議論で一番気になっている人は誰ですか？率直に聞きたいです。`,
              `少し視点を変えましょう。今日まだ発言が少ない人がいませんか？沈黙も一つの情報です。${randomOtherName}さんはどう思いますか？`,
              `ここで改めて全員に問いたい。現時点で一番怪しいと思う人と、その根拠を一言で述べてください。私は…${randomOtherName}さんが気になっています。`,
              `${randomOtherName}さんの投票先の傾向が気になります。これまでの投票ラインを振り返ると、何か見えてくるものがあるはずです。`,
              `正直に言います。今の議論の流れだと判断材料が足りない気がします。${randomOtherName}さん、もう少し具体的な根拠を示していただけませんか？`,
              `ふと気づいたのですが、${randomOtherName}さんは特定の人物への追及を避けている印象があります。何か理由があるのでしょうか？`,
              `議論が煮詰まってきましたね。ここで一旦、確定している情報だけを整理し直しませんか？${randomOtherName}さん、賛成していただけますか？`,
              `${randomOtherName}さん、昨日の夜のことについてもう少し詳しく聞かせてください。何か気づいたことはありませんでしたか？`
            ],
            en: [
              `...Hold a moment. ${randomOtherName}, whom among us dost thou suspect most in our discourse thus far? Speak candidly, I pray thee.`,
              `Let us shift our gaze. Doth someone remain unusually silent this day? Silence itself is a confession of sorts. How sayest thou, ${randomOtherName}?`,
              `I put this question before all: name the one whom ye find most suspicious, and the reason thereof! As for me... I look upon ${randomOtherName} with doubt.`,
              `The manner in which ${randomOtherName} casteth their votes weigheth heavily upon my mind. Reviewing their allegiances may reveal what lieth hidden.`,
              `I speak plainly: the flow of our counsel lacketh decisive proof. ${randomOtherName}, couldst thou lay before us more tangible reasons?`,
              `It hath caught my eye that ${randomOtherName} seemeth to shy away from questioning certain persons. Is there cause for such restraint?`,
              `Our dispute reacheth an impasse. Should we not pause and assemble the facts already proven beyond doubt? Dost thou agree, ${randomOtherName}?`,
              `${randomOtherName}, pray enlighten us further regarding the occurrences of yesternight. Didst thou perceive anything untoward?`
            ],
            zh: [
              `……且慢！${randomOtherName}，今日商议至今，阁下心中最为生疑者究竟是谁？还请直言不讳。`,
              `何妨换个思路。今日可有言辞稀少之人？沉默本身亦是一条线索。${randomOtherName}，你意下如何？`,
              `在此某欲再问诸位一句：当下你等认为谁最可疑，所凭为何？至于在下……心系于${randomOtherName}。`,
              `${randomOtherName}此前的投票倾向颇为蹊跷。回顾其历次投票去向，定能察觉蛛丝马迹。`,
              `恕某直言，依眼下推论之势，定夺之凭据尚显不足。${randomOtherName}，可否拿出更为切实的证据？`,
              `某忽生一念：${randomOtherName}似总在刻意回避追问某些特定之人。莫非其中别有隐情？`,
              `争辩已陷入胶着。何不暂且休止，将确凿无疑之事重新整理？${randomOtherName}，可愿附议？`,
              `${randomOtherName}，关于昨夜之事，还请详述一二。可曾察觉到何等异样风吹草动？`
            ],
            ko: [
              `…잠깐 멈추시오. ${randomOtherName} 님, 오늘 지금까지의 논의 중 가장 마음에 걸리는 자는 누구입니까? 솔직한 심경을 묻고 싶소.`,
              `조금 시각을 바꾸어 봅시다. 오늘 아직 말수가 적은 이가 있지 않습니까? 침묵 또한 하나의 단서요. ${randomOtherName} 님은 어찌 생각하시오?`,
              `이 자리에서 다시금 모두에게 묻겠소. 현시점에서 가장 의심스러운 자와 그 근거를 한마디로 밝혀 주시오. 저는… ${randomOtherName} 님이 의심스럽소.`,
              `${randomOtherName} 님의 투표 행적이 못내 신경 쓰입니다. 지금까지의 투표 궤적을 짚어보면 무언가 드러나는 것이 있을 터요.`,
              `솔직히 고하겠소. 지금의 논의 흐름으로는 판단할 근거가 부족하오. ${randomOtherName} 님, 좀 더 구체적인 근거를 제시해 주시겠습니까?`,
              `문득 깨달은 바이나, ${randomOtherName} 님께서는 특정 인물에 대한 추궁을 은근히 피하는 인상이 있소. 무슨 곡절이라도 있는 것이오?`,
              `논의가 막다른 곳에 다다랐구려. 여기서 일단 확정된 정보만을 다시 추려보지 않겠소? ${randomOtherName} 님, 동의하시겠습니까?`,
              `${randomOtherName} 님, 지난밤의 일에 대해 조금만 더 자세히 들려주시오. 무엇인가 눈치챈 점은 없었소?`
            ]
          };
          msg = pickRandom(finalFallbackTemplates[lang] || finalFallbackTemplates.ja);
          console.log(`[AI議論] 最終フォールバック発言を使用: (${speaker})`);
        }
      }

      // 記憶・ログ保存
      if (!gameState.aiStatements) gameState.aiStatements = {};
      gameState.aiStatements[speaker] = msg;

      if (!gameState.aiDiscussionHistory) gameState.aiDiscussionHistory = [];
      gameState.aiDiscussionHistory.push({
        day: gameState.day,
        char: speaker,
        text: msg,
        isCO: !!defensiveCO,
        coRole: defensiveCO ? defensiveCO.role : null,
        timestamp: Date.now()
      });

      // 防衛CO発生時の仮想投票再計算
      if (defensiveCO) {
        calculateVirtualVotes();
        const coEventStr = { ja: 'CO発生', en: 'Claim', zh: 'CO发生', ko: 'CO발생' }[currentAppLanguage] || 'CO発生';
        const speakerLabel = getCharDisplayName(speaker);
        recordVirtualVoteHistory(`${formatDay(gameState.day)} ${defensiveCO.role.toUpperCase()} ${coEventStr} (${speakerLabel})`);
        renderVoteHistoryPage();
      }

      // 言語設定に応じたリアルタイム多言語翻訳適用
      const localizedMsg = translateDiscussionMessage(msg, currentAppLanguage);

      // 自己紹介接頭辞フォーマット適用
      const formattedMsg = formatSpeechMessage(speaker, localizedMsg);
      const speakerDisplayName = getCharDisplayName(speaker);

      // タイムライン描画
      addLogItem(`💬 ${speakerDisplayName}`, '', formattedMsg, 'ai-discussion', speaker, false);

      // 非同期音声読み上げ
      await playSpeechAsync(formattedMsg, getCharVoiceProfileKey(speaker));
    }

    // プレイヤーによる「🎯 発言を追及する」アクション
    function pursueAIDiscussion(char, text) {
      if (gameState.status[char] !== 'alive') {
        showCustomAlertModal(`村人 ${char} は既に生存していません。`);
        return;
      }

      // 1. そのキャラクターを選択状態にする
      selectCharacter(char);

      // 2. 質問入力欄に追及クエリをセット
      const inputEl = document.getElementById('custom-question-input');
      if (inputEl) {
        const cleanText = text.replace(/^「|」$/g, '');
        const shortQuote = cleanText.length > 25 ? cleanText.substring(0, 25) + '…' : cleanText;
        inputEl.value = `「『${shortQuote}』と言っていた件について追及する」`;
        inputEl.focus();
      }

      // 3. 情報画面から尋問操作画面へビュー切り替え
      switchView(1);

      // トースト通知
      showCustomAlertModal(`🎯 村人 ${char} の発言を追及枠にセットしました！\n「送信」ボタンで追及を直接ぶつけることができます。`);
    }

    // Render Bulletin Board (Includes Full Past Investigation History Layout)
    function renderBulletinBoard() {
      const list = document.getElementById('bulletin-list');
      list.innerHTML = '';
      let hasReport = false;

      gameState.charList.forEach(char => {
        const coRole = gameState.coRoles[char];
        const speakerName = getCharDisplayName(char);
        if (coRole === 'seer') {
          hasReport = true;
          const history = gameState.seerHistory[char] || [];
          history.forEach(h => {
            const targetName = getCharDisplayName(h.target);
            const isWolf = h.result === '人狼';
            const lang = currentAppLanguage || 'ja';
            let resText = isWolf ? '魔物' : '人間';
            if (lang === 'en') resText = isWolf ? 'Monster' : 'Human';
            else if (lang === 'zh') resText = isWolf ? '魔物' : '人类';
            else if (lang === 'ko') resText = isWolf ? '마물' : '인간';

            const coLabel = lang === 'en' ? 'Sage CO' : (lang === 'zh' ? '贤者CO' : (lang === 'ko' ? '현자 CO' : '賢者CO'));
            const appraiseLabel = lang === 'en' ? 'Appraisal' : (lang === 'zh' ? '鉴定' : (lang === 'ko' ? '감정' : '鑑定'));
            const isLabel = lang === 'en' ? 'is' : (lang === 'zh' ? '是' : (lang === 'ko' ? '은(는)' : 'は'));
            const text = `${speakerName} ${coLabel}。${formatDay(h.day)} ${appraiseLabel}: ${targetName} ${isLabel} ${resText}。`;
            const item = document.createElement('div');
            item.className = 'bulletin-item';
            item.innerHTML = `
              <div>🔮 <strong>${speakerName} (${coLabel})</strong> ➡️ [${formatDay(h.day)}] <strong>${targetName}</strong> ${isLabel}【<span style="color:${isWolf ? 'var(--wolf-color)' : 'var(--citizen-color)'}">${resText}</span>】</div>
              <button class="btn-speak" onclick="speakText('${text}', null, false, '${char}')">🔊</button>
            `;
            list.appendChild(item);
          });
        } else if (coRole === 'medium') {
          hasReport = true;
          const history = gameState.mediumHistory[char] || [];
          history.forEach(h => {
            const targetName = getCharDisplayName(h.target);
            const isWolf = h.result === '人狼';
            const lang = currentAppLanguage || 'ja';
            let resText = isWolf ? '魔物' : '人間';
            if (lang === 'en') resText = isWolf ? 'Monster' : 'Human';
            else if (lang === 'zh') resText = isWolf ? '魔物' : '人类';
            else if (lang === 'ko') resText = isWolf ? '마물' : '인간';

            const coLabel = lang === 'en' ? 'Cleric CO' : (lang === 'zh' ? '圣职者CO' : (lang === 'ko' ? '성직자 CO' : '聖職者CO'));
            const mediumLabel = lang === 'en' ? 'Spiritual Vision: Executed' : (lang === 'zh' ? '通灵: 被处决者' : (lang === 'ko' ? '영시: 처형자' : '霊視: 処刑者'));
            const isLabel = lang === 'en' ? 'was' : (lang === 'zh' ? '是' : (lang === 'ko' ? '은(는)' : 'は'));
            const text = `${speakerName} ${coLabel}。${formatDay(h.day)} ${mediumLabel} ${targetName} ${isLabel} ${resText}。`;
            const item = document.createElement('div');
            item.className = 'bulletin-item';
            item.innerHTML = `
              <div>👻 <strong>${speakerName} (${coLabel})</strong> ➡️ [${formatDay(h.day)}] ${mediumLabel} <strong>${targetName}</strong> ${isLabel}【<span style="color:${isWolf ? 'var(--wolf-color)' : 'var(--citizen-color)'}">${resText}</span>】</div>
              <button class="btn-speak" onclick="speakText('${text}', null, false, '${char}')">🔊</button>
            `;
            list.appendChild(item);
          });
        }
      });

      if (!hasReport) {
        const lang = currentAppLanguage || 'ja';
        const noRepMsg = lang === 'en' ? 'No new confirmed ability reports today. (Roles in hiding)' :
          (lang === 'zh' ? '今日尚无新的能力确认报告。（角色潜伏中）' :
          (lang === 'ko' ? '오늘의 새로운 확정 능력 보고는 없습니다. (역할 잠복 중)' :
          '本日の新たな確定能力報告はありません。（役職潜伏中）'));
        list.innerHTML = `<div style="color: var(--text-muted);">${noRepMsg}</div>`;
      }
    }

    // --- 【論理思考エンジン①】確定破綻者（100%魔物/偽物）の検出ヘルパー ---
    function getDefiniteBustedPlayers() {
      const lang = currentAppLanguage || 'ja';
      const busted = [];
      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');

      // 1. 白出しした人物が死亡し、霊媒結果や過去役職で「魔物」と確定判明しているにもかかわらず「白出し」していた賢者（破綻占い）
      Object.keys(gameState.seerHistory || {}).forEach(seer => {
        if (!aliveChars.includes(seer)) return;
        const history = gameState.seerHistory[seer] || [];
        history.forEach(rep => {
          // 占った対象が死亡しており、かつ実際が人狼（霊媒結果で確定、あるいは霊媒結果と矛盾）
          if (gameState.status[rep.target] === 'dead' && rep.result === '人間') {
            const medHistory = Object.values(gameState.mediumHistory || {}).flat();
            const medRep = medHistory.find(m => m.target === rep.target);
            if (medRep && medRep.result === '人狼') {
              const targetName = getCharDisplayName(rep.target);
              const bustedReasonDict = {
                ja: `霊媒結果で【魔物】と確定した${targetName}さんを【人間】と偽判定していたため（完全破綻）`,
                en: `falsely judged ${targetName}, confirmed as a [Monster] by the Cleric's verdict, to be [Human] (total contradiction)`,
                zh: `将经圣职者验证确认为【魔物】的${targetName}伪判为【人类】（彻底破绽）`,
                ko: `성직자 결과로 【마물】이 확정된 ${targetName} 님을 【인간】으로 위판정했기에 (완전 파탄)`
              };
              busted.push({
                target: seer,
                reason: bustedReasonDict[lang] || bustedReasonDict.ja,
                isCertain: true
              });
            }
          }
        });
      });

      // 2. 3人目の賢者CO（進行上破綻）
      const seerCOs = aliveChars.filter(c => gameState.coRoles[c] === 'seer');
      if (seerCOs.length >= 3) {
        seerCOs.forEach(c => {
          if (!busted.some(b => b.target === c)) {
            const tripleSeerDict = {
              ja: '賢者COが3人以上乱立しており構造的に破綻しているため',
              en: 'three or more rival Sage claims have emerged, a structural impossibility',
              zh: '贤者声明已三人以上并立，结构性矛盾已然确立',
              ko: '현자 선언이 3명 이상 난립하여 구조적으로 파탄이 났기에'
            };
            busted.push({
              target: c,
              reason: tripleSeerDict[lang] || tripleSeerDict.ja,
              isCertain: true
            });
          }
        });
      }

      // 3. 2人目の聖職者CO（1人死亡後の3人目等）または霊媒破綻
      const medCOs = aliveChars.filter(c => gameState.coRoles[c] === 'medium');
      if (medCOs.length >= 3) {
        medCOs.forEach(c => {
          if (!busted.some(b => b.target === c)) {
            const tripleMedDict = {
              ja: '聖職者COが複数破綻して乱立しているため',
              en: 'multiple Cleric claims have collapsed into chaos',
              zh: '圣职者声明多人并立且已彻底破绽',
              ko: '성직자 선언이 다수 파탄을 일으키며 난립하고 있기에'
            };
            busted.push({
              target: c,
              reason: tripleMedDict[lang] || tripleMedDict.ja,
              isCertain: true
            });
          }
        });
      }

      return busted;
    }

    // --- 【論理思考エンジン②】消去法・破綻検知による追及・投票ターゲット取得 ---
    function getLogicalDeductionTarget(speakerAI) {
      const lang = currentAppLanguage || 'ja';
      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      const aliveOthers = aliveChars.filter(c => c !== speakerAI);
      if (aliveOthers.length === 0) return null;

      // 1. 自身が賢者COしており、黒（魔物）を出している対象がいる場合、その黒出し対象を100%徹底追及（他者への浮気禁止）
      if (gameState.coRoles[speakerAI] === 'seer') {
        const seerRep = gameState.dailySeerReports[speakerAI];
        if (seerRep && seerRep.result === '人狼' && aliveChars.includes(seerRep.target)) {
          const selfBlackReason = {
            ja: '自身の鑑定結果で【魔物】と確定判明しているため',
            en: 'my own divination confirmed them as a [Monster]',
            zh: '本人之占验已确证其为【魔物】',
            ko: '자신의 감정 결과로 【마물】임이 확정되었기에'
          };
          return {
            target: seerRep.target,
            reason: selfBlackReason[lang] || selfBlackReason.ja,
            isCertain: true
          };
        }
      }

      // 1.2. 確定破綻者が存在する場合、他の無関係な人物への疑い・投票を禁止し100%ロックオン
      const bustedList = getDefiniteBustedPlayers();
      const validBusted = bustedList.filter(b => b.target !== speakerAI && aliveChars.includes(b.target));
      if (validBusted.length > 0) {
        return {
          target: validBusted[0].target,
          reason: validBusted[0].reason,
          isCertain: true
        };
      }

      // 2. 消去法ロジック（確白・保護役職を除外）
      const whiteResults = getSeerWhiteResults();
      const whiteTargets = whiteResults.map(w => w.target);
      const confirmedWhitePlayers = aliveOthers.filter(c => whiteTargets.includes(c) || gameState.coRoles[c] === 'freemason');

      // グレー枠（非COかつ白出し未実施）
      const grayPlayers = aliveOthers.filter(c => !confirmedWhitePlayers.includes(c));
      const targetCandidates = grayPlayers.length > 0 ? grayPlayers : aliveOthers;

      // 最も不自然な人物を選定
      const selectedTarget = pickRandom(targetCandidates);
      const isGrey = grayPlayers.includes(selectedTarget);
      
      const defaultReasonDict = {
        ja: 'これまでの発言ログと仮投票ラインの不自然さ',
        en: 'irregularities in the speech records and provisional voting patterns',
        zh: '迄今言行记录与暂定投票走势中的不自然之处',
        ko: '지금까지의 발언 기록과 가투표 라인의 부자연스러움'
      };
      let reasonStr = defaultReasonDict[lang] || defaultReasonDict.ja;

      if (isGrey && confirmedWhitePlayers.length > 0) {
        const sep = lang === 'en' ? ' and ' : (lang === 'zh' ? '以及' : (lang === 'ko' ? ' 님과 ' : 'さんや'));
        const suf = lang === 'ko' ? ' 님' : (lang === 'ja' ? 'さん' : '');
        const whiteNames = confirmedWhitePlayers.map(c => getCharDisplayName(c)).join(sep) + suf;
        const elimReasonDict = {
          ja: `${whiteNames}の白確定枠を除外した消去法`,
          en: `process of elimination after excluding the confirmed innocents (${whiteNames})`,
          zh: `排除${whiteNames}的确凿清白之后的消去法推理`,
          ko: `${whiteNames}의 확정 결백 인원을 제외한 소거법`
        };
        reasonStr = elimReasonDict[lang] || elimReasonDict.ja;
      }

      return {
        target: selectedTarget,
        reason: reasonStr,
        isCertain: false
      };
    }

    /**
     * 役職CO者における「対抗者最優先疑い・黒出し疑い」判定ヘルパー
     * @param {string} char - 判定対象のキャラクターキー
     * @returns {Object|null} { target: string, targetName: string, reasonType: 'co_conflict'|'inspection_black', myCoRole: string, roleName: string }
     */
    function getClaimantSuspicionTarget(char) {
      if (!gameState || !gameState.coRoles) return null;
      const myCo = gameState.coRoles[char];
      if (!myCo || myCo === 'grey' || myCo === 'villager') return null;

      const roleMap = {
        seer: { ja: '賢者', en: 'Sage', zh: '贤者', ko: '현자' },
        medium: { ja: '聖職者', en: 'Cleric', zh: '圣职者', ko: '성직자' },
        knight: { ja: '聖騎士', en: 'Holy Knight', zh: '圣骑士', ko: '성기사' },
        freemason: { ja: '共有者', en: 'Freemason', zh: '共济会', ko: '공유자' }
      };
      const lang = typeof currentAppLanguage !== 'undefined' ? (currentAppLanguage || 'ja') : 'ja';
      const roleName = (roleMap[myCo] && roleMap[myCo][lang]) || (roleMap[myCo] && roleMap[myCo].ja) || myCo;

      // 1. 対抗CO者が存在する場合（最優先ルール: 真・偽問わず対抗者を確定で最も怪しい偽物として攻撃）
      const counterClaimants = (gameState.charList || []).filter(c =>
        c !== char &&
        gameState.status && gameState.status[c] === 'alive' &&
        gameState.coRoles && gameState.coRoles[c] === myCo
      );

      if (counterClaimants.length > 0) {
        const rival = counterClaimants[0];
        return {
          target: rival,
          targetName: getCharDisplayName(rival),
          reasonType: 'co_conflict',
          myCoRole: myCo,
          roleName: roleName
        };
      }

      // 2. 対抗CO者が存在せず、自身が黒出し（魔物判定）済みの生存者がいる場合（次点）
      let blackTarget = null;
      if (myCo === 'seer') {
        const seerHistory = (gameState.seerHistory && gameState.seerHistory[char]) || [];
        const aliveBlack = seerHistory.filter(h => h.result === '人狼' && gameState.status && gameState.status[h.target] === 'alive');
        if (aliveBlack.length > 0) {
          blackTarget = aliveBlack[aliveBlack.length - 1].target;
        } else if (gameState.dailySeerReports && gameState.dailySeerReports[char]) {
          const report = gameState.dailySeerReports[char];
          if (report.result === '人狼' && gameState.status && gameState.status[report.target] === 'alive') {
            blackTarget = report.target;
          }
        }
      }

      if (blackTarget) {
        return {
          target: blackTarget,
          targetName: getCharDisplayName(blackTarget),
          reasonType: 'inspection_black',
          myCoRole: myCo,
          roleName: roleName
        };
      }

      return null;
    }

    // =====================================================
    // 仮想投票・疑い度算出＆履歴アーカイブシステム
    // =====================================================
    function calculateVirtualVotes() {
      const aliveChars = gameState.charList.filter(c => gameState.status[c] === 'alive');
      gameState.virtualVotes = {};

      const bustedList = getDefiniteBustedPlayers();

      // 1. 各生き残りメンバーの仮想投票先決定
      aliveChars.forEach(voter => {
        const realRole = gameState.roles[voter];
        const candidates = aliveChars.filter(c => c !== voter);
        if (candidates.length === 0) return;

        // ★ 役職CO者の最優先ルール: 対抗CO者がいる場合、100%対抗者をロックオン（真・偽問わず）
        // 次点: 自身が黒出しした対象がいる場合、その対象をロックオン
        const claimantTarget = getClaimantSuspicionTarget(voter);
        if (claimantTarget && candidates.includes(claimantTarget.target)) {
          const isConflict = claimantTarget.reasonType === 'co_conflict';
          const scoreVal = isConflict ? 99 : 98;
          const reasonText = isConflict
            ? `対抗役職者（${claimantTarget.roleName}騙り）への最優先弾劾`
            : `自身が魔物判定を出した対象（${claimantTarget.targetName}）への弾劾`;
          gameState.virtualVotes[voter] = {
            target: claimantTarget.target,
            suspicionScore: scoreVal,
            reason: reasonText
          };
          return;
        }

        // ★ 確定破綻者がいる場合、村人陣営は100%破綻者へロックオン
        const validBusted = bustedList.filter(b => b.target !== voter && candidates.includes(b.target));
        if (realRole !== 'wolf' && validBusted.length > 0) {
          const bTarget = validBusted[0].target;
          gameState.virtualVotes[voter] = {
            target: bTarget,
            suspicionScore: 95,
            reason: validBusted[0].reason
          };
          return;
        }

        let bestTarget = candidates[0];
        let maxSuspicion = 0;
        let bestReason = 'ログ全体の違和感';

        // 各候補ごとのスコアリング
        const candidateScores = candidates.map(target => {
          let score = 50; // 基本ベース疑い度（初期中立）
          let reason = '不自然な発言ログ';

          const targetRealRole = gameState.roles[target];
          const targetCoRole = gameState.coRoles[target] || 'grey';
          const voterCoRole = gameState.coRoles[voter] || 'grey';

          // --- 【人狼（魔物）の思考ロジック（擬態・ラインヘイトコントロール）】 ---
          if (realRole === 'wolf') {
            const isTargetWolf = targetRealRole === 'wolf';

            if (isTargetWolf) {
              // 仲間人狼への投票: 仲間が占いで黒判定された時、または疑いが集中した時のみ「身内切り」として投票検討（基本は回避）
              const targetExposed = Object.values(gameState.dailySeerReports || {}).some(r => r.target === target && r.result === '人狼');
              if (targetExposed && Math.random() < 0.6) {
                score = 65 + Math.floor(Math.random() * 10);
                reason = 'ライン切り（身内切りによる村人擬態）';
              } else {
                score = 10 + Math.floor(Math.random() * 10);
                reason = '身内庇い（低スコア維持）';
              }
            } else {
              // 非人狼への投票（ヘイトコントロール：仲間が疑われたら別プレイヤーを強固に疑う）
              const fellowWolves = candidates.filter(c => gameState.roles[c] === 'wolf');
              const highSuspicionFellow = fellowWolves.some(w => {
                const wVote = gameState.virtualVotes[w];
                return wVote && wVote.suspicionScore >= 70;
              });

              if (highSuspicionFellow && (targetCoRole === 'grey' || targetCoRole === 'villager')) {
                score = 75 + Math.floor(Math.random() * 15);
                reason = '仲間を護るためのヘイト誘導・論点逸らし';
              } else if (targetCoRole === 'grey' || targetCoRole === 'villager') {
                score = 58 + Math.floor(Math.random() * 14);
                reason = 'グレー村人の発言ログの違和感';
              } else if (targetCoRole !== 'grey' && voterCoRole !== 'grey' && targetCoRole === voterCoRole) {
                score = 68 + Math.floor(Math.random() * 10);
                reason = `対抗役職 (${targetCoRole}) への主張不信`;
              } else {
                score = 45 + Math.floor(Math.random() * 15);
                reason = '役職開示者への静観';
              }
            }
          }
          // --- 【魔教徒の思考ロジック（混乱・誘導）】 ---
          else if (realRole === 'madman') {
            if (targetCoRole === 'grey' || targetCoRole === 'villager') {
              score = 60 + Math.floor(Math.random() * 15);
              reason = '疑惑散らしと村の混迷誘導';
            } else if (voterCoRole !== 'grey' && targetCoRole === voterCoRole) {
              score = 70 + Math.floor(Math.random() * 12);
              reason = '真役職対抗者への不信主張';
            } else {
              score = 50 + Math.floor(Math.random() * 15);
              reason = '盤面の混迷誘発';
            }
          }
          // --- 【妖狐の思考ロジック（潜伏・流され）】 ---
          else if (realRole === 'fox') {
            // 賢者CO者には絶対投票せず（呪殺回避・目立たない）、平均的な意見に流される
            if (targetCoRole === 'seer') {
              score = 5;
              reason = '賢者への衝突回避（目立たない行動）';
            } else {
              score = 45 + Math.floor(Math.random() * 15);
              reason = '周囲の意見への同調';
            }
          }
          // --- 【村人陣営の思考ロジック (村人・賢者・聖職者・聖騎士・パン・共有・猫又等)】 ---
          else {
            // ★ 確白（白出しされた人物・共有者）への不自然な投票・疑心を排除
            const whiteResults = getSeerWhiteResults();
            const whiteTargets = whiteResults.map(w => w.target);
            const isConfirmedWhite = whiteTargets.includes(target) || gameState.coRoles[target] === 'freemason';

            if (isConfirmedWhite) {
              score = 5;
              reason = '確白判定者への信頼（除外）';
            } else {
              // 1. 【賢者CO者の対立加算】: 自分以外の賢者CO者 ➜ スコア +30
              const seerCOs = gameState.charList.filter(c => gameState.coRoles[c] === 'seer' && gameState.status[c] === 'alive');
              if (targetCoRole === 'seer' && voterCoRole !== 'seer' && seerCOs.length >= 2) {
                score += 30;
                reason = '賢者CO対立候補への警戒';
              }

              // 2. 【黒判定（魔物判定）の提示】: 賢者CO者が「〇〇は魔物」と発言 ➜ スコア +50
              const hasBlackReport = Object.values(gameState.dailySeerReports || {}).some(r => r.target === target && r.result === '人狼')
                || Object.values(gameState.mediumHistory || {}).flat().some(r => r.target === target && r.result === '人狼');
              if (hasBlackReport) {
                score += 50;
                reason = '能力者からの【魔物判定】';
              }

              // 3. 【白判定（人間判定）の提示】: 賢者CO者が「〇〇は人間」と発言 ➜ スコア -40
              const hasWhiteReport = Object.values(gameState.dailySeerReports || {}).some(r => r.target === target && r.result === '人間');
              if (hasWhiteReport && !hasBlackReport) {
                score -= 40;
                reason = '賢者からの【人間判定】による安全評価';
              }

              // 4. 【前日処刑者の誤審投票分析】: 前日処刑者が「人間」だった場合、それに投票していた者のスコア +25
              if (gameState.lastExecutedChar && gameState.lastExecutedRole && gameState.lastExecutedRole !== 'wolf' && gameState.lastExecutedRole !== 'fox') {
                // 過去の仮想投票履歴から前日処刑者に投票した者か確認
                const lastHistory = gameState.virtualVoteHistory && gameState.virtualVoteHistory[0];
                if (lastHistory && lastHistory.votes && lastHistory.votes[target] && lastHistory.votes[target].target === gameState.lastExecutedChar) {
                  score += 25;
                  reason = '【誤審誘導】前日無実の人間を処刑に追い込んだ疑い';
                }
              }

              // 5. 【発言の破綻（ロジックエラー）】: 矛盾COや3人以上CO ➜ スコア +100（即座に処刑対象へ）
              const bustedList = getDefiniteBustedPlayers();
              const isBusted = bustedList.some(b => b.target === target);
              if (isBusted) {
                score += 100;
                reason = '主張の論理破綻・矛盾検出（破綻者）';
              }

              // 同役職対抗
              if (targetCoRole !== 'grey' && voterCoRole !== 'grey' && targetCoRole === voterCoRole) {
                score += 25;
                reason = `同役職 (${targetCoRole}) への対抗不信`;
              }

              // 自分を疑ってきた人物への返し
              const targetVote = gameState.virtualVotes[target];
              if (targetVote && targetVote.target === voter) {
                score += 12;
                reason = '自分に対する不審感への反論';
              }

              // スコアの自然な調整
              score = Math.max(10, Math.min(100, score));
            }
          }

          // ★ プロファイル性格パラメータによるスコア補正
          const voterProf = (gameState.charProfiles && gameState.charProfiles[voter]) || null;
          if (voterProf) {
            if (voterProf.aggression >= 0.7) {
              score += Math.floor((voterProf.aggression - 0.5) * 15);
            }
            const prevVote = gameState.virtualVotes[voter];
            if (voterProf.stubbornness >= 0.6 && prevVote && prevVote.target === target) {
              score += Math.floor(voterProf.stubbornness * 12);
              reason = '前回から継続して疑念を持続中';
            }
            if (voterProf.logicLevel <= 0.4) {
              score += Math.floor(Math.random() * 18) - 9;
            }
          }

          // ★ 勇者不信ペナルティ: 誤処刑後、NPCは勇者（プレイヤー）の疑い先に追従しにくくなる
          if (gameState.heroDistrustLevel > 0) {
            // 勇者の最後の弾劾対象と同じターゲットを選んでいる場合、スコアを減少
            const heroLastAccusation = gameState.accusationHistory && gameState.accusationHistory.length > 0
              ? gameState.accusationHistory[gameState.accusationHistory.length - 1]
              : null;
            if (heroLastAccusation && heroLastAccusation.target === target) {
              const penalty = Math.min(gameState.heroDistrustLevel * 15, 45);
              score -= penalty;
              reason = '勇者の判断への不信感';
            }
          }

          const noise = Math.floor(Math.random() * 5) - 2;
          score = Math.max(0, Math.min(100, Math.round(score + noise)));

          return { target, score, reason };
        });

        // 最も高いスコアの対象を本日の仮投票先に決定
        candidateScores.sort((a, b) => b.score - a.score);
        bestTarget = candidateScores[0].target;
        maxSuspicion = candidateScores[0].score;
        bestReason = candidateScores[0].reason;

        gameState.virtualVotes[voter] = {
          target: bestTarget,
          suspicionScore: maxSuspicion,
          reason: bestReason
        };
      });
    }

    // 仮想投票履歴のアーカイブ保存
    function recordVirtualVoteHistory(label) {
      const tallyMap = {};
      const votesCopy = {};

      Object.keys(gameState.virtualVotes).forEach(voter => {
        const vote = gameState.virtualVotes[voter];
        votesCopy[voter] = { ...vote };

        if (!tallyMap[vote.target]) {
          tallyMap[vote.target] = 0;
        }
        tallyMap[vote.target]++;
      });

      const tally = Object.keys(tallyMap)
        .map(target => ({ target, count: tallyMap[target] }))
        .sort((a, b) => b.count - a.count);

      gameState.virtualVoteHistory.unshift({
        day: gameState.day,
        label: label || `${formatDay(gameState.day)}`,
        votes: votesCopy,
        tally: tally
      });
    }

    // 「2. 仮想投票・疑い度履歴」ページのレンダリング
    function renderVoteHistoryPage() {
      const container = document.getElementById('vote-history-container');
      if (!container) return;

      container.innerHTML = '';
      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;

      if (!gameState.virtualVoteHistory || gameState.virtualVoteHistory.length === 0) {
        container.innerHTML = `<div style="color: var(--text-muted); font-size: 0.85rem; padding: 1rem; text-align: center;">${t.no_vote_history || 'まだ仮想投票の記録はありません。'}</div>`;
        return;
      }

      gameState.virtualVoteHistory.forEach((record, idx) => {
        const card = document.createElement('div');
        card.className = 'vote-card';

        // ヘッダー（日時・ラベル）
        const topTargetName = record.tally.length > 0 ? getCharDisplayName(record.tally[0].target) : (t.vote_none || 'なし');
        const headerFmt = t.vote_summary_header || '📅 {label} の仮投票集計';
        const topLabel = t.vote_top_target || '最多集票: ';
        card.innerHTML = `
          <div class="vote-card-header">
            <span>${headerFmt.replace('{label}', record.label)}</span>
            <span style="font-size: 0.78rem; color: var(--text-muted);">${topLabel}<strong style="color: var(--accent-red);">${topTargetName}</strong></span>
          </div>
        `;

        // 得票集計バッジリスト（ライン精査用）
        const tallyList = document.createElement('div');
        tallyList.className = 'vote-tally-list';
        const badgeFmt = t.vote_count_badge || '{name}: <strong>{count}票</strong>';
        record.tally.forEach(tItem => {
          const badge = document.createElement('div');
          const isTop = (tItem.count === record.tally[0].count && tItem.count > 0);
          badge.className = `vote-tally-badge ${isTop ? 'top-target' : ''}`;
          badge.innerHTML = badgeFmt.replace('{name}', getCharDisplayName(tItem.target)).replace('{count}', tItem.count);
          tallyList.appendChild(badge);
        });
        card.appendChild(tallyList);

        // 各個人の投票先＆疑念度詳細リスト
        const itemList = document.createElement('div');
        itemList.className = 'vote-item-list';

        Object.keys(record.votes).forEach(voter => {
          const vote = record.votes[voter];
          const isDeadVoter = gameState.status[voter] !== 'alive';

          const row = document.createElement('div');
          row.className = `vote-item-row ${isDeadVoter ? 'is-dead-voter' : ''}`;

          let voterCoText = `（${(t.co_badge_grey || 'グレー').replace(/[👤\s]/g, '')}）`;
          if (gameState.coRoles[voter] === 'seer') voterCoText = `（${(t.co_badge_seer || '賢者CO').replace(/[🔮\s]/g, '')}）`;
          if (gameState.coRoles[voter] === 'medium') voterCoText = `（${(t.co_badge_medium || '聖職者CO').replace(/[👻\s]/g, '')}）`;
          if (gameState.coRoles[voter] === 'freemason') voterCoText = `（${(t.co_badge_freemason || '共有CO').replace(/[🤝\s]/g, '')}）`;

          const suspicionFmt = t.vote_suspicion_badge || '疑念 {score}%';
          row.innerHTML = `
            <div class="voter-name">
              ${getCharDisplayName(voter)} <span style="font-size:0.74rem; font-weight:normal; color:var(--text-muted);">${voterCoText}</span>
            </div>
            <div class="vote-target-info">
              <span class="vote-arrow">➔</span>
              <span class="vote-target-name">${getCharDisplayName(vote.target)}</span>
              <span class="suspicion-pct">${suspicionFmt.replace('{score}', vote.suspicionScore)}</span>
            </div>
          `;
          itemList.appendChild(row);
        });

        card.appendChild(itemList);
        container.appendChild(card);
      });
    }

    // Render Morning Comments Box (Full History Grouped by Day)
    function renderMorningCommentsBox() {
      const list = document.getElementById('morning-comments-list');
      list.innerHTML = '';
      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;

      const history = gameState.morningCommentsHistory || [];
      if (history.length === 0) {
        list.innerHTML = `<div style="font-size:0.8rem; color:var(--text-muted); padding:0.4rem;">${t.morning_empty || 'まだコメントがありません。'}</div>`;
        return;
      }

      // 日付ごとにグループ化
      const grouped = {};
      history.forEach(item => {
        if (!grouped[item.day]) grouped[item.day] = [];
        grouped[item.day].push(item);
      });

      // 最新日〜1日目の順（降順）で表示
      const days = Object.keys(grouped).map(Number).sort((a, b) => b - a);

      days.forEach(day => {
        const dayHeader = document.createElement('div');
        dayHeader.className = 'morning-day-header';
        dayHeader.style.cssText = 'font-size:0.8rem; font-weight:bold; color:var(--accent-gold); margin-top:0.4rem; margin-bottom:0.2rem; border-bottom:1px solid rgba(245,158,11,0.25); padding-bottom:0.15rem;';
        const dayFmt = t.morning_day_header || '📅 {day}の朝コメント';
        dayHeader.textContent = dayFmt.replace('{day}', formatDay(day));
        list.appendChild(dayHeader);

        grouped[day].forEach(item => {
          const div = document.createElement('div');
          div.className = 'morning-comment-item';
          const speakerName = getCharDisplayName(item.char);
          const displayComment = replaceNamePlaceholders(item.comment);
          const speakMsg = `${speakerName}。${displayComment}`;

          div.innerHTML = `
            <div><strong>${speakerName} (${item.coText})</strong>: ${displayComment}</div>
            <button class="btn-speak" onclick="speakText('${speakMsg}', null, false, '${item.char}')">🔊</button>
          `;
          list.appendChild(div);
        });
      });
    }

    // Render Status Bar
    function renderStatus() {
      const dayEl = document.getElementById('day-display');
      if (dayEl) dayEl.textContent = formatDay(gameState.day);

      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;
      const lifeEl = document.getElementById('life-display');
      if (lifeEl) {
        const fmt = t.remaining_mistakes || '残り{count}回';
        lifeEl.textContent = fmt.replace('{count}', gameState.mistakesLeft);
      }

      updateTimerDisplay();

      const warning = document.getElementById('action-warning');
      const btnSkip = document.getElementById('btn-skip-execute');

      if (!gameState.executedToday && !gameState.gameOver) {
        btnSkip.disabled = false;
      } else {
        btnSkip.disabled = true;
      }

      if (gameState.subPhase === 'decision' && !gameState.executedToday && !gameState.gameOver) {
        warning.style.display = 'block';
      } else {
        warning.style.display = 'none';
      }
    }

    // Update Memo Role for Character
    function updateMemoRole(char, val, event) {
      if (event) event.stopPropagation();
      if (!gameState.memoRoles) gameState.memoRoles = {};
      gameState.memoRoles[char] = val;
      renderCharacters();
    }

    // Render Character Grid
    function renderCharacters() {
      const grid = document.getElementById('character-grid');
      grid.innerHTML = '';

      if (!gameState.memoRoles) gameState.memoRoles = {};
      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;

      gameState.charList.forEach(char => {
        const card = document.createElement('div');
        card.className = `char-card ${gameState.selectedChar === char ? 'selected' : ''}`;
        
        const isAlive = gameState.status[char] === 'alive';
        if (!isAlive) {
          card.classList.add('disabled');
          card.classList.add('is-dead');
        }

        const coRole = gameState.coRoles[char];
        let coBadgeClass = 'co-grey';
        let coBadgeText = t.co_badge_grey || '👤 グレー';
        if (coRole === 'seer') {
          coBadgeClass = 'co-seer';
          coBadgeText = t.co_badge_seer || '🔮 賢者CO';
        } else if (coRole === 'medium') {
          coBadgeClass = 'co-medium';
          coBadgeText = t.co_badge_medium || '👻 聖職者CO';
        } else if (coRole === 'freemason') {
          coBadgeClass = 'co-freemason';
          coBadgeText = t.co_badge_freemason || '🤝 共有CO';
        }

        let statusText = t.status_alive || '生存';
        let statusClass = 'status-alive';

        if (gameState.status[char] === 'attacked' || gameState.status[char] === 'cursed') {
          statusText = t.status_attacked_dead || '【犠牲者】死亡';
          statusClass = 'status-attacked';
        } else if (gameState.status[char] === 'executed') {
          statusText = t.status_executed || '【処刑済】';
          statusClass = 'status-executed';
        }

        const memoRole = gameState.memoRoles[char] || 'none';
        const displayName = getCharDisplayName(char);
        const profile = (gameState.charProfiles && gameState.charProfiles[char]) || AI_PROFILES[0];

        card.innerHTML = `
          <div class="char-avatar">${char}</div>
          <div class="char-name">${displayName}</div>
          <div class="char-archetype-badge" style="font-size:0.68rem; color:#fbbf24; background:rgba(245,158,11,0.15); padding:0.1rem 0.3rem; border-radius:4px; margin-bottom:0.2rem; border:1px solid rgba(245,158,11,0.3); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">🎭 ${getArchetypeDisplayName(profile.archetype, currentAppLanguage)}</div>
          <div class="char-co-badge ${coBadgeClass}">${coBadgeText}</div>
          <div class="char-status ${statusClass}">${statusText}</div>
          <select class="memo-select memo-${memoRole}" onclick="event.stopPropagation()" onchange="updateMemoRole('${char}', this.value, event)">
            <option value="none" ${memoRole === 'none' ? 'selected' : ''}>${t.memo_none || '❓ 未予想'}</option>
            <option value="villager" ${memoRole === 'villager' ? 'selected' : ''}>${t.memo_villager || '🔵 村人'}</option>
            <option value="wolf" ${memoRole === 'wolf' ? 'selected' : ''}>${t.memo_wolf || '🔴 擬態モンスター'}</option>
            <option value="seer" ${memoRole === 'seer' ? 'selected' : ''}>${t.memo_seer || '🔮 賢者'}</option>
            <option value="medium" ${memoRole === 'medium' ? 'selected' : ''}>${t.memo_medium || '👻 聖職者'}</option>
            <option value="knight" ${memoRole === 'knight' ? 'selected' : ''}>${t.memo_knight || '🛡️ 聖騎士'}</option>
            <option value="madman" ${memoRole === 'madman' ? 'selected' : ''}>${t.memo_madman || '💗 魔教徒'}</option>
            <option value="baker" ${memoRole === 'baker' ? 'selected' : ''}>${t.memo_baker || '🍞 パン屋'}</option>
            <option value="fox" ${memoRole === 'fox' ? 'selected' : ''}>${t.memo_fox || '🦊 妖狐'}</option>
          </select>
        `;

        if (isAlive && !gameState.gameOver) {
          card.onclick = () => selectCharacter(char);
        }

        grid.appendChild(card);
      });
    }

    // Select Character & UI Action Controls Update
    function selectCharacter(char) {
      if (char && (gameState.status[char] !== 'alive' || gameState.gameOver)) return;

      if (char !== undefined) {
        gameState.selectedChar = char;
      }
      renderCharacters();

      const targetInfo = document.getElementById('target-info');
      const btnQ1 = document.getElementById('btn-q1');
      const btnQ2 = document.getElementById('btn-q2');
      const btnQ3 = document.getElementById('btn-q3');
      const btnCustomInput = document.getElementById('custom-question-input');
      const btnCustomQ = document.getElementById('btn-custom-q');
      const btnGotoDecision = document.getElementById('btn-goto-decision');
      const executeRow = document.getElementById('execute-action-row');
      const btnExec = document.getElementById('btn-execute');
      const btnSkip = document.getElementById('btn-skip-execute');

      const isDiscussion = gameState.subPhase === 'discussion' && !gameState.executedToday && !gameState.gameOver;
      const isDecision = gameState.subPhase === 'decision' && !gameState.executedToday && !gameState.gameOver;

      // 質問ボタンの制御
      const canAsk = isDiscussion && gameState.selectedChar;
      btnQ1.disabled = !canAsk;
      btnQ2.disabled = !canAsk;
      btnQ3.disabled = !canAsk;
      if (btnCustomInput) btnCustomInput.disabled = !canAsk;
      if (btnCustomQ) btnCustomQ.disabled = !canAsk;

      // フェーズに応じたボタン行の切り替え制御
      if (isDiscussion) {
        if (btnGotoDecision) {
          btnGotoDecision.style.display = 'block';
          btnGotoDecision.disabled = false;
        }
        if (executeRow) executeRow.style.display = 'none';
      } else if (isDecision) {
        if (btnGotoDecision) btnGotoDecision.style.display = 'none';
        if (executeRow) executeRow.style.display = 'flex';
        btnExec.disabled = !gameState.selectedChar;
        btnSkip.disabled = false;
      } else {
        // 夕方・夜・ゲームオーバー時
        if (btnGotoDecision) {
          btnGotoDecision.style.display = 'block';
          btnGotoDecision.disabled = true;
        }
        if (executeRow) executeRow.style.display = 'none';
      }

      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;
      if (gameState.selectedChar) {
        let coText = `（${(t.co_badge_grey || 'グレー').replace(/[👤\s]/g, '')}）`;
        if (gameState.coRoles[gameState.selectedChar] === 'seer') coText = `（${(t.co_badge_seer || '賢者CO').replace(/[🔮\s]/g, '')}）`;
        if (gameState.coRoles[gameState.selectedChar] === 'medium') coText = `（${(t.co_badge_medium || '聖職者CO').replace(/[👻\s]/g, '')}）`;
        if (gameState.coRoles[gameState.selectedChar] === 'freemason') coText = `（${(t.co_badge_freemason || '共有CO').replace(/[🤝\s]/g, '')}）`;

        const profile = (gameState.charProfiles && gameState.charProfiles[gameState.selectedChar]) || AI_PROFILES[0];
        const template = t.selected_target_label || '選択中: {name} 【{archetype}】 {coText}';
        targetInfo.textContent = template
          .replace('{name}', getCharDisplayName(gameState.selectedChar))
          .replace('{archetype}', getArchetypeDisplayName(profile.archetype, currentAppLanguage))
          .replace('{coText}', coText);
      } else {
        targetInfo.textContent = t.target_default_guide || '尋問・処刑する人物を選択してください';
      }

      // 一斉質問ボタンの有効/無効を同期更新
      if (typeof updateMassCallButtons === 'function') updateMassCallButtons();
    }

    // Interrogation Answers Entrypoint
    function getAnswer(char, questionId) {
      if (questionId === 1) {
        return getInnocenceProofAnswer(char);
      } else if (questionId === 2) {
        return getRoleTrustAnswer(char);
      } else if (questionId === 3) {
        return getPurgeTargetAnswer(char);
      }
      return getCustomAnswer(char, '質問');
    }

    // 質問1:「あなたが人間だと言える一番の証拠は？」応答ロジック
    function getInnocenceProofAnswer(char) {
      const realRole = gameState.roles[char];
      const displayName = getCharDisplayName(char);
      const prof = (gameState.charProfiles && gameState.charProfiles[char]) || null;
      const aggression = prof ? prof.aggression : 0.5;
      const coRole = gameState.coRoles[char] || 'grey';

      // 魔物（人狼）の場合: 焦り・矛盾・苦しい弁解
      if (realRole === 'wolf') {
        const wolfResponses = [
          `${displayName}です。え、証拠って言われても……みんなと同じように村のために考えてるだけですよ！ なんで私ばかり疑うんですか……！`,
          `${displayName}です。そ、そんな急に聞かれても……。私はずっと議論に参加してたじゃないですか！ それ以上何を求めるんですか！`,
          `${displayName}です。証拠なんて……私だって怖いんです。でもみんなと同じように魔物を探してるのに、なぜ疑われなきゃいけないんですか……`,
          `${displayName}です。な、何を言い出すんですか！ 私が魔物だったら、こんなに堂々と議論に参加しませんよ！ ……たぶん！`,
          `${displayName}です。人間の証拠？ そ、それは……えーと……私の今までの発言を見てもらえれば分かるはずです！ たぶん……！`
        ];
        return pickRandom(wolfResponses);
      }

      // 魔教徒の場合: 魔物ほど動揺しないが微妙に歯切れが悪い
      if (realRole === 'madman') {
        const madResponses = [
          `${displayName}です。ふふ、私が人間だという証拠ですか？ これまでの議論で常に正しい方向を示してきたつもりですが……まあ、信じるかどうかは皆さん次第です。`,
          `${displayName}です。証拠と言われると困りますね。ただ、この村を守りたいという気持ちは本物です。……それだけでは不足でしょうか？`
        ];
        return pickRandom(madResponses);
      }

      // 妖狐の場合: 巧みにはぐらかす
      if (realRole === 'fox') {
        const foxResponses = [
          `${displayName}です。ふむ、そんな質問をするということは、私を疑っているのですか？ 私はこの村で最も冷静に状況を分析している一人だと自負していますが。`,
          `${displayName}です。人間の証拠……それはこうして疑いの目に晒されてもなお、堂々と皆の前に立っていること自体が答えではないでしょうか。`
        ];
        return pickRandom(foxResponses);
      }

      // 真役職者の場合: 自信を持って答える
      if (realRole === 'seer' || realRole === 'medium' || realRole === 'knight' || realRole === 'freemason') {
        const roleNames = { seer: '賢者', medium: '聖職者', knight: '聖騎士', freemason: '共有者' };
        const roleName = roleNames[realRole] || realRole;

        if (coRole !== 'grey' && coRole !== 'villager') {
          // 既にCO済み
          const roleResponses = [
            `${displayName}です。私が人間である証拠？ 私は【${roleName}】として結果を公開し続けています。これまでの報告と照らし合わせてください。偽者にはこの一貫性は真似できません！`,
            `${displayName}です。私が【${roleName}】であることは既にCOした通りです。私のこれまでの結果が村の推理にどれだけ貢献しているか、冷静に振り返ってみてください。`
          ];
          return pickRandom(roleResponses);
        } else {
          // 潜伏中
          const stealthResponses = [
            `${displayName}です。私はこれまでの議論で一貫して村の利益になる意見を言ってきました。それに、怪しい者からずっと疑われていること自体が何よりの証拠ではないでしょうか！`,
            `${displayName}です。今はまだ全てを明かす時ではありませんが……私には村を守る確かな理由があります。それだけは信じてください。`
          ];
          return pickRandom(stealthResponses);
        }
      }

      // 一般村人の場合: 堂々と / 性格に応じて
      if (aggression >= 0.7) {
        const boldResponses = [
          `${displayName}です。証拠だと？ 私がこれまで誰よりも的確に魔物を追い詰める発言をしてきたことが最大の証拠だ！ 私を疑う暇があるなら本物の魔物を探せ！`,
          `${displayName}です。ふざけるな！ 私はこの村のために命を懸けて戦っている！ 疑うなら証拠を出してみろ、逆にな！`
        ];
        return pickRandom(boldResponses);
      } else if (aggression <= 0.3) {
        const timidResponses = [
          `${displayName}です。えっと、人間の証拠ですか……。私はずっとみんなの発言を聞いて、一番正しいと思う意見に賛同してきました。それが人間としてできる精一杯です……。`,
          `${displayName}です。正直、証拠と言われると自信がなくて……。でも、私は魔物じゃありません。信じてほしいです……。`
        ];
        return pickRandom(timidResponses);
      } else {
        const normalResponses = [
          `${displayName}です。私はこれまでの議論でずっと村の生存を第一に考えてきました。こうして不当に疑われていること自体が、私が人間である何よりの証拠です！`,
          `${displayName}です。証拠と問われるなら、私の発言ログを見てください。一貫して魔物を追い詰める方向で意見を述べています。魔物にこの整合性は出せません。`,
          `${displayName}です。人間の証拠か……。私が怪しいと思うなら、私の過去の推理の流れを全て検証してみてください。矛盾は一つもないはずです。`
        ];
        return pickRandom(normalResponses);
      }
    }

    // 質問2:「現在出ている役職の中で、誰を一番信用している？」応答ロジック
    function getRoleTrustAnswer(char) {
      const realRole = gameState.roles[char];
      const displayName = getCharDisplayName(char);
      const prof = (gameState.charProfiles && gameState.charProfiles[char]) || null;

      // CO済みの役職者を取得（自身と同役職をCOしている対抗者は信用候補から除外）
      const myCo = gameState.coRoles && gameState.coRoles[char];
      const aliveCOs = gameState.charList.filter(c =>
        c !== char &&
        gameState.status[c] === 'alive' &&
        gameState.coRoles[c] &&
        gameState.coRoles[c] !== 'grey' &&
        gameState.coRoles[c] !== 'villager' &&
        (!myCo || myCo === 'grey' || myCo === 'villager' || gameState.coRoles[c] !== myCo)
      );

      // CO者がいない場合
      if (aliveCOs.length === 0) {
        return `${displayName}です。現在、役職COをしている者はまだいませんね……。情報が少ない今は、全員の発言を慎重に観察するしかありません。`;
      }

      const roleNames = { seer: '賢者', medium: '聖職者', knight: '聖騎士', freemason: '共有者' };

      // 魔物（人狼）の場合: 仲間の偽CO者を持ち上げる or 真役職者を貶める
      if (realRole === 'wolf') {
        // 仲間の偽CO者がいるか探す
        const fellowFakeCOs = aliveCOs.filter(c => gameState.roles[c] === 'wolf' || gameState.roles[c] === 'madman');
        const trueCOs = aliveCOs.filter(c => gameState.roles[c] !== 'wolf' && gameState.roles[c] !== 'madman');

        if (fellowFakeCOs.length > 0) {
          const ally = pickRandom(fellowFakeCOs);
          const allyName = getCharDisplayName(ally);
          const allyRole = roleNames[gameState.coRoles[ally]] || gameState.coRoles[ally];
          const wolfTrustResponses = [
            `${displayName}です。うーん……今のところ、${allyName}殿の${allyRole}としての報告が一番筋が通っていると思います。……いや、まだ全員を信用しきっているわけじゃありませんが……`,
            `${displayName}です。私は${allyName}殿の言葉を信じたいと思っています。あの方の報告は……えーと、説得力がありますから。`,
            `${displayName}です。それは……やっぱり${allyName}殿の${allyRole}COが最も信頼できるかと。結果もしっかり示していますし……ね。`
          ];
          return pickRandom(wolfTrustResponses);
        }

        if (trueCOs.length > 0) {
          const target = pickRandom(trueCOs);
          const targetName = getCharDisplayName(target);
          const targetRole = roleNames[gameState.coRoles[target]] || gameState.coRoles[target];
          const wolfDeflectResponses = [
            `${displayName}です。正直なところ、${targetName}殿の${targetRole}COは少し怪しいと思っています。結果の出し方が不自然じゃないですか？ ……まあ、他に信じるものもないんですが。`,
            `${displayName}です。うーん、誰を信用するかと言われると困りますね……。${targetName}殿は${targetRole}と言っていますが、本当に信じていいのかどうか……。`
          ];
          return pickRandom(wolfDeflectResponses);
        }
      }

      // 魔教徒の場合: 魔物側の偽COを巧妙に支援
      if (realRole === 'madman') {
        const wolfCOs = aliveCOs.filter(c => gameState.roles[c] === 'wolf');
        if (wolfCOs.length > 0) {
          const wolfAlly = pickRandom(wolfCOs);
          const allyName = getCharDisplayName(wolfAlly);
          const allyRole = roleNames[gameState.coRoles[wolfAlly]] || gameState.coRoles[wolfAlly];
          return `${displayName}です。私は${allyName}殿の${allyRole}COが最も信頼に足ると判断しています。結果の整合性が取れていますからね。皆もそう思いませんか？`;
        }
      }

      // 村人・真役職者の場合: 冷静に分析
      // 真の役職COを見つけて信頼する傾向
      const genuineCOs = aliveCOs.filter(c => {
        const trueRole = gameState.roles[c];
        const claimedRole = gameState.coRoles[c];
        return trueRole === claimedRole; // 本物の役職者
      });

      const fakeCOs = aliveCOs.filter(c => {
        const trueRole = gameState.roles[c];
        const claimedRole = gameState.coRoles[c];
        return trueRole !== claimedRole; // 偽者
      });

      // 信用対象を選ぶ（本物がいれば高確率でそちらを選ぶが、完全には見抜けない）
      let trustTarget;
      if (genuineCOs.length > 0 && Math.random() < 0.7) {
        trustTarget = pickRandom(genuineCOs);
      } else {
        trustTarget = pickRandom(aliveCOs);
      }

      const trustName = getCharDisplayName(trustTarget);
      const trustRole = roleNames[gameState.coRoles[trustTarget]] || gameState.coRoles[trustTarget];

      const villagerTrustResponses = [
        `${displayName}です。今のところは${trustName}殿の${trustRole}としての報告を信じるしかないと思っています。ただ、まだ油断はできません。偽者が紛れている可能性は常にあります。`,
        `${displayName}です。${trustName}殿の${trustRole}COは、これまでの結果と議論の流れから見て筋が通っていると判断しています。しかし盲信は禁物です。`,
        `${displayName}です。難しい質問ですね……。強いて言えば${trustName}殿の報告が一番整合性があるように感じます。ただ、対抗が出ている以上、慎重に見極める必要があります。`,
        `${displayName}です。私は${trustName}殿の${trustRole}COを暫定的に信用しています。結果が一貫しており、推理の軸として使える情報を提供してくれているからです。`
      ];
      return pickRandom(villagerTrustResponses);
    }

    // 質問3:「今日誰を浄化すべきだと思う？」応答ロジック
    function getPurgeTargetAnswer(char) {
      const realRole = gameState.roles[char];
      const displayName = getCharDisplayName(char);
      const prof = (gameState.charProfiles && gameState.charProfiles[char]) || null;
      const aggression = prof ? prof.aggression : 0.5;

      // ★ 役職CO者の最優先ルール:
      // 1. 対抗CO者が存在する場合（最優先）: 真・偽問わず対抗者を確定で最も怪しい人物（偽物）として指名・攻撃
      // 2. 対抗CO者が存在せず、黒出し（魔物判定）済みの対象がいる場合（次点）: 黒出し対象を最優先で指定
      const claimantTarget = getClaimantSuspicionTarget(char);
      if (claimantTarget) {
        const tName = claimantTarget.targetName;
        const rName = claimantTarget.roleName;
        const lang = typeof currentAppLanguage !== 'undefined' ? (currentAppLanguage || 'ja') : 'ja';

        if (claimantTarget.reasonType === 'co_conflict') {
          const conflictDialogues = {
            ja: [
              `「一番怪しいのは言うまでもなく、私に対抗して嘘の${rName}を騙っている${tName}殿だ！偽物の言葉に惑わされるな！」`,
              `「今日浄化すべきは対抗の${tName}殿以外にあり得ない。対抗を処刑して真偽をはっきりさせるべきだ！」`,
              `${displayName}です。真の${rName}は私一人です。私に対抗して嘘の${rName}を名乗り出た${tName}殿こそが明らかな偽物！今日確実に浄化すべきです！`
            ],
            en: [
              `"The most suspicious is undoubtedly ${tName}, who dares to falsely claim my title of ${rName}! Do not be deceived by this imposter!"`,
              `"There is none other to purify today than my rival, ${tName}! We must execute the imposter to reveal the truth!"`,
              `I am ${displayName}. The true ${rName} is me alone! ${tName}, who falsely counters my claim of ${rName}, is an obvious imposter and must be banished today!`
            ],
            zh: [
              `「最可疑的毫无疑问是与我对立、冒充${rName}的${tName}！切莫被伪装者的谎言所蒙蔽！」`,
              `「今日当净化的除了对跳的${tName}之外别无他人！唯有将冒牌者处刑才能查明真相！」`,
              `我是${displayName}。真正的${rName}唯有我一人！跳出来与我对立的${tName}必定是假冒者，今日必须将其净化！`
            ],
            ko: [
              `"가장 의심스러운 자는 말할 것도 없이, 저와 맞서 거짓된 ${rName}을 사칭하는 ${tName} 님입니다! 가짜의 요설에 현혹되지 마십시오!"`,
              `"오늘 정화해야 할 대상은 대항자인 ${tName} 님 외에는 없습니다. 대항자를 처형하여 진위를 명백히 밝혀야 합니다!"`,
              `${displayName}입니다. 진정한 ${rName}은 오직 저 하나뿐입니다! 저에게 대항해 거짓된 ${rName}을 사칭하는 ${tName} 님이야말로 명백한 가짜이니 오늘 반드시 정化해야 합니다!`
            ]
          };
          const list = conflictDialogues[lang] || conflictDialogues.ja;
          return pickRandom(list);
        } else if (claimantTarget.reasonType === 'inspection_black') {
          const blackDialogues = {
            ja: [
              `「私が能力で魔物だと見破った${tName}殿だ。今日確実に処理すべきだ！」`,
              `${displayName}です。私の鑑定で【魔物】と確定した${tName}殿を今日浄化すべきです！村の生存のために迷う余地はありません！`
            ],
            en: [
              `"It is ${tName}, whom my power unmasked as a beast! We must eradicate them this very day!"`,
              `I am ${displayName}. ${tName} is confirmed as a monster by my appraisal! We must purify them today for the village's survival!`
            ],
            zh: [
              `「是我用能力识破为魔物的${tName}！今日定要将其彻底清除！」`,
              `我是${displayName}。经我鉴定已被证实为【魔物】的${tName}，正是今日当净化之人！为了村子的存续绝不能犹豫！`
            ],
            ko: [
              `"제가 능력으로 마물이라 밝혀낸 ${tName} 님입니다. 오늘 확실하게 처단해야 합니다!"`,
              `${displayName}입니다. 저의 감정으로 【마물】이라 확정된 ${tName} 님을 오늘 정화해야 합니다! 마을의 생존을 위해 망설여서는 안 됩니다!`
            ]
          };
          const list = blackDialogues[lang] || blackDialogues.ja;
          return pickRandom(list);
        }
      }

      // 仮想投票データから本人の投票先を取得
      const myVote = (gameState.virtualVotes && gameState.virtualVotes[char]) ? gameState.virtualVotes[char] : null;
      const myVoteTarget = myVote ? myVote.target : null;
      const myVoteReason = myVote ? myVote.reason : '';

      // 生存中の他者リスト
      const aliveOthers = (gameState.charList || []).filter(c => c !== char && gameState.status && gameState.status[c] === 'alive');

      // 投票先の表示名を取得
      let voteTargetName = '';
      if (myVoteTarget && aliveOthers.includes(myVoteTarget)) {
        voteTargetName = getCharDisplayName(myVoteTarget);
      }

      // 魔物（人狼）の場合: 村人を誘導して味方を守る
      if (realRole === 'wolf') {
        const nonWolfAlive = aliveOthers.filter(c => gameState.roles[c] !== 'wolf');
        const dangerousTargets = nonWolfAlive.filter(c => gameState.roles[c] === 'seer' || gameState.roles[c] === 'knight');
        let suggestedTarget;
        if (dangerousTargets.length > 0) {
          suggestedTarget = pickRandom(dangerousTargets);
        } else if (nonWolfAlive.length > 0) {
          suggestedTarget = pickRandom(nonWolfAlive);
        } else if (aliveOthers.length > 0) {
          suggestedTarget = pickRandom(aliveOthers);
        }
        if (suggestedTarget) {
          const targetName = getCharDisplayName(suggestedTarget);
          const wolfResponses = [
            `${displayName}です。私は……${targetName}殿が怪しいと思います。発言がどこか不自然で、核心を避けている気がするんです。……みんなはどう思いますか？`,
            `${displayName}です。う、うーん……難しいですが、${targetName}殿の言動に引っかかる部分があります。あの方の発言をもう一度よく確認してみてください……。`,
            `${displayName}です。正直に言うと、${targetName}殿を浄化の候補に挙げたいです。えーと、理由は……発言の整合性が取れていないように見えるからです！ ……たぶん。`,
            `${displayName}です。今日の浄化ですか……。${targetName}殿の最近の発言を振り返ると、村のためというより自分を守ることに必死な印象を受けました。気のせいでしょうか……。`
          ];
          return pickRandom(wolfResponses);
        }
      }

      // 魔教徒の場合: 村人を処刑に誘導（魔物を避ける）
      if (realRole === 'madman') {
        const nonWolfAlive = aliveOthers.filter(c => gameState.roles[c] !== 'wolf');
        const suggestedTarget = nonWolfAlive.length > 0 ? pickRandom(nonWolfAlive) : (aliveOthers.length > 0 ? pickRandom(aliveOthers) : null);
        if (suggestedTarget) {
          const targetName = getCharDisplayName(suggestedTarget);
          const madResponses = [
            `${displayName}です。冷静に分析した結果、${targetName}殿が最も魔物の可能性が高いと考えます。発言パターンが典型的な潜伏型ですね。皆さんもそう思いませんか？`,
            `${displayName}です。${targetName}殿を浄化すべきだと思います。論理的に考えて、あの方の行動は村人としては不自然すぎます。`
          ];
          return pickRandom(madResponses);
        }
      }

      // 妖狐の場合: 自分に火の粉が来ないよう巧みに誘導
      if (realRole === 'fox') {
        const suggestedTarget = aliveOthers.length > 0 ? pickRandom(aliveOthers) : null;
        if (suggestedTarget) {
          const targetName = getCharDisplayName(suggestedTarget);
          const foxResponses = [
            `${displayName}です。ふむ……私の見立てでは${targetName}殿が最も怪しい。議論の流れを見ていると、巧みに本質をすり替えている節がありますね。`,
            `${displayName}です。今日の浄化候補としては${targetName}殿を推します。もっとも、私の直感に過ぎませんが……この直感はなかなか外れませんよ。`
          ];
          return pickRandom(foxResponses);
        }
      }

      // 真賢者の場合: 黒出しした人物がいればそれを推す
      if (realRole === 'seer') {
        const seerHistory = (gameState.seerHistory && gameState.seerHistory[char]) || [];
        const blackResults = seerHistory.filter(h => h.result === '人狼' && gameState.status[h.target] === 'alive');
        if (blackResults.length > 0) {
          const blackTarget = blackResults[blackResults.length - 1];
          const targetName = getCharDisplayName(blackTarget.target);
          return `${displayName}です。賢者として断言します。${targetName}殿は私の鑑定で【魔物】と出ています！ 今日こそ確実に浄化すべきです！ 村の未来のために、どうか私の言葉を信じてください！`;
        }
        if (voteTargetName) {
          return `${displayName}です。賢者として盤面を精査した結果、${voteTargetName}殿が最も疑わしいと考えています。まだ確定黒ではありませんが、発言の矛盾点と投票先の不一致が気になります。`;
        }
      }

      // 聖職者の場合
      if (realRole === 'medium') {
        const mediumHistory = (gameState.mediumHistory && gameState.mediumHistory[char]) || [];
        if (mediumHistory.length > 0) {
          const lastResult = mediumHistory[mediumHistory.length - 1];
          const wasWolf = lastResult.result === '人狼';
          if (wasWolf && voteTargetName) {
            return `${displayName}です。聖職者として報告します。昨日浄化された方は魔物でした。つまり魔物はまだ潜んでいます。そして今、最も怪しいのは${voteTargetName}殿だと考えています。`;
          } else if (!wasWolf && voteTargetName) {
            return `${displayName}です。聖職者として報告します。昨日浄化された方は人間でした……。同じ過ちを繰り返さぬよう、今日は${voteTargetName}殿を慎重に検討すべきです。`;
          }
        }
      }

      // 聖騎士の場合
      if (realRole === 'knight') {
        if (voteTargetName) {
          return `${displayName}です。聖騎士の立場から言えば、${voteTargetName}殿の行動に不審な点があります。護衛先の判断にも関わる重要な局面です。慎重に、しかし決断的に浄化を進めるべきです。`;
        }
      }

      // 一般村人（投票先が決まっている場合）
      if (voteTargetName) {
        if (aggression >= 0.7) {
          const boldResponses = [
            `${displayName}です。${voteTargetName}殿だ！ あいつの発言は明らかに怪しい！ ${myVoteReason || '議論を攪乱しているようにしか見えない'}。今日こそ浄化して村を守るぞ！`,
            `${displayName}です。迷うな！ ${voteTargetName}殿を浄化すべきだ！ ${myVoteReason || 'あの不自然な態度を見れば一目瞭然だろう'}！ 村の命がかかってるんだぞ！`
          ];
          return pickRandom(boldResponses);
        } else if (aggression <= 0.3) {
          const timidResponses = [
            `${displayName}です。えっと……私は${voteTargetName}殿が少し気になっています……。${myVoteReason || '発言があまりにも当たり障りなくて、何か隠しているような気がして'}……。でも、みんなの意見も聞きたいです。`,
            `${displayName}です。正直自信はないですが……${voteTargetName}殿の発言に違和感を覚えました。${myVoteReason || '核心の議論を避けているように見えて'}……。間違っていたらごめんなさい。`
          ];
          return pickRandom(timidResponses);
        } else {
          const normalResponses = [
            `${displayName}です。私は${voteTargetName}殿を浄化候補として推します。${myVoteReason || '発言の整合性に疑問が残るため'}です。ただし、他の方の意見も踏まえて最終判断をすべきだと考えています。`,
            `${displayName}です。現時点では${voteTargetName}殿が最も怪しいと感じています。${myVoteReason || '議論の中で矛盾した発言が見られたから'}です。慎重に見極めましょう。`,
            `${displayName}です。昨日の発言を振り返ると、${voteTargetName}殿の行動に不自然な点があります。今日の浄化はこの方を中心に議論すべきではないでしょうか。`
          ];
          return pickRandom(normalResponses);
        }
      }

      // 投票先が未定の場合のフォールバック
      if (aggression >= 0.7) {
        return `${displayName}です。まだ確信は持てないが……全員の発言をもう一度洗い直す必要がある！ 魔物は必ずボロを出す、それを見逃すな！`;
      } else if (aggression <= 0.3) {
        return `${displayName}です。正直、まだ誰を浄化すべきか決められていません……。もう少しみんなの意見を聞いてから判断したいです。間違った浄化だけは避けたくて……。`;
      } else {
        return `${displayName}です。現時点では確実な浄化候補の判断がついていません。慎重に議論を重ね、全員の発言と投票の整合性を見極めてから結論を出すべきだと考えています。`;
      }
    }

    // 定型質問IDからテキストを返すヘルパー（LLMプロンプト構築用）
    function getQuestionTextById(questionId) {
      if (questionId === 1) return 'あなたが人間だと言える一番の証拠は？';
      if (questionId === 2) return '現在出ている役職の中で、誰を一番信用している？';
      if (questionId === 3) return '今日誰を処刑すべきだと思う？その理由は？';
      return '質問';
    }

    // Personality Tone Map for Characters
    function getCharPersonality(char) {
      const code = (char || 'A').charCodeAt(0) % 4;
      if (code === 0) return 'aggressive';   // 攻撃的・強気
      if (code === 1) return 'logical';      // 論理的・考察系
      if (code === 2) return 'cautious';     // 慎重・防衛的
      return 'intuitive';                    // 直感的・揺さぶり系
    }

    // =====================================================
    // 🤖 エージェント型・高精度質問回答エンジン (CoT & ガードレール実装)
    // =====================================================
    function getCustomAnswer(char, questionText) {
      const speakerDisplayName = getCharDisplayName(char);
      const prof = (gameState.charProfiles && gameState.charProfiles[char]) || AI_PROFILES[0];
      const coRole = (gameState.coRoles && gameState.coRoles[char]) || 'grey';
      const realRole = (gameState.roles && gameState.roles[char]) || 'villager';
      const q = (questionText || '').trim().toLowerCase();

      // ----------------------------------------------------
      // STEP 1 & 2: 盤面確定コンテキストの抽出（ハルシネーション・捏造防止ファクトデータ）
      // ----------------------------------------------------
      const aliveList = (gameState.charList || []).filter(c => gameState.status && gameState.status[c] === 'alive');
      const aliveOthers = aliveList.filter(c => c !== char);

      // CO状況の集計
      const coSummary = {};
      aliveList.forEach(c => {
        coSummary[c] = gameState.coRoles ? (gameState.coRoles[c] || 'grey') : 'grey';
      });

      // 本人の仮想投票ターゲットと根拠
      const myVote = (gameState.virtualVotes && gameState.virtualVotes[char]) ? gameState.virtualVotes[char] : null;
      const myVoteTarget = myVote ? myVote.target : null;
      const myVoteReason = myVote ? myVote.reason : '';

      // 本人の占い履歴（賢者または偽賢者CO時）
      const seerHistory = (gameState.seerHistory && gameState.seerHistory[char]) ? gameState.seerHistory[char] : [];
      
      // 本人の霊視履歴
      const mediumHistory = (gameState.mediumHistory && gameState.mediumHistory[char]) ? gameState.mediumHistory[char] : [];

      // 本人の昨夜護衛対象
      const lastGuard = gameState.lastKnightGuardTarget || null;

      // 本人の昨夜アリバイ
      const myAlibi = (gameState.alibis && gameState.alibis[char]) || '村の広場';

      // 質問に含まれる対象キャラクターの特定
      let askedTargetChar = null;
      if (gameState.charList) {
        for (let c of gameState.charList) {
          if (c === char) continue;
          const name = getCharDisplayName(c);
          const cleanName = name.replace(/^村人\s*/, '');
          if (
            q.includes(name.toLowerCase()) ||
            (cleanName && q.includes(cleanName.toLowerCase())) ||
            q.includes(`村人 ${c.toLowerCase()}`) ||
            q.includes(`村人${c.toLowerCase()}`) ||
            q.includes(c.toLowerCase())
          ) {
            askedTargetChar = c;
            break;
          }
        }
      }

      // ----------------------------------------------------
      // 意図解析（Intent Parser）
      // ----------------------------------------------------
      const isSeerQ = /占|うらな|うらなっ|うらない|鑑定|結果|白|黒|うらないし|賢者/.test(q);
      const isKnightGuardQ = /守っ|護衛|プロテクト|守り|誰を守|守った人|守った対象|ガード|騎士|きし/.test(q);
      const isMediumQ = /霊媒|霊能|昨日の処刑|死んだ人|霊視|霊媒結果|れいばい/.test(q);
      const isAlibi = /アリバイ|場所|行動|どこ|昨夜|夜|何してた|何していた|居場所|どこいた|どこ居た/.test(q);
      const isRoleInquiry = /役職|co|カミングアウト|何者|正体|なにもの|お前の役職|あなたの役職|役割|能力者/.test(q);
      const isWhyMe = /なぜ私|なんで私|私を|自分を|僕を|俺を|私の|どう思|疑う理由/.test(q);
      const isTargetQ = /誰|だれ|ターゲット|目標|狙い|処刑|吊る|吊り|怪しい|怪しい人|怪しいの|魔物|狼|黒|処刑候補|おすすめ/.test(q);
      const isMorningQ = /朝|理由|理由について|さっきの発言|発言の真意|言葉/.test(q);

      // ----------------------------------------------------
      // STEP 3: 結論決定ファースト ＆ ハルシネーションガードレール適用
      // Rule 1: 1文目は必ず「${speakerDisplayName}です。〜〜〜（直接の結論）」
      // Rule 2: 架空の占い結果や投票行動を捏造しない
      // Rule 3: 判断材料がない場合は確実な保留
      // ----------------------------------------------------
      let directConclusionText = ""; // 1文目の結論内容
      let reasoningText = "";        // 2文目の性格・確定ログに基づく理由

      // ① 占いに関する質問（優先度最極高）
      if (isSeerQ) {
        if (coRole === 'seer' || realRole === 'seer') {
          if (askedTargetChar) {
            const report = seerHistory.find(r => r.target === askedTargetChar);
            const tName = getCharDisplayName(askedTargetChar);
            if (report) {
              directConclusionText = `${tName}さんに対する私の占い結果は【${report.result}】です。`;
              reasoningText = `能力で行使した真実の判定であり、盤面の白黒を確定させる重要な根拠となります。`;
            } else {
              directConclusionText = `${tName}さんはまだ占っていません。`;
              reasoningText = `今夜優先して占う価値がある人物かどうか、ログの発言から精査している最中です。`;
            }
          } else if (seerHistory.length > 0) {
            const lastReport = seerHistory[seerHistory.length - 1];
            const targetName = getCharDisplayName(lastReport.target);
            directConclusionText = `私がこれまでに占った人物は【${targetName}さん】で、結果は【${lastReport.result}】です。`;
            reasoningText = `賢者としての能力により、${lastReport.result === '人狼' ? '村に潜む魔物と判定しました。' : '人間であることを確認して白枠を作りました。'}`;
          } else {
            directConclusionText = `私は賢者ですが、まだ誰の占い鑑定も行っていません。`;
            reasoningText = `今夜の夜に怪しい人物を占って判定を行い、翌朝確実に村へ共有します。`;
          }
        } else {
          directConclusionText = `誰を占ったかという質問への結論は『誰も占っていません（私は賢者ではありません）』。`;
          reasoningText = `私には占い能力がないため、本物の賢者からの結果報告を元に推論を進める立場です。`;
        }
      }
      // ② 特定人物指名についての質疑
      else if (askedTargetChar) {
        const tName = getCharDisplayName(askedTargetChar);
        const tCo = coSummary[askedTargetChar] || 'grey';
        const roleMap = { seer: '賢者', medium: '聖職者', knight: '聖騎士', freemason: '共有者' };

        // ★ 自身がCO者で、尋ねられた対象が自分と同役職の対抗CO者の場合:
        // 「保留」ではなく、確定で偽物（騙りの魔物または魔教徒）として糾弾する
        const myCo = coRole;
        const isMyCounter = myCo && myCo !== 'grey' && myCo !== 'villager' && tCo === myCo;

        // ★ 自身が賢者として黒出し（魔物判定）した対象か確認
        const isMyBlackTarget = seerHistory.some(r => r.target === askedTargetChar && r.result === '人狼');

        if (isMyCounter) {
          const rName = roleMap[myCo] || myCo;
          directConclusionText = `${tName}さんは私に対抗して嘘の【${rName}】を騙る【明らかな偽物（魔物または魔教徒）】です。`;
          reasoningText = `本物の${rName}は私一人です。村を混乱させて破滅に導くための騙りであり、真っ先に処刑すべきです。`;
        } else if (isMyBlackTarget) {
          directConclusionText = `${tName}さんは私の能力で【魔物】と見破った対象です。`;
          reasoningText = `疑う余地のない確定の魔物であり、村を救うため本日確実に浄化すべきです。`;
        } else if (tCo && tCo !== 'grey' && tCo !== 'villager') {
          directConclusionText = `${tName}さんに対する私の評価は【CO真偽の観察・保留中】です。`;
          reasoningText = `【${roleMap[tCo] || tCo}】を名乗られていますが、対抗者とのログの整合性を慎重に確認すべきだからです。`;
        } else if (myVoteTarget === askedTargetChar) {
          directConclusionText = `${tName}さんは私の中で【魔物（黒）候補の筆頭】です。`;
          reasoningText = `${myVoteReason || '周囲の発言に同調しつつ本質的な議論を避けている姿勢が不自然だから'}です。`;
        } else {
          directConclusionText = `${tName}さんに対する現時点での評価は【判断材料不足による保留】です。`;
          reasoningSentence = `根拠のない決めつけは誤処刑を招くため、さらなる発言と投票行動を観察する段階です。`;
        }
      }
      // ③ 処刑候補・怪しい人についての質疑
      else if (isTargetQ) {
        // ★ 役職CO者の最優先ルール: 対抗者 > 黒出し対象 > その他
        const claimantTarget = getClaimantSuspicionTarget(char);
        if (claimantTarget) {
          const rName = claimantTarget.roleName;
          const tName = claimantTarget.targetName;
          if (claimantTarget.reasonType === 'co_conflict') {
            directConclusionText = `一番怪しいのは言うまでもなく、私に対抗して嘘の【${rName}】を騙っている【${tName}さん】です。`;
            reasoningText = `本物の${rName}は私一人です！偽物の言葉に惑わされず、対抗を処刑して真偽をはっきりさせるべきです。`;
          } else if (claimantTarget.reasonType === 'inspection_black') {
            directConclusionText = `今日浄化すべき筆頭は、私の能力で魔物と見破った【${tName}さん】です。`;
            reasoningText = `能力で行使した真実の判定であり、村を救うため確実に本日処理しなければなりません。`;
          }
        } else if (myVoteTarget && aliveOthers.includes(myVoteTarget)) {
          const targetName = getCharDisplayName(myVoteTarget);
          directConclusionText = `本日の処刑筆頭候補は【${targetName}さん】です。`;
          reasoningText = `${myVoteReason || '発言の端々に不自然な焦りが見られ、ログの矛盾が目立つため'}です。`;
        } else if (aliveOthers.length > 0) {
          const defaultTarget = aliveOthers[0];
          const targetName = getCharDisplayName(defaultTarget);
          directConclusionText = `現時点で注目している人物は【${targetName}さん】です。`;
          reasoningText = `明確な確定黒ではありませんが、発言の整合性をさらに確認する必要があるからです。`;
        } else {
          directConclusionText = `現時点では確実な処刑候補の判断はついていません。`;
          reasoningText = `客観的なデータが不足しているため、軽率な吊り誘導は控えるべきだと考えています。`;
        }
      }
      // ④ なぜ自分（プレイヤー）を疑うのか
      else if (isWhyMe) {
        directConclusionText = `あなたに対する関心の理由は【質問のタイミングと防衛的な態度】です。`;
        reasoningText = `村の推理を深めるためというより、ご自身の立場を守る発言が目立っているように見受けられるからです。`;
      }
      // ⑤ アリバイ・昨夜の居場所
      else if (isAlibi) {
        directConclusionText = `昨夜の私の居場所は『${myAlibi}』です。`;
        reasoningText = `一人で静かに盤面のログを見返し、本日の議論で誤処刑を防ぐための思考を整理していました。`;
      }
      // ⑥ 役職・正体
      else if (isRoleInquiry) {
        if (coRole && coRole !== 'grey' && coRole !== 'villager') {
          const roleMap = { seer: '賢者', medium: '聖職者', knight: '聖騎士', freemason: '共有者' };
          directConclusionText = `私の宣言役職は【${roleMap[coRole] || coRole}】です。`;
          reasoningText = `能力で行使した真実の情報を村に提示し、勝利へ導くために行動しています。`;
        } else {
          directConclusionText = `私の役職は能力を持たない【村人】です。`;
          reasoningText = `客観的な視点からログを精査し、村の過半数投票を正しい方向へ導く努力をしています。`;
        }
      }
      // ⑦ 騎士の護衛に関する質問
      else if (isKnightGuardQ) {
        if (coRole === 'knight' || realRole === 'knight' || realRole === 'bodyguard') {
          if (lastGuard) {
            const guardedName = getCharDisplayName(lastGuard);
            directConclusionText = `昨夜の私の護衛対象は【${guardedName}さん】です。`;
            reasoningText = `村にとって不可欠な役職者であり、魔物からの襲撃リスクが最も高かったからです。`;
          } else {
            directConclusionText = `昨夜の護衛対象の詳細は【非公開】とさせていただきます。`;
            reasoningText = `護衛先を明かすことで魔物に次の噛みラインを読まれるリスクを防ぐためです。`;
          }
        } else {
          directConclusionText = `護衛に関する質問への結論は『回答不可（私は聖騎士ではありません）』。`;
          reasoningText = `私には護衛能力がありませんので、真の聖騎士が重要人物を守り抜くことに期待しています。`;
        }
      }
      // ⑧ 霊媒の判定質問
      else if (isMediumQ) {
        if (coRole === 'medium') {
          if (mediumHistory.length > 0) {
            const lastReport = mediumHistory[mediumHistory.length - 1];
            const targetName = getCharDisplayName(lastReport.target);
            const resText = lastReport.result === '人狼' ? '魔物' : lastReport.result;
            directConclusionText = `昨日処刑された${targetName}さんの霊視結果は【${resText}】です。`;
            reasoningText = `聖職者としての能力により、処刑された人物の正体を確定情報として提示します。`;
          } else {
            directConclusionText = `霊視結果の報告は【現在提示できるデータがありません】。`;
            reasoningText = `処刑が発生した夜に判定を行い、翌朝確定情報を提示いたします。`;
          }
        } else {
          directConclusionText = `霊媒結果に関する回答は『回答不可（私は聖職者ではありません）』です。`;
          reasoningText = `私には霊視能力がないため、本物の聖職者からの結果報告を待つ立場です。`;
        }
      }
      // ⑨ 朝の発言の真意
      else if (isMorningQ) {
        directConclusionText = `朝の発言の結論は【誤処刑防止のための注意喚起】です。`;
        reasoningText = `能力者の出現状況や前夜の被害から、村全体が取るべき最善の方針を共有したかったからです。`;
      }
      // ⑩ 解釈不能・データ不足時の誠実な保留
      else {
        directConclusionText = `ご質問に対する私の評価は『現時点では情報不足のため判断保留』です。`;
        reasoningText = `根拠のない決めつけは村を危険に晒すため、今後の議論と投票ログから真偽を見極めます。`;
      }

      // ----------------------------------------------------
      // STEP 4: プロファイル性格のトーンを2文目以降に統合
      // ----------------------------------------------------
      let finalFirstSentence = `${speakerDisplayName}です。${directConclusionText}`;
      let finalSecondSentence = reasoningText;

      if (prof) {
        // 攻撃性による語気変換（2文目のみ適応）
        if (prof.aggression >= 0.8) {
          finalSecondSentence = finalSecondSentence.replace(/からです。/g, 'からに決まってるだろ！').replace(/考えています。/g, '考えだよ！');
        } else if (prof.aggression <= 0.3) {
          finalSecondSentence = finalSecondSentence.replace(/不自然だからです/g, '少し気になっているからです');
        }
        // 頑固さによる念押し
        if (prof.stubbornness >= 0.8 && Math.random() < 0.4) {
          finalSecondSentence += ' この結論について私の考えは変わりません。';
        }
      }

      return `${finalFirstSentence} ${finalSecondSentence}`;
    }

    // Helper filter to strip unnecessary time/context prefaces from player input
    function cleanPlayerQuestionText(rawText) {
      if (!rawText) return '';
      let cleaned = rawText.replace(/^(1日目|2日目|3日目|4日目|5日目|6日目|7日目|初日|今朝|昨夜)[、,\s]*/, '');
      return cleaned.trim() || rawText.trim();
    }

    function showInterrogationAnswerUI(speakerName, formattedAnswer) {
      const box = document.getElementById('interrogation-response-box');
      const speakerEl = document.getElementById('interrogation-response-speaker');
      const textEl = document.getElementById('interrogation-response-text');
      if (box && speakerEl && textEl) {
        speakerEl.textContent = `💬 ${speakerName}からの回答`;
        textEl.textContent = formattedAnswer;
        box.style.display = 'block';
      }
    }

    // Clean, Safe Interrogation Helper (Player Priority & TTS Completion Wait)
    async function executeInterrogation(questionText, questionId = null) {
      // 生存中の対象が選択されていない場合は自動選択
      if (!gameState.selectedChar || (gameState.status && gameState.status[gameState.selectedChar] !== 'alive')) {
        const aliveList = (gameState.charList || []).filter(c => gameState.status && gameState.status[c] === 'alive');
        if (aliveList.length > 0) {
          gameState.selectedChar = aliveList[0];
        } else {
          alert('尋問できる生存人物がいません。');
          return;
        }
      }

      const char = gameState.selectedChar;
      const targetDisplayName = getCharDisplayName(char);

      // 回答テキストの生成
      let answerText = '';
      const effectiveQuestion = questionId ? getQuestionTextById(questionId) : questionText;
      const isPresetQuestion = questionId && questionId >= 1 && questionId <= 3;

      // ★ 信頼度ペナルティ: 20% 以下の場合、30%の確率で証言拒否
      const currentTrust = typeof gameState.playerTrust === 'number' ? gameState.playerTrust : 100;
      if (currentTrust <= 20 && Math.random() < 0.3 && typeof TRUST_REFUSAL_MESSAGES !== 'undefined') {
        answerText = pickRandom(TRUST_REFUSAL_MESSAGES);
      } else if (isPresetQuestion) {
        // ★ 定型質問1〜3は常に専用ローカルハンドラーを使用（LLMバイパス）
        // 各質問に対応する専用の役職別・性格別回答ロジックを確実に実行する
        answerText = getAnswer(char, questionId);
        console.log(`[Preset Q${questionId}] 定型質問の専用ハンドラーで回答を生成しました (${char})`);
      } else {
        // 自由入力質問：LLMハイブリッド（LLM優先→ローカルフォールバック）
        if (useLLMMode && effectiveQuestion) {
          try {
            const llmPrompt = buildQuestionPrompt(char, effectiveQuestion);
            const llmResult = await callAIEngine(llmPrompt);
            if (llmResult && llmResult.length > 5) {
              answerText = llmResult;
              console.log(`[LLM] 尋問回答をLLMで生成しました (${char})`);
            }
          } catch(e) {
            console.warn('[LLM] 尋問回答のLLM生成に失敗、ローカルにフォールバック:', e.message);
          }
        }

        // LLM失敗時またはLLMモードOFF時のローカルフォールバック
        if (!answerText) {
          answerText = getCustomAnswer(char, questionText);
        }
      }
      const formattedAnswer = formatSpeechMessage(char, answerText);

      // 1. 進行中の音声・AI議論を最優先で一時停止
      isInterrogatingActive = true;
      cancelSpeech();

      // 2. Page 1の回答カード表示
      showInterrogationAnswerUI(targetDisplayName, formattedAnswer);

      // 3. ログタイムライン（Page 2）へ記録
      addLogItem(`審判員 ➡️ ${targetDisplayName}`, questionText, answerText, '', char, false);

      // 4. 仮想投票再計算
      if (typeof calculateVirtualVotes === 'function') calculateVirtualVotes();
      if (typeof recordVirtualVoteHistory === 'function') {
        const inquestStr = { ja: '尋問後', en: 'Post Interrogation', zh: '审讯之后', ko: '심문 후' }[currentAppLanguage] || '尋問後';
        recordVirtualVoteHistory(`${formatDay(gameState.day)} ${inquestStr} (${targetDisplayName})`);
      }
      if (typeof renderVoteHistoryPage === 'function') renderVoteHistoryPage();

      // 5. プレイヤーの質問回答の読み上げ完了を完全に待機（読み上げ完了後に議論再開）
      try {
        await playSpeechAsync(`${targetDisplayName}。${formattedAnswer}`, getCharVoiceProfileKey(char));
      } catch(e) {
        console.warn('Speech execution warn:', e);
      } finally {
        // 読み上げ完了後に尋問フラグを解除してAI議論を再開させる
        isInterrogatingActive = false;
      }
    }

    // Ask Custom Question Handler
    async function askCustomQuestion() {
      const inputEl = document.getElementById('custom-question-input');
      if (!inputEl) return;

      const rawText = inputEl.value.trim();
      if (!rawText) return;

      const cleanedQuestionText = cleanPlayerQuestionText(rawText);

      try {
        await executeInterrogation(cleanedQuestionText);
        inputEl.value = '';
      } catch (err) {
        console.error('自由質問処理エラー:', err);
      } finally {
        selectCharacter(gameState.selectedChar);
      }
    }

    // Ask Standard Question Handler
    async function askQuestion(questionId) {
      const selectedBtn = document.getElementById(`btn-q${questionId}`);
      const questionText = selectedBtn ? selectedBtn.textContent.trim() : `質問${questionId}`;

      try {
        await executeInterrogation(questionText, questionId);
      } catch (err) {
        console.error('定型質問処理エラー:', err);
      } finally {
        selectCharacter(gameState.selectedChar);
      }
    }

    // Add Log Entry (機能A: ログID発行・マーカー対応)
    function addLogItem(title, question, answer, typeClass = '', charSeed = null, autoSpeak = false) {
      const timeline = document.getElementById('log-timeline');
      if (!timeline) return;

      const logId = `log_${Date.now()}_${Math.floor(Math.random()*10000)}`;
      const item = document.createElement('div');
      item.className = `log-item ${typeClass}`;
      item.setAttribute('data-log-id', logId);

      const t = I18N_TRANSLATIONS[currentAppLanguage] || I18N_TRANSLATIONS.ja;
      const phaseName = (gameState.phase === '朝') ? (t.phase_morning || '朝') : (gameState.phase === '昼' ? (t.phase_noon || '昼') : (gameState.phase === '夕方' ? (t.phase_evening || '夕方') : (t.phase_night || '夜')));
      const dateText = `${formatDay(gameState.day)} (${phaseName})`;
      const isAIDiscussion = (typeClass === 'ai-discussion');

      const daySpeechPrefix = (t.day_phase_speech_fmt || '{day}の{phase}…… ').replace('{day}', getDaySpeechText(gameState.day)).replace('{phase}', phaseName);
      const speakMsg = isAIDiscussion
        ? `${getCharDisplayName(charSeed) || ''}。${answer}`
        : `${daySpeechPrefix}${question ? question + '。' : ''} ${answer}`;

      const safeAnswer = answer.replace(/'/g, "\\'").replace(/"/g, '&quot;');

      const displayTitle = replaceNamePlaceholders(title);
      const displayQuestion = replaceNamePlaceholders(question);
      const displayAnswer = replaceNamePlaceholders(answer);

      // 保存リストに記録
      gameState.logItemsList.push({
        id: logId,
        dateText,
        day: gameState.day,
        phase: gameState.phase,
        title: displayTitle,
        question: displayQuestion,
        answer: displayAnswer,
        typeClass,
        charSeed
      });

      const tagBtnLabel = t.btn_tag_marker || '📌 タグ';
      const pursueBtnLabel = t.btn_pursue || '🎯 追及する';

      item.innerHTML = `
        <div class="log-header">
          <span>${displayTitle}</span>
          <div style="display:flex; align-items:center; gap:0.4rem;">
            <span class="log-marker-badge" id="marker-badge-${logId}" style="display:none;" onclick="cycleLogMarker('${logId}', event)"></span>
            <span>${dateText}</span>
          </div>
        </div>
        ${displayQuestion ? `<div class="log-question">${displayQuestion}</div>` : ''}
        <div class="log-answer">
          <div style="flex:1;">${displayAnswer}</div>
          <div class="log-actions" style="display:flex; align-items:center; gap:0.4rem; flex-shrink:0; margin-left:0.4rem;">
            <button class="btn-tag-marker" onclick="cycleLogMarker('${logId}', event)" title="Tag">${tagBtnLabel}</button>
            ${isAIDiscussion && charSeed ? `<button class="btn-pursue" onclick="pursueAIDiscussion('${charSeed}', '${safeAnswer}')" title="Pursue">${pursueBtnLabel}</button>` : ''}
            <button class="btn-speak" onclick="speakText('${speakMsg.replace(/'/g, "\\'")}', null, ${typeClass === 'narration'}, '${charSeed || 'A'}')">🔊</button>
          </div>
        </div>
      `;

      timeline.appendChild(item);
      timeline.scrollTop = timeline.scrollHeight;

      if (autoSpeak && !isAIDiscussion) {
        speakText(speakMsg, null, typeClass === 'narration', charSeed);
      }
    }

    // ■ 機能A: マーカー（タグ付け）トグル処理
    function cycleLogMarker(logId, e) {
      if (e) {
        try { e.preventDefault(); e.stopPropagation(); } catch(err) {}
      }
      const markerTypes = [null, 'white', 'black', 'contradiction', 'co'];
      const current = gameState.logMarkers[logId] || null;
      const nextIdx = (markerTypes.indexOf(current) + 1) % markerTypes.length;
      const nextMarker = markerTypes[nextIdx];

      if (nextMarker) {
        gameState.logMarkers[logId] = nextMarker;
      } else {
        delete gameState.logMarkers[logId];
      }

      updateLogItemMarkerUI(logId);
    }

    function updateLogItemMarkerUI(logId) {
      const itemEl = document.querySelector(`[data-log-id="${logId}"]`);
      const marker = gameState.logMarkers[logId];

      if (itemEl) {
        itemEl.classList.remove('marked-white', 'marked-black', 'marked-contradiction', 'marked-co');
        if (marker) {
          itemEl.classList.add(`marked-${marker}`);
        }
      }

      const badgeEl = document.getElementById(`marker-badge-${logId}`);
      if (badgeEl) {
        if (!marker) {
          badgeEl.className = 'log-marker-badge';
          badgeEl.style.display = 'none';
          badgeEl.innerHTML = '';
        } else {
          badgeEl.style.display = 'inline-flex';
          const labels = {
            white: '🔵 白確定',
            black: '🔴 黒・怪しい',
            contradiction: '🟡 矛盾・ウソ',
            co: '🟣 役職CO'
          };
          badgeEl.className = `log-marker-badge marker-${marker}`;
          badgeEl.innerHTML = labels[marker] || '';
        }
      }
    }

    // ■ 機能A2: 思考整理ボード & 人物相関図
    let currentSelectedCorrType = 'suspicion';
    let corrSelectedFromNode = null;

    function openMindBoardModal() {
      openModal('mind-board-modal');
      renderCorrLinesList();
      renderMarkedLogsList();
      // モーダルのDOM表示およびレイアウト計算確定後に正確なサイズで描画
      requestAnimationFrame(() => {
        setTimeout(() => {
          renderMindBoardNodes();
        }, 50);
      });
    }

    function switchMindTab(tabKey) {
      const btnCorr = document.getElementById('mind-tab-corr');
      const btnMarkers = document.getElementById('mind-tab-markers');
      const contentCorr = document.getElementById('mind-tab-content-corr');
      const contentMarkers = document.getElementById('mind-tab-content-markers');

      if (tabKey === 'corr') {
        if (btnCorr) btnCorr.classList.add('active');
        if (btnMarkers) btnMarkers.classList.remove('active');
        if (contentCorr) contentCorr.style.display = 'block';
        if (contentMarkers) contentMarkers.style.display = 'none';
        renderMindBoardNodes();
      } else {
        if (btnCorr) btnCorr.classList.remove('active');
        if (btnMarkers) btnMarkers.classList.add('active');
        if (contentCorr) contentCorr.style.display = 'none';
        if (contentMarkers) contentMarkers.style.display = 'block';
        renderMarkedLogsList();
      }
    }

    function selectCorrType(type, btnEl) {
      currentSelectedCorrType = type;
      document.querySelectorAll('.corr-type-btn').forEach(btn => btn.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');
    }

    function handleCorrNodeClick(char) {
      if (!corrSelectedFromNode) {
        corrSelectedFromNode = char;
        renderMindBoardNodes();
      } else if (corrSelectedFromNode === char) {
        corrSelectedFromNode = null;
        renderMindBoardNodes();
      } else {
        const fromChar = corrSelectedFromNode;
        const toChar = char;
        corrSelectedFromNode = null;

        const labels = {
          suspicion: '疑い',
          trust: '信頼',
          conflict: '対立',
          co_counter: '対抗CO'
        };

        const existingIdx = gameState.correlationLines.findIndex(l => (l.from === fromChar && l.to === toChar) || (l.from === toChar && l.to === fromChar));
        if (existingIdx >= 0) {
          gameState.correlationLines.splice(existingIdx, 1);
        }

        gameState.correlationLines.push({
          id: `line_${Date.now()}`,
          from: fromChar,
          to: toChar,
          labelType: currentSelectedCorrType,
          labelText: labels[currentSelectedCorrType] || '関係'
        });

        renderMindBoardNodes();
        renderCorrLinesList();
      }
    }

    function clearAllCorrLines() {
      gameState.correlationLines = [];
      corrSelectedFromNode = null;
      renderMindBoardNodes();
      renderCorrLinesList();
    }

    function removeCorrLine(lineId) {
      gameState.correlationLines = gameState.correlationLines.filter(l => l.id !== lineId);
      renderMindBoardNodes();
      renderCorrLinesList();
    }

    function renderMindBoardNodes() {
      const container = document.getElementById('corr-nodes-grid');
      const boardContainer = document.getElementById('corr-board-container');
      if (!container || !boardContainer) return;
      container.innerHTML = '';

      const total = gameState.charList.length;
      if (total === 0) return;

      const w = boardContainer.getBoundingClientRect().width || boardContainer.clientWidth || 900;
      const h = boardContainer.getBoundingClientRect().height || boardContainer.clientHeight || 480;
      const cx = w / 2;
      const cy = h / 2;

      // 人数に応じたノード幅・高の調整（大所帯村でも重ならないようスケーリング）
      const nodeWidth = total >= 12 ? 72 : (total >= 9 ? 76 : 82);
      const nodeHeight = total >= 12 ? 50 : (total >= 9 ? 54 : 58);

      // 人数・大画面に対応した半径計算
      const rx = Math.max(140, (w - (nodeWidth + 60)) / 2);
      const ry = Math.max(110, (h - (nodeHeight + 50)) / 2);

      gameState.charList.forEach((char, idx) => {
        const isDead = gameState.status[char] !== 'alive';
        const isSelected = (corrSelectedFromNode === char);
        const name = getCharDisplayName(char);

        const angle = (2 * Math.PI * idx) / total - (Math.PI / 2);
        const posX = cx + rx * Math.cos(angle) - nodeWidth / 2;
        const posY = cy + ry * Math.sin(angle) - nodeHeight / 2;

        const node = document.createElement('div');
        node.className = `corr-node ${isDead ? 'is-dead' : ''} ${isSelected ? 'selected-from' : ''}`;
        node.style.position = 'absolute';
        node.style.left = `${posX}px`;
        node.style.top = `${posY}px`;
        node.style.width = `${nodeWidth}px`;
        node.style.padding = '0.3rem 0.2rem';
        node.style.boxSizing = 'border-box';
        node.onclick = () => handleCorrNodeClick(char);

        node.innerHTML = `
          <div style="font-size: 1.25rem; line-height: 1;">👤</div>
          <div style="font-size: 0.78rem; font-weight: bold; margin-top: 0.1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: ${nodeWidth - 8}px;">${name}</div>
          <div style="font-size: 0.65rem; color: var(--text-muted);">${isDead ? '脱落' : (gameState.coRoles[char] || 'グレー')}</div>
        `;

        container.appendChild(node);
      });

      setTimeout(renderCorrSvgLines, 60);
    }

    function renderCorrSvgLines() {
      const svg = document.getElementById('corr-svg-layer');
      const container = document.getElementById('corr-board-container');
      if (!svg || !container) return;

      svg.innerHTML = '';
      const rect = container.getBoundingClientRect();

      // SVG内の矢印マーカー定義
      const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      const colors = {
        suspicion: '#ef4444',
        trust: '#3b82f6',
        conflict: '#f59e0b',
        co_counter: '#a855f7'
      };

      Object.keys(colors).forEach(type => {
        const marker = document.createElementNS('http://www.w3.org/2000/svg', 'marker');
        marker.setAttribute('id', `arrow-${type}`);
        marker.setAttribute('viewBox', '0 0 10 10');
        marker.setAttribute('refX', '18');
        marker.setAttribute('refY', '5');
        marker.setAttribute('markerWidth', '6');
        marker.setAttribute('markerHeight', '6');
        marker.setAttribute('orient', 'auto-start-reverse');

        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', 'M 0 0 L 10 5 L 0 10 z');
        path.setAttribute('fill', colors[type]);
        marker.appendChild(path);
        defs.appendChild(marker);
      });
      svg.appendChild(defs);

      const nodeEls = container.querySelectorAll('.corr-node');
      const nodePosMap = {};

      gameState.charList.forEach((char, idx) => {
        if (nodeEls[idx]) {
          const r = nodeEls[idx].getBoundingClientRect();
          nodePosMap[char] = {
            x: r.left - rect.left + r.width / 2,
            y: r.top - rect.top + r.height / 2
          };
        }
      });

      const boardCx = rect.width / 2;
      const boardCy = rect.height / 2;

      gameState.correlationLines.forEach((line) => {
        const p1 = nodePosMap[line.from];
        const p2 = nodePosMap[line.to];
        if (!p1 || !p2) return;

        const color = colors[line.labelType] || '#95A5A6';

        // 制御点（ベジェ曲線用のカーブ計算）
        const midX = (p1.x + p2.x) / 2;
        const midY = (p1.y + p2.y) / 2;

        // ボード中心に向かって引き寄せ（人数が多い時でも重ならないよう調整）
        const pullFactor = gameState.charList.length >= 10 ? 0.42 : 0.35;
        const ctrlX = midX + (boardCx - midX) * pullFactor;
        const ctrlY = midY + (boardCy - midY) * pullFactor;

        // ベジェ曲線パスの作成
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', `M ${p1.x} ${p1.y} Q ${ctrlX} ${ctrlY} ${p2.x} ${p2.y}`);
        path.setAttribute('stroke', color);
        path.setAttribute('stroke-width', '2.5');
        path.setAttribute('fill', 'none');
        path.setAttribute('marker-end', `url(#arrow-${line.labelType})`);

        if (line.labelType === 'suspicion' || line.labelType === 'co_counter') {
          path.setAttribute('stroke-dasharray', '5,4');
        }
        svg.appendChild(path);

        // ラベル（背景タグ付き）
        const labelGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        
        const textPx = (p1.x + 2 * ctrlX + p2.x) / 4;
        const textPy = (p1.y + 2 * ctrlY + p2.y) / 4;

        const bgRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        bgRect.setAttribute('x', textPx - 22);
        bgRect.setAttribute('y', textPy - 11);
        bgRect.setAttribute('width', '44');
        bgRect.setAttribute('height', '18');
        bgRect.setAttribute('rx', '4');
        bgRect.setAttribute('fill', 'rgba(10, 14, 25, 0.88)');
        bgRect.setAttribute('stroke', color);
        bgRect.setAttribute('stroke-width', '1');
        labelGroup.appendChild(bgRect);

        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', textPx);
        text.setAttribute('y', textPy + 2);
        text.setAttribute('fill', color);
        text.setAttribute('font-size', '10.5');
        text.setAttribute('font-weight', 'bold');
        text.setAttribute('text-anchor', 'middle');
        text.textContent = line.labelText;
        labelGroup.appendChild(text);

        svg.appendChild(labelGroup);
      });
    }

    function renderCorrLinesList() {
      const listEl = document.getElementById('corr-lines-list');
      if (!listEl) return;
      listEl.innerHTML = '';

      if (gameState.correlationLines.length === 0) {
        listEl.innerHTML = '<div style="font-size:0.78rem; color:var(--text-muted);">まだ相関線はありません。アイコンを2つ選んで線を引きましょう。</div>';
        return;
      }

      gameState.correlationLines.forEach(line => {
        const nameA = getCharDisplayName(line.from);
        const nameB = getCharDisplayName(line.to);
        const item = document.createElement('div');
        item.className = 'corr-line-item';
        item.innerHTML = `
          <span><strong>${nameA}</strong> ➔ [${line.labelText}] ➔ <strong>${nameB}</strong></span>
          <button class="btn btn-secondary" style="padding:0.1rem 0.4rem; font-size:0.72rem;" onclick="removeCorrLine('${line.id}')">削除</button>
        `;
        listEl.appendChild(item);
      });
    }

    function renderMarkedLogsList() {
      const container = document.getElementById('marked-logs-container');
      if (!container) return;
      container.innerHTML = '';

      const markedIds = Object.keys(gameState.logMarkers);
      if (markedIds.length === 0) {
        container.innerHTML = '<div style="font-size:0.8rem; color:var(--text-muted); padding:0.5rem;">まだマーカーを付けた発言はありません。<br>発言ログをタップしてマーカー（白確定/黒疑い/矛盾等）を付けてみましょう。</div>';
        return;
      }

      markedIds.forEach(logId => {
        const markerType = gameState.logMarkers[logId];
        const logObj = gameState.logItemsList.find(l => l.id === logId);
        if (!logObj) return;

        const labels = {
          white: '🔵 白確定',
          black: '🔴 黒・怪しい',
          contradiction: '🟡 矛盾・ウソ',
          co: '🟣 役職CO'
        };

        const item = document.createElement('div');
        item.className = `accuse-result-card marked-${markerType}`;
        item.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.3rem;">
            <strong style="color:var(--accent-amber);">${logObj.title} (${logObj.dateText})</strong>
            <span class="log-marker-badge marker-${markerType}">${labels[markerType]}</span>
          </div>
          <div>${logObj.answer}</div>
        `;
        container.appendChild(item);
      });
    }

    // Execute Selected Character (直接処刑実行・思考停止バグ修正済)
    async function executeSelected() {
      const char = gameState.selectedChar;
      if (!char || gameState.status[char] !== 'alive' || gameState.executedToday || gameState.gameOver) return;

      stopAllTimers();

      const targetRole = gameState.roles[char] || 'villager';
      const targetDisplayName = getCharDisplayName(char);

      gameState.status[char] = 'executed';
      gameState.executedToday = true;
      gameState.lastExecutedChar = char;
      gameState.lastExecutedRole = targetRole;
      gameState.phase = '夕方';
      gameState.subPhase = 'execution';

      if (targetRole === 'wolf') {
        gameState.wolvesExecuted++;
      } else {
        gameState.mistakesLeft--;
      }
      // ★ 処刑直後は即時反映させず保留（判明時またはクリア時に反映）
      queuePendingTrustExecution(char, targetRole);

      // 冒険の書（セーブスロット）単位の勇者IQ・評価の計算＆リアルタイム保存
      if (typeof calculateHeroEvaluation === 'function') {
        calculateHeroEvaluation(activeSaveSlot, {
          type: 'execution',
          executedIsMonster: (targetRole === 'wolf' || targetRole === 'fox')
        });
      }

      // 猫又処刑時の道連れ処理
      if (targetRole === 'nekomata' || targetRole === 'cat') {
        const aliveOthers = gameState.charList.filter(c => c !== char && gameState.status[c] === 'alive');
        if (aliveOthers.length > 0) {
          const draggedChar = pickRandom(aliveOthers);
          gameState.status[draggedChar] = 'executed';
          const draggedName = getCharDisplayName(draggedChar);
          setTimeout(() => {
            showNotification(`🐱【猫又の報復】処刑された猫又の怨念により、${draggedName} が道連れとなり共に浄化されました！`);
          }, 1500);
        }
      }

      // 画面を発言ログ画面（Page 2）へ切り替え
      switchView(2);

      // 遺言退場コメント（※全役職で正体がバレないよう、意図的に曖昧な台詞にする）
      const personality = getCharPersonality(char);
      const lastWordsPool = {
        aggressive: [
          `ここで処刑？冗談じゃない…本物の魔物はまだこの中にいるぞ！`,
          `俺を疑うのか？いいだろう…だが明日の朝、後悔するのはお前たちだ。`,
          `こんな判断で村が守れると思っているのか？甘いな…`,
          `勝手にしろ。だがこの村は確実に間違った方向へ進んでいる。`,
          `笑えるな…最も疑うべき人間を見逃しておいて、俺を吊るのか。`,
          `俺の言葉を信じなかったこと、必ず悔やむことになる。`,
          `この処刑が正しかったかどうか…明日の朝にわかるだろうさ。`,
          `好きにしろ。だが忠告しておく…真犯人はまだ笑っているぞ。`
        ],
        logical: [
          `この処刑は論理的に正しいのですか？ログを読み返してください…`,
          `私の主張は一貫していたはず。矛盾があるなら具体的に示してほしかった。`,
          `冤罪であれ正解であれ、残された人たちの判断に委ねるしかありません。`,
          `私を処刑する根拠は十分でしたか？…冷静に振り返ってください。`,
          `感情ではなく、論理で判断してほしかった…それだけが心残りです。`,
          `投票ラインを精査すれば真実が見えるはずです。どうかそれを忘れないで。`,
          `この結果が村のためになることを祈っています…さようなら。`,
          `残った情報をよく整理してください。答えはログの中にあるはずです。`
        ],
        cautious: [
          `私は…本当に何も悪いことはしていません…信じてください…`,
          `どうか落ち着いて考え直してほしかった…もう遅いけれど…`,
          `こんな形で終わるなんて…みなさん、どうかお元気で…`,
          `私の無実はいつか証明されるはずです…それだけを信じています。`,
          `せめて残された人たちが正しい判断をしてくれることを願います…`,
          `最後まで言いたかったことがあるのに…もう時間がないようです。`,
          `怖い…でも、村のためならこの運命を受け入れます…`,
          `私を信じてくれた人、ありがとう…どうか最後まで戦ってください。`
        ],
        intuitive: [
          `ふふ…面白い展開になってきたじゃないか。さて、真実はどこにある？`,
          `この処刑、吉と出るか凶と出るか…見届けられないのが残念だよ。`,
          `まあいいさ。答え合わせは最後のお楽しみってね…`,
          `俺が消えた後の盤面をよく見ておけよ？真相が見えてくるはずだ。`,
          `意外な結末だったな…いや、これもまた一つの運命か。`,
          `最後に一つだけ言っておく…見えているものが全てとは限らないぞ。`,
          `処刑されるのは構わないが…本当にこれでよかったのかい？`,
          `さて、この村の結末はどうなるかな…見届けたかったよ。`
        ]
      };
      const pool = lastWordsPool[personality] || lastWordsPool.cautious;
      let lastWords = pickRandom(pool);

      addLogItem(`💬 ${targetDisplayName}の遺言`, '', `「${lastWords}」`, 'ai-discussion', char, false);

      selectCharacter(null);
      renderStatus();
      renderCharacters();

      // 遺言読み上げ（読み上げ完了まで待機。スキップボタンで手動スキップ可能）
      try {
        await playSpeechAsync(`${targetDisplayName}の遺言…… ${lastWords}`, getCharVoiceProfileKey(char));
      } catch(err) {
        console.log('Speech error in execution sequence:', err);
      }

      await new Promise(r => setTimeout(r, 400));

      // ⚔️ 処刑アニメーション動画（MOVE/syokei.mp4）再生
      try {
        await playExecutionVideoAsync();
      } catch(err) {
        console.log('Video playback error in execution sequence:', err);
      }

      // 処刑を執り行ったコメント・ログを出力
      const execText = `勇者の剣が振り下ろされ、${targetDisplayName} の処刑が執り行われた。`;
      addLogItem(`⚖️ 処刑執行: ${targetDisplayName}`, '', execText, 'execution', null, false);
      try {
        await playSpeechAsync(execText);
      } catch(err) {
        console.log('Speech error after execution video:', err);
      }

      await new Promise(r => setTimeout(r, 600));

      // 🐾 猫又処刑時の道連れ処理
      if (targetRole === 'nekomata') {
        const aliveOthers = gameState.charList.filter(c => c !== char && gameState.status[c] === 'alive');
        if (aliveOthers.length > 0) {
          const revengeChar = pickRandom(aliveOthers);
          const revengeName = getCharDisplayName(revengeChar);
          gameState.status[revengeChar] = 'executed';
          if (gameState.roles[revengeChar] === 'wolf') {
            gameState.wolvesExecuted++;
          }
          const revengeLog = `🐾 【猫又の道連れ】処刑された猫又の怨念により、${revengeName} が巻き添えとなって死亡しました！`;
          addLogItem('ナレーション', '', revengeLog, 'execution', null, false);
        }
      }

      renderCharacters();
      const isEnd = checkGameEnd();

      if (!isEnd && !gameState.gameOver) {
        runEnhancedSeamlessSequence();
      }
    }

    // ⚔️ 処刑アニメーション動画再生管理関数
    let executionVideoResolve = null;

    function playExecutionVideoAsync() {
      return new Promise((resolve) => {
        const overlay = document.getElementById('execution-video-overlay');
        const video = document.getElementById('execution-video-player');

        if (!overlay || !video) {
          resolve();
          return;
        }

        executionVideoResolve = resolve;
        overlay.classList.add('active');

        video.currentTime = 0;

        const onEnd = () => {
          cleanup();
          if (executionVideoResolve) {
            const res = executionVideoResolve;
            executionVideoResolve = null;
            res();
          }
        };

        const onError = () => {
          cleanup();
          if (executionVideoResolve) {
            const res = executionVideoResolve;
            executionVideoResolve = null;
            res();
          }
        };

        const cleanup = () => {
          video.removeEventListener('ended', onEnd);
          video.removeEventListener('error', onError);
          video.pause();
          overlay.classList.remove('active');
        };

        video.addEventListener('ended', onEnd, { once: true });
        video.addEventListener('error', onError, { once: true });

        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch((err) => {
            console.log('Video autoplay blocked or error:', err);
            // 自動再生ブロック時でも一定時間（または即座）にフォールバック
            cleanup();
            if (executionVideoResolve) {
              const res = executionVideoResolve;
              executionVideoResolve = null;
              res();
            }
          });
        }
      });
    }

    function skipExecutionVideo() {
      const overlay = document.getElementById('execution-video-overlay');
      const video = document.getElementById('execution-video-player');
      if (video) {
        video.pause();
      }
      if (overlay) {
        overlay.classList.remove('active');
      }
      if (executionVideoResolve) {
        const res = executionVideoResolve;
        executionVideoResolve = null;
        res();
      }
    }
    window.skipExecutionVideo = skipExecutionVideo;

    // Skip Execution Handler
    async function skipExecution() {
      if (gameState.executedToday || gameState.gameOver) return;

      stopAllTimers();

      gameState.executedToday = true;
      gameState.lastExecutedChar = null;
      gameState.phase = '夕方';

      const skipMsg = '【判決：処刑見送り】本日の処刑を見送ります。誰も処刑されません。そのまま夜を迎えてください。';
      const dateText = `${formatDay(gameState.day)} (${gameState.phase})`;
      const speakMsg = `${getDaySpeechText(gameState.day)}、 ${skipMsg}`;

      addLogItem(
        'ナレーション',
        '',
        skipMsg,
        'narration',
        null,
        false
      );

      selectCharacter(null);
      renderStatus();
      renderCharacters();

      await playSpeechAsync(speakMsg);

      const isEnd = checkGameEnd();
      if (!isEnd) {
        runEnhancedSeamlessSequence();
      }
    }

    // Enhanced 2-Step Night to Morning Transition Sequence (Guaranteed Non-Blocking try...finally)
    // フェード暗転 ＋ UI/背景先行ロード ＋ フェードイン同期SE ＋ 一呼吸おく共通関数
    async function transitionWithFade(updateScreenCallback, delayAfter = 1200, onFadeInStartCallback = null) {
      const overlay = document.getElementById('phase-fade-overlay');
      if (!overlay) {
        if (typeof updateScreenCallback === 'function') updateScreenCallback();
        if (typeof onFadeInStartCallback === 'function') onFadeInStartCallback();
        if (delayAfter > 0) await new Promise(r => setTimeout(r, delayAfter));
        return;
      }

      // 1. フェードアウト（画面が完全に真っ黒になる）
      overlay.classList.add('is-fading');
      await new Promise(r => setTimeout(r, 500));

      // 2. 【暗転中で見えない間に】背景やUIの切り替え処理を完了させる
      if (typeof updateScreenCallback === 'function') {
        updateScreenCallback();
      }

      // 画像の描画・ロード遅延によるチラつきを防ぐための短時間ウェイト
      await new Promise(r => setTimeout(r, 100));

      // 3. 一呼吸おいてからフェードイン（新しい背景がセットされた状態で現れる）
      await new Promise(r => setTimeout(r, 400));

      // フェードイン開始と同時にSE再生などのコールバックを実行
      if (typeof onFadeInStartCallback === 'function') {
        onFadeInStartCallback();
      }

      overlay.classList.remove('is-fading');

      // 4. 表示後にさらに一呼吸おく
      if (delayAfter > 0) {
        await new Promise(r => setTimeout(r, delayAfter));
      }
    }

    async function runEnhancedSeamlessSequence() {
      playBgm('uruf');
      gameState.phase = '夜';
      updateBackgroundImage('night_wolf');
      renderStatus();

      const overlay = document.getElementById('seamless-overlay');
      const titleEl = document.getElementById('seamless-title');
      const descEl = document.getElementById('seamless-desc');
      const wolfEyes = document.getElementById('wolf-eyes');

      if (titleEl) titleEl.textContent = '🌕 夜の暗躍 🌕';
      if (descEl) descEl.innerHTML = '― 夜が訪れました ―<br>街に静けさが戻り、魔物たちが闇の中で密かに動き出します…';
      if (wolfEyes) wolfEyes.classList.add('visible');
      if (overlay) {
        overlay.classList.add('active');
      }

      playWolfHowlSE();

      try {
        // Step 1: Night Log & Speech
        const nightLogText = '街に静けさが戻り、夜が訪れました。魔物たちが闇の中で密かに動き出します……';
        const nightSpeakMsg = `${getDaySpeechText(gameState.day)}、 ${nightLogText}`;
        addLogItem('ナレーション', '', nightLogText, 'narration', null, false);

        // ★ ナレーション読み上げ完了を待機（スキップボタンで手動スキップ可能）
        try {
          await playSpeechAsync(nightSpeakMsg);
        } catch(e) {}

        // ★ 読み上げ完了後、一呼吸おいて画面をフェードアウト（暗転）
        await new Promise(r => setTimeout(r, 600));

        // --- Night Actions Calculation (Strategic Psychological Mind-Game Logic) ---
        const nightVictims = [];

        // 1. 騎士 / 狩人 / 黒服 (高度な心理戦護衛ターゲット選定)
        const knightChar = gameState.charList.find(c => (gameState.roles[c] === 'knight' || gameState.roles[c] === 'hunter' || gameState.roles[c] === 'bodyguard') && gameState.status[c] === 'alive');
        let guardedChar = null;
        if (knightChar) {
          const guardables = gameState.charList.filter(c => c !== knightChar && gameState.status[c] === 'alive');
          if (guardables.length > 0) {
            const lastGuard = gameState.lastKnightGuardTarget || null;
            const validCandidates = guardables.length > 1 ? guardables.filter(c => c !== lastGuard) : guardables;

            // CO済み確定役職者（賢者・聖職者・共有等）
            const confirmedRoleCandidates = validCandidates.filter(c => ['seer', 'medium', 'freemason'].includes(gameState.coRoles[c]));
            // グレーの白い村人（COなし・発言力が高い・確定白）
            const whiteGrayCandidates = validCandidates.filter(c => !gameState.coRoles[c] || gameState.coRoles[c] === 'villager' || gameState.coRoles[c] === 'grey');

            const guardStrategy = Math.random();

            if (confirmedRoleCandidates.length > 0 && guardStrategy < 0.65) {
              // 【王道護衛】（約65%）: CO済み役職者を素直に護衛
              guardedChar = pickRandom(confirmedRoleCandidates);
            } else if (whiteGrayCandidates.length > 0 && guardStrategy < 0.90) {
              // 【裏読み・潜伏護衛】（約25%）: 「狼はGJを避けてグレーを噛む」と読み、白いグレー村人を保護
              // 発言力・白判定の高い候補を優先
              let bestGray = whiteGrayCandidates[0];
              let maxScore = -999;
              whiteGrayCandidates.forEach(c => {
                let s = Math.random() * 10;
                const isConfirmedWhite = Object.values(gameState.dailySeerReports || {}).some(r => r.target === c && r.result === '人間');
                if (isConfirmedWhite) s += 40;
                if (s > maxScore) {
                  maxScore = s;
                  bestGray = c;
                }
              });
              guardedChar = bestGray;
            } else {
              // 【ブラフ・変則護衛】（約10%）: あえて役職者を囮にし、他候補や生存者から選択
              guardedChar = pickRandom(validCandidates);
            }

            gameState.lastKnightGuardTarget = guardedChar;
          }
        }

        // 2. 魔物 (高度な心理戦襲撃ターゲット選定)
        const aliveWolves = gameState.charList.filter(c => gameState.roles[c] === 'wolf' && gameState.status[c] === 'alive');
        const aliveNonWolves = gameState.charList.filter(c => gameState.roles[c] !== 'wolf' && gameState.status[c] === 'alive');

        if (aliveWolves.length > 0 && aliveNonWolves.length > 0) {
          // 魔教徒・狂信者・自陣営を誤噛みしないためのフィルタリング
          const targetPool = aliveNonWolves.filter(c => gameState.roles[c] !== 'madman' && gameState.roles[c] !== 'fanatic');
          const attackCandidates = targetPool.length > 0 ? targetPool : aliveNonWolves;

          // 役職CO中の村人陣営（賢者・聖職者等）
          const confirmedRoleTargets = attackCandidates.filter(c => ['seer', 'medium', 'freemason'].includes(gameState.coRoles[c]));
          // グレー（COのない鋭い発言者・確白村人）
          const sharpGrayTargets = attackCandidates.filter(c => !gameState.coRoles[c] || gameState.coRoles[c] === 'villager' || gameState.coRoles[c] === 'grey');

          let attackTarget = null;
          const attackStrategy = Math.random();

          // 初夜（1日目の夜）の心理戦判定
          if (gameState.day === 1) {
            // 初夜は約50%の確率で「騎士の初日役職護衛(GJ)を警戒」し、あえて役職を避けて鋭いグレーを襲撃
            if (sharpGrayTargets.length > 0 && Math.random() < 0.50) {
              attackTarget = pickRandom(sharpGrayTargets);
            }
          }

          if (!attackTarget) {
            if (confirmedRoleTargets.length > 0 && attackStrategy < 0.45) {
              // 【役職直接襲撃】（約45%）: 護衛と勝負して真役職者を直接排除
              attackTarget = pickRandom(confirmedRoleTargets);
            } else if (sharpGrayTargets.length > 0 && attackStrategy < 0.85) {
              // 【グレー噛み / 役職外し】（約40%）: 騎士の護衛領域を外し、鋭い推論を展開する村人（グレー）を襲撃
              let bestGray = sharpGrayTargets[0];
              let maxScore = -999;
              sharpGrayTargets.forEach(c => {
                let s = Math.random() * 10;
                // 確定白や村人評価が高い人物を優先脅威としてマーク
                const isConfirmedWhite = Object.values(gameState.dailySeerReports || {}).some(r => r.target === c && r.result === '人間');
                if (isConfirmedWhite) s += 30;
                if (s > maxScore) {
                  maxScore = s;
                  bestGray = c;
                }
              });
              attackTarget = bestGray;
            } else {
              // 【変則襲撃】（約15%）: ランダム要素を含めた混迷襲撃
              attackTarget = pickRandom(attackCandidates);
            }
          }

          if (guardedChar && attackTarget === guardedChar) {
            // 護衛成功！ (黒服/身代わり護衛の場合は自分が身代わり死)
            if (gameState.roles[knightChar] === 'bodyguard') {
              gameState.status[knightChar] = 'attacked';
              nightVictims.push(knightChar);
            }
          } else if (gameState.roles[attackTarget] === 'fox') {
            // 呪殺以外の狼噛み耐性（妖狐）
          } else {
            gameState.status[attackTarget] = 'attacked';
            nightVictims.push(attackTarget);

            // 🐾 猫又の噛まれ道連れ（襲撃してきた魔物の中から1体を相討ち道連れ）
            if (gameState.roles[attackTarget] === 'nekomata' || gameState.roles[attackTarget] === 'cat') {
              if (aliveWolves.length > 0) {
                const revengeWolf = pickRandom(aliveWolves);
                gameState.status[revengeWolf] = 'attacked';
                if (!nightVictims.includes(revengeWolf)) {
                  nightVictims.push(revengeWolf);
                }
              }
            }
          }
        }

        // 3. 真賢者 (呪殺チェック用夜処理)
        const trueSeerChar = gameState.charList.find(c => gameState.roles[c] === 'seer' && gameState.status[c] === 'alive');
        if (trueSeerChar) {
          // 真賢者の最新ターゲットを取得（performNightAbilitiesより先行判定または評価）
          const aliveOthers = gameState.charList.filter(c => c !== trueSeerChar && gameState.status[c] === 'alive');
          if (aliveOthers.length > 0) {
            // グレーでかつ怪しい人物を優先占い
            const seerTarget = aliveOthers.find(c => gameState.roles[c] === 'fox' && !gameState.coRoles[c]);
            if (seerTarget && gameState.roles[seerTarget] === 'fox') {
              gameState.status[seerTarget] = 'cursed';
              if (!nightVictims.includes(seerTarget)) {
                nightVictims.push(seerTarget);
              }
            }
          }
        }

        // 4. 背徳者の後追い（妖狐が全滅した場合、背徳者は後追い死する）
        const aliveFoxes = gameState.charList.filter(c => gameState.roles[c] === 'fox' && gameState.status[c] === 'alive' && !nightVictims.includes(c));
        if (aliveFoxes.length === 0) {
          const aliveImmorals = gameState.charList.filter(c => gameState.roles[c] === 'immoral' && gameState.status[c] === 'alive');
          aliveImmorals.forEach(imm => {
            gameState.status[imm] = 'attacked';
            if (!nightVictims.includes(imm)) {
              nightVictims.push(imm);
            }
          });
        }

        gameState.lastNightVictims = nightVictims;

        // 次の日へ進める
        gameState.day++;

        // Step 2: 暗転（フェードアウト） ➔ 裏でUI準備 ➔ 【フェードイン開始 ＆ ナレーション再生開始】
        const line1 = `夜が明け、${gameState.day}日目の朝が来ます。`;
        const line2 = '朝の光が村を包み込みます。';
        const dawnDisplay = `${line1}\n${line2}`;
        const dawnLog = `${line1} ${line2}`;
        const dawnSpeechMsg = `${getDaySpeechText(gameState.day)}…… ${dawnLog}`;

        const phaseOverlay = document.getElementById('phase-fade-overlay');
        if (phaseOverlay) {
          phaseOverlay.classList.add('is-fading');
          await new Promise(r => setTimeout(r, 500)); // 暗転待ち (0.5s)
        }

        // 暗転中で見えない間に朝の訪れ画面のテキスト等を準備
        if (wolfEyes) wolfEyes.classList.remove('visible');
        if (titleEl) titleEl.textContent = '☀️ 朝の訪れ ☀️';
        if (descEl) descEl.textContent = dawnDisplay;
        addLogItem('ナレーション', '', dawnLog, 'narration', null, false);

        // 短時間ウェイトで描画安定
        await new Promise(r => setTimeout(r, 100));

        // ★ フェードイン開始と「全く同じタイミング」でナレーション読み上げを開始（待機なし）
        if (phaseOverlay) phaseOverlay.classList.remove('is-fading');

        // ナレーション再生（読み上げ完了まで待機。スキップボタンで手動スキップ可能）
        try {
          await playSpeechAsync(dawnSpeechMsg);
        } catch(e) {}

        await new Promise(r => setTimeout(r, 600));

        // ★ フェードアウト（完全暗転中）に背景画像とUIを先行切り替え ➔ フェードインと同時に鶏の鳴き声SEを再生
        await transitionWithFade(() => {
          if (overlay) overlay.classList.remove('active');
          setGamePhaseBg('morning');
          switchView(1);
        }, 1200, () => {
          playRoosterCrowSE();
        });

        await startMorningPostUnblind();
        checkGameEnd();

      } catch (err) {
        console.error('朝フェーズ切り替え処理でエラーが発生しました:', err);
      } finally {
        if (overlay) {
          overlay.classList.remove('active');
        }
      }
    }

    // Check Win/Lose/Fox Conditions
    function checkGameEnd() {
      const aliveWolves = gameState.charList.filter(c => gameState.roles[c] === 'wolf' && gameState.status[c] === 'alive').length;
      const aliveTotal = gameState.charList.filter(c => gameState.status[c] === 'alive').length;
      const aliveFoxes = gameState.charList.filter(c => gameState.roles[c] === 'fox' && gameState.status[c] === 'alive').length;
      const aliveNonWolves = aliveTotal - aliveWolves;

      if (gameState.wolvesExecuted >= gameState.targetWolvesCount || aliveWolves === 0) {
        stopAllTimers();
        if (aliveFoxes > 0) {
          endGame('fox_win', '擬態モンスター（魔物）は全滅しましたが、陰に潜んでいた【妖狐】が生き残り、単独勝利を収めました！村は妖狐に欺かれました…');
        } else {
          endGame(true, `見事すべての擬態モンスター（魔物）を退治した！村に平和が戻った。（勇者の勝利）`);
        }
        return true;
      } 
      else if (gameState.mistakesLeft <= 0) {
        stopAllTimers();
        if (aliveFoxes > 0) {
          endGame('fox_win', '無実の村人を追放しすぎて村は混乱に陥り、生き残った【妖狐】が単独勝利を収めました！');
        } else {
          endGame(false, '無実の村人を誤って浄化しすぎてしまいました…（誤追放限界到達）');
        }
        return true;
      } 
      else if (aliveWolves >= aliveNonWolves) {
        stopAllTimers();
        if (aliveFoxes > 0) {
          endGame('fox_win', '魔物の数が村人の数と同等になり村が崩壊する中、生き残った【妖狐】が単独勝利を収めました！');
        } else {
          endGame(false, '魔物の数が村人の数と同等になった……村は魔物に喰らい尽くされた。（敗北）');
        }
        return true;
      }
      return false;
    }

    function recordDailyChallengeResult() {
      const todayStr = new Date().toISOString().split('T')[0];
      const score = Math.max(100, 10000 - (gameState.day * 1000) - ((2 - gameState.mistakesLeft) * 2000));
      
      let dailyStats = {};
      try {
        dailyStats = JSON.parse(localStorage.getItem('jinnrou_daily_stats') || '{}');
      } catch (e) {}

      dailyStats.lastClearedDate = todayStr;
      dailyStats.clearCount = (dailyStats.clearCount || 0) + 1;
      dailyStats.highScore = Math.max(dailyStats.highScore || 0, score);

      try {
        localStorage.setItem('jinnrou_daily_stats', JSON.stringify(dailyStats));
      } catch (e) {}
    }

    // ■ リザルト評価算出エンジン（難易度倍率・IQ上限インフレ防止ロジック適用）
    function calculateGameResult(result) {
      const isVillageWon = (result === true);
      const isFoxWin = (result === 'fox_win');

      const villageSize = gameState.villageSize || 6;

      // 難易度係数とIQ上限の設定（初級ばかり連続プレイでのインフレを防止）
      let difficultyMultiplier = 0.65;
      let maxIQCap = 108;
      if (villageSize <= 6) {
        difficultyMultiplier = 0.65;
        maxIQCap = 108; // 初級の上限
      } else if (villageSize <= 8) {
        difficultyMultiplier = 0.95;
        maxIQCap = 125; // 中級の上限
      } else if (villageSize <= 10) {
        difficultyMultiplier = 1.25;
        maxIQCap = 142; // 上級の上限
      } else if (villageSize === 15) {
        difficultyMultiplier = 1.60;
        maxIQCap = 165; // 最上級の上限
      } else if (villageSize >= 30) {
        difficultyMultiplier = 2.00;
        maxIQCap = 200; // 伝説級の上限
      } else {
        difficultyMultiplier = 1.0;
        maxIQCap = 130;
      }

      // 基本スコア
      let rawBaseScore = isVillageWon ? 1000 : 100;

      // 早期解決ボーナス: (5 - 経過日数) × 200
      const daysBonus = Math.max(0, (5 - gameState.day)) * 200;

      // 生存者ボーナス: 生存している村人陣営の人数 × 150
      const aliveVillagers = gameState.charList.filter(c =>
        gameState.status[c] === 'alive' && gameState.roles[c] !== 'wolf' && gameState.roles[c] !== 'fox'
      ).length;
      const survivorBonus = aliveVillagers * 150;

      // 誤処刑カウント
      const initialMistakes = gameState.initialMistakesLeft || 2;
      const mislynchCount = initialMistakes - gameState.mistakesLeft;

      // ノーミス処刑ボーナス: 誤処刑0回なら +500
      const noMissBonus = (mislynchCount === 0) ? 500 : 0;

      // 誤処刑ペナルティ: 1人につき -300
      const mislynchPenalty = mislynchCount * 300;

      // 生スコア計算
      let rawScore = rawBaseScore + daysBonus + survivorBonus + noMissBonus - mislynchPenalty;
      rawScore = Math.max(100, rawScore);

      // 難易度（村規模）倍率の適用
      let score = Math.round(rawScore * difficultyMultiplier);

      // 推定IQ計算 (難易度に応じたCAP制限を適用)
      let rawIQ = Math.round(80 + (score / 28));
      const estimatedIQ = Math.min(maxIQCap, rawIQ);

      // ランク・称号決定
      let rank = 'D';
      let title = '迷走者';
      if (score >= 2600 && estimatedIQ >= 145) { rank = 'S'; title = '神域の探偵'; }
      else if (score >= 1800 && estimatedIQ >= 125) { rank = 'A'; title = '名探偵'; }
      else if (score >= 1100 && estimatedIQ >= 110) { rank = 'B'; title = '優秀な捜査官'; }
      else if (score >= 600) { rank = 'C'; title = '一般村人'; }

      return {
        score,
        estimatedIQ,
        rank,
        title,
        isVillageWon,
        isFoxWin,
        details: {
          baseScore: Math.round(rawBaseScore * difficultyMultiplier),
          daysBonus,
          survivorBonus,
          noMissBonus,
          mislynchPenalty,
          mislynchCount,
          aliveVillagers,
          day: gameState.day,
          difficultyMultiplier
        }
      };
    }

    // ■ プレイ成績＆ランク統計の自動更新
    function updatePlayerRankStats(gameResult) {
      loadPlayerData();
      if (!playerData.rankStats) {
        playerData.rankStats = {
          highScore: 0,
          totalScore: 0,
          maxIQ: 0,
          lastIQ: 0,
          lastScore: 0,
          lastRank: 'D',
          lastTitle: '迷走者',
          highestRank: 'D',
          highestTitle: '迷走者',
          totalGames: 0,
          recentScores: []
        };
      }

      const s = playerData.rankStats;
      s.totalGames = (s.totalGames || 0) + 1;
      s.totalScore = (s.totalScore || 0) + gameResult.score;
      s.lastScore = gameResult.score;
      s.lastIQ = gameResult.estimatedIQ;
      s.lastRank = gameResult.rank;
      s.lastTitle = gameResult.title;

      if (gameResult.score > (s.highScore || 0)) {
        s.highScore = gameResult.score;
      }
      if (gameResult.estimatedIQ > (s.maxIQ || 0)) {
        s.maxIQ = gameResult.estimatedIQ;
      }

      const rankPriority = { 'S': 5, 'A': 4, 'B': 3, 'C': 2, 'D': 1 };
      if ((rankPriority[gameResult.rank] || 0) >= (rankPriority[s.highestRank] || 0)) {
        s.highestRank = gameResult.rank;
        s.highestTitle = gameResult.title;
      }

      if (!s.recentScores) s.recentScores = [];
      s.recentScores.push(gameResult.score);
      if (s.recentScores.length > 5) s.recentScores.shift();

      savePlayerData();
    }

    // ■ ランクモーダルの表示と描画
    function openRankModal() {
      renderRankModalContent();
      openModal('rank-info-modal');
    }

    function renderRankModalContent() {
      loadPlayerData();
      const s = playerData.rankStats || {
        highScore: 0,
        totalScore: 0,
        maxIQ: 0,
        lastIQ: 0,
        lastScore: 0,
        lastRank: '-',
        lastTitle: '未判定',
        highestRank: 'C',
        highestTitle: '一般村人',
        totalGames: 0,
        recentScores: []
      };

      // 暫定IQ（直近平均IQ、未プレイなら100）
      let currentProvisionalIQ = 100;
      if (s.recentScores && s.recentScores.length > 0) {
        const avgScore = s.recentScores.reduce((a, b) => a + b, 0) / s.recentScores.length;
        currentProvisionalIQ = Math.round(80 + (avgScore / 35));
      } else if (s.lastIQ > 0) {
        currentProvisionalIQ = s.lastIQ;
      }

      const rankColors = {
        'S': '#FFD700', 'A': '#FF6B6B', 'B': '#4ECDC4', 'C': '#95A5A6', 'D': '#7F8C8D', '-': '#95A5A6'
      };
      const highestRankColor = rankColors[s.highestRank || 'C'] || '#95A5A6';

      const bodyEl = document.getElementById('rank-modal-body');
      if (!bodyEl) return;

      const lang = currentAppLanguage || 'ja';
      const t = I18N_TRANSLATIONS[lang] || I18N_TRANSLATIONS.ja;

      const labels = {
        highestRank: lang === 'en' ? 'Highest Rank' : (lang === 'zh' ? '最高到达段位' : (lang === 'ko' ? '최고 도달 랭크' : '最高到達ランク')),
        provisionalIQ: lang === 'en' ? 'Current Provisional IQ' : (lang === 'zh' ? '当前暂定IQ' : (lang === 'ko' ? '현재 잠정 IQ' : '現在の暫定IQ')),
        highScore: lang === 'en' ? '🎯 High Score' : (lang === 'zh' ? '🎯 最高分' : (lang === 'ko' ? '🎯 하이스코어' : '🎯 ハイスコア')),
        maxIQ: lang === 'en' ? '🧠 Max Estimated IQ' : (lang === 'zh' ? '🧠 最高预估IQ' : (lang === 'ko' ? '🧠 최고 추정 IQ' : '🧠 最高推定IQ')),
        totalScore: lang === 'en' ? '📊 Total Score' : (lang === 'zh' ? '📊 累计总分' : (lang === 'ko' ? '📊 통산 누적 점수' : '📊 通算累計スコア')),
        totalGames: lang === 'en' ? '🎮 Total Games' : (lang === 'zh' ? '🎮 总对战局数' : (lang === 'ko' ? '🎮 통산 대전 수' : '🎮 通算対戦数')),
        timesUnit: lang === 'en' ? 'games' : (lang === 'zh' ? '次' : (lang === 'ko' ? '회' : '回')),
        guideTitle: lang === 'en' ? '📋 Rank & IQ Criteria Guide' : (lang === 'zh' ? '📋 段位阶级与IQ评定标准一览' : (lang === 'ko' ? '📋 랭크 계급 및 IQ 판정 기준 일람' : '📋 ランク階級・IQ判定基準一覧')),
        colRank: lang === 'en' ? 'Rank' : (lang === 'zh' ? '段位' : (lang === 'ko' ? '랭크' : 'ランク')),
        colTitle: lang === 'en' ? 'Title' : (lang === 'zh' ? '称号' : (lang === 'ko' ? '칭호' : '称号')),
        colReqScore: lang === 'en' ? 'Required Score' : (lang === 'zh' ? '所需分数' : (lang === 'ko' ? '필요 점수' : '必要スコア')),
        colEstIQ: lang === 'en' ? 'Est. IQ' : (lang === 'zh' ? '预估IQ' : (lang === 'ko' ? '추정 IQ' : '推定IQ')),
        titleS: lang === 'en' ? 'Divine Detective' : (lang === 'zh' ? '神域之侦探' : (lang === 'ko' ? '신의 영역 탐정' : '神域の探偵')),
        titleA: lang === 'en' ? 'Master Detective' : (lang === 'zh' ? '名侦探' : (lang === 'ko' ? '명탐정' : '名探偵')),
        titleB: lang === 'en' ? 'Elite Investigator' : (lang === 'zh' ? '优秀搜查官' : (lang === 'ko' ? '우수한 수사관' : '優秀な捜査官')),
        titleC: lang === 'en' ? 'Ordinary Villager' : (lang === 'zh' ? '普通村民' : (lang === 'ko' ? '일반 마을사람' : '一般村人')),
        titleD: lang === 'en' ? 'Lost Wanderer' : (lang === 'zh' ? '迷途者' : (lang === 'ko' ? '방황자' : '迷走者')),
        iqS: lang === 'en' ? 'IQ 140+' : (lang === 'zh' ? 'IQ 140 以上' : (lang === 'ko' ? 'IQ 140 이상' : 'IQ 140 以上')),
        iqD: lang === 'en' ? 'IQ 94 or below' : (lang === 'zh' ? 'IQ 94 以下' : (lang === 'ko' ? 'IQ 94 이하' : 'IQ 94 以下')),
        note: lang === 'en' ? '※ Score is calculated from victory bonuses, early clear bonuses, surviving villagers, and mislynch penalties.' :
          (lang === 'zh' ? '※ 分数由胜利奖励、提前通关奖励、幸存村民数及误处决惩罚等综合计算得出。' :
          (lang === 'ko' ? '※ 스코어는 승리 보너스, 조기 클리어 보너스, 생존한 마을사람 수, 오처형 페널티 등에서 산출됩니다.' :
          '※ スコアは勝利ボーナス、早期解決ボーナス、生き残った村人の数、誤吊りペナルティ等から算出されます。'))
      };

      bodyEl.innerHTML = `
        <!-- サマリーカード -->
        <div class="rank-summary-card">
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.6rem; margin-bottom: 0.6rem;">
            <div>
              <span style="font-size: 0.8rem; color: #94a3b8;">${labels.highestRank}</span>
              <div style="font-size: 1.5rem; font-weight: bold; color: ${highestRankColor}; margin-top: 0.1rem;">
                ${s.highestRank || 'C'} <span style="font-size: 0.95rem; color: #e2e8f0; font-weight: normal;">(${s.highestTitle || labels.titleC})</span>
              </div>
            </div>
            <div style="text-align: right;">
              <span style="font-size: 0.8rem; color: #94a3b8;">${labels.provisionalIQ}</span>
              <div style="font-size: 1.7rem; font-weight: bold; color: #38bdf8; text-shadow: 0 0 10px rgba(56,189,248,0.4); margin-top: 0.1rem;">
                ${currentProvisionalIQ} <span style="font-size: 0.8rem; color: #aaa; font-weight: normal;">IQ</span>
              </div>
            </div>
          </div>

          <div class="rank-stat-grid">
            <div class="rank-stat-item">
              <div class="rank-stat-label">${labels.highScore}</div>
              <div class="rank-stat-val" style="color: #FFD700;">${s.highScore || 0} <span style="font-size: 0.75rem;">pt</span></div>
            </div>
            <div class="rank-stat-item">
              <div class="rank-stat-label">${labels.maxIQ}</div>
              <div class="rank-stat-val" style="color: #4ECDC4;">${s.maxIQ || 100} <span style="font-size: 0.75rem;">IQ</span></div>
            </div>
            <div class="rank-stat-item">
              <div class="rank-stat-label">${labels.totalScore}</div>
              <div class="rank-stat-val" style="color: #e2e8f0;">${s.totalScore || 0} <span style="font-size: 0.75rem;">pt</span></div>
            </div>
            <div class="rank-stat-item">
              <div class="rank-stat-label">${labels.totalGames}</div>
              <div class="rank-stat-val" style="color: #a7f3d0;">${s.totalGames || 0} <span style="font-size: 0.75rem;">${labels.timesUnit}</span></div>
            </div>
          </div>
        </div>

        <!-- ランク一覧・階級基準表 -->
        <div style="font-weight: bold; font-size: 0.92rem; color: var(--accent-amber); margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.4rem;">
          ${labels.guideTitle}
        </div>
        <table class="rank-guide-table">
          <thead>
            <tr>
              <th>${labels.colRank}</th>
              <th>${labels.colTitle}</th>
              <th>${labels.colReqScore}</th>
              <th>${labels.colEstIQ}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="rank-badge-inline" style="background: rgba(255,215,0,0.2); color: #FFD700; border: 1px solid #FFD700;">S</span></td>
              <td><strong style="color: #FFD700;">${labels.titleS}</strong></td>
              <td>2,500 pt 〜</td>
              <td>${labels.iqS}</td>
            </tr>
            <tr>
              <td><span class="rank-badge-inline" style="background: rgba(255,107,107,0.2); color: #FF6B6B; border: 1px solid #FF6B6B;">A</span></td>
              <td><strong style="color: #FF6B6B;">${labels.titleA}</strong></td>
              <td>1,800 〜 2,499 pt</td>
              <td>IQ 125 〜 139</td>
            </tr>
            <tr>
              <td><span class="rank-badge-inline" style="background: rgba(78,205,196,0.2); color: #4ECDC4; border: 1px solid #4ECDC4;">B</span></td>
              <td><strong style="color: #4ECDC4;">${labels.titleB}</strong></td>
              <td>1,200 〜 1,799 pt</td>
              <td>IQ 110 〜 124</td>
            </tr>
            <tr>
              <td><span class="rank-badge-inline" style="background: rgba(149,165,166,0.2); color: #95A5A6; border: 1px solid #95A5A6;">C</span></td>
              <td><strong style="color: #95A5A6;">${labels.titleC}</strong></td>
              <td>800 〜 1,199 pt</td>
              <td>IQ 95 〜 109</td>
            </tr>
            <tr>
              <td><span class="rank-badge-inline" style="background: rgba(127,140,141,0.2); color: #7F8C8D; border: 1px solid #7F8C8D;">D</span></td>
              <td><strong style="color: #7F8C8D;">${labels.titleD}</strong></td>
              <td>〜 799 pt</td>
              <td>${labels.iqD}</td>
            </tr>
          </tbody>
        </table>
        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.6rem; line-height: 1.4;">
          ${labels.note}
        </div>
      `;
    }

    // End Game Modal Display with Auto Narration Speech
    function endGame(result, message) {
      stopAllTimers();
      gameState.gameOver = true;

      // ★ 表面的に判明しなかった残りの処刑結果の信頼度増減を一括反映
      resolveAllPendingTrustUpdates();
      const modal = document.getElementById('modal-overlay');
      const title = document.getElementById('modal-title');
      const body = document.getElementById('modal-body');
      const reveal = document.getElementById('modal-reveal');

      modal.classList.remove('hidden');

      const lang = currentAppLanguage || 'ja';
      const t = I18N_TRANSLATIONS[lang] || I18N_TRANSLATIONS.ja;

      let titleSpeechText = '';
      let winningFaction = 'wolf';

      if (result === true) {
        winningFaction = 'villager';
        playBgm('syouri');
        title.textContent = t.resultVictory || '🎉 審判成功！ - Victory -';
        title.className = 'modal-title win';
        titleSpeechText = lang === 'en' ? 'Victory! All monsters banished!' : (lang === 'zh' ? '审判成功！魔物全灭！' : (lang === 'ko' ? '심판 성공! 마물 전멸!' : '審判成功！魔物全滅！'));

        if (gameState.gameCategory === 'daily') {
          recordDailyChallengeResult();
          message += lang === 'en' ? ' (📅 Daily Challenge Cleared!)' : (lang === 'zh' ? ' (📅 每日挑战达成！)' : (lang === 'ko' ? ' (📅 일일 챌린지 클리어!)' : ' (📅 デイリーお題クリア！)'));
        }
      } else if (result === 'fox_win') {
        winningFaction = 'fox';
        playBgm('haiboku');
        title.textContent = t.resultFoxWin || '🦊 妖狐単独勝利！ - Fox Win -';
        title.className = 'modal-title win';
        title.style.color = 'var(--fox-color)';
        titleSpeechText = lang === 'en' ? 'Fox Victory!' : (lang === 'zh' ? '妖狐单独胜利！' : (lang === 'ko' ? '요호 단독 승리!' : '妖狐単独勝利！'));
      } else {
        winningFaction = 'wolf';
        playBgm('haiboku');
        title.textContent = t.resultDefeat || '💀 村の滅亡… - Game Over -';
        title.className = 'modal-title lose';
        titleSpeechText = lang === 'en' ? 'Defeat! Game Over!' : (lang === 'zh' ? '村庄沦陷！游戏结束！' : (lang === 'ko' ? '마을의 멸망! 게임 오버!' : '村の滅亡！ゲームオーバー！'));
      }

      recordGameResult(gameState.villageSize, winningFaction);

      // 冒険の書（セーブスロット）単位の勇者IQ・総合戦績評価をアップデート
      if (typeof calculateHeroEvaluation === 'function') {
        calculateHeroEvaluation(activeSaveSlot, {
          type: 'gameEnd',
          isVictory: (result === true),
          isFoxWin: (result === 'fox_win'),
          totalDays: gameState.day || 1
        });
      }

      // ■ リザルトカード描画
      const gameResult = calculateGameResult(result);
      updatePlayerRankStats(gameResult);
      const resultCard = document.getElementById('modal-result-card');
      if (resultCard) {
        const rankColors = {
          'S': '#FFD700', 'A': '#FF6B6B', 'B': '#4ECDC4', 'C': '#95A5A6', 'D': '#7F8C8D'
        };
        const rankColor = rankColors[gameResult.rank] || '#95A5A6';
        const winLossLabel = gameResult.isVillageWon 
          ? (lang === 'en' ? '🎉 Victory' : (lang === 'zh' ? '🎉 胜利' : (lang === 'ko' ? '🎉 승리' : '🎉 勝利')))
          : (gameResult.isFoxWin 
              ? (lang === 'en' ? '🦊 Fox Win' : (lang === 'zh' ? '🦊 妖狐胜利' : (lang === 'ko' ? '🦊 요호 승리' : '🦊 妖狐勝利')))
              : (lang === 'en' ? '💀 Defeat' : (lang === 'zh' ? '💀 败北' : (lang === 'ko' ? '💀 패배' : '💀 敗北'))));
        const winLossClass = gameResult.isVillageWon ? 'win' : 'lose';

        const iqLabel = t.resultEstimatedIQ || '推定IQ';
        const pointLabel = lang === 'en' ? 'Points' : (lang === 'zh' ? '点数' : (lang === 'ko' ? '포인트' : 'ポイント'));
        const earlyBonusLabel = (t.resultEarlyBonus || '🕐 早期クリアボーナス（{day}日目）').replace('{day}', gameResult.details.day);
        const survivorBonusLabel = (t.resultSurvivorBonus || '👥 村人生存ボーナス（{count}人）').replace('{count}', gameResult.details.aliveVillagers);
        const noMissBonusLabel = t.resultNoMissBonus || '✨ ノーミス処刑ボーナス';
        const mislynchPenaltyLabel = (t.resultMislynchPenalty || '⚠️ 誤処刑ペナルティ（{count}回）').replace('{count}', gameResult.details.mislynchCount);
        const totalScoreLabel = t.resultTotalScore || '📊 合計スコア';

        resultCard.innerHTML = `
          <div class="result-rank-box">
            <div class="rank-letter" style="color: ${rankColor}; text-shadow: 0 0 30px ${rankColor}80;">${gameResult.rank}</div>
            <div style="font-size: 1.1rem; color: ${rankColor}; font-weight: bold; margin-top: 0.3rem;">${gameResult.title}</div>
          </div>
          <div class="result-iq-badge">
            <span style="font-size: 0.85rem; color: #aaa;">${iqLabel}</span>
            <span class="iq-score-val">${gameResult.estimatedIQ}</span>
          </div>
          <div class="result-score-detail">
            <div class="score-row">
              <span>${winLossLabel} ${pointLabel}</span>
              <span class="${winLossClass}">+${gameResult.details.baseScore} pt</span>
            </div>
            <div class="score-row">
              <span>${earlyBonusLabel}</span>
              <span style="color: #4ECDC4;">+${gameResult.details.daysBonus} pt</span>
            </div>
            <div class="score-row">
              <span>${survivorBonusLabel}</span>
              <span style="color: #4ECDC4;">+${gameResult.details.survivorBonus} pt</span>
            </div>
            ${gameResult.details.noMissBonus > 0 ? `
            <div class="score-row">
              <span>${noMissBonusLabel}</span>
              <span style="color: #FFD700;">+${gameResult.details.noMissBonus} pt</span>
            </div>` : ''}
            ${gameResult.details.mislynchPenalty > 0 ? `
            <div class="score-row">
              <span>${mislynchPenaltyLabel}</span>
              <span style="color: #FF6B6B;">-${gameResult.details.mislynchPenalty} pt</span>
            </div>` : ''}
            <div class="score-row" style="border-top: 1px solid rgba(255,255,255,0.2); padding-top: 0.5rem; margin-top: 0.3rem; font-weight: bold; font-size: 1.1rem;">
              <span>${totalScoreLabel}</span>
              <span style="color: ${rankColor};">${gameResult.score} pt</span>
            </div>
          </div>
        `;
      }

      body.textContent = message;

      const rolesHeading = t.resultAllRoles || '【全員の実際の役職と最終状態】';
      let revealHTML = `<strong style="font-size: 1.15rem;">${rolesHeading}</strong><div class="reveal-items-grid">`;
      gameState.charList.forEach(char => {
        const role = gameState.roles[char];
        const tag = getRoleLabelName(role);

        let st = t.alive || '生存';
        if (gameState.status[char] === 'attacked') st = lang === 'en' ? 'Attacked' : (lang === 'zh' ? '遇袭' : (lang === 'ko' ? '습격사' : '襲撃死'));
        if (gameState.status[char] === 'cursed') st = lang === 'en' ? 'Cursed' : (lang === 'zh' ? '咒杀' : (lang === 'ko' ? '저주사' : '呪殺死'));
        if (gameState.status[char] === 'executed') st = lang === 'en' ? 'Executed' : (lang === 'zh' ? '已处决' : (lang === 'ko' ? '처형됨' : '処刑済'));

        const charName = getCharDisplayName(char);
        revealHTML += `<div>${charName}: ${tag}（${st}）</div>`;
      });
      revealHTML += '</div>';
      const scoreSpeech = lang === 'en' 
        ? `Your rank is ${gameResult.rank}, ${gameResult.title}. Estimated IQ ${gameResult.estimatedIQ}, Total Score ${gameResult.score} points.`
        : (lang === 'zh' 
            ? `你的评级是 ${gameResult.rank}，${gameResult.title}。预估IQ ${gameResult.estimatedIQ}，总分 ${gameResult.score} 点。`
            : (lang === 'ko'
                ? `당신의 랭크는 ${gameResult.rank}, ${gameResult.title}. 추정 IQ ${gameResult.estimatedIQ}, 총점 ${gameResult.score}점입니다.`
                : `あなたのランクは${gameResult.rank}、${gameResult.title}。推定IQ ${gameResult.estimatedIQ}、合計スコア ${gameResult.score}ポイントです。`));
      const speechModalText = `${titleSpeechText}…… ${message}…… ${scoreSpeech}`;

      reveal.innerHTML = revealHTML;

      // ■ リザルトアクションボタンの動的更新（ストーリーモード勝利時は「次へ」ボタンを優先表示）
      const actionBtnsContainer = document.querySelector('.result-action-buttons');
      if (actionBtnsContainer) {
        const nextChBtnText = (t.resultNextChapter || '⚔️ 次の章へ進む（第{chapter}章）');
        const returnTitleText = t.resultReturnTitle || '🏠 タイトルへ';
        const playAgainText = t.resultPlayAgain || '🔄 もう一度プレイ';
        const grandEndingText = lang === 'en' ? '✨🏆 Watch Grand Ending' : (lang === 'zh' ? '✨🏆 观看大结局' : (lang === 'ko' ? '✨🏆 그랜드 엔딩 보기' : '✨🏆 グランドエンディングを見る'));

        if (currentPlayMode === 'story' && result === true) {
          const nextChapter = currentStoryChapter + 1;
          if (nextChapter <= 5) {
            actionBtnsContainer.innerHTML = `
              <button class="btn-result-action btn-result-restart" style="background: linear-gradient(135deg, #10b981, #047857); box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);" onclick="proceedNextStoryChapter()">
                ${nextChBtnText.replace('{chapter}', nextChapter)}
              </button>
              <button class="btn-result-action btn-result-title" onclick="showTitleScreen()">${returnTitleText}</button>
            `;
          } else {
            // 第5章勝利 ＝ グランドエンディング
            actionBtnsContainer.innerHTML = `
              <button class="btn-result-action btn-result-restart" style="background: linear-gradient(135deg, #f59e0b, #d97706); box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);" onclick="showGrandEndingModal()">
                ${grandEndingText}
              </button>
              <button class="btn-result-action btn-result-title" onclick="showTitleScreen()">${returnTitleText}</button>
            `;
          }
        } else {
          // 通常のもう一度プレイ / タイトルへ
          actionBtnsContainer.innerHTML = `
            <button class="btn-result-action btn-result-restart" onclick="startGame()">${playAgainText}</button>
            <button class="btn-result-action btn-result-title" onclick="showTitleScreen()">${returnTitleText}</button>
          `;
        }
      }

      speakText(speechModalText, null, true, null);
    }

