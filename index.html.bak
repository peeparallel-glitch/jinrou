<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <!-- Viewport制御（ピンチイン・アウトによるズームを防止しアプリ感を高める） -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">

  <!-- iOS Safari 用フルスクリーン・Web App設定 -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="審判の勇者">

  <!-- Android / Chrome 用設定 -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#0f141e">

  <!-- Web App Manifest 連携 -->
  <link rel="manifest" href="./manifest.json">

  <title>ぼっち人狼 〜審判の勇者〜</title>
  <style>
    :root {
      --bg-color: #0c0e17;
      --card-bg: #161927;
      --card-border: #262b42;
      --text-main: #e2e8f0;
      --text-muted: #94a3b8;
      --accent-red: #e11d48;
      --accent-red-hover: #f43f5e;
      --accent-blue: #3b82f6;
      --accent-blue-hover: #60a5fa;
      --accent-amber: #f59e0b;
      --accent-green: #10b981;
      --accent-purple: #a855f7;
      --medium-color: #06b6d4;
      --baker-color: #f97316;
      --freemason-color: #34d399;
      --fox-color: #f43f5e;
      --dead-color: #64748b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      touch-action: manipulation;
    }

    html, body {
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      padding-top: env(safe-area-inset-top);
      padding-bottom: env(safe-area-inset-bottom);
      padding-left: env(safe-area-inset-left);
      padding-right: env(safe-area-inset-right);
    }

    /* Screen Management & Game Screen Backgrounds */
    .screen {
      display: flex;
      flex-direction: column;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
    }

    #game-screen {
      display: flex;
      flex-direction: column;
      height: 100vh;
      height: 100dvh;
      max-height: 100dvh;
      overflow: hidden;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      transition: background-image 0.5s ease-in-out;
      background-color: var(--bg-color);
    }

    /* フルスクリーンAPI発動時の高度固定・溢れ防止 */
    :fullscreen #game-screen,
    :-webkit-full-screen #game-screen,
    :-ms-fullscreen #game-screen {
      height: 100vh !important;
      height: 100dvh !important;
      max-height: 100vh !important;
      max-height: 100dvh !important;
      overflow: hidden !important;
    }

    /* --- 朝フェーズ --- */
    #game-screen[data-phase="morning"] {
      background-image: linear-gradient(rgba(10, 12, 20, 0.5), rgba(10, 12, 20, 0.6)), url('./IMG/asa.jpg');
    }
    @media (orientation: portrait) {
      #game-screen[data-phase="morning"] {
        background-image: linear-gradient(rgba(10, 12, 20, 0.5), rgba(10, 12, 20, 0.6)), url('./IMG/asahitate.jpg');
        background-position: center top;
      }
    }

    /* --- 狼の夜のターンフェーズ --- */
    #game-screen[data-phase="night_wolf"],
    #game-screen[data-phase="night"] {
      background-image: linear-gradient(rgba(10, 12, 20, 0.5), rgba(10, 12, 20, 0.6)), url('./IMG/ookamita-n.jpg');
    }
    @media (orientation: portrait) {
      #game-screen[data-phase="night_wolf"],
      #game-screen[data-phase="night"] {
        background-image: linear-gradient(rgba(10, 12, 20, 0.5), rgba(10, 12, 20, 0.6)), url('./IMG/ookamita-n1tate.jpg');
        background-position: center top;
      }
    }

    /* --- 昼フェーズ（3分議論） --- */
    #game-screen[data-phase="day-debate"] {
      background-image: linear-gradient(rgba(10, 12, 20, 0.5), rgba(10, 12, 20, 0.6)), url('./IMG/kaigi1.jpg');
    }
    @media (orientation: portrait) {
      #game-screen[data-phase="day-debate"] {
        background-image: linear-gradient(rgba(10, 12, 20, 0.5), rgba(10, 12, 20, 0.6)), url('./IMG/kyougi2tate.jpg');
        background-position: center top;
      }
    }

    /* --- 処刑決断フェーズ（30秒タイマー） --- */
    #game-screen[data-phase="execution"] {
      background-image: linear-gradient(rgba(15, 8, 12, 0.55), rgba(15, 8, 12, 0.65)), url('./IMG/syokei1.jpg');
    }
    @media (orientation: portrait) {
      #game-screen[data-phase="execution"] {
        background-image: linear-gradient(rgba(15, 8, 12, 0.55), rgba(15, 8, 12, 0.65)), url('./IMG/syokei2tate.jpg');
        background-position: center top;
      }
    }

    .screen.hidden {
      display: none !important;
    }

    /* --- Title Screen --- */
    #title-screen {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 2rem 1.5rem 80px 1.5rem !important;
      background-image: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.55)), url('./IMG/jinnrouyoko.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      text-align: center;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch;
      box-sizing: border-box;
      transition: background-image 0.3s ease-in-out;
    }

    /* --- Splash Screen (Attract Screen) --- */
    #splash-screen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      z-index: 10000;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      padding-bottom: 80px !important;
      background-image: url('./IMG/o-puningu1.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      text-align: center;
      cursor: pointer;
      user-select: none;
      box-sizing: border-box;
      transition: opacity 0.5s ease-in-out;
    }

    #splash-screen.fade-out {
      opacity: 0;
      pointer-events: none;
    }

    /* スマホ・縦長画面用背景設定 */
    @media (max-aspect-ratio: 1/1), (orientation: portrait) {
      #splash-screen {
        background-image: url('./IMG/o-puningu2tate.jpg');
        background-position: center top;
      }
    }

    /* PC・横長画面用背景設定 */
    @media (min-aspect-ratio: 1/1) {
      #splash-screen {
        background-image: url('./IMG/o-puningu1.jpg');
        background-position: center;
      }
    }

    /* スタート画面のタイトルテキストは非表示（画像内にデザイン済み） */
    #splash-screen .splash-title-box,
    #splash-screen .title-text {
      display: none !important;
    }

    .splash-start-text {
      font-family: "Cinzel", "Times New Roman", serif;
      font-size: 1.85rem;
      font-weight: 700;
      letter-spacing: 4px;
      background: linear-gradient(180deg, #ffffff 0%, #fde68a 50%, #d97706 80%, #78350f 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.9)) drop-shadow(0 0 15px rgba(217, 119, 6, 0.7));
      animation: splashBlink 2s infinite ease-in-out;
      margin-bottom: 0;
      cursor: pointer;
    }

    @keyframes splashBlink {
      0%   { opacity: 0.2; transform: scale(0.98); }
      50%  { opacity: 1.0; transform: scale(1.03); }
      100% { opacity: 0.2; transform: scale(0.98); }
    }

    .title-box {
      max-width: 460px;
      width: 100%;
      background: rgba(22, 25, 39, 0.88);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 2px solid var(--card-border);
      border-radius: 16px;
      padding: 2rem 1.5rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    }

    .title-box h1 {
      font-size: 1.8rem;
      letter-spacing: 2px;
      margin-bottom: 0.4rem;
      color: #f8fafc;
    }

    .title-box h1 span {
      font-size: 1.2rem;
      font-weight: normal;
      color: var(--accent-red);
      margin-left: 0.3rem;
      white-space: nowrap;
      display: inline-block;
    }

    .title-subtitle {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
    }

    .mode-select-title {
      font-size: 1rem;
      color: var(--accent-amber);
      margin-bottom: 0.8rem;
      font-weight: bold;
    }

    .mode-buttons {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      margin-bottom: 1.5rem;
    }

    .mode-btn {
      background: #1f2338;
      border: 2px solid var(--card-border);
      border-radius: 10px;
      padding: 0.85rem;
      color: var(--text-main);
      cursor: pointer;
      text-align: left;
      transition: all 0.2s ease;
    }

    .mode-btn.selected {
      border-color: var(--accent-amber);
      background: rgba(245, 158, 11, 0.1);
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.3);
    }

    .mode-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: bold;
      font-size: 0.95rem;
      margin-bottom: 0.2rem;
    }

    .mode-desc {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.3;
    }

    .village-stats-container {
      display: flex;
      gap: 0.4rem;
      margin-top: 0.35rem;
      padding-top: 0.3rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      flex-wrap: wrap;
    }

    .stat-badge {
      font-size: 0.72rem;
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      background: rgba(10, 12, 20, 0.6);
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .stat-badge strong {
      font-weight: bold;
    }

    .stat-badge.villager-win strong { color: #60a5fa; }
    .stat-badge.wolf-win strong { color: #f87171; }
    .stat-badge.fox-win strong { color: #fbbf24; }

    .btn-start-game {
      width: 100%;
      padding: 0.9rem;
      font-size: 1.05rem;
      background: var(--accent-red);
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }

    .title-action-buttons {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-top: 0.8rem;
    }

    .title-sub-buttons {
      display: flex;
      gap: 0.6rem;
    }

    .btn-title-sub {
      flex: 1;
      padding: 0.6rem;
      font-size: 0.85rem;
      background: rgba(37, 42, 63, 0.85);
      color: var(--text-main);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }

    .btn-title-sub:hover {
      background: rgba(59, 130, 246, 0.2);
      border-color: var(--accent-blue);
    }

    /* --- Game Main Screen --- */
    header {
      background-color: #07080e;
      border-bottom: 1px solid var(--card-border);
      padding: 0.6rem 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-shrink: 0;
    }

    header h1 {
      font-size: 1.1rem;
      letter-spacing: 1px;
      color: #f1f5f9;
    }

    header h1 span {
      font-size: 0.85rem;
      font-weight: normal;
      color: var(--accent-red);
      margin-left: 0.2rem;
    }

    .header-buttons {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .btn-header-icon {
      background: #1e2338;
      color: var(--text-main);
      border: 1px solid var(--card-border);
      padding: 0.3rem 0.55rem;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: bold;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      transition: background 0.2s;
    }

    .btn-header-icon:hover {
      background: #2b3250;
      border-color: var(--accent-blue);
    }

    .btn-title-mini {
      background: #252a3f;
      color: var(--text-main);
      border: 1px solid var(--card-border);
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: bold;
      cursor: pointer;
    }

    /* Status Bar */
    .status-bar {
      display: flex;
      justify-content: space-around;
      background: rgba(15, 18, 30, 0.92);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border-bottom: 1px solid var(--card-border);
      padding: 0.4rem 0.5rem;
      font-size: 0.8rem;
      font-weight: bold;
      flex-shrink: 0;
    }

    .status-item span {
      color: var(--accent-amber);
    }

    .timer-display {
      color: var(--accent-red) !important;
      font-weight: bold;
    }

    .timer-display.normal {
      color: var(--accent-amber) !important;
    }

    .timer-display.decision {
      color: #ff3366 !important;
      animation: blinkTimer 1s infinite alternate;
    }

    @keyframes blinkTimer {
      0% { opacity: 1; }
      100% { opacity: 0.6; }
    }

    /* Navigation Bar / View Switcher */
    .nav-bar {
      display: flex;
      background-color: rgba(18, 22, 38, 0.92);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border-bottom: 2px solid var(--card-border);
      flex-shrink: 0;
      width: 100vw;
    }

    .nav-btn {
      flex: 1;
      padding: 0.6rem 0.2rem;
      background: none;
      border: none;
      color: var(--text-muted);
      font-weight: bold;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    }

    /* 1. 仮想投票・疑い度履歴 (シアン・ミントグリーン) */
    #nav-btn-0 {
      color: #2dd4bf;
    }
    #nav-btn-0.active {
      color: #67e8f9;
      border-bottom: 3px solid #06b6d4;
      background: linear-gradient(180deg, rgba(6, 182, 212, 0.05), rgba(6, 182, 212, 0.22));
      text-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
    }

    /* 2. 村人一覧・尋問 (ゴールド・アンバー) */
    #nav-btn-1 {
      color: #fcd34d;
    }
    #nav-btn-1.active {
      color: #fef08a;
      border-bottom: 3px solid #f59e0b;
      background: linear-gradient(180deg, rgba(245, 158, 11, 0.05), rgba(245, 158, 11, 0.22));
      text-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
    }

    /* 3. 発言ログ・確定情報 (パープル・ブルー) */
    #nav-btn-2 {
      color: #a5b4fc;
    }
    #nav-btn-2.active {
      color: #93c5fd;
      border-bottom: 3px solid #3b82f6;
      background: linear-gradient(180deg, rgba(59, 130, 246, 0.05), rgba(59, 130, 246, 0.22));
      text-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
    }

    /* 📌 タグボタン色付けスタイル */
    .btn-tag-marker {
      background: linear-gradient(135deg, #ec4899, #d946ef);
      color: #ffffff !important;
      border: 1px solid #f472b6 !important;
      border-radius: 12px;
      padding: 0.2rem 0.55rem;
      font-size: 0.76rem;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(236, 72, 153, 0.35);
      transition: all 0.2s ease;
    }
    .btn-tag-marker:hover {
      background: linear-gradient(135deg, #f472b6, #ec4899);
      transform: translateY(-1px);
    }

    /* Viewport Area */
    .viewport-area {
      flex: 1;
      width: 100vw;
      overflow: hidden;
      position: relative;
    }

    /* 左右ナビゲーション矢印ボタン */
    .screen-nav-arrow {
      position: absolute;
      top: 48%;
      transform: translateY(-50%);
      z-index: 99;
      width: 44px;
      height: 60px;
      background: rgba(15, 23, 42, 0.65);
      border: 1.5px solid rgba(255, 255, 255, 0.25);
      color: #ffffff;
      font-size: 1.6rem;
      font-weight: bold;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      backdrop-filter: blur(8px);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    }
    .screen-nav-arrow.left {
      left: 6px;
      border-radius: 0 16px 16px 0;
      border-left: none;
    }
    .screen-nav-arrow.right {
      right: 6px;
      border-radius: 16px 0 0 16px;
      border-right: none;
    }
    .screen-nav-arrow:hover {
      background: rgba(30, 41, 59, 0.9);
      border-color: var(--accent-amber);
      color: var(--accent-amber);
      box-shadow: 0 0 16px rgba(245, 158, 11, 0.5);
    }
    .screen-nav-arrow:active {
      transform: translateY(-50%) scale(0.92);
    }
    .screen-nav-arrow.hidden-arrow {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-50%) scale(0.8);
    }

    .carousel-container {
      display: flex;
      width: 300vw;
      height: 100%;
      transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      transform: translateX(0%);
    }

    /* 仮想投票・疑い度履歴スタイル */
    .vote-history-container {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      overflow-y: auto;
      padding-bottom: 2rem;
    }

    .vote-card {
      background: rgba(22, 25, 39, 0.88);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 0.8rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      backdrop-filter: blur(4px);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      width: 100%;
    }

    .vote-card-header {
      font-size: 0.9rem;
      font-weight: bold;
      color: var(--accent-amber);
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 0.4rem;
    }

    .vote-tally-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.4rem;
    }

    .vote-tally-badge {
      background: rgba(245, 158, 11, 0.18);
      border: 1px solid var(--accent-amber);
      color: #fef08a;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: bold;
    }

    .vote-tally-badge.top-target {
      background: rgba(225, 29, 72, 0.25);
      border-color: var(--accent-red);
      color: #fca5a5;
      box-shadow: 0 0 8px rgba(225, 29, 72, 0.4);
    }

    .vote-item-list {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .vote-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(15, 20, 32, 0.6);
      padding: 0.4rem 0.6rem;
      border-radius: 6px;
      font-size: 0.82rem;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .vote-item-row.is-dead-voter {
      opacity: 0.5;
    }

    .voter-name {
      font-weight: bold;
      color: #e2e8f0;
    }

    .vote-target-info {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .vote-arrow {
      color: var(--accent-red);
      font-weight: bold;
    }

    .vote-target-name {
      color: #fca5a5;
      font-weight: bold;
    }

    .suspicion-pct {
      font-size: 0.76rem;
      color: var(--accent-amber);
      background: rgba(245, 158, 11, 0.15);
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
    }

    .view-page {
      width: 100vw;
      height: 100%;
      display: flex;
      flex-direction: column;
      padding: 0.8rem;
      gap: 0.8rem;
      overflow-y: auto;
      flex-shrink: 0;
    }

    /* Page 1: Character List & Interrogation */
    .character-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(95px, 1fr));
      gap: 0.5rem;
      max-height: 290px;
      overflow-y: auto;
      padding-right: 0.2rem;
    }

    .char-card {
      background-color: rgba(22, 25, 39, 0.88);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border: 2px solid var(--card-border);
      border-radius: 8px;
      padding: 0.5rem 0.3rem;
      text-align: center;
      cursor: pointer;
      position: relative;
    }

    .char-card.selected {
      border-color: var(--accent-amber);
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.35);
    }

    .char-card.disabled {
      opacity: 0.7;
      background-color: rgba(16, 18, 28, 0.85);
    }

    /* 脱落・死亡した村人カードのトーンダウン＆赤い❌マークオーバレイ表示 */
    .char-card.is-dead {
      opacity: 0.62;
      filter: grayscale(40%);
      background-color: rgba(35, 12, 18, 0.92) !important;
      border-color: rgba(225, 29, 72, 0.5) !important;
      position: relative;
    }

    .char-card.is-dead::after {
      content: "❌";
      position: absolute;
      top: 42%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 2.2rem;
      color: #ef4444;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9), 0 0 12px rgba(239, 68, 68, 0.7);
      pointer-events: none;
      z-index: 10;
      animation: popCross 0.3s ease-out;
    }

    @keyframes popCross {
      0% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    .char-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background-color: #23273c;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      font-weight: bold;
      margin: 0 auto 0.2rem;
    }

    .char-name {
      font-weight: bold;
      font-size: 0.85rem;
      margin-bottom: 0.15rem;
    }

    .char-co-badge {
      font-size: 0.68rem;
      font-weight: bold;
      padding: 0.1rem 0.25rem;
      border-radius: 6px;
      display: inline-block;
      margin-bottom: 0.15rem;
    }

    .co-grey {
      background-color: rgba(148, 163, 184, 0.15);
      color: var(--text-muted);
      border: 1px solid var(--text-muted);
    }

    .co-seer {
      background-color: rgba(168, 85, 247, 0.15);
      color: var(--accent-purple);
      border: 1px solid var(--accent-purple);
    }

    .co-medium {
      background-color: rgba(6, 182, 212, 0.15);
      color: var(--medium-color);
      border: 1px solid var(--medium-color);
    }

    .co-freemason {
      background-color: rgba(52, 211, 153, 0.15);
      color: var(--freemason-color);
      border: 1px solid var(--freemason-color);
    }

    .char-status {
      font-size: 0.68rem;
      padding: 0.1rem 0.25rem;
      border-radius: 8px;
      background: #1c2033;
      color: var(--text-muted);
      display: block;
    }

    .status-alive { color: var(--accent-green); }

    /* Memo Role Selection Box */
    .memo-select {
      width: 100%;
      margin-top: 0.3rem;
      padding: 0.15rem 0.1rem;
      font-size: 0.68rem;
      font-weight: bold;
      border-radius: 4px;
      outline: none;
      cursor: pointer;
      text-align: center;
      text-align-last: center;
      pointer-events: auto !important;
      transition: all 0.2s ease;
    }

    .memo-none { background-color: #1a1e30; color: var(--text-muted); border: 1px solid var(--card-border); }
    .memo-villager { background-color: rgba(148, 163, 184, 0.25); color: #e2e8f0; border: 1px solid #94a3b8; }
    .memo-wolf { background-color: rgba(225, 29, 72, 0.3); color: #fda4af; border: 1px solid var(--accent-red); font-weight: bold; }
    .memo-seer { background-color: rgba(168, 85, 247, 0.3); color: #e9d5ff; border: 1px solid var(--accent-purple); }
    .memo-medium { background-color: rgba(6, 182, 212, 0.3); color: #a5f3fc; border: 1px solid var(--medium-color); }
    .memo-knight { background-color: rgba(16, 185, 129, 0.3); color: #a7f3d0; border: 1px solid var(--accent-green); }
    .memo-madman { background-color: rgba(244, 63, 94, 0.3); color: #fecdd3; border: 1px solid #f43f5e; }
    .memo-baker { background-color: rgba(249, 115, 22, 0.3); color: #ffedd5; border: 1px solid var(--baker-color); }
    .memo-fox { background-color: rgba(245, 158, 11, 0.3); color: #fef08a; border: 1px solid var(--accent-amber); }
    .status-attacked { background-color: rgba(100, 116, 139, 0.2); color: var(--dead-color); }
    .status-executed { background-color: rgba(245, 158, 11, 0.15); color: var(--accent-amber); }

    /* Interrogation Panel */
    .interrogation-panel {
      background: transparent !important;
      background-color: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0.4rem 0 0 0 !important;
      margin-bottom: 0 !important;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-top: auto;
    }

    .target-info {
      font-size: 0.9rem;
      font-weight: bold;
      color: var(--accent-amber);
    }

    .question-buttons {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .execute-action-row {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.3rem;
    }

    .btn {
      padding: 0.65rem 0.8rem;
      border-radius: 6px;
      border: none;
      font-weight: bold;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .btn-question {
      background-color: #1f2336;
      color: var(--text-main);
      border: 1px solid var(--card-border);
      text-align: left;
      transition: all 0.2s ease-in-out;
    }

    .btn-question.is-active,
    .btn-custom-question.is-active {
      background-color: #d97706 !important;
      color: #ffffff !important;
      border-color: #f59e0b !important;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.6) !important;
      transform: scale(0.97);
      opacity: 1 !important;
    }

    .custom-question-box {
      display: flex;
      gap: 0.4rem;
      margin-top: 0.2rem;
    }

    .custom-question-input {
      flex: 1;
      background-color: #111320;
      border: 1px solid var(--card-border);
      border-radius: 6px;
      padding: 0.55rem 0.7rem;
      color: var(--text-main);
      font-size: 0.82rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .custom-question-input:focus:not(:disabled) {
      border-color: var(--accent-blue);
      box-shadow: 0 0 8px rgba(59, 130, 246, 0.3);
    }

    .custom-question-input:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      background-color: #0d0f19;
    }

    .btn-custom-question {
      background-color: var(--accent-blue);
      color: white;
      white-space: nowrap;
      padding: 0.55rem 0.9rem;
    }

    .btn-custom-question:hover:not(:disabled) {
      background-color: var(--accent-blue-hover);
    }

    .execution-transition-container {
      margin-top: 0.4rem;
      padding-top: 0.3rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      flex-shrink: 0;
    }

    .btn-goto-decision {
      width: 100%;
      background: linear-gradient(135deg, #dc2626, #991b1b);
      color: white;
      font-size: 0.95rem;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      border: none;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(220, 38, 38, 0.45);
      transition: transform 0.15s, background 0.2s, box-shadow 0.2s;
    }

    .btn-goto-decision:hover:not(:disabled) {
      background: linear-gradient(135deg, #ef4444, #b91c1c);
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(239, 68, 68, 0.55);
    }

    .btn-execute {
      flex: 1;
      background-color: var(--accent-red);
      color: white;
    }

    .btn-skip-execute {
      flex: 1;
      background-color: #2b304a;
      color: var(--text-main);
      border: 1px solid var(--card-border);
    }

    .btn-skip-execute:hover:not(:disabled) {
      background-color: #3b4266;
    }

    /* Page 2: Bulletin & Comments & Log Timeline */
    .bulletin-board {
      background-color: rgba(18, 20, 34, 0.92);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 0;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0.8rem;
      cursor: pointer;
      user-select: none;
      -webkit-user-select: none;
      transition: background-color 0.15s;
      border-radius: 8px;
    }

    .card-header:hover {
      background-color: rgba(255, 255, 255, 0.04);
    }

    .card-header:active {
      background-color: rgba(255, 255, 255, 0.08);
    }

    .toggle-icon {
      font-size: 0.72rem;
      font-weight: bold;
      color: var(--accent-amber);
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.3);
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      flex-shrink: 0;
      margin-left: 0.5rem;
      transition: all 0.2s ease;
    }

    .card-header:hover .toggle-icon {
      background: rgba(245, 158, 11, 0.25);
      border-color: var(--accent-amber);
    }

    .card-body {
      padding: 0 0.8rem 0.6rem;
      max-height: 180px;
      overflow-y: auto;
      transition: max-height 0.3s ease, padding 0.3s ease, opacity 0.25s ease;
      opacity: 1;
    }

    .card-body.collapsed {
      max-height: 0 !important;
      padding-top: 0;
      padding-bottom: 0;
      overflow: hidden;
      opacity: 0;
    }

    .bulletin-title {
      font-size: 0.85rem;
      font-weight: bold;
      color: var(--accent-amber);
    }

    .bulletin-list {
      font-size: 0.8rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .bulletin-item {
      padding: 0.3rem 0.5rem;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 4px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .morning-comments-box {
      background-color: rgba(19, 22, 38, 0.92);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 1px solid var(--accent-blue);
      border-radius: 8px;
      padding: 0;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }

    .morning-title {
      font-size: 0.85rem;
      font-weight: bold;
      color: var(--accent-blue);
    }

    .morning-comments-list {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .morning-comment-item {
      font-size: 0.8rem;
      padding: 0.35rem 0.5rem;
      background: rgba(26, 30, 48, 0.9);
      border-radius: 6px;
      border-left: 3px solid var(--accent-blue);
      line-height: 1.35;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .btn-speak {
      background: rgba(59, 130, 246, 0.2);
      border: 1px solid var(--accent-blue);
      color: var(--accent-blue);
      border-radius: 4px;
      padding: 0.15rem 0.4rem;
      font-size: 0.75rem;
      cursor: pointer;
      margin-left: 0.4rem;
      flex-shrink: 0;
    }

    .btn-speak:hover {
      background: var(--accent-blue);
      color: white;
    }

    .log-timeline {
      flex: 1;
      min-height: 200px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .log-item {
      background-color: rgba(17, 19, 32, 0.92);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border-radius: 6px;
      padding: 0.6rem 0.8rem;
      border-left: 3px solid var(--accent-blue);
      font-size: 0.85rem;
    }

    /* Unified Narration Log Style */
    .log-item.narration { border-left-color: var(--accent-amber); background-color: rgba(25, 23, 19, 0.92); }
    .log-item.baker { border-left-color: var(--baker-color); background-color: rgba(40, 24, 15, 0.92); }
    .log-item.execution { border-left-color: var(--accent-amber); background-color: rgba(38, 28, 16, 0.92); }
    .log-item.ai-discussion { border-left-color: #3b82f6; background-color: rgba(15, 23, 42, 0.92); box-shadow: inset 0 0 10px rgba(59, 130, 246, 0.1); }

    .btn-pursue {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(217, 119, 6, 0.35));
      border: 1px solid var(--accent-amber);
      color: #fbbf24;
      border-radius: 4px;
      padding: 0.2rem 0.5rem;
      font-size: 0.75rem;
      font-weight: bold;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
    }
    .btn-pursue:hover {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #ffffff;
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
    }

    .log-header {
      display: flex;
      justify-content: space-between;
      color: var(--text-muted);
      font-size: 0.75rem;
      margin-bottom: 0.3rem;
    }

    .log-question {
      color: var(--accent-amber);
      font-weight: bold;
      margin-bottom: 0.2rem;
      padding-left: 0.4rem;
      border-left: 2px solid var(--accent-amber);
    }

    .log-answer {
      color: var(--text-main);
      line-height: 1.35;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    /* Enhanced Seamless Night Overlay (透過オーバーレイで背景画像を常時表示) */
    .seamless-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      background: linear-gradient(rgba(10, 12, 20, 0.4), rgba(10, 12, 20, 0.55));
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      z-index: 250;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.8s ease-in-out;
      overflow: hidden;
    }

    /* フェーズ切り替え用暗転オーバーレイ */
    .phase-fade-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      background-color: #000000;
      z-index: 9999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s ease-in-out;
    }
    .phase-fade-overlay.is-fading {
      opacity: 1;
      pointer-events: auto;
    }

    .seamless-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }





    .moon-graphic {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #fef08a 0%, #eab308 70%, #ca8a04 100%);
      box-shadow: 0 0 25px rgba(234, 179, 8, 0.6);
      margin-bottom: 1.2rem;
      animation: moonGlow 3s infinite alternate ease-in-out;
    }

    @keyframes moonGlow {
      0% { transform: scale(1) translateY(0); box-shadow: 0 0 20px rgba(234, 179, 8, 0.5); }
      100% { transform: scale(1.05) translateY(-5px); box-shadow: 0 0 35px rgba(234, 179, 8, 0.8); }
    }

    .wolf-eyes-container {
      display: flex;
      gap: 30px;
      margin-bottom: 1rem;
      opacity: 0;
      transition: opacity 1s ease;
    }

    .wolf-eyes-container.visible {
      opacity: 1;
    }

    .wolf-eye {
      width: 12px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--accent-red);
      box-shadow: 0 0 12px var(--accent-red), 0 0 20px #ff0000;
      animation: eyeBlink 3s infinite ease-in-out;
    }

    @keyframes eyeBlink {
      0%, 90%, 100% { opacity: 1; transform: scaleY(1); }
      95% { opacity: 0.1; transform: scaleY(0.1); }
    }

    .seamless-title {
      font-size: 1.6rem;
      letter-spacing: 3px;
      color: var(--accent-purple);
      margin-bottom: 1rem;
      text-shadow: 0 0 15px rgba(168, 85, 247, 0.7);
    }

    .seamless-desc {
      font-size: 0.95rem;
      line-height: 1.6;
      color: #f1f5f9;
      max-width: 340px;
      min-height: 5.5rem;
      white-space: pre-line;
      transition: opacity 0.6s ease;
    }

    /* Modal Overlay & Extended Layout */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 300;
    }

    .modal-overlay.hidden {
      display: none !important;
    }

    .modal-content {
      background-color: #121626;
      border: 2px solid var(--card-border);
      border-radius: 12px;
      padding: 1.2rem;
      max-width: 400px;
      width: 92%;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
      box-sizing: border-box;
      text-align: left;
    }

    .modal-content.modal-large {
      max-width: 560px;
    }

    .modal-content.modal-result {
      max-width: 1150px;
      width: 95%;
      max-height: 92vh;
      overflow-y: auto;
    }

    .result-columns {
      display: flex;
      gap: 1.2rem;
      align-items: flex-start;
    }

    .result-col-left {
      flex: 1.1;
      min-width: 0;
    }

    .result-col-right {
      flex: 1.4;
      min-width: 0;
    }

    .reveal-list {
      text-align: left;
      background: #111320;
      padding: 0.8rem 1rem;
      border-radius: 6px;
      margin: 0.8rem 0;
      font-size: 1.1rem;
      line-height: 1.6;
    }

    .reveal-items-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.3rem 0.8rem;
      margin-top: 0.4rem;
    }

    @media (min-width: 900px) {
      .reveal-items-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1050px) {
      .reveal-items-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      margin-bottom: 0.8rem;
    }

    .modal-header h2 {
      font-size: 1.1rem;
      color: #f1f5f9;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .modal-close-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 1.2rem;
      cursor: pointer;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      transition: color 0.2s;
    }

    .modal-close-btn:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.1);
    }

    .modal-title {
      font-size: 1.5rem;
      margin-bottom: 0.8rem;
      text-align: center;
    }

    .modal-title.win { color: var(--accent-green); }
    .modal-title.lose { color: var(--accent-red); }

    .modal-body {
      overflow-y: auto;
      flex: 1 1 auto;
      text-align: left;
      font-size: 0.88rem;
      line-height: 1.5;
      padding-right: 0.2rem;
    }

    .modal-footer {
      margin-top: 0.8rem;
      padding-top: 0.6rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      justify-content: flex-end;
    }

    /* Result IQ & Rank Card Styling */
    .result-rank-box {
      display: flex;
      align-items: center;
      justify-content: space-around;
      background: linear-gradient(135deg, rgba(20, 26, 45, 0.9), rgba(12, 16, 28, 0.95));
      border: 2px solid var(--accent-amber);
      border-radius: 12px;
      padding: 0.75rem 1rem;
      margin-bottom: 0.8rem;
      box-shadow: 0 4px 15px rgba(245, 158, 11, 0.25);
    }

    .result-rank-badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .rank-letter {
      font-size: 2.8rem;
      font-weight: 900;
      line-height: 1;
      font-family: 'Cinzel', 'Arial Black', sans-serif;
      text-shadow: 0 0 15px currentColor;
    }

    .rank-letter.rank-S { color: #f59e0b; }
    .rank-letter.rank-A { color: #e11d48; }
    .rank-letter.rank-B { color: #3b82f6; }
    .rank-letter.rank-C { color: #10b981; }
    .rank-letter.rank-D { color: #94a3b8; }

    .rank-title-label {
      font-size: 0.85rem;
      font-weight: bold;
      color: var(--text-main);
      margin-top: 0.2rem;
    }

    .result-iq-badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-left: 1px solid rgba(255, 255, 255, 0.12);
      padding-left: 1.2rem;
    }

    .iq-score-val {
      font-size: 1.8rem;
      font-weight: bold;
      color: #38bdf8;
      line-height: 1.1;
      text-shadow: 0 0 10px rgba(56, 189, 248, 0.5);
    }

    .iq-score-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.1rem;
    }

    .result-score-detail {
      background: rgba(15, 20, 32, 0.7);
      border-radius: 8px;
      padding: 0.8rem 1rem;
      margin-bottom: 0.8rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 1.25rem;
    }

    .score-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.4rem 0;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
    }

    .score-row:last-child {
      border-bottom: none;
    }

    .score-row.total-row {
      border-top: 1px solid rgba(245, 158, 11, 0.4);
      margin-top: 0.3rem;
      padding-top: 0.4rem;
      font-weight: bold;
      font-size: 0.92rem;
      color: var(--accent-amber);
    }

    .result-action-buttons {
      display: flex;
      gap: 0.6rem;
      margin-top: 0.8rem;
    }

    /* Rank Info Modal Styling */
    .rank-summary-card {
      background: linear-gradient(135deg, rgba(20, 26, 45, 0.95), rgba(10, 14, 25, 0.98));
      border: 2px solid var(--accent-amber);
      border-radius: 12px;
      padding: 1rem;
      margin-bottom: 1rem;
      box-shadow: 0 4px 20px rgba(245, 158, 11, 0.2);
    }
    .rank-stat-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
      margin-top: 0.8rem;
    }
    .rank-stat-item {
      background: rgba(15, 20, 32, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      padding: 0.6rem 0.8rem;
      text-align: center;
    }
    .rank-stat-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 0.2rem;
    }
    .rank-stat-val {
      font-size: 1.35rem;
      font-weight: bold;
      color: #38bdf8;
    }
    .rank-guide-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 0.6rem;
      font-size: 0.88rem;
    }
    .rank-guide-table th {
      background: rgba(30, 40, 65, 0.8);
      color: var(--accent-amber);
      padding: 0.5rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .rank-guide-table td {
      padding: 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .rank-badge-inline {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      font-weight: bold;
      font-size: 0.82rem;
    }

    .btn-result-action {
      flex: 1;
      padding: 0.7rem;
      font-size: 0.9rem;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
    }

    .btn-result-restart {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
    }

    .btn-result-restart:hover {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      transform: translateY(-1px);
    }

    .btn-result-title {
      background: #252a3f;
      color: var(--text-main);
      border: 1px solid var(--card-border);
    }

    .btn-result-title:hover {
      background: #323854;
    }

    /* =====================================================
       思考整理ボード & 突きつけシステム CSS
       ===================================================== */
    /* マーカーバッジ & ログハイライト */
    .log-item {
      position: relative;
      cursor: pointer;
      transition: background-color 0.2s ease, border-color 0.2s ease;
    }
    .log-item:hover {
      background-color: rgba(255, 255, 255, 0.04);
    }
    .log-marker-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      font-size: 0.72rem;
      font-weight: bold;
      margin-left: 0.4rem;
      cursor: pointer;
    }
    .marker-white {
      background: rgba(59, 130, 246, 0.2);
      border: 1px solid #3b82f6;
      color: #93c5fd;
    }
    .marker-black {
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid #ef4444;
      color: #fca5a5;
    }
    .marker-contradiction {
      background: rgba(245, 158, 11, 0.2);
      border: 1px solid #f59e0b;
      color: #fef08a;
    }
    .marker-co {
      background: rgba(168, 85, 247, 0.2);
      border: 1px solid #a855f7;
      color: #d8b4fe;
    }

    .log-item.marked-white {
      border-left: 3px solid #3b82f6 !important;
      background: rgba(59, 130, 246, 0.08);
    }
    .log-item.marked-black {
      border-left: 3px solid #ef4444 !important;
      background: rgba(239, 68, 68, 0.08);
    }
    .log-item.marked-contradiction {
      border-left: 3px solid #f59e0b !important;
      background: rgba(245, 158, 11, 0.08);
    }
    .log-item.marked-co {
      border-left: 3px solid #a855f7 !important;
      background: rgba(168, 85, 247, 0.08);
    }

    /* 相関図ツールバー & ボード */
    .corr-tool-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      background: rgba(15, 20, 32, 0.7);
      padding: 0.5rem 0.8rem;
      border-radius: 8px;
      margin-bottom: 0.8rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 0.82rem;
    }
    .corr-type-btn {
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      border: 1px solid transparent;
      background: rgba(255, 255, 255, 0.06);
      transition: all 0.2s ease;
    }
    .corr-type-btn.active {
      border-color: var(--accent-amber);
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.4);
      background: rgba(245, 158, 11, 0.15);
    }

    .corr-board-container {
      position: relative;
      width: 100%;
      height: 480px;
      min-height: 400px;
      background: rgba(10, 14, 25, 0.95);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      padding: 0;
    }
    .corr-svg-layer {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }
    .corr-nodes-grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
    }
    .corr-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0.5rem;
      border-radius: 10px;
      background: rgba(22, 28, 45, 0.9);
      border: 2px solid rgba(255, 255, 255, 0.15);
      cursor: pointer;
      user-select: none;
      transition: all 0.2s ease;
      min-width: 75px;
    }
    .corr-node:hover {
      border-color: var(--accent-amber);
      transform: scale(1.05);
    }
    .corr-node.selected-from {
      border-color: #38bdf8;
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.6);
      background: rgba(56, 189, 248, 0.2);
    }
    .corr-node.is-dead {
      opacity: 0.4;
      filter: grayscale(80%);
    }

    .corr-lines-list {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      max-height: 150px;
      overflow-y: auto;
    }
    .corr-line-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(15, 20, 32, 0.7);
      padding: 0.35rem 0.6rem;
      border-radius: 6px;
      font-size: 0.8rem;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* 突きつけ処刑モーダル */
    .accuse-section {
      background: rgba(15, 20, 32, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      padding: 0.8rem;
      margin-bottom: 0.8rem;
    }
    .accuse-step-title {
      font-size: 0.9rem;
      font-weight: bold;
      color: var(--accent-amber);
      margin-bottom: 0.5rem;
    }
    .accuse-target-card {
      background: rgba(225, 29, 72, 0.15);
      border: 1px solid var(--accent-red);
      padding: 0.6rem;
      border-radius: 6px;
      font-size: 1.05rem;
    }
    .accuse-reason-options {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .reason-radio-item {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      background: rgba(20, 26, 42, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.6rem 0.8rem;
      border-radius: 6px;
      cursor: pointer;
      transition: border-color 0.2s ease;
    }
    .reason-radio-item:hover, .reason-radio-item:has(input:checked) {
      border-color: var(--accent-amber);
      background: rgba(245, 158, 11, 0.1);
    }
    .reason-title {
      font-weight: bold;
      font-size: 0.88rem;
      color: #fef08a;
      display: block;
    }
    .reason-desc {
      font-size: 0.76rem;
      color: var(--text-muted);
    }
    .accuse-evidence-list {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      max-height: 200px;
      overflow-y: auto;
    }
    .evidence-item-card {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      background: rgba(10, 14, 25, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.5rem;
      border-radius: 6px;
      font-size: 0.8rem;
      cursor: pointer;
    }

    /* 突きつけリザルトカード & カードアニメーション */
    .accuse-result-card {
      background: linear-gradient(135deg, rgba(20, 26, 45, 0.95), rgba(12, 16, 28, 0.95));
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      padding: 0.7rem;
      margin-bottom: 0.6rem;
      font-size: 0.85rem;
    }
    .accuse-eval-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      font-weight: bold;
      font-size: 0.82rem;
    }
    .eval-ronpa {
      background: rgba(34, 197, 94, 0.25);
      border: 1px solid #22c55e;
      color: #86efac;
    }
    .eval-enzyai {
      background: rgba(239, 68, 68, 0.25);
      border: 1px solid #ef4444;
      color: #fca5a5;
    }

    /* Setting Items Styling */
    .setting-item {
      margin-bottom: 1rem;
      background: rgba(20, 24, 40, 0.6);
      padding: 0.75rem 0.9rem;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .setting-label-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.4rem;
      font-weight: bold;
      font-size: 0.88rem;
      color: var(--text-main);
    }

    .volume-val {
      color: var(--accent-amber);
      font-weight: bold;
      font-size: 0.85rem;
    }

    .setting-item input[type="range"] {
      width: 100%;
      accent-color: var(--accent-amber);
      cursor: pointer;
      height: 6px;
      border-radius: 3px;
      background: #252a3f;
    }

    .setting-select {
      width: 100%;
      padding: 0.6rem;
      font-size: 0.9rem;
      background: rgba(15, 23, 42, 0.9);
      color: var(--text-main);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      margin-top: 0.3rem;
      cursor: pointer;
    }

    .setting-select:focus {
      outline: none;
      border-color: var(--accent-gold);
    }

    /* Name Settings Modal Styling */
    .name-input-scroll-container {
      max-height: 55vh;
      overflow-y: auto;
      padding-right: 0.4rem;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.6rem;
      margin: 0.8rem 0;
    }

    .name-input-row {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      background: rgba(15, 23, 42, 0.6);
      padding: 0.4rem 0.5rem;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .name-input-row label {
      font-size: 0.75rem;
      color: var(--accent-amber);
      font-weight: bold;
    }

    .name-input-row input {
      width: 100%;
      padding: 0.35rem 0.45rem;
      font-size: 0.85rem;
      background: rgba(10, 15, 30, 0.8);
      color: var(--text-primary);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      box-sizing: border-box;
    }

    .name-input-row input:focus {
      outline: none;
      border-color: var(--accent-gold);
      box-shadow: 0 0 4px rgba(245, 158, 11, 0.4);
    }

    .modal-btn-group {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin: 0.6rem 0;
    }

    .modal-btn-group button {
      flex: 1;
      min-width: 90px;
      padding: 0.45rem 0.4rem;
      font-size: 0.78rem;
      font-weight: bold;
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      color: var(--text-primary);
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .modal-btn-group button:hover {
      background: var(--card-border);
      border-color: var(--accent-amber);
    }

    /* Rule Explanation Styling */
    .rule-explanation {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .rule-section {
      background: rgba(20, 24, 40, 0.6);
      padding: 0.7rem 0.85rem;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .rule-section h3 {
      font-size: 0.92rem;
      color: var(--accent-amber);
      margin-top: 0;
      margin-bottom: 0.4rem;
      border-bottom: 1px solid rgba(245, 158, 11, 0.2);
      padding-bottom: 0.2rem;
    }

    .rule-section p, .rule-section ul {
      margin: 0;
      padding-left: 0;
      font-size: 0.82rem;
      color: #cbd5e1;
    }

    .rule-section ul {
      list-style-type: none;
    }

    .rule-section ul li {
      margin-bottom: 0.3rem;
      position: relative;
      padding-left: 0.9rem;
    }

    .rule-section ul li::before {
      content: "•";
      color: var(--accent-amber);
      position: absolute;
      left: 0;
      font-weight: bold;
    }

    .role-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 0.4rem;
      margin-top: 0.3rem;
    }

    .role-item {
      font-size: 0.78rem;
      background: rgba(10, 12, 20, 0.5);
      padding: 0.35rem 0.5rem;
      border-radius: 4px;
      color: #94a3b8;
    }

    .role-badge {
      font-size: 0.7rem;
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      font-weight: bold;
      color: #fff;
      margin-right: 0.2rem;
      display: inline-block;
    }

    .role-villager { background: #3b82f6; }
    .role-seer { background: #8b5cf6; }
    .role-medium { background: #06b6d4; }
    .role-knight { background: #10b981; }
    .role-wolf { background: #ef4444; }
    .role-madman { background: #ec4899; }
    .role-baker { background: #d97706; }
    .role-freemason { background: #6366f1; }
    .role-fox { background: #f59e0b; }
    .role-cakeshop { background: #f472b6; }
    .role-hunter { background: #16a34a; }
    .role-nekomata { background: #14b8a6; }
    .role-bodyguard { background: #64748b; }
    .role-immoral { background: #8b5cf6; }
    .role-fanatic { background: #c026d3; }

    /* 🩸 誤審発生時 禍々しい赤テロップ演出 */
    .mislynch-banner-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 99999;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background: radial-gradient(circle, rgba(185, 28, 28, 0.45) 0%, rgba(0, 0, 0, 0.85) 85%);
      opacity: 0;
      transition: opacity 0.4s ease-in-out;
    }
    .mislynch-banner-overlay.active {
      opacity: 1;
    }
    .mislynch-banner-text {
      font-family: 'Cinzel', 'serif', 'Georgia', 'Yu Mincho', serif;
      font-size: 1.8rem;
      font-weight: bold;
      color: #ef4444;
      text-shadow: 0 0 20px #7f1d1d, 0 0 10px #b91c1c, 0 2px 6px #000000;
      letter-spacing: 0.12em;
      transform: scale(0.85);
      transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      text-align: center;
      padding: 1rem 2rem;
      border-top: 2px solid rgba(239, 68, 68, 0.7);
      border-bottom: 2px solid rgba(239, 68, 68, 0.7);
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(6px);
      box-shadow: 0 0 30px rgba(185, 28, 28, 0.5);
    }
    .mislynch-banner-overlay.active .mislynch-banner-text {
      transform: scale(1.05);
    }

    /* ⚔️ 処刑演出（MOVE/syokei.mp4）用フルスクリーンオーバーレイ */
    .execution-video-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: #000000;
      z-index: 100000;
      display: none;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }
    .execution-video-overlay.active {
      display: flex;
    }
    .execution-video-overlay video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .execution-video-skip-btn {
      position: absolute;
      bottom: 24px;
      right: 24px;
      background: rgba(0, 0, 0, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #e2e8f0;
      font-size: 0.82rem;
      padding: 0.4rem 0.8rem;
      border-radius: 20px;
      cursor: pointer;
      z-index: 100001;
      backdrop-filter: blur(4px);
      transition: background 0.2s;
    }
    .execution-video-skip-btn:hover {
      background: rgba(0, 0, 0, 0.9);
      color: #fff;
    }
    .warning-box {
      color: var(--accent-amber);
      font-size: 0.75rem;
      margin-top: 0.4rem;
    }

    /* =====================================================
       スマホ縦画面（orientation: portrait）レイアウト最適化
       「処刑決断へ進む」ボタン常時固定＆視認性確保
       ===================================================== */
    @media (orientation: portrait) {
      .viewport-area {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
        overflow: hidden;
      }

      /* 画面全体（ビューページ）の縦スクロールを有効化（はみ出し防止＆iOSスムーズスクロール対応） */
      .view-page {
        padding: 0.4rem 0.5rem max(1rem, env(safe-area-inset-bottom, 1rem)) 0.5rem;
        gap: 0.5rem;
        height: 100%;
        min-height: 0;
        box-sizing: border-box;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
        display: flex;
        flex-direction: column;
      }

      /* ① 上部：村人カードエリア（人数が増えても柔軟に展開） */
      .character-grid {
        flex: 0 0 auto;
        max-height: none;
        overflow-y: visible;
        gap: 0.35rem;
        grid-template-columns: repeat(auto-fill, minmax(82px, 1fr));
        padding-right: 0.15rem;
      }

      .char-card {
        padding: 0.35rem 0.2rem !important;
      }

      .char-avatar {
        width: 26px;
        height: 26px;
        font-size: 0.8rem;
        margin-bottom: 0.1rem;
      }

      .char-name {
        font-size: 0.75rem;
        margin-bottom: 0.1rem;
      }

      .char-co-badge, .char-status {
        font-size: 0.62rem;
        padding: 0.05rem 0.2rem;
      }

      .memo-select {
        margin-top: 0.15rem;
        padding: 0.1rem 0.05rem;
        font-size: 0.62rem;
      }

      /* ② 下部：質問＆処刑パネル（全体スクロールに連動して下に自然展開） */
      .interrogation-panel {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        padding: 0.4rem 0 0 0 !important;
        padding-bottom: 70px !important; /* 最下部の固定ナビやボタンに埋もれない安全余白 */
        gap: 0.4rem;
        margin-top: 0;
        margin-bottom: 0 !important;
        overflow: visible !important;
        background: transparent !important;
        background-color: transparent !important;
        border: none !important;
        box-shadow: none !important;
      }

      .target-info {
        font-size: 0.82rem;
        flex-shrink: 0;
      }

      /* 質問項目リストコンテナ */
      .question-scroll-container {
        flex: 0 0 auto;
        overflow-y: visible !important;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding-right: 0.15rem;
      }

      .question-buttons {
        gap: 0.25rem;
      }

      .mass-call-container {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.35rem 0.45rem;
        background: rgba(15, 23, 42, 0.65);
        border: 1px solid rgba(245, 158, 11, 0.35);
        border-radius: 8px;
        margin-bottom: 0.2rem;
      }

      .mass-call-title {
        font-size: 0.72rem;
        font-weight: bold;
        color: var(--accent-amber);
        display: flex;
        align-items: center;
        gap: 0.3rem;
      }

      .mass-call-buttons {
        display: flex;
        gap: 0.25rem;
      }

      .btn-mass-call {
        flex: 1;
        padding: 0.38rem 0.45rem !important;
        font-size: 0.75rem !important;
        line-height: 1.2 !important;
        background: linear-gradient(135deg, rgba(217, 119, 6, 0.25), rgba(180, 83, 9, 0.45)) !important;
        border: 1px solid rgba(245, 158, 11, 0.5) !important;
        color: #fef3c7 !important;
        border-radius: 6px !important;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        font-weight: 600;
      }

      .btn-mass-call:hover:not(:disabled) {
        background: linear-gradient(135deg, rgba(217, 119, 6, 0.45), rgba(180, 83, 9, 0.7)) !important;
        border-color: var(--accent-amber) !important;
        box-shadow: 0 0 8px rgba(245, 158, 11, 0.4);
      }

      .btn-mass-call:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }

      .btn-question {
        padding: 0.45rem 0.6rem !important;
        font-size: 0.78rem !important;
        line-height: 1.25 !important;
      }

      .custom-question-box {
        margin-top: 0.1rem !important;
        gap: 0.3rem;
      }

      .custom-question-input {
        padding: 0.45rem 0.5rem !important;
        font-size: 0.78rem !important;
      }

      .btn-custom-question {
        padding: 0.45rem 0.7rem !important;
        font-size: 0.78rem !important;
      }

      /* ③ 処刑決断移行ボタンコンテナ（最下部に配置・確実にスクロールして押せる） */
      .execution-transition-container {
        flex: 0 0 auto;
        margin-top: 0.5rem;
        padding-top: 0.45rem;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
      }

      .btn-goto-decision {
        margin-top: 0 !important;
        margin-bottom: 0.5rem !important;
        padding: 0.75rem 0.8rem !important;
        font-size: 0.92rem !important;
        width: 100%;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(220, 38, 38, 0.5);
      }

      .execute-action-row {
        margin-top: 0.2rem !important;
        margin-bottom: 0.5rem !important;
        flex-shrink: 0;
      }

      .btn-execute, .btn-skip-execute {
        padding: 0.65rem 0.6rem !important;
        font-size: 0.82rem !important;
      }

      /* ④ Page 2: 「発言ログ・確定情報」タブの高さ・スクロール領域最適化（最下部枠外はみ出し防止） */
      .log-header-sections {
        flex: 0 1 auto;
        max-height: 42vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        flex-shrink: 0;
      }

      .log-timeline {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 120px !important;
        box-sizing: border-box;
      }

      /* ⑤ タイトル画面・村選択画面のスマホ用スクロール安全領域拡張 */
      #title-screen {
        padding-bottom: 90px !important;
      }
      .title-box {
        margin-bottom: 60px !important;
      }
    }

    /* Speech Skip Indicator & Button Only Capture Overlay */
    #speech-skip-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 9998;
      pointer-events: none;
    }
    #speech-skip-overlay.visible {
      display: block;
    }
    #speech-skip-overlay .skip-badge {
      position: absolute;
      bottom: 1.2rem;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(59, 130, 246, 0.95);
      color: #fff;
      font-size: 0.88rem;
      font-weight: bold;
      padding: 0.6rem 1.4rem;
      border-radius: 2rem;
      box-shadow: 0 4px 15px rgba(59, 130, 246, 0.7);
      white-space: nowrap;
      pointer-events: auto;
      touch-action: manipulation;
      cursor: pointer;
      user-select: none;
      animation: speechSkipPulse 1.2s ease-in-out infinite;
      border: 1px solid rgba(255, 255, 255, 0.4);
    }
    @keyframes speechSkipPulse {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }
    /* Mode Category Switcher Tabs */
    .mode-category-tabs {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 1rem;
      width: 100%;
      max-width: 500px;
    }
    .category-tab {
      flex: 1;
      padding: 0.6rem 0.4rem;
      font-size: 0.88rem;
      font-weight: bold;
      color: var(--text-muted);
      background: rgba(22, 25, 39, 0.8);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s ease;
    }
    .category-tab:hover {
      background: rgba(59, 130, 246, 0.15);
      border-color: var(--accent-blue);
    }
    .category-tab.active {
      color: #fff;
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.8), rgba(37, 99, 235, 0.9));
      border-color: var(--accent-blue);
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }

    /* Daily Village Card */
    .daily-village-card {
      background: rgba(22, 25, 39, 0.9);
      border: 2px solid var(--accent-amber);
      border-radius: 12px;
      padding: 1rem;
      max-width: 500px;
      width: 100%;
      margin: 0 auto 1rem auto;
      text-align: left;
      box-shadow: 0 4px 15px rgba(245, 158, 11, 0.2);
    }
    .daily-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: bold;
      font-size: 1rem;
      color: var(--accent-amber);
      margin-bottom: 0.5rem;
      border-bottom: 1px solid rgba(245, 158, 11, 0.3);
      padding-bottom: 0.4rem;
    }
    .daily-card-rule {
      font-size: 0.85rem;
      color: var(--text-main);
      margin-bottom: 0.6rem;
      line-height: 1.4;
    }
    .daily-card-stats {
      display: flex;
      gap: 0.8rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      background: rgba(10, 12, 20, 0.5);
      padding: 0.5rem 0.8rem;
      border-radius: 6px;
    }
    .daily-cleared-badge {
      display: inline-block;
      background: var(--accent-green);
      color: #fff;
      font-size: 0.75rem;
      font-weight: bold;
      padding: 0.2rem 0.6rem;
      border-radius: 12px;
    }

    /* Custom Village Modal / Form */
    .custom-setting-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 0.88rem;
    }
    .custom-counter {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .counter-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 1px solid var(--card-border);
      background: rgba(59, 130, 246, 0.2);
      color: #fff;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .counter-btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }
    .counter-val {
      min-width: 24px;
      text-align: center;
      font-weight: bold;
      color: #fff;
    }
    .custom-total-box {
      margin-top: 1rem;
      padding: 0.6rem;
      border-radius: 8px;
      background: rgba(10, 12, 20, 0.6);
      text-align: center;
      font-weight: bold;
      font-size: 0.9rem;
    }
    .custom-total-box.valid { color: var(--accent-green); }
    .custom-total-box.invalid { color: var(--accent-red); }

    /* Role Shop & Points UI */
    .points-display-badge {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(217, 119, 6, 0.35));
      border: 1px solid var(--accent-amber);
      color: #fbbf24;
      font-weight: bold;
      font-size: 0.85rem;
      padding: 0.4rem 0.8rem;
      border-radius: 20px;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .unlock-btn {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #fff;
      border: none;
      font-size: 0.75rem;
      font-weight: bold;
      padding: 0.35rem 0.75rem;
      border-radius: 12px;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
      transition: all 0.2s ease;
    }
    .unlock-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.6);
    }
    .unlock-btn:disabled {
      background: #475569;
      color: #94a3b8;
      box-shadow: none;
      cursor: not-allowed;
      transform: none;
    }
    .locked-role-row {
      opacity: 0.75;
    }
    .category-tab.locked {
      opacity: 0.6;
      background: rgba(15, 20, 30, 0.7);
      border-color: rgba(255, 255, 255, 0.1);
      color: #64748b;
      cursor: pointer;
    }

    /* Game Custom Alert Modal */
    .custom-alert-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(0, 0, 0, 0.75);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 99999;
      backdrop-filter: blur(4px);
    }
    .custom-alert-content {
      background: #1e2230;
      border: 2px solid #3b82f6;
      border-radius: 12px;
      padding: 24px;
      width: 88%;
      max-width: 400px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.85);
      text-align: center;
      color: #ffffff;
      animation: customModalPop 0.2s ease-out;
    }
    .custom-alert-text {
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 20px;
      text-align: left;
      white-space: pre-wrap;
      color: var(--text-main);
    }
    .custom-alert-btn {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: white;
      border: none;
      padding: 10px 28px;
      border-radius: 8px;
      font-weight: bold;
      font-size: 0.95rem;
      cursor: pointer;
      width: 100%;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
      transition: all 0.2s ease;
    }
    .custom-alert-btn:hover {
      background: linear-gradient(135deg, #60a5fa, #3b82f6);
    }
    @keyframes customModalPop {
      0% { transform: scale(0.9); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    /* Custom Confirm Modal */
    .custom-confirm-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(0, 0, 0, 0.8);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 99999;
      backdrop-filter: blur(4px);
    }
    .custom-confirm-content {
      background: linear-gradient(145deg, #1e2230, #151927);
      border: 2px solid #f59e0b;
      border-radius: 12px;
      padding: 24px;
      width: 88%;
      max-width: 420px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.85), 0 0 20px rgba(245, 158, 11, 0.15);
      text-align: center;
      color: #ffffff;
      animation: customModalPop 0.2s ease-out;
    }
    .custom-confirm-title {
      font-size: 1.1rem;
      font-weight: bold;
      color: #fbbf24;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(251, 191, 36, 0.3);
    }
    .custom-confirm-text {
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 20px;
      text-align: left;
      white-space: pre-wrap;
      color: var(--text-main);
    }
    .custom-confirm-buttons {
      display: flex;
      gap: 10px;
      justify-content: center;
    }
    .custom-confirm-btn-ok {
      background: linear-gradient(135deg, #dc2626, #b91c1c);
      color: white;
      border: none;
      padding: 10px 28px;
      border-radius: 8px;
      font-weight: bold;
      font-size: 0.95rem;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
      transition: all 0.2s ease;
      flex: 1;
    }
    .custom-confirm-btn-ok:hover {
      background: linear-gradient(135deg, #ef4444, #dc2626);
    }
    .custom-confirm-btn-cancel {
      background: rgba(71, 85, 105, 0.6);
      color: #e2e8f0;
      border: 1px solid #64748b;
      padding: 10px 28px;
      border-radius: 8px;
      font-weight: bold;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.2s ease;
      flex: 1;
    }
    .custom-confirm-btn-cancel:hover {
      background: rgba(71, 85, 105, 0.9);
    }

    /* Toast Notification Styles */
    .toast-notification {
      position: fixed;
      top: 20px;
      right: 20px;
      background: rgba(30, 41, 59, 0.92);
      color: #f3f4f6;
      border: 1px solid #ef4444;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 0.9rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 15px rgba(239, 68, 68, 0.3);
      z-index: 99999;
      display: flex;
      align-items: center;
      gap: 10px;
      opacity: 0;
      transform: translateY(-20px);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
    }
    .toast-notification.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* Save / Load Slot Modal Styles */
    .save-slot-list {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      margin-top: 0.5rem;
    }
    .save-slot-card {
      background: rgba(15, 20, 30, 0.7);
      border: 1.5px solid var(--card-border);
      border-radius: 10px;
      padding: 0.8rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      transition: all 0.2s ease;
    }
    .save-slot-card.active-slot {
      border-color: var(--accent-amber);
      background: rgba(245, 158, 11, 0.08);
    }
    .save-slot-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 0.4rem;
    }
    .save-slot-title {
      font-weight: bold;
      font-size: 0.95rem;
      color: var(--text-main);
    }
    .save-slot-title.empty {
      color: var(--text-muted);
    }
    .save-slot-detail {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.4;
    }
    .save-slot-actions {
      display: flex;
      gap: 0.4rem;
      justify-content: flex-end;
      margin-top: 0.2rem;
    }
    .btn-slot-action {
      font-size: 0.78rem;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      border: none;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-slot-save {
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
    }
    .btn-slot-load {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: white;
    }
    .btn-slot-delete {
      background: rgba(225, 29, 72, 0.2);
      color: #f43f5e;
      border: 1px solid rgba(225, 29, 72, 0.4);
    }
    .btn-slot-delete:hover {
      background: rgba(225, 29, 72, 0.4);
    }

    /* Title Save Slot Selector Styles */
    .slot-select-container {
      margin-bottom: 0.8rem;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      padding: 0.6rem 0.8rem;
    }
    .slot-select-title {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      font-weight: bold;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .slot-select-buttons {
      display: flex;
      gap: 0.5rem;
    }
    .btn-slot-select {
      flex: 1;
      padding: 0.45rem 0.4rem;
      font-size: 0.78rem;
      font-weight: bold;
      background: rgba(30, 41, 59, 0.8);
      border: 1.5px solid var(--card-border);
      color: var(--text-muted);
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.1rem;
    }
    .btn-slot-select:hover {
      border-color: var(--accent-amber);
      color: var(--text-main);
    }
    .btn-slot-select.active {
      border-color: var(--accent-amber);
      background: rgba(245, 158, 11, 0.18);
      color: #fbbf24;
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.3);
    }
    .btn-slot-select .slot-subtext {
      font-size: 0.68rem;
      font-weight: normal;
      opacity: 0.85;
    }
  </style>
<body>
  <!-- 🩸 誤審テロップ演出用オーバーレイ -->
  <div id="mislynch-banner-overlay" class="mislynch-banner-overlay">
    <div class="mislynch-banner-text">【誤審】村人の血が流された……</div>
  </div>

  <!-- ⚔️ 処刑アニメーション動画用オーバーレイ -->
  <div id="execution-video-overlay" class="execution-video-overlay">
    <video id="execution-video-player" playsinline preload="auto">
      <source src="MOVE/syokei.mp4" type="video/mp4">
    </video>
    <button class="execution-video-skip-btn" onclick="skipExecutionVideo()">スキップ ⏭</button>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast-notification" class="toast-notification">
    <span id="toast-message">⚡ 通信上限のため軽量AIモードで動作中</span>
  </div>

  <!-- Game Custom Alert Modal Overlay -->
  <div id="custom-alert-overlay" class="custom-alert-overlay" style="display: none;" onclick="if(event.target===this) closeCustomAlertModal()">
    <div class="custom-alert-content">
      <div id="custom-alert-text" class="custom-alert-text"></div>
      <button class="custom-alert-btn" onclick="closeCustomAlertModal()">OK</button>
    </div>
  </div>

  <!-- Game Custom Confirm Modal Overlay -->
  <div id="custom-confirm-overlay" class="custom-confirm-overlay" style="display: none;">
    <div class="custom-confirm-content">
      <div id="custom-confirm-title" class="custom-confirm-title">⚠️ 確認</div>
      <div id="custom-confirm-text" class="custom-confirm-text"></div>
      <div class="custom-confirm-buttons">
        <button id="custom-confirm-btn-cancel" class="custom-confirm-btn-cancel">キャンセル</button>
        <button id="custom-confirm-btn-ok" class="custom-confirm-btn-ok">実行する</button>
      </div>
    </div>
  </div>

  <!-- Speech Skip Indicator Button (tap button only to skip) -->
  <div id="speech-skip-overlay">
    <div id="speech-skip-btn" class="skip-badge" onclick="triggerSpeechSkip(event)" ontouchstart="triggerSpeechSkip(event)">⏭ タップで読み上げスキップ</div>
  </div>

  <!-- SPLASH SCREEN (START WAIT ATTRACT SCREEN) -->
  <div id="splash-screen" onclick="handleSplashTap(event)" ontouchstart="handleSplashTap(event)">
    <div class="splash-start-text">
      TAP TO START
    </div>
  </div>

  <!-- 📜 オープニング物語モーダル（新規プレイ・初回表示） -->
  <div id="opening-story-modal" class="modal-overlay hidden" style="z-index: 99990; background: rgba(5, 7, 12, 0.95); backdrop-filter: blur(8px);">
    <div class="modal-content" style="max-width: 580px; width: 92%; background: linear-gradient(135deg, rgba(20, 24, 38, 0.98), rgba(12, 15, 26, 0.99)); border: 2px solid var(--accent-amber); box-shadow: 0 0 30px rgba(245, 158, 11, 0.3); padding: 1.5rem; text-align: left;">
      <div style="font-family: serif; font-size: 1.25rem; font-weight: bold; color: var(--accent-amber); border-bottom: 1px solid rgba(245, 158, 11, 0.4); padding-bottom: 0.5rem; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
        <span id="opening-story-title">📜 序章 ～災いに見舞われし地～</span>
        <button class="btn btn-secondary" onclick="finishOpeningStory()" style="padding: 0.25rem 0.65rem; font-size: 0.75rem; border-radius: 12px;">⏩ スキップ</button>
      </div>
      <div id="opening-story-content" style="font-size: 0.92rem; line-height: 1.85; color: #f1f5f9; font-family: serif; white-space: pre-wrap; background: rgba(0, 0, 0, 0.3); padding: 1.2rem; border-radius: 8px; border-left: 3px solid var(--accent-amber); margin-bottom: 1.2rem; max-height: 55vh; overflow-y: auto;">かつて平和を誇った「レムの王国」。
いま、その辺境の村々には、恐ろしい災いが忍び寄っていた。

人間に完璧に化け、夜闇に乗じて住民を喰らう悪魔――「擬態モンスター」。
姿形も声も、昨日まで共に過ごした家族や友人そのもの。
誰が人間で、誰が皮を被った化け物なのか……村人たちは互いを疑い、狂気に呑まれつつあった。

そこへ現れたのが、絶対の審判権を持つ「勇者（あなた）」。

「これより審判会議を執り行う。
言葉の裏に潜む偽りを見抜き、私に潜伏する魔物を示せ。
私の剣が、災いに引導を渡す――」

暗雲立ち込める村の門を叩き、勇者の審判が今、始まる。</div>
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 0.5rem;">
        <button id="opening-story-prev-btn" class="btn btn-secondary" onclick="prevStoryStep()" style="display: none; padding: 0.65rem 1.2rem; font-size: 0.95rem;">
          ◀ 前へ
        </button>
        <button id="opening-story-btn" class="btn-start-game" onclick="nextStoryStep()" style="flex: 1; font-size: 1.05rem; padding: 0.75rem; margin-top: 0;">
          次へ進む ▶
        </button>
      </div>
    </div>
  </div>

  <!-- TITLE SCREEN -->
  <div id="title-screen" class="screen">
    <div class="title-box" id="title-box-container" style="display: none;">
      <h1 class="main-title">ぼっち人狼<br><span class="sub-title">〜審判の勇者〜</span></h1>

      <!-- Sub Header Buttons (遊び方・ランク) -->
      <div class="title-sub-buttons" style="margin-bottom: 0.8rem;">
        <button class="btn-title-sub" onclick="openModal('how-to-play-modal')">📖 遊び方</button>
        <button class="btn-title-sub" onclick="openRankModal()">🏆 勇者ランク</button>
      </div>

      <!-- Title Screen Main Action Buttons -->
      <div class="title-main-menu-buttons" style="display: flex; gap: 0.8rem; margin: 1rem 0; width: 100%; max-width: 480px;">
        <button class="btn-start-game" style="flex: 1; margin-top:0; font-size: 1.05rem;" onclick="onStartNewGameClick()">
          ⚔️ はじめから<br><span style="font-size:0.75rem; font-weight:normal; opacity:0.9;">(新たな旅立ち)</span>
        </button>
        <button class="btn-start-game" style="flex: 1; margin-top:0; font-size: 1.05rem; background: linear-gradient(135deg, #f59e0b, #d97706); box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);" onclick="openSaveModal()">
          📜 冒険の書を開く<br><span style="font-size:0.75rem; font-weight:normal; opacity:0.9;">(続きから)</span>
        </button>
      </div>

      <!-- フリーモード用 村選択セクション (モード選択でフリーモードを選んだ際のみ表示) -->
      <div id="free-mode-selection-section" style="display: none; margin-top: 1rem; border-top: 1px dashed rgba(255,255,255,0.2); padding-top: 1rem;">
        <!-- Mode Category Selection Tabs -->
        <div class="mode-category-tabs">
          <button class="category-tab active" id="tab-cat-normal" onclick="selectGameCategory('normal')">通常試練</button>
          <button class="category-tab" id="tab-cat-daily" onclick="selectGameCategory('daily')">📅 デイリー村</button>
          <button class="category-tab" id="tab-cat-custom" onclick="selectGameCategory('custom')">🛠️ カスタマイズ村</button>
        </div>

        <!-- NORMAL MODE CONTAINER -->
        <div id="category-container-normal">
          <div class="mode-select-title">村の規模を選択してください</div>
          <div class="mode-buttons">
            <div class="mode-btn selected" id="mode-6" onclick="selectVillageMode(6)">
              <div class="mode-header">
                <span>🏰 始まりの村（6名 / 初級）</span>
              </div>
              <div class="mode-desc">配役: 擬態モンスター1 / 賢者1 / 聖職者1 / 村人3</div>
              <div class="village-stats-container">
                <span class="stat-badge villager-win">👨 村人: <strong id="stats-6-villager">0</strong>勝</span>
                <span class="stat-badge wolf-win">🐺 魔物: <strong id="stats-6-wolf">0</strong>勝</span>
                <span class="stat-badge point-reward" style="background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4);">🏆 獲得: 1 P</span>
              </div>
            </div>

            <div class="mode-btn" id="mode-8" onclick="selectVillageMode(8)">
              <div class="mode-header">
                <span>🌆 黄昏の村（8名 / 中級）</span>
              </div>
              <div class="mode-desc">配役: 擬態モンスター2 / 賢者1 / 聖職者1 / 聖騎士1 / 魔教徒1 / 村人2</div>
              <div class="village-stats-container">
                <span class="stat-badge villager-win">👨 村人: <strong id="stats-8-villager">0</strong>勝</span>
                <span class="stat-badge wolf-win">🐺 魔物: <strong id="stats-8-wolf">0</strong>勝</span>
                <span class="stat-badge point-reward" style="background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4);">🏆 獲得: 2 P</span>
              </div>
            </div>

            <div class="mode-btn" id="mode-10" onclick="selectVillageMode(10)">
              <div class="mode-header">
                <span>🏚️ 終焉の村（10名 / 上級）</span>
              </div>
              <div class="mode-desc">配役: 擬態モンスター2 / 賢者1 / 聖職者1 / 聖騎士1 / 魔教徒1 / パン屋1 / 村人3</div>
              <div class="village-stats-container">
                <span class="stat-badge villager-win">👨 村人: <strong id="stats-10-villager">0</strong>勝</span>
                <span class="stat-badge wolf-win">🐺 魔物: <strong id="stats-10-wolf">0</strong>勝</span>
                <span class="stat-badge point-reward" style="background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4);">🏆 獲得: 3 P</span>
              </div>
            </div>

            <div class="mode-btn" id="mode-15" onclick="selectVillageMode(15)">
              <div class="mode-header">
                <span>💀 絶望の村（15名 / 超上級）</span>
              </div>
              <div class="mode-desc">配役: 擬態モンスター3 / 賢者1 / 聖職者1 / 聖騎士1 / 魔教徒1 / パン屋1 / 共有2 / 妖狐1 / 村人4</div>
              <div class="village-stats-container">
                <span class="stat-badge villager-win">👨 村人: <strong id="stats-15-villager">0</strong>勝</span>
                <span class="stat-badge wolf-win">🐺 魔物: <strong id="stats-15-wolf">0</strong>勝</span>
                <span class="stat-badge fox-win">🦊 妖狐: <strong id="stats-15-fox">0</strong>勝</span>
                <span class="stat-badge point-reward" style="background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4);">🏆 獲得: 6 P</span>
              </div>
            </div>

            <div class="mode-btn" id="mode-30" onclick="selectVillageMode(30)">
              <div class="mode-header">
                <span>👑 神話の村（30名 / 伝説級）</span>
              </div>
              <div class="mode-desc">配役: 擬態モンスター6 / 賢者2 / 聖職者2 / 聖騎士2 / 魔教徒2 / パン屋1 / 共有2 / 猫又1 / 黒服1 / ケーキ屋1 / 妖狐1 / 村人9</div>
              <div class="village-stats-container">
                <span class="stat-badge villager-win">👨 村人: <strong id="stats-30-villager">0</strong>勝</span>
                <span class="stat-badge wolf-win">🐺 魔物: <strong id="stats-30-wolf">0</strong>勝</span>
                <span class="stat-badge fox-win">🦊 妖狐: <strong id="stats-30-fox">0</strong>勝</span>
                <span class="stat-badge point-reward" style="background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4);">🏆 獲得: 15 P</span>
              </div>
            </div>
          </div>
        </div>

        <!-- DAILY MODE CONTAINER -->
        <div id="category-container-daily" style="display: none;">
          <div class="daily-village-card">
            <div class="daily-card-header">
              <span id="daily-date-title">📅 本日の試練お題村</span>
              <span id="daily-clear-badge" style="display:none;" class="daily-cleared-badge">CLEAR!</span>
            </div>
            <div class="daily-card-rule" id="daily-rule-desc">
              読み込み中...
            </div>
            <div class="daily-card-stats" id="daily-stats-info">
              ハイスコア: <strong id="daily-highscore">-</strong> | クリア済: <strong id="daily-cleared-count">0</strong>回
            </div>
          </div>
        </div>

        <!-- CUSTOM MODE CONTAINER -->
        <div id="category-container-custom" style="display: none;">
          <div class="daily-village-card" style="border-color: var(--accent-blue);">
            <div class="daily-card-header" style="color: var(--accent-blue); border-bottom-color: rgba(59,130,246,0.3);">
              <span>🛠️ カスタマイズ村の設定</span>
            </div>
            <div class="daily-card-rule" id="custom-summary-desc">
              参加人数・配役・審判時間を自由に変更できます。
            </div>
            <button class="btn btn-primary" onclick="openCustomModal()" style="width: 100%; margin-top: 0.5rem; padding: 0.6rem; font-weight: bold;">
              ⚙ 配役とルールを設定する
            </button>
          </div>
        </div>

        <div class="title-action-buttons">
          <button class="btn-start-game" id="btn-start-game-main" onclick="startGame()">模擬戦（フリーモード）を出撃する</button>
          <div style="display: flex; gap: 0.6rem; margin-top: 0.3rem;">
            <button class="btn btn-secondary" onclick="returnToModeSelect()" style="flex: 1; padding: 0.65rem 0.8rem; font-size: 0.88rem; font-weight: bold; background: rgba(30, 41, 59, 0.85); border: 1px solid #475569; color: #e2e8f0; border-radius: 8px; cursor: pointer; transition: all 0.2s;">
              ◀ モード選択へ戻る
            </button>
            <button class="btn btn-secondary" onclick="returnToTitleScreen()" style="flex: 1; padding: 0.65rem 0.8rem; font-size: 0.88rem; font-weight: bold; background: rgba(30, 41, 59, 0.85); border: 1px solid #475569; color: #e2e8f0; border-radius: 8px; cursor: pointer; transition: all 0.2s;">
              🏠 タイトルへ戻る
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN GAME SCREEN -->
  <div id="game-screen" class="screen hidden">
    <!-- Header -->
    <header>
      <h1 class="game-header-title">ぼっち人狼 <span>〜審判の勇者〜</span></h1>
      <div class="header-buttons">
        <button class="btn-header-icon" onclick="openModal('how-to-play-modal')" title="遊び方">📖 遊び方</button>
        <button class="btn-header-icon" onclick="openRankModal()" title="ランク">🏆 ランク</button>
        <button class="btn-header-icon" onclick="openSaveModal()" title="冒険の書">📜 冒険の書</button>
        <button class="btn-header-icon" onclick="openModal('settings-modal')" title="設定">⚙ 設定</button>
        <button class="btn-title-mini" onclick="showTitleScreen()">タイトルへ</button>
      </div>
    </header>

    <!-- Status Bar with Countdown Timer -->
    <div class="status-bar">
      <div class="status-item"><span id="lbl-village-size">規模: </span><span id="village-size-display">6人村</span></div>
      <div class="status-item"><span id="lbl-day-display">日数: </span><span id="day-display">1日目</span></div>
      <div class="status-item"><span id="timer-label">⏱️ 審判時間:</span> <span id="timer-display" class="timer-display normal">03:00</span></div>
      <div class="status-item" id="trust-bar-container" style="display:flex; align-items:center; gap:0.4rem; background:rgba(0,0,0,0.3); padding:0.2rem 0.6rem; border-radius:12px; border:1px solid rgba(255,255,255,0.15);">
        <span style="font-weight:bold; font-size:0.82rem; color:#fde68a;">🤝 信頼度:</span>
        <div style="width:70px; height:12px; background:rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.25); border-radius:6px; overflow:hidden; position:relative;">
          <div id="trust-gauge-fill" style="width:100%; height:100%; background:linear-gradient(90deg, #22c55e, #10b981); transition:width 0.4s ease, background 0.4s ease;"></div>
        </div>
        <strong id="trust-value-display" style="color:#10b981; font-size:0.85rem; min-width:38px; text-align:right;">100%</strong>
      </div>
    </div>

    <!-- Navigation Bar / View Switcher -->
    <div class="nav-bar">
      <button class="nav-btn" id="nav-btn-0" onclick="switchView(0)">
        <span>[ 1. 仮想投票・疑い度履歴 ◀ ]</span>
      </button>
      <button class="nav-btn active" id="nav-btn-1" onclick="switchView(1)">
        <span>[ 2. 村人一覧・尋問 ]</span>
      </button>
      <button class="nav-btn" id="nav-btn-2" onclick="switchView(2)">
        <span>[ 3. 発言ログ・確定情報 ► ]</span>
      </button>
    </div>

    <!-- Viewport Area -->
    <div class="viewport-area" id="viewport-area">
      <!-- 画面中央 左右ナビゲーション矢印ボタン -->
      <button class="screen-nav-arrow left" id="nav-arrow-left" onclick="switchView(currentViewIndex - 1)" title="前の画面へ">❮</button>
      <button class="screen-nav-arrow right" id="nav-arrow-right" onclick="switchView(currentViewIndex + 1)" title="次の画面へ">❯</button>

      <div class="carousel-container" id="carousel-container">
        
        <!-- PAGE 0: Virtual Vote & Suspicion History -->
        <div class="view-page">
          <div style="font-size:0.88rem; color:var(--accent-amber); font-weight:bold; flex-shrink:0;">
            📊 仮想投票・疑い度履歴（リアルタイム精査）
          </div>
          
          <div class="vote-history-container" id="vote-history-container">
            <!-- Dynamic Virtual Vote & Line Analysis Content -->
          </div>
        </div>

        <!-- PAGE 1: Character List & Interrogation -->
        <div class="view-page">
          <div id="villager-list-header" style="font-size:0.85rem; color:var(--text-muted); font-weight:bold;">村人一覧 (尋問・勇者の裁き対象を選択)</div>
          <div class="character-grid" id="character-grid">
            <!-- Characters inserted dynamically -->
          </div>

          <div class="interrogation-panel">
            <div id="interrogation-response-box" style="display:none; background:rgba(30, 41, 59, 0.95); border:1.5px solid var(--accent-amber); border-radius:10px; padding:0.65rem 0.85rem; margin-bottom:0.4rem; box-shadow:0 4px 15px rgba(0,0,0,0.5); backdrop-filter:blur(6px);">
              <div id="interrogation-response-speaker" style="font-weight:bold; color:var(--accent-amber); font-size:0.85rem; margin-bottom:0.25rem;"></div>
              <div id="interrogation-response-text" style="color:#f8fafc; font-size:0.88rem; line-height:1.45;"></div>
            </div>
            <div id="target-info" class="target-info">尋問・追放する人物を選択してください</div>
            
            <div class="question-scroll-container">
              <!-- 一斉質問: 役職対抗・名乗り出呼びかけ -->
              <div class="mass-call-container">
                <div class="mass-call-title">📢 一斉質問（対抗CO・役職名乗り出）</div>
                <div class="mass-call-buttons">
                  <button class="btn btn-mass-call" id="btn-mass-seer" onclick="triggerMassRoleCall('seer')">
                    🔮 「賢者」の対抗は？
                  </button>
                  <button class="btn btn-mass-call" id="btn-mass-medium" onclick="triggerMassRoleCall('medium')">
                    👻 「聖職者」の対抗は？
                  </button>
                  <button class="btn btn-mass-call" id="btn-mass-knight" onclick="triggerMassRoleCall('knight')">
                    🛡️ 「聖騎士」の対抗は？
                  </button>
                </div>
              </div>

              <div class="question-buttons">
                <button class="btn btn-question" id="btn-q1" onclick="askQuestion(1)" disabled>
                  1. 「あなたが人間だと言える一番の証拠は？」
                </button>
                <button class="btn btn-question" id="btn-q2" onclick="askQuestion(2)" disabled>
                  2. 「現在出ている役職の中で、誰を一番信用している？」
                </button>
                <button class="btn btn-question" id="btn-q3" onclick="askQuestion(3)" disabled>
                  3. 「今日誰を浄化すべきだと思う？」
                </button>
              </div>

              <div class="custom-question-box">
                <input type="text" id="custom-question-input" class="custom-question-input" placeholder="自由尋問（例: 昨日〇〇さんを占った理由は？）" disabled onkeydown="if(event.key==='Enter') askCustomQuestion()">
                <button class="btn btn-custom-question" id="btn-custom-q" onclick="askCustomQuestion()" disabled>尋問する</button>
              </div>

              <!-- 質問入力欄のすぐ直下に配置 -->
              <div class="execution-transition-container">
                <button class="btn btn-goto-decision" id="btn-goto-decision" onclick="startDecisionTimer()" disabled>
                  ⚖ 勇者の裁きへ進む（審判終了）
                </button>

                <div class="execute-action-row" id="execute-action-row" style="display: none;">
                  <button class="btn btn-execute" id="btn-execute" onclick="executeSelected()" disabled>
                    選択者を処刑（浄化）
                  </button>
                  <button class="btn btn-skip-execute" id="btn-skip-execute" onclick="skipExecution()" disabled>
                    誰も処分しない
                  </button>
                </div>
              </div>
            </div>
            
            <div id="action-warning" class="warning-box" style="display: none;">
              ⚠️ 審判時間が終了しました。勇者の裁き対象を選択するか、処刑を見送ってください。
            </div>
          </div>
        </div>

        <!-- PAGE 2: Bulletin & Comments & Log Timeline -->
        <div class="view-page">
          <div class="log-header-sections">
            <!-- Bulletin Board (Collapsible) -->
            <div class="bulletin-board">
              <div class="card-header" onclick="toggleCard(this)">
                <span class="bulletin-title">📜 本日の確定情報（能力報告）</span>
                <span class="toggle-icon">開く</span>
              </div>
              <div class="card-body collapsed">
                <div class="bulletin-list" id="bulletin-list">
                  <!-- Ability Reports dynamically added -->
                </div>
              </div>
            </div>

            <!-- Morning Comments (Collapsible) -->
            <div class="morning-comments-box">
              <div class="card-header" onclick="toggleCard(this)">
                <span class="morning-title">💬 朝コメント過去ログ一覧</span>
                <span class="toggle-icon">開く</span>
              </div>
              <div class="card-body collapsed">
                <div class="morning-comments-list" id="morning-comments-list">
                  <!-- Morning comments dynamically added -->
                </div>
              </div>
            </div>
          </div>

          <div style="display:flex; align-items:center; justify-content:space-between; flex-shrink:0; margin-bottom:0.2rem;">
            <div style="font-size:0.9rem; color:var(--text-muted); font-weight:bold;">タイムライン・尋問ログ</div>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <button id="btn-open-mind-board" onclick="openMindBoardModal()" style="font-size:0.85rem; font-weight:bold; padding:0.45rem 0.9rem; background:linear-gradient(135deg, #ec4899, #be185d); border:1.5px solid #f472b6; color:#fff; border-radius:20px; cursor:pointer; display:flex; align-items:center; gap:0.4rem; box-shadow:0 2px 10px rgba(236,72,153,0.35); transition:all 0.2s ease;">
                <span>🧠 思考整理</span>
              </button>
              <button id="btn-toggle-discussion-pause" onclick="toggleDiscussionPause()" style="font-size:0.85rem; font-weight:bold; padding:0.45rem 0.9rem; background:linear-gradient(135deg, #3a3f58, #2a2d42); border:1.5px solid var(--accent-amber); color:#fff; border-radius:20px; cursor:pointer; display:flex; align-items:center; gap:0.4rem; box-shadow:0 2px 8px rgba(0,0,0,0.3); transition:all 0.2s ease;">
                <span>⏸️ 審判を一時停止</span>
              </button>
            </div>
          </div>
          <div class="log-timeline" id="log-timeline">
            <!-- Logs dynamically added -->
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- PHASE FADE OVERLAY -->
  <div id="phase-fade-overlay" class="phase-fade-overlay"></div>

  <!-- ENHANCED SEAMLESS NIGHT OVERLAY -->
  <div id="seamless-overlay" class="seamless-overlay">
    <div class="moon-graphic" id="moon-graphic"></div>
    <div class="wolf-eyes-container" id="wolf-eyes">
      <div class="wolf-eye"></div>
      <div class="wolf-eye"></div>
    </div>
    <div class="seamless-title" id="seamless-title">🌕 魔物の夜襲 🌕</div>
    <div class="seamless-desc" id="seamless-desc">― 夜が訪れました ―<br>魔物たちが暗闇の中で目を光らせ、村人を狙っています…</div>
  </div>

  <!-- Modal Result Screen -->
  <div class="modal-overlay hidden" id="modal-overlay">
    <div class="modal-content modal-result">
      <div id="modal-title" class="modal-title"></div>
      <div class="result-columns">
        <div class="result-col-left">
          <div id="modal-result-card"></div>
          <div id="modal-body" class="modal-body"></div>
        </div>
        <div class="result-col-right">
          <div class="reveal-list" id="modal-reveal"></div>
        </div>
      </div>
      <div class="result-action-buttons">
        <button class="btn-result-action btn-result-restart" onclick="startGame()">🔄 もう一度プレイ</button>
        <button class="btn-result-action btn-result-title" onclick="showTitleScreen()">🏠 タイトルへ</button>
      </div>
    </div>
  </div>

  <!-- Custom Village Settings Modal -->
  <div id="custom-village-modal" class="modal-overlay hidden" onclick="if(event.target===this) closeModal('custom-village-modal')">
    <div class="modal-content" style="max-width: 480px; width: 92%;">
      <div class="modal-header">
        <h2>🛠️ カスタマイズ村の設定</h2>
        <button class="modal-close-btn" onclick="closeModal('custom-village-modal')">✕</button>
      </div>
      <div class="modal-body" style="text-align: left; max-height: 70vh; overflow-y: auto;">
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; background: rgba(10,12,20,0.5); padding: 0.5rem 0.8rem; border-radius: 8px;">
          <span style="font-size: 0.85rem; color: var(--text-muted);">🏆 勝利ポイント:</span>
          <span class="points-display-badge">💰 <span id="custom-points-val">0</span> P</span>
        </div>

        <div class="custom-setting-row">
          <span>👥 参加人数 (<span id="custom-player-max-label">5〜12人</span>):</span>
          <div class="custom-counter">
            <button class="counter-btn" onclick="changeCustomPlayers(-1)">-</button>
            <span class="counter-val" id="custom-player-val">8</span>
            <button class="counter-btn" onclick="changeCustomPlayers(1)">+</button>
          </div>
        </div>

        <div style="font-size: 0.8rem; color: var(--text-muted); margin: 0.8rem 0 0.2rem 0; font-weight: bold;">【基本配役】</div>

        <div class="custom-setting-row">
          <span>🐺 擬態モンスター:</span>
          <div class="custom-counter">
            <button class="counter-btn" onclick="changeCustomRole('wolf', -1)">-</button>
            <span class="counter-val" id="custom-role-wolf">2</span>
            <button class="counter-btn" onclick="changeCustomRole('wolf', 1)">+</button>
          </div>
        </div>

        <div class="custom-setting-row">
          <span>🔮 賢者:</span>
          <div class="custom-counter">
            <button class="counter-btn" onclick="changeCustomRole('seer', -1)">-</button>
            <span class="counter-val" id="custom-role-seer">1</span>
            <button class="counter-btn" onclick="changeCustomRole('seer', 1)">+</button>
          </div>
        </div>

        <div class="custom-setting-row">
          <span>👻 聖職者:</span>
          <div class="custom-counter">
            <button class="counter-btn" onclick="changeCustomRole('medium', -1)">-</button>
            <span class="counter-val" id="custom-role-medium">1</span>
            <button class="counter-btn" onclick="changeCustomRole('medium', 1)">+</button>
          </div>
        </div>

        <div class="custom-setting-row">
          <span>🛡️ 聖騎士:</span>
          <div class="custom-counter">
            <button class="counter-btn" onclick="changeCustomRole('knight', -1)">-</button>
            <span class="counter-val" id="custom-role-knight">1</span>
            <button class="counter-btn" onclick="changeCustomRole('knight', 1)">+</button>
          </div>
        </div>

        <div class="custom-setting-row">
          <span>💗 魔教徒:</span>
          <div class="custom-counter">
            <button class="counter-btn" onclick="changeCustomRole('madman', -1)">-</button>
            <span class="counter-val" id="custom-role-madman">1</span>
            <button class="counter-btn" onclick="changeCustomRole('madman', 1)">+</button>
          </div>
        </div>

        <div class="custom-setting-row">
          <span>🍞 パン屋:</span>
          <div class="custom-counter">
            <button class="counter-btn" onclick="changeCustomRole('baker', -1)">-</button>
            <span class="counter-val" id="custom-role-baker">0</span>
            <button class="counter-btn" onclick="changeCustomRole('baker', 1)">+</button>
          </div>
        </div>

        <div style="font-size: 0.8rem; color: var(--accent-amber); margin: 1rem 0 0.2rem 0; font-weight: bold;">【ショップアンロック役職】</div>

        <!-- ケーキ屋 (6P) -->
        <div class="custom-setting-row" id="custom-row-cakeShop">
          <span>🍰 ケーキ屋 (6 P):</span>
          <div id="custom-ctrl-cakeShop"></div>
        </div>

        <!-- 共有者 (10P) -->
        <div class="custom-setting-row" id="custom-row-freemason">
          <span>🤝 共有者ペア (10 P):</span>
          <div id="custom-ctrl-freemason"></div>
        </div>

        <!-- 狩人 (16P) -->
        <div class="custom-setting-row" id="custom-row-hunter">
          <span>🏹 狩人 (16 P):</span>
          <div id="custom-ctrl-hunter"></div>
        </div>

        <!-- 猫又 (20P) -->
        <div class="custom-setting-row" id="custom-row-nekomata">
          <span>🐾 猫又 (20 P):</span>
          <div id="custom-ctrl-nekomata"></div>
        </div>

        <!-- 狂信者 (22P) -->
        <div class="custom-setting-row" id="custom-row-fanatic">
          <span>🔮 狂信者 (22 P):</span>
          <div id="custom-ctrl-fanatic"></div>
        </div>

        <!-- 黒服/身代わり (24P) -->
        <div class="custom-setting-row" id="custom-row-bodyguard">
          <span>🕶️ 黒服/身代わり (24 P):</span>
          <div id="custom-ctrl-bodyguard"></div>
        </div>

        <!-- 背徳者 (26P) -->
        <div class="custom-setting-row" id="custom-row-immoral">
          <span>🍷 背徳者 (26 P):</span>
          <div id="custom-ctrl-immoral"></div>
        </div>

        <!-- 妖狐 (30P) -->
        <div class="custom-setting-row" id="custom-row-fox">
          <span>🦊 妖狐 (30 P):</span>
          <div id="custom-ctrl-fox"></div>
        </div>

        <!-- 最大30人村 (30P) -->
        <div class="custom-setting-row" id="custom-row-maxPlayers30">
          <span>👥 最大30人村 (30 P):</span>
          <div id="custom-ctrl-maxPlayers30"></div>
        </div>

        <div class="custom-setting-row">
          <span>👨‍🌾 村人 (自動調整):</span>
          <span class="counter-val" id="custom-role-citizen" style="color: var(--accent-blue);">2</span>
        </div>

        <div class="custom-total-box valid" id="custom-valid-status">
          合計人数: 8 / 8 人 (配役 OK)
        </div>

      </div>
      <div class="modal-footer" style="margin-top: 1rem;">
        <button class="btn btn-primary" id="btn-start-custom-game" onclick="confirmCustomSettings()" style="width: 100%; padding: 0.65rem; font-weight: bold;">
          この設定でプレイ開始
        </button>
      </div>
    </div>
  </div>

  <!-- Settings Modal (ゲーム設定・音量調整) -->
  <div id="settings-modal" class="modal-overlay hidden" onclick="if(event.target===this) closeModal('settings-modal')">
    <div class="modal-content">
      <div class="modal-header">
        <h2>⚙ ゲーム設定</h2>
        <button class="modal-close-btn" onclick="closeModal('settings-modal')">✕</button>
      </div>
      <div class="modal-body">
        <div class="setting-item" style="margin-bottom: 1.2rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--border-color);">
          <div class="setting-label-row">
            <label for="language-setting" id="lbl-language-setting">🌐 Language / 言語</label>
          </div>
          <select id="language-setting" class="setting-select" onchange="changeLanguage(this.value)">
            <option value="ja">日本語 (Japanese)</option>
            <option value="en">English</option>
            <option value="zh">中文 (Chinese)</option>
            <option value="ko">한국어 (Korean)</option>
          </select>
        </div>

        <div class="setting-item" style="margin-bottom: 1.2rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--border-color);">
          <button class="btn btn-secondary" id="btn-open-name-modal" onclick="openNameModal()" style="width: 100%; font-weight: bold; background: linear-gradient(135deg, #1e293b, #0f172a); border: 1px solid var(--accent-gold); color: var(--accent-gold); padding: 0.7rem; font-size: 0.9rem;">
            📝 村人の名前設定（カスタマイズ）
          </button>
        </div>

        <div class="setting-item">
          <div class="setting-label-row">
            <label for="discussion-time-setting">💬 昼の議論時間</label>
          </div>
          <select id="discussion-time-setting" class="setting-select" onchange="updateDiscussionTimeSetting(this.value)">
            <option value="300" selected>5分（デフォルト）</option>
            <option value="180">3分</option>
            <option value="600">10分</option>
            <option value="-1">無制限</option>
          </select>
        </div>

        <div class="setting-item">
          <div class="setting-label-row">
            <label for="bgm-volume">🎵 BGM 音量</label>
            <span id="bgm-volume-val" class="volume-val">80%</span>
          </div>
          <input type="range" id="bgm-volume" min="0" max="100" value="80" oninput="updateVolume('bgm', this.value)">
        </div>

        <div class="setting-item">
          <div class="setting-label-row">
            <label for="se-volume">🔔 SE (効果音) 音量</label>
            <span id="se-volume-val" class="volume-val">80%</span>
          </div>
          <input type="range" id="se-volume" min="0" max="100" value="80" oninput="updateVolume('se', this.value)">
        </div>

        <div class="setting-item">
          <div class="setting-label-row">
            <label for="voice-volume">🗣️ Voice (音声) 音量</label>
            <span id="voice-volume-val" class="volume-val">80%</span>
          </div>
          <input type="range" id="voice-volume" min="0" max="100" value="80" oninput="updateVolume('voice', this.value)">
        </div>

        <div class="setting-item">
          <div class="setting-label-row">
            <label for="speech-enabled-toggle" id="lbl-speech-enabled">🎙️ ボイス / 読み上げ (TTS)</label>
          </div>
          <select id="speech-enabled-toggle" class="setting-select" onchange="updateSpeechEnabled(this.value)">
            <option value="true" selected>ON (有効)</option>
            <option value="false">OFF (無効)</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-primary" onclick="closeModal('settings-modal')">閉じる</button>
      </div>
    </div>
  </div>

  <!-- Name Settings Modal (村人の名前カスタマイズ) -->
  <div id="name-settings-modal" class="modal-overlay hidden" onclick="if(event.target===this) closeNameModal()">
    <div class="modal-content modal-large">
      <div class="modal-header">
        <h2>📝 村人の名前設定</h2>
        <button class="modal-close-btn" onclick="closeNameModal()">✕</button>
      </div>
      <div class="modal-body">
        <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0 0 0.5rem 0;">
          ゲーム内に登場する村人たちの名前（A〜T）を自由に変更できます。
        </p>

        <div id="name-input-list" class="name-input-scroll-container">
          <!-- JavaScriptで入力フォームを動的生成 -->
        </div>

        <div class="modal-btn-group" style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
          <button id="btn-name-random-auto" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); border-color: #60a5fa;" onclick="generateRandomNames('auto')">🎲 言語に合わせてランダム</button>
          <button id="btn-name-random-ja" onclick="generateRandomNames('japanese')">🎲 和風</button>
          <button id="btn-name-random-western" onclick="generateRandomNames('western')">🎲 洋風</button>
          <button id="btn-name-random-zh" onclick="generateRandomNames('chinese')">🎲 中華風</button>
          <button id="btn-name-random-ko" onclick="generateRandomNames('korean')">🎲 韓流風</button>
          <button id="btn-name-reset-default" onclick="resetDefaultNames()">🔄 デフォルト</button>
        </div>
      </div>
      <div class="modal-footer" style="gap: 0.5rem;">
        <button class="btn btn-secondary" onclick="closeNameModal()">キャンセル</button>
        <button class="btn btn-primary" onclick="saveCustomNames()">設定を保存</button>
      </div>
    </div>
  </div>

  <!-- How To Play Modal (ルール・遊び方説明) -->
  <div id="how-to-play-modal" class="modal-overlay hidden" onclick="if(event.target===this) closeModal('how-to-play-modal')">
    <div class="modal-content modal-large">
      <div class="modal-header">
        <h2>📖 遊び方・ルール</h2>
        <button class="modal-close-btn" onclick="closeModal('how-to-play-modal')">✕</button>
      </div>
      <div class="modal-body rule-explanation">
        <div class="rule-section">
          <h3>【操作方法】</h3>
          <p>昼の審判会議は左中右の３画面を切り替え、スワイプで推理して擬態モンスター（魔物）を見つけるヒントを活用してください。</p>
        </div>

        <div class="rule-section">
          <h3>【ゲームの目的】</h3>
          <p>村の中に人間に化けて潜んでいる「擬態モンスター（魔物）」を尋問と推理で見つけ出し、勇者の裁きで浄化して村に平和を取り戻しましょう！</p>
        </div>

        <div class="rule-section">
          <h3>【基本の流れ】</h3>
          <ul>
            <li><strong>☀️ 朝のフェーズ:</strong> 夜の犠牲者（魔物の夜襲被害）や各種役職のCO（カミングアウト）報告を確認します。</li>
            <li><strong>💬 昼の審判会議 (3分):</strong> 生存する村人たちの発言を観察し、定型尋問や自由尋問を使って疑わしい点を探ります。思考整理機能で役職予想を整理できます。</li>
            <li><strong>⚖️ 勇者の裁き (無制限):</strong> 昼の最後に最も怪しいと思う人物を1人選んで処刑（浄化）または見送りを選択します。</li>
            <li><strong>🌕 魔物の夜襲:</strong> 擬態モンスターが村人を襲撃し、賢者や聖職者は能力で正体を鑑定・霊視します。</li>
          </ul>
        </div>

        <div class="rule-section">
          <h3>【主要役職紹介】</h3>
          <div class="role-grid">
            <div class="role-item"><span class="role-badge role-villager">村人</span> 特別な能力を持たない市民。観察と推理で村を導きます。</div>
            <div class="role-item"><span class="role-badge role-seer">賢者</span> 毎夜1人を鑑定し、魔物か人間かを知ることができます。</div>
            <div class="role-item"><span class="role-badge role-medium">聖職者</span> 毎夜、前日に処刑（浄化）された人物の正体を霊視できます。</div>
            <div class="role-item"><span class="role-badge role-knight">聖騎士</span> 毎夜1人を魔物の夜襲から守ることができます。</div>
            <div class="role-item"><span class="role-badge role-wolf">擬態モンスター</span> 人間に化けた邪悪な存在。毎夜村人1人を襲撃します。</div>
            <div class="role-item"><span class="role-badge role-madman">魔教徒</span> 魔物陣営の人間。魔物の勝利を目指します。</div>
            <div class="role-item"><span class="role-badge role-baker">パン屋</span> 生きていれば毎朝村においしいパンを届けます。</div>
            <div class="role-item"><span class="role-badge role-freemason">共有者</span> お互いが人間であることを知っている2人組です。</div>
            <div class="role-item"><span class="role-badge role-fox">妖狐</span> 鑑定されると呪殺されますが、夜襲に耐えます。</div>
          </div>
        </div>

        <div class="rule-section">
          <h3>【ショップアンロック役職・機能】</h3>
          <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.5rem;">※勝利ポイント（P）を消費してカスタマイズ村で解放できる特殊役職・機能です。</p>
          <div class="role-grid">
            <div class="role-item"><span class="role-badge role-cakeshop">🍰 ケーキ屋</span> (6P) 生きていれば毎朝村においしいケーキを届けます。</div>
            <div class="role-item"><span class="role-badge role-freemason">🤝 共有者ペア</span> (10P) 2人組でお互いが人間であることを認知し合う仲間です。</div>
            <div class="role-item"><span class="role-badge role-hunter">🏹 狩人</span> (16P) 毎夜1人を魔物の夜襲から守ることができる村人の護衛手です。</div>
            <div class="role-item"><span class="role-badge role-nekomata">🐾 猫又</span> (20P) 処刑時に投票者から1人を道連れにし、襲撃時には襲撃した魔物を道連れにします。</div>
            <div class="role-item"><span class="role-badge role-fanatic">🔮 狂信者</span> (22P) どの人物が魔物であるかを初めからすべて知っている狂信的な人間です。</div>
            <div class="role-item"><span class="role-badge role-bodyguard">🕶️ 黒服/身代わり</span> (24P) 毎夜1人を護衛し、魔物の襲撃を受けた際に自らが身代わりとなって守ります。</div>
            <div class="role-item"><span class="role-badge role-immoral">🍷 背徳者</span> (26P) 妖狐の正体を知っており、妖狐の単独勝利を全面的に手助けする愛好者です。</div>
            <div class="role-item"><span class="role-badge role-fox">🦊 妖狐</span> (30P) 魔物の夜襲では倒されませんが、賢者に鑑定されると呪殺される第3陣営です。</div>
            <div class="role-item"><span class="role-badge role-villager" style="background:#6366f1;">👥 最大30人村</span> (30P) 参加人数を30人に拡張し、伝説級「神話の村（30名）」を解放します。</div>
          </div>
        </div>

        <div class="rule-section">
          <h3>【勝敗条件】</h3>
          <p><strong>🔵 勇者・村人陣営の勝利:</strong> 全ての擬態モンスター（魔物）を浄化する</p>
          <p><strong>🔴 擬態モンスター（魔物）陣営の勝利:</strong> 魔物の数が生存村人の数と同数以上になる</p>
          <p><strong>🦊 妖狐の勝利:</strong> ゲーム終了時に妖狐が生存している（単独勝利）</p>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-primary" onclick="closeModal('how-to-play-modal')">閉じる</button>
      </div>
    </div>
  </div>

  <!-- Rank Info Modal -->
  <div id="rank-info-modal" class="modal-overlay hidden" onclick="if(event.target===this) closeModal('rank-info-modal')">
    <div class="modal-content" style="max-width: 600px; width: 94%;">
      <div class="modal-header">
        <h2>🏆 推理ランク＆実績分析</h2>
        <button class="modal-close-btn" onclick="closeModal('rank-info-modal')">✕</button>
      </div>
      <div class="modal-body" id="rank-modal-body" style="max-height: 75vh; overflow-y: auto;">
        <!-- Dynamically rendered via renderRankModalContent() -->
      </div>
      <div class="modal-footer">
        <button class="btn btn-primary" onclick="closeModal('rank-info-modal')">閉じる</button>
      </div>
    </div>
  </div>

  <!-- 📜 冒険の書（全3巻）モーダル -->
  <div id="save-slot-modal" class="modal-overlay hidden" onclick="if(event.target===this) returnToTitleScreen()">
    <div class="modal-content" style="max-width: 520px; width: 94%;">
      <!-- ゲームタイトル＆メニューヘッダー（画像2準拠） -->
      <div style="text-align: center; margin-bottom: 0.8rem; padding-bottom: 0.7rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
        <h1 class="main-title" style="margin: 0.2rem 0; font-size: 1.65rem; color: #f8fafc; letter-spacing: 2px;">ぼっち人狼<br><span class="sub-title" style="font-size: 1.05rem; font-weight: normal; color: var(--accent-red);">〜審判の勇者〜</span></h1>
        <div class="title-sub-buttons" style="margin-top: 0.7rem; display: flex; gap: 0.5rem; justify-content: center;">
          <button class="btn-title-sub" onclick="openModal('how-to-play-modal')" style="flex: 1; padding: 0.55rem; font-size: 0.85rem;">📖 遊び方</button>
          <button class="btn-title-sub" onclick="openRankModal()" style="flex: 1; padding: 0.55rem; font-size: 0.85rem;">🏆 勇者ランク</button>
          <button class="btn-title-sub" onclick="openModal('settings-modal')" style="flex: 1; padding: 0.55rem; font-size: 0.85rem;">⚙ 設定</button>
        </div>
      </div>

      <div class="modal-header" style="padding-top: 0.2rem;">
        <h2 style="font-size: 1.15rem;">📜 冒険の書（全3巻）</h2>
        <button class="modal-close-btn" onclick="returnToTitleScreen()">✕</button>
      </div>
      <div class="modal-body" style="max-height: 65vh; overflow-y: auto;">
        <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.6rem;">
          試練の旅路の記憶（あらすじ）を『冒険の書 第一巻〜第三巻』に書き記し、いつでも復元・消去できます。
        </div>
        <div id="save-slot-list-container" class="save-slot-list">
          <!-- Dynamically generated save slots overview -->
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-primary" onclick="returnToTitleScreen()">閉じる</button>
      </div>
    </div>
  </div>

  <!-- MODE SELECT MODAL -->
  <div id="mode-select-modal" class="modal-overlay hidden" onclick="if(event.target===this) returnToTitleScreen()">
    <div class="modal-content" style="max-width: 520px; text-align: center;">
      <div class="modal-header">
        <h2>⚔️ 遠征モードの選択</h2>
        <button class="modal-close-btn" onclick="returnToTitleScreen()">✕</button>
      </div>
      <div class="modal-body" style="padding: 1.2rem 0.5rem;">
        <div style="font-size: 0.85rem; color: #fde68a; margin-bottom: 1.2rem;">
          冒険の書に刻む試練の形式を選択してください。
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <!-- STORY MODE BUTTON -->
          <div style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(180, 83, 9, 0.3)); border: 2px solid #fbbf24; border-radius: 12px; padding: 1rem; cursor: pointer; text-align: left; transition: transform 0.2s, box-shadow 0.2s;" 
               onclick="selectPlayMode('story')" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
            <div style="font-size: 1.15rem; font-weight: bold; color: #fbbf24; display: flex; align-items: center; justify-content: space-between;">
              <span>📜 ストーリーモード <span style="font-size: 0.8rem; font-weight: normal; color: #fef08a;">(勇者の遠征記)</span></span>
              <span style="font-size: 0.8rem; background: #d97706; color: #fff; padding: 0.15rem 0.5rem; border-radius: 10px;">全5章構造</span>
            </div>
            <div style="font-size: 0.82rem; color: #cbd5e1; margin-top: 0.4rem; line-height: 1.4;">
              物語に沿って第1章「始まりの村(5人)」から最終決戦 第5章「絶望の村(20人)」まで順に試練を攻略します。専用IQ・戦績が冒険の書へ永久記録されます。
            </div>
          </div>

          <!-- FREE MODE BUTTON -->
          <div style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(29, 78, 216, 0.3)); border: 2px solid #60a5fa; border-radius: 12px; padding: 1rem; cursor: pointer; text-align: left; transition: transform 0.2s, box-shadow 0.2s;" 
               onclick="selectPlayMode('free')" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
            <div style="font-size: 1.15rem; font-weight: bold; color: #60a5fa; display: flex; align-items: center; justify-content: space-between;">
              <span>🛡️ フリーモード <span style="font-size: 0.8rem; font-weight: normal; color: #93c5fd;">(審判の模擬戦)</span></span>
              <span style="font-size: 0.8rem; background: #2563eb; color: #fff; padding: 0.15rem 0.5rem; border-radius: 10px;">単発・カスタム</span>
            </div>
            <div style="font-size: 0.82rem; color: #cbd5e1; margin-top: 0.4rem; line-height: 1.4;">
              好きな難易度の村（6人〜15人）やデイリー・カスタム設定を自由に選んで単発で模擬戦を行います。お試しや腕試しに最適です。
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="returnToTitleScreen()">戻る</button>
      </div>
    </div>
  </div>

  <!-- STORY CHAPTER MODAL -->
  <div id="story-chapter-modal" class="modal-overlay hidden" onclick="if(event.target===this) returnToTitleScreen()">
    <div class="modal-content" style="max-width: 600px;">
      <div class="modal-header">
        <h2>📜 勇者の遠征記 - 章選択</h2>
        <button class="modal-close-btn" onclick="returnToTitleScreen()">✕</button>
      </div>
      <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">
        <div id="story-book-status-header" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 8px; padding: 0.6rem 0.8rem; margin-bottom: 1rem; font-size: 0.85rem; color: #fef08a; display: flex; justify-content: space-between; align-items: center;">
          <!-- Dynamically populated story mode status -->
        </div>

        <div id="story-chapters-list-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
          <!-- Dynamically generated 5 chapters -->
        </div>
      </div>
      <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center;">
        <button class="btn" style="background: linear-gradient(135deg, #991b1b, #7f1d1d); color: #fca5a5; border: 1px solid #dc2626; font-size: 0.78rem; padding: 0.4rem 0.7rem;" onclick="confirmStoryReset()">🔄 全リセット</button>
        <button class="btn btn-secondary" onclick="returnToTitleScreen()">戻る</button>
      </div>
    </div>
  </div>

  <!-- GRAND ENDING MODAL -->
  <div id="grand-ending-modal" class="modal-overlay hidden">
    <div class="modal-content" style="max-width: 650px; background: linear-gradient(145deg, #1c1917, #292524); border: 3px solid #fbbf24; box-shadow: 0 0 35px rgba(251, 191, 36, 0.4); text-align: center; padding: 1.5rem;">
      <div style="font-size: 2.2rem; margin-bottom: 0.5rem;">✨🏆✨</div>
      <h2 id="grand-ending-title" style="font-size: 1.4rem; color: #fbbf24; font-family: 'Georgia', serif; text-shadow: 0 2px 8px rgba(0,0,0,0.8); margin-bottom: 1rem; border-bottom: 2px dashed rgba(251, 191, 36, 0.4); padding-bottom: 0.6rem;">
        【絶望を越えて ―― 救世の勇者】
      </h2>

      <div id="grand-ending-content" style="font-size: 0.88rem; color: #fef3c7; line-height: 1.85; text-align: left; background: rgba(0,0,0,0.5); padding: 1rem 1.2rem; border-radius: 8px; border-left: 4px solid #fbbf24; margin-bottom: 1.2rem; max-height: 45vh; overflow-y: auto; white-space: pre-wrap;">20人の疑心が渦巻く「絶望の村」に、静寂が訪れる。

妖狐の妖しい幻影を破り、4体の魔物を全て審判の剣で討ち果たした瞬間、村を覆っていた不吉な暗雲がゆっくりと裂けていった。

擬態モンスターの脅威は去った。
人間に化け、絆を切り裂き、世界を喰らい尽くそうとしていた悪魔は、勇者の「神眼」の前に一体残らず駆逐されたのだ。

差し込む一筋の朝光が、傷つきながらも生き残った村人たちと勇者を温かく包み込む。
人々は涙を流しながら膝を折り、絶対の審判者に感謝の祈りを捧げた。

「讃えよ、審判の勇者を。その剣は偽りを断ち、世界に永遠の平和をもたらした」

レムの王国の歴史に、新たな伝説が今、刻まれたのである――。</div>

      <div id="grand-ending-stats" style="background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 8px; padding: 0.8rem; margin-bottom: 1.2rem; font-size: 0.95rem; color: #fff; display: flex; flex-direction: column; gap: 0.4rem;">
        <!-- Dynamically rendered end stats -->
      </div>

      <div>
        <button class="btn-start-game" style="width: 100%; max-width: 340px; font-size: 1.05rem; margin: 0 auto;" onclick="returnToTitleFromGrandEnding()">
          📜 冒険の書に栄光を刻み、タイトルへ
        </button>
      </div>
    </div>
  </div>
  <div id="mind-board-modal" class="modal-overlay hidden" onclick="if(event.target===this) closeModal('mind-board-modal')">
    <div class="modal-content" style="max-width: 96vw; width: 96vw; max-height: 94vh; padding: 1rem;">
      <div class="modal-header">
        <h2>🧠 思考整理ボード（相関図・メモ）</h2>
        <button class="modal-close-btn" onclick="closeModal('mind-board-modal')">✕</button>
      </div>
      
      <!-- タブ切替ボタン -->
      <div class="mind-tab-buttons" style="display: flex; gap: 0.5rem; margin-bottom: 0.8rem;">
        <button class="category-tab active" id="mind-tab-corr" onclick="switchMindTab('corr')">🕸️ 人物相関図</button>
        <button class="category-tab" id="mind-tab-markers" onclick="switchMindTab('markers')">📌 マーカーメモ発言</button>
      </div>

      <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">
        <!-- TAB 1: 人物相関図 -->
        <div id="mind-tab-content-corr">
          <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.6rem;">
            キャラアイコンを順番に2人タップして矢印線を引き、人物関係を整理できます。
          </div>
          
          <!-- 線種選択バー -->
          <div class="corr-tool-bar">
            <span>矢印の種類:</span>
            <label class="corr-type-btn active" data-type="suspicion" onclick="selectCorrType('suspicion', this)">
              🔴 疑い
            </label>
            <label class="corr-type-btn" data-type="trust" onclick="selectCorrType('trust', this)">
              🔵 信頼
            </label>
            <label class="corr-type-btn" data-type="conflict" onclick="selectCorrType('conflict', this)">
              ⚔️ 対立
            </label>
            <label class="corr-type-btn" data-type="co_counter" onclick="selectCorrType('co_counter', this)">
              🔮 対抗CO
            </label>
            <button class="btn btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.78rem; margin-left: auto;" onclick="clearAllCorrLines()">
              🗑️ 全リセット
            </button>
          </div>

          <!-- 相関図描画キャンバス＆ノードエリア -->
          <div class="corr-board-container" id="corr-board-container">
            <svg class="corr-svg-layer" id="corr-svg-layer"></svg>
            <div class="corr-nodes-grid" id="corr-nodes-grid"></div>
          </div>

          <!-- 設定された相関線リスト -->
          <div style="margin-top: 0.8rem;">
            <div style="font-weight: bold; font-size: 0.85rem; color: var(--accent-amber); margin-bottom: 0.3rem;">
              引いた相関線一覧:
            </div>
            <div id="corr-lines-list" class="corr-lines-list"></div>
          </div>
        </div>

        <!-- TAB 2: マーカーメモ発言 -->
        <div id="mind-tab-content-markers" style="display: none;">
          <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.6rem;">
            ログ画面でタグ付けしたマーカー発言の一覧です。
          </div>
          <div id="marked-logs-container" class="marked-logs-container">
            <!-- Dynamic marked logs -->
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-primary" onclick="closeModal('mind-board-modal')">閉じる</button>
      </div>
    </div>
  </div>





  <script>
    // --- BGM Manager & Audio Tracks ---
    const bgmTracks = {
      title: new Audio('BGM/Cathedral BlackoutTITLE.mp3'),
      asa: new Audio('BGM/Frosted Thresholdasa.mp3'),
      hiru: new Audio('BGM/Clueboard Tickhiru.mp3'),
      syokei: new Audio('BGM/Countdown Pulsesyokei.mp3'),
      uruf: new Audio('BGM/Moonbone Howluruf.mp3'),
      syouri: new Audio('BGM/Sunlit Villagesyouri.mp3'),
      haiboku: new Audio('BGM/After The Stormhaiboku.mp3')
    };

    let currentBgmKey = null;
    let currentBgm = null;
    let audioUnlocked = false;

    function unlockAudioOnInteraction() {
      if (audioUnlocked) return;
      audioUnlocked = true;
      initAudio();
      if (currentBgmKey && currentBgm && currentBgm.paused) {
        currentBgm.play().catch(e => console.log('BGM Autoplay Unlock Error:', e));
      } else if (!currentBgmKey) {
        playBgm('title');
      }
    }

    // Register user gesture handlers for autoplay unlock
    window.addEventListener('click', unlockAudioOnInteraction, { once: true });
    window.addEventListener('touchstart', unlockAudioOnInteraction, { once: true });
    window.addEventListener('keydown', unlockAudioOnInteraction, { once: true });

    // =====================================================
    // 🌐 Cloudflare Workers プロキシ経由 Gemini API 通信モジュール
    // =====================================================
    const AI_PROXY_URL = "https://werewolf-proxy.peeaizero.workers.dev";
    let isOfflineMode = false;     // 自動ローカルAIモード（通信上限・エラー時）
    let useLLMMode = true;         // 手動LLMモードスイッチ
    let llmConsecutiveFailures = 0; // 連続失敗カウント
    const LLM_MAX_FAILURES = 3;    // 連続失敗閾値を超えたら自動OFF
    const LLM_TIMEOUT_MS = 8000;   // タイムアウト8秒

    /**
     * ユーザーへのトースト通知表示関数
     * @param {string} msg 
     */
    function showNotification(msg) {
      const toast = document.getElementById('toast-notification');
      const toastMsg = document.getElementById('toast-message');
      if (toast && toastMsg) {
        toastMsg.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
        }, 4000);
      }
    }

    /**
     * API通信なしで動作するフォールバック用応答生成
     * @param {string} promptText 
     * @param {object} agentProfile 
     * @returns {string}
     */
    function getLocalFallbackResponse(promptText, agentProfile) {
      const lang = currentAppLanguage || 'ja';
      const roleRaw = agentProfile?.role || "村人";
      const roleDisplayMap = {
        '村人': { ja: '村人', en: 'villager', zh: '村民', ko: '마을 주민' },
        '賢者': { ja: '賢者', en: 'Sage', zh: '贤者', ko: '현자' },
        '聖職者': { ja: '聖職者', en: 'Cleric', zh: '圣职者', ko: '성직자' },
        '聖騎士': { ja: '聖騎士', en: 'Holy Knight', zh: '圣骑士', ko: '성기사' },
        '魔教徒': { ja: '魔教徒', en: 'Cultist', zh: '魔教徒', ko: '광신도' },
        '擬態モンスター': { ja: '擬態モンスター', en: 'Mimicry Monster', zh: '拟态怪物', ko: '의태 괴물' }
      };
      const role = (roleDisplayMap[roleRaw] && roleDisplayMap[roleRaw][lang]) || roleRaw;

      const discussionTemplates = {
        ja: [
          `私は${role}の視点から怪しい発言を探しています。今のところ目立った矛盾は見えませんね。`,
          `静観していましたが、議論が少し偏っていませんか？勇者様の裁きに向けて慎重に見極めたいです。`,
          `発言が少なめの人の中に擬態モンスターが潜んでいる気がします。皆さんはどう思いますか？`,
          `情報がまだ少ないですね。各自の意見をしっかり聞いて、真の魔物を見つけ出しましょう。`
        ],
        en: [
          `From my perspective as a ${role}, I have been searching for suspicious remarks. As yet, no glaring contradiction hath revealed itself.`,
          `I held my silence, yet methinks the discourse hath grown somewhat one-sided. We must weigh our words with care ere the Hero passes judgment.`,
          `I sense that a mimicry monster may lurk among those who speak least. What say ye all?`,
          `We lack sufficient intelligence as of now. Let us heed each voice in turn, that we may unmask the true beast.`
        ],
        zh: [
          `在下以${role}之视角审视可疑言辞，暂时尚未发现明显矛盾之处。`,
          `某一直静观其变，但总觉议论似有偏颇。在勇者大人裁决之前，当慎之又慎。`,
          `总觉沉默寡言之人中暗藏拟态妖物。诸位以为如何？`,
          `现有情报尚且不足。且让我等广纳各方意见，揪出真正的魔物罢。`
        ],
        ko: [
          `저는 ${role}의 관점에서 수상한 발언을 찾고 있소. 지금까지는 뚜렷한 모순이 보이지 않는군요.`,
          `지켜보고 있었으나, 논의가 다소 편향되지 않았소? 용사님의 심판을 위해 신중히 가려야 하오.`,
          `발언이 적은 이들 속에 의태 괴물이 숨어 있는 것 같소이다. 여러분은 어찌 생각하시오?`,
          `아직 정보가 부족하오. 각자의 의견을 잘 들어 진정한 마물을 밝혀냅시다.`
        ]
      };

      const templates = discussionTemplates[lang] || discussionTemplates.ja;
      const randomIndex = Math.floor(Math.random() * templates.length);
      return `${templates[randomIndex]}`;
    }

    /**
     * Cloudflare Worker プロキシ経由で Gemini API を安全に呼び出す関数
     * @param {string} promptText - AIに渡す指示・プロンプト
     * @param {object} agentProfile - オプションのプロファイル情報
     * @returns {Promise<string|null>} - AIからの返答テキスト。失敗時はnull
     */
    async function callAIEngine(promptText, agentProfile = null) {
      // 既にオフラインモードになっている場合はローカルエンジンへ
      if (isOfflineMode || !useLLMMode) {
        return getLocalFallbackResponse(promptText, agentProfile);
      }

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), LLM_TIMEOUT_MS);

      try {
        const response = await fetch(AI_PROXY_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ prompt: promptText }),
          signal: controller.signal
        });

        clearTimeout(timeoutId);

        // 上限到達(429)やサーバーエラー(500番台)の検知
        if (response.status === 429 || response.status >= 500) {
          console.warn(`[API Limit Detected] ステータス ${response.status}: オフラインモードへ自動切替します。`);
          isOfflineMode = true;
          showNotification("⚡ 通信上限に達したため、ローカルAIモードに切り替えました。");
          return getLocalFallbackResponse(promptText, agentProfile);
        }

        if (!response.ok) {
          throw new Error(`HTTP Error: ${response.status}`);
        }

        const data = await response.json();

        if (data && data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
          llmConsecutiveFailures = 0; // 成功したらリセット
          const rawText = data.candidates[0].content.parts[0].text;
          return rawText.replace(/```[a-z]*\n?/g, '').replace(/\*\*/g, '').replace(/#+\s*/g, '').trim();
        } else {
          console.warn("AIレスポンス構造が不適切:", data);
          throw new Error("Invalid response structure");
        }
      } catch (error) {
        clearTimeout(timeoutId);
        llmConsecutiveFailures++;
        console.warn(`[LLM] 通信エラー (${llmConsecutiveFailures}/${LLM_MAX_FAILURES}):`, error.message);

        if (llmConsecutiveFailures >= LLM_MAX_FAILURES || error.name === 'AbortError') {
          isOfflineMode = true;
          console.warn("[LLM] エラー検知 → 軽量AI（ローカル）モードへ自動切替します。");
          showNotification("⚡ 通信エラーが発生したため、軽量AIモードで継続します。");
          return getLocalFallbackResponse(promptText, agentProfile);
        }
        return null;
      }
    }

    /**
     * 現在のゲーム盤面コンテキストをテキストに構造化する関数
     * @returns {string} 盤面コンテキストテキスト
     */
    function buildGameContextText() {
      if (!gameState || !gameState.charList) return '（盤面情報なし）';

      const aliveList = gameState.charList.filter(c => gameState.status && gameState.status[c] === 'alive');
      const deadList = gameState.charList.filter(c => gameState.status && gameState.status[c] !== 'alive');

      let ctx = `■ 現在の盤面情報\n`;
      ctx += `・日数: ${gameState.day || 1}日目\n`;
      ctx += `・生存者(${aliveList.length}名): ${aliveList.map(c => getCharDisplayName(c)).join('、')}\n`;
      if (deadList.length > 0) {
        ctx += `・死亡者(${deadList.length}名): ${deadList.map(c => getCharDisplayName(c)).join('、')}\n`;
      }

      // CO状況
      const coEntries = [];
      aliveList.forEach(c => {
        const co = gameState.coRoles ? gameState.coRoles[c] : null;
        if (co && co !== 'grey' && co !== 'villager') {
          const roleMap = { seer: '賢者', medium: '聖職者', knight: '聖騎士', freemason: '共有者' };
          coEntries.push(`${getCharDisplayName(c)}→${roleMap[co] || co}CO`);
        }
      });
      if (coEntries.length > 0) {
        ctx += `・CO状況: ${coEntries.join('、')}\n`;
      }

      // 占い結果
      if (gameState.seerHistory) {
        const seerEntries = [];
        Object.keys(gameState.seerHistory).forEach(seer => {
          const history = gameState.seerHistory[seer];
          if (history && history.length > 0) {
            history.forEach(h => {
              seerEntries.push(`${getCharDisplayName(seer)}が${getCharDisplayName(h.target)}を占い→${h.result}`);
            });
          }
        });
        if (seerEntries.length > 0) {
          ctx += `・占い結果履歴: ${seerEntries.join('、')}\n`;
        }
      }

      // 霊媒結果
      if (gameState.mediumHistory) {
        const medEntries = [];
        Object.keys(gameState.mediumHistory).forEach(med => {
          const history = gameState.mediumHistory[med];
          if (history && history.length > 0) {
            history.forEach(h => {
              medEntries.push(`${getCharDisplayName(med)}が${getCharDisplayName(h.target)}を霊視→${h.result}`);
            });
          }
        });
        if (medEntries.length > 0) {
          ctx += `・霊媒結果履歴: ${medEntries.join('、')}\n`;
        }
      }

      // 直近の議論ログ
      if (gameState.aiDiscussionHistory && gameState.aiDiscussionHistory.length > 0) {
        const recentLogs = gameState.aiDiscussionHistory.slice(-5);
        ctx += `・直近の議論ログ:\n`;
        recentLogs.forEach(log => {
          ctx += `  [${getCharDisplayName(log.char)}]: ${log.text.substring(0, 100)}\n`;
        });
      }

      return ctx;
    }

    /**
     * プレイヤーからの自由質問用LLMプロンプトを構築する関数
     * @param {string} speakerChar - 回答するAIキャラクターのキー
     * @param {string} playerQuestion - プレイヤーの質問テキスト
     * @returns {string} 構築されたプロンプト
     */
    function buildQuestionPrompt(speakerChar, playerQuestion) {
      const speakerName = getCharDisplayName(speakerChar);
      const prof = (gameState.charProfiles && gameState.charProfiles[speakerChar]) || AI_PROFILES[0];
      const realRole = (gameState.roles && gameState.roles[speakerChar]) || 'villager';
      const coRole = (gameState.coRoles && gameState.coRoles[speakerChar]) || 'grey';
      const roleMap = { villager: '村人', wolf: '擬態モンスター', seer: '賢者', medium: '聖職者', knight: '聖騎士', freemason: '共有者', fox: '妖狐', madman: '魔教徒' };

      const gameContext = buildGameContextText();

      // 占い履歴
      let seerInfo = '';
      const seerHistory = (gameState.seerHistory && gameState.seerHistory[speakerChar]) || [];
      if (seerHistory.length > 0) {
        seerInfo = `あなたの占い履歴: ${seerHistory.map(h => `${getCharDisplayName(h.target)}→${h.result}`).join('、')}\n`;
      }

      // 投票先
      let voteInfo = '';
      const myVote = (gameState.virtualVotes && gameState.virtualVotes[speakerChar]);
      if (myVote && myVote.target) {
        voteInfo = `あなたの現在の処刑候補: ${getCharDisplayName(myVote.target)} (理由: ${myVote.reason || '不明'})\n`;
      }

      // 役職対抗・黒出し情報
      let claimantRule = '';
      if (typeof getClaimantSuspicionTarget === 'function') {
        const claimantTarget = getClaimantSuspicionTarget(speakerChar);
        if (claimantTarget) {
          if (claimantTarget.reasonType === 'co_conflict') {
            claimantRule = `9. 【最重要対抗ルール】あなたと同じ役職【${claimantTarget.roleName}】をCOしている対抗者【${claimantTarget.targetName}】が存在します。あなたにとって相手は100%偽物の騙り（魔物または魔教徒）です。誰が一番怪しいか、誰を浄化・処刑すべきかを問われた場合、必ず対抗の【${claimantTarget.targetName}】を偽物・魔物として名指しで弾劾してください。\n`;
          } else if (claimantTarget.reasonType === 'inspection_black') {
            claimantRule = `9. 【能力判定ルール】あなたは【${claimantTarget.targetName}】に対して能力で魔物（黒判定）を出しています。誰が一番怪しいか、誰を浄化・処刑すべきかを問われた場合、確定魔物である【${claimantTarget.targetName}】を最優先で指名してください。\n`;
          }
        }
      }

      // 言語強制指示（日本語以外のとき、LLMに出力言語を厳格に指定）
      const langNames = { ja: 'Japanese', en: 'English', zh: 'Simplified Chinese', ko: 'Korean' };
      const targetLangName = langNames[currentAppLanguage] || 'Japanese';
      const langInstruction = currentAppLanguage && currentAppLanguage !== 'ja' ? `【CRITICAL LANGUAGE RULE】You MUST write your ENTIRE response strictly in ${targetLangName}. Do NOT output any Japanese text. Every single word of dialogue must be in ${targetLangName}.\n\n` : '';

      return `${langInstruction}あなたたちは中世ファンタジー風の村「レムの村」の住民です。
村の中には「人間に化けた擬態モンスター（魔物）」が潜伏しています。
目の前には村を救うために訪れた「勇者（プレイヤー）」がおり、勇者の裁きによって本日追放される者が決まります。

あなたはレムの村の住民「${speakerName}」です。
あなたの本当の役職は【${roleMap[realRole] || realRole}】ですが、${coRole !== 'grey' && coRole !== 'villager' ? `すでに【${roleMap[coRole] || coRole}】としてCOを完了しています。` : 'まだ役職COしていません。'}
性格タイプ: ${prof.archetype || '標準'} (攻撃性:${prof.aggression}, 論理性:${prof.logicLevel}, 頑固さ:${prof.stubbornness})
口調: ${prof.speechStyle || '丁寧語'}

${gameContext}
${seerInfo}${voteInfo}

【会話・絶対ルール】
1. 自分の役職（村人/賢者/聖職者/聖騎士/魔教徒/擬態モンスター等）になりきって発言してください。
2. 「人狼」「占い師」「霊媒師」「狂人」「騎士」などの現代用語は使わず、「魔物」「賢者」「聖職者」「魔教徒」「聖騎士」と表現してください。
3. 勇者（プレイヤー）に対して敬意を払うか、生き残るために必死に自己主張してください。
4. 1文目は必ず「${speakerName}です。（質問に対する直接の結論）」の形式で答えてください。
5. ${coRole !== 'grey' && coRole !== 'villager' ? `あなたはすでに【${roleMap[coRole] || coRole}】としてCO済みです。絶対に他の役職（聖騎士や聖職者など）を後から名乗ったり撤回したりしないでください。` : (realRole !== 'wolf' && realRole !== 'madman' && realRole !== 'villager' ? `あなたは【${roleMap[realRole] || realRole}】です。COする場合は【${roleMap[realRole] || realRole}】のみを名乗ってください。` : '真村人は嘘の役職（賢者・聖騎士など）をCOすることは禁止です。')}
6. ゲーム内に存在しない架空の鑑定結果や投票行動を捏造しないでください。
7. 判断材料がない場合は「現時点では情報不足で判断保留」と正直に答えてください。
8. 回答は2〜3文の簡潔なものにしてください（長文禁止）。
${claimantRule}
勇者（プレイヤー）からの質問: 「${playerQuestion}」

上記の盤面情報とルールに基づいて、${speakerName}として回答してください:`;
    }

    /**
     * AI同士の議論用LLMプロンプトを構築する関数
     * @param {string} speakerChar - 発言するAIキャラクターのキー
     * @param {string|null} lastSpeakerText - 直前の発言テキスト
     * @param {string|null} lastSpeakerChar - 直前の発言者
     * @returns {string} 構築されたプロンプト
     */
    function buildDiscussionPrompt(speakerChar, lastSpeakerText, lastSpeakerChar) {
      const speakerName = getCharDisplayName(speakerChar);
      const prof = (gameState.charProfiles && gameState.charProfiles[speakerChar]) || AI_PROFILES[0];
      const realRole = (gameState.roles && gameState.roles[speakerChar]) || 'villager';
      const coRole = (gameState.coRoles && gameState.coRoles[speakerChar]) || 'grey';
      const roleMap = { villager: '村人', wolf: '擬態モンスター', seer: '賢者', medium: '聖職者', knight: '聖騎士', freemason: '共有者', fox: '妖狐', madman: '魔教徒' };

      const gameContext = buildGameContextText();

      // 論理推理の結論
      let deductionInfo = '';
      try {
        const logicalDeduction = getLogicalDeductionTarget(speakerChar);
        if (logicalDeduction) {
          deductionInfo = `論理推理による最有力容疑者: ${getCharDisplayName(logicalDeduction.target)} (${logicalDeduction.reason})\n`;
        }
      } catch(e) {}

      // 矛盾検出
      let contradictionInfo = '';
      try {
        const contradictions = detectRoleContradictions();
        if (contradictions.length > 0) {
          contradictionInfo = `検出された矛盾: ${contradictions.map(c => c.text.substring(0, 60)).join('／')}\n`;
        }
      } catch(e) {}

      let lastSpeakerSection = '';
      if (lastSpeakerText && lastSpeakerChar) {
        lastSpeakerSection = `直前の発言（${getCharDisplayName(lastSpeakerChar)}）: 「${lastSpeakerText.substring(0, 120)}」\n`;
      }

      // 言語強制指示（日本語以外のとき、LLMに出力言語を厳格に指定）
      const langNames = { ja: 'Japanese', en: 'English', zh: 'Simplified Chinese', ko: 'Korean' };
      const targetLangName = langNames[currentAppLanguage] || 'Japanese';
      const langInstruction = currentAppLanguage && currentAppLanguage !== 'ja' ? `【CRITICAL LANGUAGE RULE】You MUST write your ENTIRE response strictly in ${targetLangName}. Do NOT output any Japanese text. Every single word of dialogue must be in ${targetLangName}.\n\n` : '';

      return `${langInstruction}あなたたちは中世ファンタジー風の村「レムの村」の住民です。
村の中には「人間に化けた擬態モンスター（魔物）」が潜伏しています。
目の前には村を救うために訪れた「勇者（プレイヤー）」がおり、勇者の裁きによって本日追放される者が決まります。

あなたは「${speakerName}」です。審判会議（昼の議論）での発言を生成してください。
あなたの本当の役職は【${roleMap[realRole] || realRole}】です。${coRole !== 'grey' && coRole !== 'villager' ? `すでに【${roleMap[coRole] || coRole}】としてCO完了しています。` : ''}
性格タイプ: ${prof.archetype || '標準'} (攻撃性:${prof.aggression}, 論理性:${prof.logicLevel}, 頑固さ:${prof.stubbornness})
口調: ${prof.speechStyle || '丁寧語'}

${gameContext}
${deductionInfo}${contradictionInfo}${lastSpeakerSection}

【会話・絶対ルール】
1. 1〜2文の簡潔な議論発言を生成してください（長文禁止）。
2. 「人狼」「占い師」「霊媒師」「狂人」「騎士」などの現代用語は使わず、「魔物」「賢者」「聖職者」「魔教徒」「聖騎士」と表現してください。
3. ${realRole === 'wolf' ? '自分が擬態モンスター（魔物）の場合は、人間になりすまして他の人物に疑いを向けてください。' : '村人陣営として論理的に推理し、魔物を見つける方向で発言してください。'}
4. ${coRole !== 'grey' && coRole !== 'villager' ? `あなたはすでに【${roleMap[coRole] || coRole}】としてCO済みです。発言中で別の役職を名乗ったりCO撤回したりすることは厳禁です。` : (realRole !== 'wolf' && realRole !== 'madman' && realRole !== 'villager' ? `あなたは【${roleMap[realRole] || realRole}】です。COする場合は【${roleMap[realRole] || realRole}】のみを名乗ってください。` : '真村人が嘘の役職をCOすることは禁止です。')}
5. ゲーム内に存在しない架空の鑑定結果や投票行動を捏造しないでください。
6. 「${speakerName}です。」などの自己紹介は不要です。議論の中身だけを出力してください。

${speakerName}としての審判会議発言:`;
    }

    /**
     * F12コンソールから呼び出せるプロキシ接続テスト関数
     */
    async function testProxyConnection() {
      console.log('[テスト開始] Cloudflare Worker プロキシ接続テスト...');
      console.log(`[テスト] エンドポイント: ${AI_PROXY_URL}`);

      const testPrompt = 'あなたはファンタジーRPGのAIプレイヤーです。「テスト接続成功」と答えてください。';

      try {
        const startTime = Date.now();
        const result = await callAIEngine(testPrompt);
        const elapsed = Date.now() - startTime;

        if (result) {
          console.log(`✅ [テスト成功] 応答時間: ${elapsed}ms`);
          console.log(`✅ [テスト成功] AIの返答: ${result}`);
          return { success: true, response: result, latency: elapsed };
        } else {
          console.error('❌ [テスト失敗] AIからの応答がnullです。');
          return { success: false, error: 'null response' };
        }
      } catch(e) {
        console.error('❌ [テスト失敗] エラー:', e.message);
        return { success: false, error: e.message };
      }
    }

    // =====================================================
    // 📜 冒険の書（全3巻）マルチセーブ＆オートセーブ管理モジュール
    // =====================================================
    const BOOK_KEY_PREFIX = "hero_chronicle_book_";
    const SAVE_KEY_PREFIX = BOOK_KEY_PREFIX; // 後方互換性エイリアス
    let activeSaveSlot = 1; // デフォルトで第一巻を選択

    const BOOK_NAMES = {
      1: "冒険の書 第一巻",
      2: "冒険の書 第二巻",
      3: "冒険の書 第三巻"
    };

    /**
     * 称号多言語変換マップ
     */
    const RANK_TITLE_I18N = {
      "伝説の神眼勇者": { en: "Legendary God-Eye Hero", zh: "传说的神眼勇者", ko: "전설의 신안 용사" },
      "至高の審判官": { en: "Supreme Magistrate", zh: "至高审判官", ko: "지고의 심판관" },
      "名探偵勇者": { en: "Master Detective Hero", zh: "名侦探勇者", ko: "명탐정 용사" },
      "新米審判者": { en: "Novice Arbiter", zh: "新晋审判者", ko: "신참 심판자" },
      "迷走する勇者": { en: "Wandering Hero", zh: "迷茫的勇者", ko: "방황하는 용사" }
    };

    function translateRankTitle(rawTitle, lang) {
      if (!rawTitle) return "";
      const currentLang = lang || currentAppLanguage || 'ja';
      if (currentLang === 'ja') return rawTitle;
      const match = RANK_TITLE_I18N[rawTitle];
      if (match && match[currentLang]) return match[currentLang];
      return rawTitle;
    }

    /**
     * 称号判定関数
     */
    function getRankTitle(iq, score, lang) {
      let title = "迷走する勇者";
      if (iq >= 160 && score >= 10000) title = "伝説の神眼勇者";
      else if (iq >= 140) title = "至高の審判官";
      else if (iq >= 120) title = "名探偵勇者";
      else if (iq >= 90)  title = "新米審判者";
      return translateRankTitle(title, lang);
    }

    /**
     * セーブデータに保存された日本語フェーズ名を現在の言語に翻訳
     * 既存セーブデータは日本語で保存されているため、表示時に変換する
     */
    function translateSavedPhase(rawText, lang) {
      if (!rawText) return rawText;
      lang = lang || currentAppLanguage || 'ja';

      const PHASE_DEFS = [
        {
          key: 'night',
          matches: [/魔物の夜襲/i, /Monster'?s Night Raid/i, /魔物的夜袭/i, /마물의 야습/i],
          labels: { ja: '魔物の夜襲', en: "Monster's Night Raid", zh: '魔物的夜袭', ko: '마물의 야습' }
        },
        {
          key: 'decision',
          matches: [/勇者の裁き/i, /Hero'?s Judgment/i, /勇者的裁决/i, /용사의 심판/i],
          labels: { ja: '勇者の裁き', en: "Hero's Judgment", zh: '勇者的裁决', ko: '용사의 심판' }
        },
        {
          key: 'day',
          matches: [/審判の昼/i, /Day of Judgment/i, /审判之昼/i, /심판의 낮/i],
          labels: { ja: '審判の昼', en: 'Day of Judgment', zh: '审判之昼', ko: '심판의 낮' }
        },
        {
          key: 'progress',
          matches: [/進行中/i, /In Progress/i, /进行中/i, /진행\s*중/i],
          labels: { ja: '進行中', en: 'In Progress', zh: '进行中', ko: '진행 중' }
        }
      ];

      // 日数の抽出（"1日目", "Day 1", "第1天", "1일째" など）
      const dayMatch = rawText.match(/(?:Day\s*|第|)(\d+)(?:\s*日目|\s*天|\s*일째|\s*일차|)/i);
      const dayNum = dayMatch ? dayMatch[1] : null;

      // フェーズの検出
      let matchedPhase = null;
      for (const def of PHASE_DEFS) {
        if (def.matches.some(regex => regex.test(rawText))) {
          matchedPhase = def;
          break;
        }
      }

      if (dayNum && matchedPhase) {
        const pLabel = matchedPhase.labels[lang] || matchedPhase.labels.ja;
        if (lang === 'en') return `Day ${dayNum} : ${pLabel}`;
        if (lang === 'zh') return `第${dayNum}天：${pLabel}`;
        if (lang === 'ko') return `${dayNum}일차：${pLabel}`;
        return `${dayNum}日目：${pLabel}`;
      } else if (matchedPhase) {
        return matchedPhase.labels[lang] || matchedPhase.labels.ja;
      }

      return rawText;
    }

    /**
     * セーブデータに保存されたストーリーサマリーを現在の言語に双方向翻訳
     */
    function translateSavedSummary(rawSummary, lang) {
      if (!rawSummary) return rawSummary;
      lang = lang || currentAppLanguage || 'ja';

      // パターン1: 序章（Prologue）
      const isPrologue = /(?:序章|Prologue|서장)/i.test(rawSummary) ||
        /(?:偽りの姿を暴く|began the quest to expose|揭露伪装者|거짓된 모습을 밝혀내는)/i.test(rawSummary);

      if (isPrologue) {
        const mHero = rawSummary.match(/\[(.*?)\]/);
        const hero = mHero ? mHero[1] : (lang === 'en' ? 'Hero' : (lang === 'zh' ? '勇者' : (lang === 'ko' ? '용사' : '勇者')));
        if (lang === 'en') return `Prologue: The Hero of Judgment [${hero}] gathered the villagers and began the quest to expose the hidden imposters.`;
        if (lang === 'zh') return `序章：审判勇者 [${hero}] 召集村民，踏上揭露伪装者的冒险之路。`;
        if (lang === 'ko') return `서장: 심판의 용사 [${hero}]는 마을 사람들을 모아, 거짓된 모습을 밝혀내는 모험을 시작했다.`;
        return `序章：審判の勇者 [${hero}] は村人たちを集め、偽りの姿を暴く冒険を開始した。`;
      }

      // パターン2: 第N章：処刑（Chapter N: The hero passed judgment on [victim]...）
      const isVictim = /(?:審判を下し|passed judgment on|做出了审判|심판을 내렸고)/i.test(rawSummary);
      if (isVictim) {
        const mCh = rawSummary.match(/(?:第(\d+)章|Chapter\s*(\d+)|제(\d+)장)/i);
        const ch = mCh ? (mCh[1] || mCh[2] || mCh[3] || '1') : '1';
        const mVictim = rawSummary.match(/\[(.*?)\]/);
        const victim = mVictim ? mVictim[1] : (lang === 'en' ? 'Villager' : '村人');
        if (lang === 'en') return `Chapter ${ch}: The hero passed judgment on [${victim}], and silence fell upon the village.`;
        if (lang === 'zh') return `第${ch}章：勇者对 [${victim}] 做出了审判，村庄回归了宁静。`;
        if (lang === 'ko') return `제${ch}장: 용사는 [${victim}]에게 심판을 내렸고, 마을에 정적이 찾아왔다.`;
        return `第${ch}章：勇者は [${victim}] に審判を下し、村に静寂が訪れた。`;
      }

      // パターン3: 第N章：試練継続（Chapter N: Amidst the lurking presence...）
      const isTrial = /(?:試練の審判が続く|trials of judgment continue|试炼审判仍在继续|시련의 심판이 계속된다)/i.test(rawSummary) ||
        /(?:擬態モンスターの気配|mimicry monsters|拟态怪物气息|의태 몬스터의 기운)/i.test(rawSummary);
      if (isTrial) {
        const mCh = rawSummary.match(/(?:第(\d+)章|Chapter\s*(\d+)|제(\d+)장)/i);
        const ch = mCh ? (mCh[1] || mCh[2] || mCh[3] || '1') : '1';
        if (lang === 'en') return `Chapter ${ch}: Amidst the lurking presence of vile mimicry monsters, the trials of judgment continue.`;
        if (lang === 'zh') return `第${ch}章：凶恶的拟态怪物气息潜伏其中，试炼审判仍在继续。`;
        if (lang === 'ko') return `제${ch}장: 흉악한 의태 몬스터의 기운이 감도는 가운데, 시련의 심판이 계속된다.`;
        return `第${ch}章：凶悪な擬態モンスターの気配が潜むなか、試練の審判が続く。`;
      }

      // パターン4: デフォルトサマリー（苛烈な審判が繰り広げられた記録）
      const isDefaultSummary = /(?:苛烈な審判が繰り広げられた記録|chronicle of the Hero'?s intense judgment|记载着勇者严苛审判的历程|용사의 가혹한 심판이 펼쳐진 기록)/i.test(rawSummary);
      if (isDefaultSummary) {
        if (lang === 'en') return "A chronicle of the Hero's intense judgment.";
        if (lang === 'zh') return "记载着勇者严苛审判的历程。";
        if (lang === 'ko') return "용사의 가혹한 심판이 펼쳐진 기록.";
        return "勇者の苛烈な審判が繰り広げられた記録。";
      }

      // パターン5: 未使用白紙スロット
      const isBlank = /(?:まだ何も記されていない未知の羊皮紙|untouched parchment awaiting your legend|尚未书写任何内容的未知羊皮纸|아직 아무것도 적히지 않은 미지의 양피지)/i.test(rawSummary);
      if (isBlank) {
        if (lang === 'en') return "An untouched parchment awaiting your legend.";
        if (lang === 'zh') return "尚未书写任何内容的未知羊皮纸。";
        if (lang === 'ko') return "아직 아무것도 적히지 않은 미지의 양피지입니다.";
        return "まだ何も記されていない未知の羊皮紙です。";
      }

      return rawSummary;
    }

    /**
     * 冒険の書ごとの勇者IQ・評価計算ロジック
     */
    function calculateHeroEvaluation(bookId, gameResult) {
      let data = loadGameData(bookId);
      if (!data) return null;

      let iqChange = 0;
      let scoreGained = 0;

      // 1. 審判（処刑）の正確さ判定
      if (gameResult.type === 'execution') {
        if (gameResult.executedIsMonster) {
          iqChange += 15;        // 魔物・妖狐の処刑成功: IQ+15
          scoreGained += 1000;
          data.monstersDefeated = (data.monstersDefeated || 0) + 1;
        } else {
          iqChange -= 20;        // 無実の人間を処刑: IQ-20
          scoreGained -= 500;
          data.innocentVictims = (data.innocentVictims || 0) + 1;
        }
      }

      // 2. ゲーム決着時のボーナス判定
      if (gameResult.type === 'gameEnd') {
        if (gameResult.isVictory) {
          data.clearedVillages = (data.clearedVillages || 0) + 1;
          const dayBonus = Math.max(0, (10 - (gameResult.totalDays || 1)) * 100);
          scoreGained += 2000 + dayBonus;
          iqChange += 10;

          // ★ ステージクリアボーナス: 信頼度 +10
          updateTrust('STAGE_CLEAR');

          // ストーリーモード専用処理
          if (currentPlayMode === 'story') {
            if (!data.chapterRecords) data.chapterRecords = {};
            const chKey = `ch${currentStoryChapter}`;
            data.chapterRecords[chKey] = {
              cleared: true,
              iqGained: iqChange,
              score: scoreGained
            };

            // 次の章をアンロック
            const nextCh = Math.min(5, currentStoryChapter + 1);
            const curUnlock = typeof data.unlockChapter === 'number' ? data.unlockChapter : 1;
            data.unlockChapter = Math.max(curUnlock, nextCh);

            // 第5章クリア時のグランドエンディング判定
            if (currentStoryChapter === 5) {
              data.isStoryCleared = true;
              setTimeout(() => {
                showGrandEndingModal(data.heroIQ + iqChange, data.totalScore + scoreGained, data.rankTitle);
              }, 1200);
            }
          }
        } else if (gameResult.isFoxWin) {
          iqChange -= 30; // 妖狐に単独勝利（乗っ取り）された場合: IQ-30 (大敗北)
        } else {
          iqChange -= 15; // 通常の敗北
        }
      }

      // IQ・スコアの上下限制御
      const currentIQ = typeof data.heroIQ === 'number' ? data.heroIQ : 100;
      const currentScore = typeof data.totalScore === 'number' ? data.totalScore : 0;

      data.heroIQ = Math.min(200, Math.max(50, currentIQ + iqChange));
      data.totalScore = Math.max(0, currentScore + scoreGained);
      data.rankTitle = getRankTitle(data.heroIQ, data.totalScore);
      // ★ 信頼度の永続化（勝利時のみ保存 — ゲームオーバー時は保存しない）
      if (gameResult.isVictory && typeof gameState !== 'undefined' && typeof gameState.playerTrust === 'number') {
        data.playerTrust = gameState.playerTrust;
      }
      data.updatedAt = new Date().toLocaleString("ja-JP");

      // 最新の冒険の書データを保存
      try {
        localStorage.setItem(BOOK_KEY_PREFIX + bookId, JSON.stringify(data));
        updateTitleSaveSlotUI();
      } catch (e) {
        console.error(`冒険の書 第${bookId}巻 評価更新保存エラー:`, e);
      }

      return data;
    }

    /**
     * 冒険の書に保存するデータ構造を作成
     */
    function createChronicleData(bookId, gameStateData) {
      const lang = currentAppLanguage || 'ja';
      const aliveCount = (gameStateData.charList || []).filter(c => gameStateData.status && gameStateData.status[c] === 'alive').length;
      const totalCount = (gameStateData.charList || []).length;
      const dayText = formatDay ? formatDay(gameStateData.day || 1) : `${gameStateData.day || 1}日目`;
      const PHASE_TITLES = {
        night: { ja: '魔物の夜襲', en: "Monster's Night Raid", zh: '魔物的夜袭', ko: '마물의 야습' },
        decision: { ja: '勇者の裁き', en: "Hero's Judgment", zh: '勇者的裁决', ko: '용사의 심판' },
        day: { ja: '審判の昼', en: 'Day of Judgment', zh: '审判之昼', ko: '심판의 낮' }
      };
      const phaseKey = gameStateData.phase === '夜' ? 'night' : (gameStateData.subPhase === 'decision' ? 'decision' : 'day');
      const phaseTitle = PHASE_TITLES[phaseKey][lang] || PHASE_TITLES[phaseKey].ja;

      let storySummary = "";
      if (gameStateData.lastExecutedChar || gameStateData.lastExecution) {
        const victim = gameStateData.lastExecutedChar || gameStateData.lastExecution;
        if (lang === 'en') storySummary = `Chapter ${gameStateData.day || 1}: The hero passed judgment on [${victim}], and silence fell upon the village.`;
        else if (lang === 'zh') storySummary = `第${gameStateData.day || 1}章：勇者对 [${victim}] 做出了审判，村庄回归了宁静。`;
        else if (lang === 'ko') storySummary = `제${gameStateData.day || 1}장: 용사는 [${victim}]에게 심판을 내렸고, 마을에 정적이 찾아왔다.`;
        else storySummary = `第${gameStateData.day || 1}章：勇者は [${victim}] に審判を下し、村に静寂が訪れた。`;
      } else if (gameStateData.day > 1) {
        if (lang === 'en') storySummary = `Chapter ${gameStateData.day}: Amidst the lurking presence of vile mimicry monsters, the trials of judgment continue.`;
        else if (lang === 'zh') storySummary = `第${gameStateData.day}章：凶恶的拟态怪物气息潜伏其中，试炼审判仍在继续。`;
        else if (lang === 'ko') storySummary = `제${gameStateData.day}장: 흉악한 의태 몬스터의 기운이 감도는 가운데, 시련의 심판이 계속된다.`;
        else storySummary = `第${gameStateData.day}章：凶悪な擬態モンスターの気配が潜むなか、試練の審判が続く。`;
      } else {
        if (lang === 'en') storySummary = `Prologue: The Hero of Judgment [${gameStateData.heroName || "Hero"}] gathered the villagers and began the quest to expose the hidden imposters.`;
        else if (lang === 'zh') storySummary = `序章：审判勇者 [${gameStateData.heroName || "勇者"}] 召集村民，踏上揭露伪装者的冒险之路。`;
        else if (lang === 'ko') storySummary = `서장: 심판의 용사 [${gameStateData.heroName || "용사"}]는 마을 사람들을 모아, 거짓된 모습을 밝혀내는 모험을 시작했다.`;
        else storySummary = `序章：審判の勇者 [${gameStateData.heroName || "勇者"}] は村人たちを集め、偽りの姿を暴く冒険を開始した。`;
      }

      // 既存のセーブデータからスコア・戦績パラメータを引き継ぐ
      const existingData = loadGameData(bookId) || {};
      const heroIQ = typeof existingData.heroIQ === 'number' ? existingData.heroIQ : 100;
      const totalScore = typeof existingData.totalScore === 'number' ? existingData.totalScore : 0;
      const clearedVillages = existingData.clearedVillages || 0;
      const monstersDefeated = existingData.monstersDefeated || 0;
      const innocentVictims = existingData.innocentVictims || 0;
      const rankTitle = existingData.rankTitle || getRankTitle(heroIQ, totalScore);
      const unlockChapter = typeof existingData.unlockChapter === 'number' ? existingData.unlockChapter : 1;
      const chapterRecords = existingData.chapterRecords || { ch1: { cleared: false, highScore: 0 } };
      // ★ 信頼度の引き継ぎ（gameStateData > existingData > 100）
      const playerTrust = typeof gameStateData.playerTrust === 'number' ? gameStateData.playerTrust : (typeof existingData.playerTrust === 'number' ? existingData.playerTrust : 100);

      return {
        bookId: bookId,
        slotId: bookId,
        bookTitle: BOOK_NAMES[bookId] || `冒険の書 第${bookId}巻`,
        updatedAt: new Date().toLocaleString("ja-JP"),
        heroName: gameStateData.heroName || "勇者",
        heroIQ: heroIQ,
        totalScore: totalScore,
        playerTrust: playerTrust,
        clearedVillages: clearedVillages,
        monstersDefeated: monstersDefeated,
        innocentVictims: innocentVictims,
        rankTitle: rankTitle,
        unlockChapter: unlockChapter,
        chapterRecords: chapterRecords,
        currentChapter: `${dayText}：${phaseTitle}`,
        currentDay: `${dayText} ${gameStateData.phase || "昼"} (${phaseTitle})`,
        aliveCount: `${aliveCount}/${totalCount}`,
        storySummary: storySummary,
        gameState: gameStateData
      };
    }

    /**
     * タイトル画面等でアクティブな冒険の書を選択
     */
    function selectActiveSaveSlot(slotId) {
      activeSaveSlot = slotId;
      updateTitleSaveSlotUI();
    }

    /**
     * タイトル画面の冒険の書選択UI表示を更新
     */
    function updateTitleSaveSlotUI() {
      const lang = currentAppLanguage || 'ja';
      const labelEl = document.getElementById('active-slot-label');
      if (labelEl) {
        const getSlotLabel = (id) => {
          if (lang === 'en') return `Adventure Log Vol.${id} Selected`;
          if (lang === 'zh') return `冒险之书 第${id}卷 已选`;
          if (lang === 'ko') return `모험의 서 제${id}권 선택 중`;
          return `${BOOK_NAMES[id] || '第' + id + '巻'} 選択中`;
        };
        labelEl.textContent = getSlotLabel(activeSaveSlot);
      }

      const blankLabel = lang === 'en' ? 'Blank Log' : (lang === 'zh' ? '空白之书' : (lang === 'ko' ? '백지의 서' : '白紙の書'));

      for (let i = 1; i <= 3; i++) {
        const btn = document.getElementById(`title-slot-btn-${i}`);
        const subEl = document.getElementById(`title-slot-sub-${i}`);
        if (btn) {
          if (i === activeSaveSlot) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        }
        if (subEl) {
          const data = loadGameData(i);
          if (data) {
            subEl.textContent = `${translateSavedPhase(data.currentChapter || data.currentDay, lang)}`;
            subEl.style.color = '#34d399';
          } else {
            subEl.textContent = blankLabel;
            subEl.style.color = 'var(--text-muted)';
          }
        }
      }
    }

    /**
     * オートセーブ実行関数（通知なしでアクティブ巻に上書き保存）
     */
    function autoSaveCurrentGame() {
      if (!gameState || !gameState.charList || gameState.gameOver) return;
      saveGameData(activeSaveSlot, gameState, true); // isAutoSave = true
    }

    /**
     * 指定スロット（冒険の書）にデータを保存
     */
    function saveGameData(slotId, gameStateData, isAutoSave = false) {
      const lang = currentAppLanguage || 'ja';
      const noDataMsg = lang === 'en' ? 'No ongoing story to save.' : (lang === 'zh' ? '没有可保存的进行中故事。' : (lang === 'ko' ? '저장할 진행 중인 이야기가 없습니다.' : '保存可能な進行中の物語がありません。'));
      if (!gameStateData) {
        if (!isAutoSave) showCustomAlertModal(noDataMsg);
        return false;
      }

      let saveData;
      // すでにフォーマット済みのセーブデータオブジェクトが渡された場合
      if (gameStateData.slotId || gameStateData.bookId || typeof gameStateData.unlockChapter === 'number') {
        saveData = gameStateData;
        if (typeof gameState !== 'undefined' && typeof gameState.playerTrust === 'number') {
          saveData.playerTrust = gameState.playerTrust;
        }
      } else if (gameStateData.charList) {
        // gameState オブジェクトからフォーマット済みデータを構築
        saveData = createChronicleData(slotId, gameStateData);
      } else {
        if (!isAutoSave) showCustomAlertModal(noDataMsg);
        return false;
      }

      const getBookName = (id) => {
        if (lang === 'en') return `Adventure Log Vol.${id}`;
        if (lang === 'zh') return `冒险之书 第${id}卷`;
        if (lang === 'ko') return `모험의 서 제${id}권`;
        return BOOK_NAMES[id] || `冒険の書 第${id}巻`;
      };
      const bookName = getBookName(slotId);

      try {
        localStorage.setItem(BOOK_KEY_PREFIX + slotId, JSON.stringify(saveData));
        if (isAutoSave) {
          console.log(`[AutoSave] ${bookName} saved.`);
        } else {
          const savedMsg = lang === 'en' ? `📜 Your journey has been recorded in ${bookName}.` :
            (lang === 'zh' ? `📜 旅途记忆已记录于 ${bookName}。` :
            (lang === 'ko' ? `📜 여행의 기억이 ${bookName}에 기록되었습니다.` :
            `📜 ${bookName} に旅の記憶を書き記しました。`));
          showNotification(savedMsg);
        }
        updateTitleSaveSlotUI();
        return true;
      } catch (e) {
        console.error("Save failed:", e);
        const errMsg = lang === 'en' ? `Unfortunately, ${bookName} has been lost (storage error).` :
          (lang === 'zh' ? `很遗憾，${bookName} 已丢失（存储容量错误）。` :
          (lang === 'ko' ? `안타깝게도 ${bookName}의 기록이 사라졌습니다 (저장 용량 오류).` :
          `お気の毒ですが ${bookName} は 消えてしまいました (ストレージ容量エラー)。`));
        if (!isAutoSave) showCustomAlertModal(errMsg);
        return false;
      }
    }

    /**
     * 指定スロットから冒険の書データを読み込み
     */
    function loadGameData(slotId) {
      let dataStr = localStorage.getItem(BOOK_KEY_PREFIX + slotId);
      // 古いキーからの自動以降ロジック
      if (!dataStr) {
        dataStr = localStorage.getItem("hero_judgement_save_slot_" + slotId);
      }
      if (!dataStr) return null;
      try {
        return JSON.parse(dataStr);
      } catch (e) {
        console.error(`冒険の書 第${slotId}巻 読込エラー:`, e);
        return null;
      }
    }

    /**
     * 指定スロットの冒険の書データを削除
     */
    function deleteGameData(slotId) {
      const lang = currentAppLanguage || 'ja';
      const getBookName = (id) => {
        if (lang === 'en') return `Adventure Log Vol.${id}`;
        if (lang === 'zh') return `冒险之书 第${id}卷`;
        if (lang === 'ko') return `모험의 서 제${id}권`;
        return BOOK_NAMES[id] || `冒険の書 第${id}巻`;
      };
      const bookName = getBookName(slotId);
      localStorage.removeItem(BOOK_KEY_PREFIX + slotId);
      localStorage.removeItem("hero_judgement_save_slot_" + slotId);
      const delMsg = lang === 'en' ? `📜 The memories of ${bookName} have faded away...` :
        (lang === 'zh' ? `📜 ${bookName} 的记忆已消散……` :
        (lang === 'ko' ? `📜 ${bookName}의 기억이 사라져 갔습니다……` :
        `📜 ${bookName} の記憶は消え去りました……`));
      showNotification(delMsg);
      updateTitleSaveSlotUI();
    }

    /**
     * 全スロットのあらすじ概要を取得（UI表示用）
     */
    function getAllSaveSlotsOverview() {
      const slots = [];
      const lang = currentAppLanguage || 'ja';
      const t = I18N_TRANSLATIONS[lang] || I18N_TRANSLATIONS.ja;

      const getBookTitle = (i) => {
        if (lang === 'en') return `Adventure Log Vol.${i}`;
        if (lang === 'zh') return `冒险之书 第${i}卷`;
        if (lang === 'ko') return `모험의 서 제${i}권`;
        return BOOK_NAMES[i] || `冒険の書 第${i}巻`;
      };

      const emptyTitle = (i) => {
        if (lang === 'en') return `[Vol.${i}: Blank Log]`;
        if (lang === 'zh') return `[第${i}卷: 空白冒险之书]`;
        if (lang === 'ko') return `[제${i}권: 백지의 모험의 서]`;
        return `『${BOOK_NAMES[i]}』 [白紙の冒険の書]`;
      };

      const emptyDetail = lang === 'en' ? 'No heroic journey has been recorded yet' :
        (lang === 'zh' ? '尚未记录任何旅途历程' :
        (lang === 'ko' ? '아직 여행의 기록이 적혀있지 않습니다' :
        'まだ旅の記録は書き記されていません'));

      const emptySummary = lang === 'en' ? 'An untouched parchment awaiting your legend.' :
        (lang === 'zh' ? '尚未书写任何内容的未知羊皮纸。' :
        (lang === 'ko' ? '아직 아무것도 적히지 않은 미지의 양피지입니다.' :
        'まだ何も記されていない未知の羊皮紙です。'));

      for (let i = 1; i <= 3; i++) {
        const data = loadGameData(i);
        const bookName = getBookTitle(i);
        if (data) {
          const defaultHero = lang === 'en' ? 'Hero' : (lang === 'zh' ? '勇者' : (lang === 'ko' ? '용사' : '勇者'));
          const defaultProg = translateSavedPhase(data.currentChapter || data.currentDay, lang) || (lang === 'en' ? 'In Progress' : '進行中');
          const defaultSummary = lang === 'en' ? 'A chronicle of the Hero\'s intense judgment.' :
            (lang === 'zh' ? '记载着勇者严苛审判的历程。' :
            (lang === 'ko' ? '용사의 가혹한 심판이 펼쳐진 기록.' :
            '勇者の苛烈な審判が繰り広げられた記録。'));

          const savedSummary = translateSavedSummary(data.storySummary, lang) || defaultSummary;

          slots.push({
            slotId: i,
            isEmpty: false,
            title: `『${bookName}』 ${defaultProg}`,
            detail: `${lang === 'en' ? 'Hero' : '勇者'}: ${data.heroName || defaultHero} | ${lang === 'en' ? 'Alive' : '生存'}: ${data.aliveCount} | ${data.updatedAt}`,
            summary: savedSummary,
            raw: data
          });
        } else {
          slots.push({
            slotId: i,
            isEmpty: true,
            title: emptyTitle(i),
            detail: emptyDetail,
            summary: emptySummary,
            raw: null
          });
        }
      }
      return slots;
    }

    /**
     * 冒険の書（セーブ/ロード）モーダルを開く
     */
    function openSaveModal() {
      renderSaveModalContent();
      openModal('save-slot-modal');
    }

    /**
     * モーダル内の冒険の書一覧UIを羊皮紙・魔導書スタイルでレンダリング
     */
    function renderSaveModalContent() {
      const container = document.getElementById('save-slot-list-container');
      if (!container) return;

      const slots = getAllSaveSlotsOverview();
      container.innerHTML = '';

      const lang = currentAppLanguage || 'ja';
      const isGameInSession = gameState && gameState.charList && gameState.charList.length > 0 && !gameState.gameOver;

      const btnOverwrite = lang === 'en' ? '✍️ Overwrite' : (lang === 'zh' ? '✍️ 覆盖记忆' : (lang === 'ko' ? '✍️ 기억 덮어쓰기' : '✍️ 記憶を上書き'));
      const btnStartExpedition = lang === 'en' ? '⚔️ Start Expedition' : (lang === 'zh' ? '⚔️ 开始远征' : (lang === 'ko' ? '⚔️ 원정 시작' : '⚔️ 遠征を開始'));
      const btnResume = lang === 'en' ? '📖 Resume' : (lang === 'zh' ? '📖 继续旅途' : (lang === 'ko' ? '📖 여행 재개' : '📖 旅を再開'));
      const btnDelete = lang === 'en' ? '🔥 Delete' : (lang === 'zh' ? '🔥 删除记录' : (lang === 'ko' ? '🔥 기록 삭제' : '🔥 記録を消す'));
      const autoSaveTag = lang === 'en' ? '(Autosave Target)' : (lang === 'zh' ? '(自动保存对象)' : (lang === 'ko' ? '(자동 세이브 대상)' : '(オートセーブ対象)'));

      const lblHeroName = lang === 'en' ? 'Hero' : (lang === 'zh' ? '勇者名' : (lang === 'ko' ? '용사명' : '勇者名'));
      const lblTitle = lang === 'en' ? 'Title' : (lang === 'zh' ? '称号' : (lang === 'ko' ? '칭호' : '称号'));
      const lblIQ = lang === 'en' ? 'Hero IQ' : (lang === 'zh' ? '勇者IQ' : (lang === 'ko' ? '용사 IQ' : '勇者IQ'));
      const lblTotalScore = lang === 'en' ? 'Total Score' : (lang === 'zh' ? '综合总分' : (lang === 'ko' ? '종합 스코어' : '総合スコア'));

      const lblFeats = lang === 'en' ? 'Records' : (lang === 'zh' ? '战绩' : (lang === 'ko' ? '실적' : '実績'));
      const lblSavedVillages = lang === 'en' ? 'Saved' : (lang === 'zh' ? '拯救村庄' : (lang === 'ko' ? '구한 마을' : '救った村'));
      const lblDefeatedMonsters = lang === 'en' ? 'Defeated' : (lang === 'zh' ? '讨伐魔物' : (lang === 'ko' ? '처치한 마물' : '倒した魔物'));
      const lblMislynch = lang === 'en' ? 'Mislynch' : (lang === 'zh' ? '误审' : (lang === 'ko' ? '오심' : '誤審'));

      const lblProg = lang === 'en' ? 'Progress' : (lang === 'zh' ? '进度' : (lang === 'ko' ? '진행' : '進行'));
      const lblAlive = lang === 'en' ? 'Alive' : (lang === 'zh' ? '幸存' : (lang === 'ko' ? '생존' : '生存'));
      const lblTime = lang === 'en' ? 'Date' : (lang === 'zh' ? '记录时间' : (lang === 'ko' ? '기록일시' : '記録日時'));

      slots.forEach(slot => {
        const card = document.createElement('div');
        const isActive = (slot.slotId === activeSaveSlot);
        card.className = `save-slot-card ${slot.isEmpty ? '' : 'active-slot'}`;
        if (isActive) card.style.borderColor = 'var(--accent-amber)';

        let actionBtns = '';
        if (isGameInSession) {
          actionBtns += `<button class="btn-slot-action btn-slot-save" onclick="executeSaveSlot(${slot.slotId})">${btnOverwrite}</button>`;
        }
        actionBtns += `<button class="btn-slot-action btn-slot-save" style="background:linear-gradient(135deg,#d97706,#b45309); border-color:#fbbf24;" onclick="openModeSelectModal(${slot.slotId})">${btnStartExpedition}</button>`;
        if (!slot.isEmpty) {
          actionBtns += `<button class="btn-slot-action btn-slot-load" onclick="executeLoadSlot(${slot.slotId})">${btnResume}</button>`;
          actionBtns += `<button class="btn-slot-action btn-slot-delete" onclick="executeDeleteSlot(${slot.slotId})">${btnDelete}</button>`;
        }

        const volPrefix = lang === 'en' ? `Vol.${slot.slotId}` : (lang === 'zh' ? `第${slot.slotId}卷` : (lang === 'ko' ? `제${slot.slotId}권` : `第${slot.slotId}巻`));
        const bookBadge = `<span class="book-vol-badge">${volPrefix}</span>`;

        if (slot.isEmpty) {
          card.innerHTML = `
            <div class="save-slot-header">
              <div class="save-slot-title empty">${bookBadge} ${slot.title} ${isActive ? `<span style="font-size:0.72rem; color:#fbbf24; margin-left:0.4rem; font-weight:normal;">${autoSaveTag}</span>` : ''}</div>
            </div>
            <div class="save-slot-detail">${slot.detail}</div>
            <div class="save-slot-summary" style="font-size:0.78rem; color:#fde68a; font-style:italic; background:rgba(0,0,0,0.3); padding:0.4rem 0.6rem; border-radius:6px; border-left:3px solid var(--accent-amber); margin:0.2rem 0;">
              📜 ${slot.summary}
            </div>
            <div class="save-slot-actions">
              ${actionBtns}
            </div>
          `;
        } else {
          const raw = slot.raw || {};
          const heroIQ = typeof raw.heroIQ === 'number' ? raw.heroIQ : 100;
          const score = typeof raw.totalScore === 'number' ? raw.totalScore.toLocaleString() : "0";
          const rankTitle = translateRankTitle(raw.rankTitle || getRankTitle(heroIQ, raw.totalScore || 0), lang);
          const cleared = raw.clearedVillages || 0;
          const defeated = raw.monstersDefeated || 0;
          const victims = raw.innocentVictims || 0;
          const defaultHero = lang === 'en' ? 'Hero' : (lang === 'zh' ? '勇者' : (lang === 'ko' ? '용사' : '勇者'));

          const unitDefeated = lang === 'en' ? '' : (lang === 'zh' ? '只' : (lang === 'ko' ? '마리' : '体'));
          const unitVictims = lang === 'en' ? '' : (lang === 'zh' ? '次' : (lang === 'ko' ? '회' : '回'));

          card.innerHTML = `
            <div class="save-slot-header" style="border-bottom: 1px solid rgba(251, 191, 36, 0.2); padding-bottom: 0.4rem; margin-bottom: 0.4rem;">
              <div class="save-slot-title">${bookBadge} ${slot.title} ${isActive ? `<span style="font-size:0.72rem; color:#fbbf24; margin-left:0.4rem; font-weight:normal;">${autoSaveTag}</span>` : ''}</div>
            </div>
            
            <div style="font-size:0.85rem; color:#fef08a; display:flex; flex-wrap:wrap; gap:0.6rem 1.2rem; margin-bottom:0.4rem; background:rgba(0,0,0,0.35); padding:0.5rem 0.7rem; border-radius:6px; border:1px solid rgba(251, 191, 36, 0.25);">
              <div>${lblHeroName}: <strong>${raw.heroName || defaultHero}</strong></div>
              <div>${lblTitle}: <span style="color:#fbbf24; font-weight:bold; background:rgba(251, 191, 36, 0.15); padding:0.1rem 0.4rem; border-radius:4px; border:1px solid rgba(251, 191, 36, 0.3);">【 ${rankTitle} 】</span></div>
              <div>${lblIQ}: <strong style="color:#60a5fa; font-size:0.95rem;">${heroIQ}</strong></div>
              <div>${lblTotalScore}: <strong style="color:#34d399; font-size:0.95rem;">${score} pt</strong></div>
            </div>

            <div style="font-size:0.78rem; color:#d1d5db; margin-bottom:0.4rem;">
              🏆 <strong>${lblFeats}:</strong> ${lblSavedVillages} <span style="color:#34d399; font-weight:bold;">${cleared}</span> / ${lblDefeatedMonsters} <span style="color:#f87171; font-weight:bold;">${defeated}${unitDefeated}</span> / ${lblMislynch} <span style="color:#fbbf24; font-weight:bold;">${victims}${unitVictims}</span>
            </div>

            <div class="save-slot-detail" style="font-size:0.8rem; color:#9ca3af; margin-bottom:0.3rem;">
              📍 ${lblProg}: <strong>${translateSavedPhase(raw.currentChapter || raw.currentDay, lang)}</strong> | ${lblAlive}: ${raw.aliveCount} | ${lblTime}: ${raw.updatedAt}
            </div>

            <div class="save-slot-summary" style="font-size:0.78rem; color:#fde68a; font-style:italic; background:rgba(0,0,0,0.25); padding:0.35rem 0.6rem; border-radius:6px; border-left:3px solid var(--accent-amber); margin:0.2rem 0 0.5rem 0;">
              📜 ${slot.summary}
            </div>

            <div class="save-slot-actions">
              ${actionBtns}
            </div>
          `;
        }

        container.appendChild(card);
      });
    }

    /**
     * スロット保存実行
     */
    function executeSaveSlot(slotId) {
      const lang = currentAppLanguage || 'ja';
      if (!gameState || !gameState.charList || gameState.gameOver) {
        const msg = lang === 'en' ? 'No ongoing game to save.' : (lang === 'zh' ? '没有可保存的进行中游戏。' : (lang === 'ko' ? '저장할 진행 중인 게임이 없습니다.' : 'セーブできる進行中のゲームがありません。'));
        showCustomAlertModal(msg);
        return;
      }
      activeSaveSlot = slotId; // アクティブスロットも更新
      if (saveGameData(slotId, gameState)) {
        renderSaveModalContent();
      }
    }

    /**
     * スロット復元（ロード）実行
     */
    function executeLoadSlot(slotId) {
      const lang = currentAppLanguage || 'ja';
      const data = loadGameData(slotId);
      if (!data || !data.gameState) {
        const failMsg = lang === 'en' ? 'Failed to load save data.' : (lang === 'zh' ? '存档数据加载失败。' : (lang === 'ko' ? '세이브 데이터 로드에 실패했습니다.' : 'セーブデータの読み込みに失敗しました。'));
        if (typeof showCustomAlertModal === 'function') {
          showCustomAlertModal(failMsg);
        } else {
          alert(failMsg);
        }
        return;
      }

      const getBookName = (id) => {
        if (lang === 'en') return `Adventure Log Vol.${id}`;
        if (lang === 'zh') return `冒险之书 第${id}卷`;
        if (lang === 'ko') return `모험의 서 제${id}권`;
        return BOOK_NAMES[id] || `冒険の書 第${id}巻`;
      };
      const bookName = getBookName(slotId);
      const confirmMsg = lang === 'en' ? `Open the memories of "${bookName}"?\n(${data.currentChapter || data.currentDay})` :
        (lang === 'zh' ? `要翻阅「${bookName}」的记忆吗？\n(${data.currentChapter || data.currentDay})` :
        (lang === 'ko' ? `「${bookName}」의 기억을 펼쳐볼까요?\n(${data.currentChapter || data.currentDay})` :
        `『${bookName}』の記憶を紐解きますか？\n(${data.currentChapter || data.currentDay})`));

      const doLoad = () => {
        activeSaveSlot = slotId; // ロードしたスロットをアクティブに
        updateTitleSaveSlotUI();
        closeModal('save-slot-modal');
        stopAllTimers();
        cancelSpeech();

        // gameStateの完全復元
        gameState = data.gameState;
        selectedVillageSize = gameState.villageSize || 6;

        // BGMおよび背景・画面の再構築
        const splash = document.getElementById('splash-screen');
        if (splash) splash.style.display = 'none';
        document.getElementById('title-screen').classList.add('hidden');
        document.getElementById('game-screen').classList.remove('hidden');

        if (gameState.phase === '夜' || gameState.subPhase === 'execution') {
          playBgm('syokei');
          setGamePhaseBg('execution');
        } else {
          playBgm('hiru');
          setGamePhaseBg('day-debate');
        }

        renderStatus();
        renderCharacters();
        renderBulletinBoard();
        renderMorningCommentsBox();
        renderVoteHistoryPage();
        selectCharacter(gameState.selectedChar || null);

        // ログタイムラインの再描画
        const timeline = document.getElementById('log-timeline');
        if (timeline && gameState.logHistory) {
          timeline.innerHTML = '';
          gameState.logHistory.forEach(item => {
            addLogItem(item.speaker, item.badge, item.text, item.type, item.charKey, false);
          });
        }

        // タイマー再開
        if (gameState.subPhase === 'discussion' && !gameState.executedToday && !gameState.gameOver) {
          startDiscussionTimer();
        } else if (gameState.subPhase === 'decision' && !gameState.executedToday && !gameState.gameOver) {
          startDecisionTimer();
        }

        const restoredMsg = lang === 'en' ? `📖 Memories of "${bookName}" have been restored. (${data.currentChapter || data.currentDay})` :
          (lang === 'zh' ? `📖 「${bookName}」的记忆已恢复。(${data.currentChapter || data.currentDay})` :
          (lang === 'ko' ? `📖 「${bookName}」의 기억이 복원되었습니다. (${data.currentChapter || data.currentDay})` :
          `📖 『${bookName}』の記憶を復元しました (${data.currentChapter || data.currentDay})`));
        showNotification(restoredMsg);
      };

      if (typeof showCustomConfirmModal === 'function') {
        showCustomConfirmModal(confirmMsg, (confirmed) => {
          if (confirmed) doLoad();
        });
      } else if (window.confirm(confirmMsg)) {
        doLoad();
      }
    }

    /**
     * 冒険の書 削除実行
     */
    function executeDeleteSlot(slotId) {
      const lang = currentAppLanguage || 'ja';
      const getBookName = (id) => {
        if (lang === 'en') return `Adventure Log Vol.${id}`;
        if (lang === 'zh') return `冒险之书 第${id}卷`;
        if (lang === 'ko') return `모험의 서 제${id}권`;
        return BOOK_NAMES[id] || `冒険の書 第${id}巻`;
      };
      const bookName = getBookName(slotId);
      const confirmMsg = lang === 'en' ? `Are you sure you want to erase the memories of "${bookName}"?` :
        (lang === 'zh' ? `确定要消除「${bookName}」的旅途记忆吗？` :
        (lang === 'ko' ? `「${bookName}」의 여행 기억을 지우시겠습니까?` :
        `『${bookName}』の旅の記憶を消し去ってもよろしいですか？`));

      const doDelete = () => {
        deleteGameData(slotId);
        renderSaveModalContent();
      };

      if (typeof showCustomConfirmModal === 'function') {
        showCustomConfirmModal(confirmMsg, (confirmed) => {
          if (confirmed) doDelete();
        });
      } else if (window.confirm(confirmMsg)) {
        doDelete();
      }
    }

    // グローバル公開
    window.showCustomConfirmModal = showCustomConfirmModal;
    window.selectActiveSaveSlot = selectActiveSaveSlot;
    window.updateTitleSaveSlotUI = updateTitleSaveSlotUI;
    window.autoSaveCurrentGame = autoSaveCurrentGame;
    window.saveGameData = saveGameData;
    window.loadGameData = loadGameData;
    window.deleteGameData = deleteGameData;
    window.getAllSaveSlotsOverview = getAllSaveSlotsOverview;
    window.openSaveModal = openSaveModal;
    window.executeSaveSlot = executeSaveSlot;
    window.executeLoadSlot = executeLoadSlot;
    window.executeDeleteSlot = executeDeleteSlot;
    window.getRankTitle = getRankTitle;
    window.calculateHeroEvaluation = calculateHeroEvaluation;
    window.toggleDiscussionPause = toggleDiscussionPause;
    window.restartAIDiscussion = restartAIDiscussion;

    // グローバル公開（F12コンソールからアクセス可能に）
    window.testProxyConnection = testProxyConnection;
    window.callAIEngine = callAIEngine;
    window.showNotification = showNotification;
    window.getLocalFallbackResponse = getLocalFallbackResponse;
    // LLM/オフラインモード手動切替用
    window.enableLLM = () => { useLLMMode = true; isOfflineMode = false; llmConsecutiveFailures = 0; console.log('✅ LLMモードを有効にしました'); };
    window.disableLLM = () => { useLLMMode = false; isOfflineMode = true; console.log('🔒 LLMモードを無効にしました（ローカル軽量AIモード）'); };

