        vote_history_title: "📊 가상 투표 및 의심도 기록 (실시간 정밀 분석)",
        no_vote_history: "아직 가상 투표 기록이 없습니다.",
        vote_summary_header: "📅 {label} 가상 투표 집계",
        vote_top_target: "최다 득표: ",
        vote_count_badge: "{name}: <strong>{count}표</strong>",
        vote_suspicion_badge: "의심 {score}%",
        vote_none: "없음",
        // 공지
        bulletin_empty: "오늘 새로 확인된 능력 보고가 없습니다. (직업 잠복 중)",
        morning_empty: "아직 발언이 없습니다.",
        morning_day_header: "📅 {day} 아침 코멘트",
        // 정산 화면
        result_win_title: "🎉 심판 성공! - Victory -",
        result_lose_title: "💀 마을의 멸망… - Game Over -",
        result_fox_title: "🦊 요호 단독 승리! - Fox Win -",
        result_daily_cleared: " (📅 데일리 과제 클리어!)",
        result_win_label: "🎉 승리",
        result_lose_label: "💀 패배",
        result_fox_label: "🦊 요호 승리",
        result_estimated_iq: "추정 IQ",
        result_point_row: "{label} 포인트",
        result_bonus_day: "🕐 조기 해결 보너스 ({day}일차)",
        result_bonus_survivor: "👥 주민 생존 보너스 ({count}명)",
        result_bonus_nomiss: "✨ 완벽 심판 보너스",
        result_penalty_mislynch: "⚠️ 오심 페널티 ({count}회)",
        result_total_score: "📊 최종 점수",
        result_reveal_title: "【전원의 실제 직업 및 최종 상태】",
        result_btn_next_chapter: "⚔️ 다음 장으로 진행 (제{ch}장)",
        result_btn_grand_ending: "✨🏆 그랜드 엔딩 감상",
        result_btn_replay: "🔄 다시 플레이",
        result_btn_to_title: "🏠 타이틀로"
      }
    };

    let currentAppLanguage = 'ja';

    // 1. 初回起動時の言語判定・選択ロジック
    function getInitialLanguage() {
      // 1. すでにユーザーが手動で言語を選択・保存している場合はそれを優先
      const savedLang = localStorage.getItem('user_selected_language');
      if (savedLang && (savedLang === 'ja' || savedLang === 'en' || savedLang === 'zh' || savedLang === 'ko')) {
        return savedLang;
      }

      // 2. 端末（ブラウザ）の言語を取得
      const browserLang = (navigator.language || navigator.userLanguage || 'en').toLowerCase();

      // 3. 言語コードの前方一致で判定
      if (browserLang.startsWith('ja')) {
        return 'ja';
      } else if (browserLang.startsWith('zh')) {
        return 'zh';
      } else if (browserLang.startsWith('ko')) {
        return 'ko';
      } else {
        // 対応言語以外（例: fr, de, esなど）はすべてデフォルトで英語を適用
        return 'en';
      }
    }

    /**
     * 選択言語に応じたタイトル画面背景画像の自動切り替え関数
     * @param {string} lang - 'ja' | 'en' | 'zh' | 'ko'
     */
    function updateTitleBackground(lang) {
      const titleContainer = document.getElementById('title-screen');
      const splashContainer = document.getElementById('splash-screen');

      const langCode = lang || currentAppLanguage || 'ja';
      let fileName = "";
      let splashFileName = "";

      switch (langCode) {
        case 'en':
          fileName = "TITLE_US.jpg";
          splashFileName = "TITLE_US.jpg";
          break;
        case 'zh':
          fileName = "TITLE_cin.jpg";
          splashFileName = "TITLE_cin.jpg";
          break;
        case 'ko':
          fileName = "TITLE_kol.jpg";
          splashFileName = "TITLE_kol.jpg";
          break;
        case 'ja':
        default:
          fileName = "jinnrouyoko.jpg"; // デフォルト日本語タイトル画像
          splashFileName = "o-puningu1.jpg"; // 日本語アトラクトスプラッシュ
          break;
      }

      // 1. タイトル画面（#title-screen）の背景画像更新
      if (titleContainer) {
        const imagePath = `./IMG/${fileName}`;
        if (titleContainer.tagName === 'IMG') {
          titleContainer.src = imagePath;
        } else {
          titleContainer.style.setProperty('background-image', `linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.55)), url('${imagePath}')`, 'important');
        }
      }

      // 2. スタート待機画面（#splash-screen）の背景画像更新（タップ前もずっと言語背景を表示）
      if (splashContainer) {
        const splashPath = `./IMG/${splashFileName}`;
        splashContainer.style.setProperty('background-image', `url('${splashPath}')`, 'important');
      }
    }

    // 2. 言語切り替えハンドラ
    function changeLanguage(langCode) {
      if (!I18N_TRANSLATIONS[langCode]) langCode = 'en';
      currentAppLanguage = langCode;
      localStorage.setItem('user_selected_language', langCode);

      const langSelect = document.getElementById('language-setting');
      if (langSelect && langSelect.value !== langCode) {
        langSelect.value = langCode;
      }

      applyLanguageToUI(langCode);
      updateTitleBackground(langCode);
    }

    // 3. UIテキスト一括適用処理
    function applyLanguageToUI(langCode) {
      const lang = langCode || currentAppLanguage || 'ja';
      const t = I18N_TRANSLATIONS[lang] || I18N_TRANSLATIONS.en;

      // ブラウザタブタイトル
      const titleMap = {
        ja: "ぼっち人狼 〜審判の勇者〜",
        en: "Solo Werewolf ~The Judgment of the Hero~",
        zh: "独行人狼 〜审判之勇者〜",
        ko: "나홀로 늑대인간 〜심판의 용사〜"
      };
      document.title = titleMap[lang] || titleMap.ja;

      // タイトル画面
      document.querySelectorAll('.main-title').forEach(el => {
        el.innerHTML = t.main_title;
      });

      // ゲーム画面ヘッダータイトル
      const headerTitleMap = {
        ja: 'ぼっち人狼 <span>〜審判の勇者〜</span>',
        en: 'Solo Werewolf <span>~The Judgment of the Hero~</span>',
        zh: '独行人狼 <span>〜审判之勇者〜</span>',
        ko: '나홀로 늑대인간 <span>〜심판의 용사〜</span>'
      };
      document.querySelectorAll('.game-header-title').forEach(el => {
        el.innerHTML = headerTitleMap[lang] || headerTitleMap.ja;
      });

      document.querySelectorAll('.title-sub-buttons').forEach(group => {
        const btns = group.querySelectorAll('.btn-title-sub');
        if (btns.length >= 2) {
          btns[0].textContent = t.how_to_play;
          btns[1].textContent = t.hero_rank;
          if (btns.length >= 3) {
            btns[2].textContent = t.settings;
          }
        }
      });

      const titleMainButtons = document.querySelectorAll('.title-main-menu-buttons .btn-start-game');
      if (titleMainButtons.length >= 2) {
        titleMainButtons[0].innerHTML = t.start_new;
        titleMainButtons[1].innerHTML = t.open_save;
      }

      const tabNormal = document.getElementById('tab-cat-normal');
      if (tabNormal) tabNormal.textContent = t.tab_normal;
      const tabDaily = document.getElementById('tab-cat-daily');
      if (tabDaily) tabDaily.textContent = t.tab_daily;
      const tabCustom = document.getElementById('tab-cat-custom');
      if (tabCustom) tabCustom.textContent = t.tab_custom;

      const modeSelectTitle = document.querySelector('.mode-select-title');
      if (modeSelectTitle) modeSelectTitle.textContent = t.mode_select_title;

      // ゲーム画面ヘッダー
      const btnTitleMini = document.querySelector('.btn-title-mini');
      if (btnTitleMini) btnTitleMini.textContent = t.to_title;

      const navBtn0 = document.getElementById('nav-btn-0');
      if (navBtn0 && navBtn0.querySelector('span')) navBtn0.querySelector('span').textContent = t.nav_tab_0;
      const navBtn1 = document.getElementById('nav-btn-1');
      if (navBtn1 && navBtn1.querySelector('span')) navBtn1.querySelector('span').textContent = t.nav_tab_1;
      const navBtn2 = document.getElementById('nav-btn-2');
      if (navBtn2 && navBtn2.querySelector('span')) navBtn2.querySelector('span').textContent = t.nav_tab_2;

      // 村人一覧タイトル
      const villagerListHeader = document.getElementById('villager-list-header');
      if (villagerListHeader && t.villager_list_title) villagerListHeader.textContent = t.villager_list_title;

      // アコーディオン開閉ボタン初期化
      document.querySelectorAll('.card-header').forEach(header => {
        const body = header.nextElementSibling;
        const icon = header.querySelector('.toggle-icon');
        if (icon && body) {
          icon.textContent = body.classList.contains('collapsed') ? (t.open_text || '開く') : (t.close_text || '閉じる');
        }
      });

      // 尋問パネル
      const massTitle = document.querySelector('.mass-call-title');
      if (massTitle) massTitle.textContent = t.mass_call_title;

      const btnMassSeer = document.getElementById('btn-mass-seer');
      if (btnMassSeer) btnMassSeer.textContent = t.btn_mass_seer;
      const btnMassMedium = document.getElementById('btn-mass-medium');
      if (btnMassMedium) btnMassMedium.textContent = t.btn_mass_medium;
      const btnMassKnight = document.getElementById('btn-mass-knight');
      if (btnMassKnight) btnMassKnight.textContent = t.btn_mass_knight;

      const btnQ1 = document.getElementById('btn-q1');
      if (btnQ1) btnQ1.textContent = t.btn_q1;
      const btnQ2 = document.getElementById('btn-q2');
      if (btnQ2) btnQ2.textContent = t.btn_q2;
      const btnQ3 = document.getElementById('btn-q3');
      if (btnQ3) btnQ3.textContent = t.btn_q3;

      const customInput = document.getElementById('custom-question-input');
      if (customInput) customInput.placeholder = t.custom_question_placeholder;
      const btnCustomQ = document.getElementById('btn-custom-q');
      if (btnCustomQ) btnCustomQ.textContent = t.btn_custom_q;

      const btnGotoDecision = document.getElementById('btn-goto-decision');
      if (btnGotoDecision) btnGotoDecision.textContent = t.btn_goto_decision;
      const btnExecute = document.getElementById('btn-execute');
      if (btnExecute) btnExecute.textContent = t.btn_execute;
      const btnSkipExecute = document.getElementById('btn-skip-execute');
      if (btnSkipExecute) btnSkipExecute.textContent = t.btn_skip_execute;

      // 設定モーダル
      const settingsH2 = document.querySelector('#settings-modal .modal-header h2');
      if (settingsH2) settingsH2.textContent = t.settings_title;
      const lblLang = document.getElementById('lbl-language-setting');
      if (lblLang) lblLang.textContent = t.lbl_language;
      const btnOpenName = document.getElementById('btn-open-name-modal');
      if (btnOpenName) btnOpenName.textContent = t.btn_custom_names;

      const lblDiscTime = document.querySelector('label[for="discussion-time-setting"]');
      if (lblDiscTime) lblDiscTime.textContent = t.lbl_discussion_time;
      const lblBgm = document.querySelector('label[for="bgm-volume"]');
      if (lblBgm) lblBgm.textContent = t.lbl_bgm_vol;
      const lblSe = document.querySelector('label[for="se-volume"]');
      if (lblSe) lblSe.textContent = t.lbl_se_vol;
      const lblVoice = document.querySelector('label[for="voice-volume"]');
      if (lblVoice) lblVoice.textContent = t.lbl_voice_vol;
      const lblSpeechToggle = document.getElementById('lbl-speech-enabled');
      if (lblSpeechToggle && t.lbl_speech_enabled) lblSpeechToggle.textContent = t.lbl_speech_enabled;

      const settingsClose = document.querySelector('#settings-modal .modal-footer .btn-primary');
      if (settingsClose) settingsClose.textContent = t.btn_close;

      const timerLabel = document.getElementById('timer-label');
      if (timerLabel) timerLabel.textContent = t.timer_label;

      // ゲーム画面ヘッダーアイコンボタン（タイトル画面と共通/個別）
      const gameHeaderButtons = document.querySelectorAll('#game-screen header .btn-header-icon');
      if (gameHeaderButtons.length >= 4) {
        gameHeaderButtons[0].textContent = t.header_how_to_play;
        gameHeaderButtons[1].textContent = t.header_rank;
        gameHeaderButtons[2].textContent = t.header_save;
        gameHeaderButtons[3].textContent = t.header_settings;
      }

      // Page 2: 確定情報・過去ログ・思考整理・一時停止ボタン
      const bulletinTitle = document.querySelector('.bulletin-title');
      if (bulletinTitle) bulletinTitle.textContent = t.bulletin_title;
      const morningTitle = document.querySelector('.morning-title');
      if (morningTitle) morningTitle.textContent = t.morning_title;
      const timelineHeader = document.querySelector('.carousel-container .view-page:nth-child(3) > div:nth-child(2) > div:first-child');
      if (timelineHeader) timelineHeader.textContent = t.timeline_header;

      const btnMindBoard = document.getElementById('btn-open-mind-board');
      if (btnMindBoard && btnMindBoard.querySelector('span')) {
        btnMindBoard.querySelector('span').textContent = t.btn_mind_board;
      }

      const btnPauseDisc = document.getElementById('btn-toggle-discussion-pause');
      if (btnPauseDisc && btnPauseDisc.querySelector('span')) {
        btnPauseDisc.querySelector('span').textContent = (typeof isDiscussionPaused !== 'undefined' && isDiscussionPaused) ? (t.btn_resume_disc || '▶️ Resume Trial') : (t.btn_pause_disc || '⏸️ Pause Trial');
      }

      // 読み上げスキップボタン
      const skipBtn = document.getElementById('speech-skip-btn') || document.querySelector('#speech-skip-overlay .skip-badge');
      if (skipBtn && t.skip_speech_btn) skipBtn.textContent = t.skip_speech_btn;

      // ステータスバー（規模・日数・信頼度ラベル）
      const lblSize = document.getElementById('lbl-village-size');
      if (lblSize && t.village_size_label) lblSize.textContent = t.village_size_label;
      const lblDay = document.getElementById('lbl-day-display');
      if (lblDay && t.day_label) lblDay.textContent = t.day_label;
      const trustBarLabel = document.querySelector('#trust-bar-container > span:first-child');
      if (trustBarLabel) trustBarLabel.textContent = t.trust_label;

      // タイトル画面：村選択カード（6/8/10/15/30人）
      const updateCard = (size, titleKey, descKey) => {
        const modeEl = document.getElementById(`mode-${size}`);
        if (modeEl) {
          const headerSpan = modeEl.querySelector('.mode-header span');
          if (headerSpan && t[titleKey]) headerSpan.textContent = t[titleKey];
          const descEl = modeEl.querySelector('.mode-desc');
          if (descEl && t[descKey]) descEl.textContent = t[descKey];
        }
      };
      updateCard(6, 'card_6_title', 'card_6_desc');
      updateCard(8, 'card_8_title', 'card_8_desc');
      updateCard(10, 'card_10_title', 'card_10_desc');
      updateCard(15, 'card_15_title', 'card_15_desc');
      updateCard(30, 'card_30_title', 'card_30_desc');

      // デイリー & カスタムカードのタイトルと説明
      const dailyDateTitle = document.getElementById('daily-date-title');
      if (dailyDateTitle && t.daily_date_title) dailyDateTitle.textContent = t.daily_date_title;
      const customCardTitle = document.querySelector('#category-container-custom .daily-card-header span');
      if (customCardTitle && t.custom_card_title) customCardTitle.textContent = t.custom_card_title;
      const customSummaryDesc = document.getElementById('custom-summary-desc');
      if (customSummaryDesc && t.custom_summary_default) customSummaryDesc.textContent = t.custom_summary_default;
      const openCustomBtn = document.querySelector('#category-container-custom button.btn-primary');
      if (openCustomBtn && t.btn_open_custom_config) openCustomBtn.textContent = t.btn_open_custom_config;

      // タイトルアクションボタン
      const btnStartGameMain = document.getElementById('btn-start-game-main');
      if (btnStartGameMain && t.btn_start_free_game) btnStartGameMain.textContent = t.btn_start_free_game;
      const titleActionBtns = document.querySelectorAll('.title-action-buttons button.btn-secondary');
      if (titleActionBtns.length >= 2) {
        if (t.btn_return_mode_select) titleActionBtns[0].textContent = t.btn_return_mode_select;
        if (t.btn_return_title) titleActionBtns[1].textContent = t.btn_return_title;
      }

      // 遠征モード選択モーダル (#mode-select-modal)
      const modeSelectH2 = document.querySelector('#mode-select-modal .modal-header h2');
      if (modeSelectH2 && t.mode_select_header) modeSelectH2.textContent = t.mode_select_header;
      const modeSelectGuide = document.querySelector('#mode-select-modal .modal-body > div:first-child');
      if (modeSelectGuide && t.mode_select_guide) modeSelectGuide.textContent = t.mode_select_guide;
      const modeStoryBox = document.querySelector('#mode-select-modal [onclick*="story"]');
      if (modeStoryBox) {
        const titleSpan = modeStoryBox.querySelector('div:first-child > span:first-child');
        if (titleSpan && t.mode_story_title) titleSpan.innerHTML = t.mode_story_title;
        const badgeSpan = modeStoryBox.querySelector('div:first-child > span:last-child');
        if (badgeSpan && t.mode_story_badge) badgeSpan.textContent = t.mode_story_badge;
        const descDiv = modeStoryBox.querySelector('div:nth-child(2)');
        if (descDiv && t.mode_story_desc) descDiv.textContent = t.mode_story_desc;
      }
      const modeFreeBox = document.querySelector('#mode-select-modal [onclick*="free"]');
      if (modeFreeBox) {
        const titleSpan = modeFreeBox.querySelector('div:first-child > span:first-child');
        if (titleSpan && t.mode_free_title) titleSpan.innerHTML = t.mode_free_title;
        const badgeSpan = modeFreeBox.querySelector('div:first-child > span:last-child');
        if (badgeSpan && t.mode_free_badge) badgeSpan.textContent = t.mode_free_badge;
        const descDiv = modeFreeBox.querySelector('div:nth-child(2)');
        if (descDiv && t.mode_free_desc) descDiv.textContent = t.mode_free_desc;
      }
      const modeSelectBackBtn = document.querySelector('#mode-select-modal .modal-footer .btn-secondary');
      if (modeSelectBackBtn && t.btn_back) modeSelectBackBtn.textContent = t.btn_back;

      // 冒険の書モーダル (#save-slot-modal)
      const saveModalH2 = document.querySelector('#save-slot-modal .modal-header h2');
      if (saveModalH2 && t.save_book_header) saveModalH2.textContent = t.save_book_header;
      const saveModalDesc = document.querySelector('#save-slot-modal .modal-body > div:first-child');
      if (saveModalDesc && t.save_book_desc) saveModalDesc.textContent = t.save_book_desc;
      const saveModalCloseBtn = document.querySelector('#save-slot-modal .modal-footer .btn-primary');
      if (saveModalCloseBtn && t.btn_close) saveModalCloseBtn.textContent = t.btn_close;
      renderSaveModalContent();

      // 遊び方モーダル (#how-to-play-modal)
      const howToPlayH2 = document.querySelector('#how-to-play-modal .modal-header h2');
      if (howToPlayH2 && t.how_to_play_title) howToPlayH2.textContent = t.how_to_play_title;
      const howToPlayCloseBtn = document.querySelector('#how-to-play-modal .modal-footer .btn-primary');
      if (howToPlayCloseBtn && t.btn_close) howToPlayCloseBtn.textContent = t.btn_close;
      renderHowToPlayModalContent(lang);

      // 章選択モーダル (#story-chapter-modal)
      const storyModalH2 = document.querySelector('#story-chapter-modal .modal-header h2');
      if (storyModalH2) {
        storyModalH2.textContent = lang === 'en' ? '📜 Expedition Chronicle - Chapter Select' :
          (lang === 'zh' ? '📜 勇者远征记 - 章节选择' :
          (lang === 'ko' ? '📜 용사의 원정기 - 장 선택' :
          '📜 勇者の遠征記 - 章選択'));
      }
      const storyResetBtn = document.querySelector('#story-chapter-modal .modal-footer .btn:first-child');
      if (storyResetBtn) {
        storyResetBtn.textContent = lang === 'en' ? '🔄 Full Reset' :
          (lang === 'zh' ? '🔄 全部重置' :
          (lang === 'ko' ? '🔄 전체 리셋' :
          '🔄 全リセット'));
      }
      const storyBackBtn = document.querySelector('#story-chapter-modal .modal-footer .btn-secondary');
      if (storyBackBtn) {
        storyBackBtn.textContent = lang === 'en' ? 'Back' :
          (lang === 'zh' ? '返回' :
          (lang === 'ko' ? '돌아가기' :
          '戻る'));
      }

      // オープニングストーリーモーダル (#opening-story-modal)
      const storySkipBtn = document.querySelector('#opening-story-modal .btn-secondary');
      if (storySkipBtn) {
        storySkipBtn.textContent = lang === 'en' ? '⏩ Skip' :
          (lang === 'zh' ? '⏩ 跳过' :
          (lang === 'ko' ? '⏩ 스킵' :
          '⏩ スキップ'));
      }

      // ランクモーダル (#rank-info-modal)
      const rankInfoH2 = document.querySelector('#rank-info-modal .modal-header h2');
      if (rankInfoH2 && t.hero_rank) rankInfoH2.textContent = t.hero_rank;
      const rankInfoCloseBtn = document.querySelector('#rank-info-modal .modal-footer .btn-primary');
      if (rankInfoCloseBtn && t.btn_close) rankInfoCloseBtn.textContent = t.btn_close;

      // 設定モーダル内のセレクト option 要素
      const discTimeSelect = document.getElementById('discussion-time-setting');
      if (discTimeSelect && discTimeSelect.options.length >= 4) {
        if (t.time_opt_300) discTimeSelect.options[0].textContent = t.time_opt_300;
        if (t.time_opt_180) discTimeSelect.options[1].textContent = t.time_opt_180;
        if (t.time_opt_600) discTimeSelect.options[2].textContent = t.time_opt_600;
        if (t.time_opt_inf) discTimeSelect.options[3].textContent = t.time_opt_inf;
      }
      const speechSelect = document.getElementById('speech-enabled-toggle');
      if (speechSelect && speechSelect.options.length >= 2) {
        if (t.opt_on) speechSelect.options[0].textContent = t.opt_on;
        if (t.opt_off) speechSelect.options[1].textContent = t.opt_off;
      }

      // 村人名前設定モーダル (#name-settings-modal)
      const nameModalH2 = document.querySelector('#name-settings-modal .modal-header h2');
      if (nameModalH2 && t.name_settings_title) nameModalH2.textContent = t.name_settings_title;
      const nameModalDesc = document.querySelector('#name-settings-modal .modal-body p');
      if (nameModalDesc && t.name_settings_desc) nameModalDesc.textContent = t.name_settings_desc;
      const btnAuto = document.getElementById('btn-name-random-auto');
      if (btnAuto && t.btn_random_auto) btnAuto.textContent = t.btn_random_auto;
      const btnJa = document.getElementById('btn-name-random-ja');
      if (btnJa && t.btn_random_japanese) btnJa.textContent = t.btn_random_japanese;
      const btnWestern = document.getElementById('btn-name-random-western');
      if (btnWestern && t.btn_random_western) btnWestern.textContent = t.btn_random_western;
      const btnZh = document.getElementById('btn-name-random-zh');
      if (btnZh && t.btn_random_chinese) btnZh.textContent = t.btn_random_chinese;
      const btnKo = document.getElementById('btn-name-random-ko');
      if (btnKo && t.btn_random_korean) btnKo.textContent = t.btn_random_korean;
      const btnDefault = document.getElementById('btn-name-reset-default');
      if (btnDefault && t.btn_reset_default_names) btnDefault.textContent = t.btn_reset_default_names;
      const nameModalCancel = document.querySelector('#name-settings-modal .modal-footer .btn-secondary');
      if (nameModalCancel && t.btn_cancel) nameModalCancel.textContent = t.btn_cancel;
      const nameModalSave = document.querySelector('#name-settings-modal .modal-footer .btn-primary');
      if (nameModalSave && t.btn_save_settings) nameModalSave.textContent = t.btn_save_settings;

      // 思考整理ボードモーダル (#mind-board-modal)
      const mindBoardH2 = document.querySelector('#mind-board-modal .modal-header h2');
      if (mindBoardH2 && t.mind_board_title) mindBoardH2.textContent = t.mind_board_title;
      const mindTabCorr = document.getElementById('mind-tab-corr');
      if (mindTabCorr && t.mind_tab_corr_text) mindTabCorr.textContent = t.mind_tab_corr_text;
      const mindTabMarkers = document.getElementById('mind-tab-markers');
      if (mindTabMarkers && t.mind_tab_markers_text) mindTabMarkers.textContent = t.mind_tab_markers_text;
      const mindCorrGuide = document.querySelector('#mind-tab-content-corr > div:first-child');
      if (mindCorrGuide && t.mind_corr_guide) mindCorrGuide.textContent = t.mind_corr_guide;
      const mindArrowTypeLabel = document.querySelector('.corr-tool-bar > span:first-child');
      if (mindArrowTypeLabel && t.mind_arrow_type_label) mindArrowTypeLabel.textContent = t.mind_arrow_type_label;
      const mindResetBtn = document.querySelector('.corr-tool-bar .btn-secondary');
      if (mindResetBtn && t.btn_reset_all) mindResetBtn.textContent = t.btn_reset_all;
      const mindLinesTitle = document.querySelector('#mind-tab-content-corr > div:nth-child(3) > div:first-child');
      if (mindLinesTitle && t.mind_lines_list_title) mindLinesTitle.textContent = t.mind_lines_list_title;
      const mindMarkersGuide = document.querySelector('#mind-tab-content-markers > div:first-child');
      if (mindMarkersGuide && t.mind_marked_logs_guide) mindMarkersGuide.textContent = t.mind_marked_logs_guide;
      const mindCloseBtn = document.querySelector('#mind-board-modal .modal-footer .btn-primary');
      if (mindCloseBtn && t.btn_close) mindCloseBtn.textContent = t.btn_close;

      // 誤審テロップ
      const mislynchTextEl = document.querySelector('.mislynch-banner-text');
      if (mislynchTextEl && t.mislynch_banner) mislynchTextEl.textContent = t.mislynch_banner;

      // 動画スキップボタン
      const videoSkipBtn = document.querySelector('.execution-video-skip-btn');
      if (videoSkipBtn && t.btn_skip_video) videoSkipBtn.textContent = t.btn_skip_video;

      // トースト通知
      const toastMsgEl = document.getElementById('toast-message');
      if (toastMsgEl && t.toast_lightweight_ai) toastMsgEl.textContent = t.toast_lightweight_ai;

      // カスタム確認モーダルボタン
      const confirmTitleEl = document.getElementById('custom-confirm-title');
      if (confirmTitleEl && t.confirm_title) confirmTitleEl.textContent = t.confirm_title;
      const confirmCancelBtn = document.getElementById('custom-confirm-btn-cancel');
      if (confirmCancelBtn && t.btn_cancel) confirmCancelBtn.textContent = t.btn_cancel;
      const confirmOkBtn = document.getElementById('custom-confirm-btn-ok');
      if (confirmOkBtn && t.btn_confirm_ok) confirmOkBtn.textContent = t.btn_confirm_ok;

      // 仮想投票タイトル
      const voteHistHeader = document.querySelector('#carousel-container .view-page:first-child > div:first-child');
      if (voteHistHeader && t.vote_history_title) voteHistHeader.textContent = t.vote_history_title;

      // 警告テキスト
      const actionWarningEl = document.getElementById('action-warning');
      if (actionWarningEl && t.action_warning_timeout) actionWarningEl.textContent = t.action_warning_timeout;

      // 各モーダル・画面の動的再描画
      if (typeof renderStatus === 'function') renderStatus();
      if (typeof updateVillageSizeDisplay === 'function') updateVillageSizeDisplay();
      if (typeof renderCharacters === 'function') renderCharacters();
      if (typeof renderVoteHistoryPage === 'function') renderVoteHistoryPage();
      if (typeof renderBulletinBoard === 'function') renderBulletinBoard();
      if (typeof renderMorningCommentsBox === 'function') renderMorningCommentsBox();
      if (typeof renderSaveModalContent === 'function') renderSaveModalContent();
      if (typeof renderStoryChapterModalContent === 'function') renderStoryChapterModalContent();
      if (typeof updateTitleSaveSlotUI === 'function') updateTitleSaveSlotUI();
      if (typeof updateTitleBackground === 'function') updateTitleBackground(lang);
    }

    /**
     * 📖 遊び方モーダル（#how-to-play-modal）の多言語コンテンツ描画
     */
    function renderHowToPlayModalContent(lang) {
      const container = document.querySelector('#how-to-play-modal .rule-explanation');
      if (!container) return;

      const currentLang = lang || currentAppLanguage || 'ja';

      if (currentLang === 'en') {
        container.innerHTML = `
          <div class="rule-section">
            <h3>【Controls】</h3>
            <p>During the Daytime Judgment Conference, switch between the left, center, and right screens. Swipe and deduce to find clues pointing to the Mimic Monsters!</p>
          </div>

          <div class="rule-section">
            <h3>【Game Objective】</h3>
            <p>Uncover the "Mimic Monsters" hiding among the villagers disguised as humans through interrogation and reasoning. Purify them with the Hero's Judgment to restore peace to the village!</p>
          </div>

          <div class="rule-section">
            <h3>【Basic Flow】</h3>
            <ul>
              <li><strong>☀️ Morning Phase:</strong> Review victims of the monster's night attack and Coming Out (CO) reports from various roles.</li>
              <li><strong>💬 Daytime Judgment Conference (3 min):</strong> Observe surviving villagers' statements, interrogate them using preset or custom questions, and organize suspected roles with Mind Board notes.</li>
              <li><strong>⚖️ Hero's Judgment (Untimed):</strong> At the end of the day, select the most suspicious person to execute (purify) or choose to skip.</li>
              <li><strong>🌕 Monster's Night Attack:</strong> The Mimic Monster attacks a villager, while Sages and Clerics use abilities to inspect identities.</li>
            </ul>
          </div>

          <div class="rule-section">
            <h3>【Main Roles】</h3>
            <div class="role-grid">
              <div class="role-item"><span class="role-badge role-villager">Villager</span> Ordinary citizen with no special powers. Leads the village through keen observation and deduction.</div>
              <div class="role-item"><span class="role-badge role-seer">Sage</span> Inspects one person each night to determine whether they are human or monster.</div>
              <div class="role-item"><span class="role-badge role-medium">Cleric</span> Communicates with spirits each night to reveal the true identity of the person executed the previous day.</div>
              <div class="role-item"><span class="role-badge role-knight">Holy Knight</span> Protects one person each night from the monster's attack.</div>
              <div class="role-item"><span class="role-badge role-wolf">Mimic Monster</span> Evil beast disguised as human. Attacks and devours one villager each night.</div>
              <div class="role-item"><span class="role-badge role-madman">Cultist</span> Human aligned with the monsters. Seeks monster victory at all costs.</div>
              <div class="role-item"><span class="role-badge role-baker">Baker</span> Delivers delicious warm bread to the village every morning while alive.</div>
              <div class="role-item"><span class="role-badge role-freemason">Mason</span> A pair of villagers who know each other are innocent humans.</div>
              <div class="role-item"><span class="role-badge role-fox">Specter Fox</span> Survives night attacks, but instantly dies if inspected by a Sage. Wins alone.</div>
            </div>
          </div>

          <div class="rule-section">
            <h3>【Shop Unlock Roles & Features】</h3>
            <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.5rem;">※Special roles and features unlockable with Victory Points (P) for Custom Villages.</p>
            <div class="role-grid">
              <div class="role-item"><span class="role-badge role-cakeshop">🍰 Patissier</span> (6P) Delivers delicious cake to the village every morning while alive.</div>
              <div class="role-item"><span class="role-badge role-freemason">🤝 Mason Pair</span> (10P) A duo recognizing each other as fellow humans from Day 1.</div>
              <div class="role-item"><span class="role-badge role-hunter">🏹 Hunter</span> (16P) A skilled villager capable of guarding someone each night against monster strikes.</div>
              <div class="role-item"><span class="role-badge role-nekomata">🐾 Nekomata</span> (20P) Drags a random voter to death if executed, or drags the attacking monster to death if slain at night.</div>
              <div class="role-item"><span class="role-badge role-fanatic">🔮 Fanatic</span> (22P) A devoted cultist who knows the exact identities of all monsters from the start.</div>
              <div class="role-item"><span class="role-badge role-bodyguard">🕶️ Bodyguard</span> (24P) Guards one person each night, sacrificing their own life if that target is attacked.</div>
              <div class="role-item"><span class="role-badge role-immoral">🍷 Corruptor</span> (26P) Knows the Specter Fox's identity and works exclusively to assist the Fox's solitary victory.</div>
              <div class="role-item"><span class="role-badge role-fox">🦊 Specter Fox</span> (30P) 3rd party faction; immune to attacks, but cursed if appraised by a Sage.</div>
              <div class="role-item"><span class="role-badge role-villager" style="background:#6366f1;">👥 Up to 30 Players</span> (30P) Expands village capacity up to 30, unlocking the legendary "Mythic Village (30 Players)".</div>
            </div>
          </div>

          <div class="rule-section">
            <h3>【Victory Conditions】</h3>
            <p><strong>🔵 Hero & Villager Camp:</strong> Purify and eradicate all Mimic Monsters</p>
            <p><strong>🔴 Mimic Monster Camp:</strong> The number of monsters equals or exceeds the number of surviving villagers</p>
            <p><strong>🦊 Specter Fox:</strong> Survives until the end of the game (Solitary Victory)</p>
          </div>
        `;
      } else if (currentLang === 'zh') {
        container.innerHTML = `
          <div class="rule-section">
            <h3>【操作方法】</h3>
            <p>白天的审判会议可在左、中、右3个画面间切换，通过滑动与推理寻找潜伏拟态魔物的线索！</p>
          </div>

          <div class="rule-section">
            <h3>【游戏目的】</h3>
            <p>通过讯问与逻辑推理，找出伪装成人类潜藏在村子里的“拟态魔物”，以勇者的审判将其净化，为村庄夺回和平！</p>
          </div>

          <div class="rule-section">
            <h3>【基本流程】</h3>
            <ul>
              <li><strong>☀️ 清晨阶段:</strong> 确认昨夜遇害者（魔物夜袭）以及各神职人员的CO（身份自告）报告。</li>
              <li><strong>💬 白天审判会议 (3分钟):</strong> 观察生存村民的言论，使用固定问答或自由讯问排查可疑点，并在思维看板中整理角色推理。</li>
              <li><strong>⚖️ 勇者的审判 (无时限):</strong> 白天结束时挑选1名最可疑的人进行净化（处刑）或选择弃权。</li>
              <li><strong>🌕 魔物夜袭:</strong> 拟态魔物袭击村民，贤者与圣职者则发动能力进行身份查验或招魂通灵。</li>
            </ul>
          </div>

          <div class="rule-section">
            <h3>【主要角色介绍】</h3>
            <div class="role-grid">
              <div class="role-item"><span class="role-badge role-villager">村民</span> 无特殊能力的普通市民。依靠敏锐的观察与推理引导村庄走向胜利。</div>
              <div class="role-item"><span class="role-badge role-seer">贤者</span> 每晚可查验一人身份，判明其为人类还是魔物。</div>
              <div class="role-item"><span class="role-badge role-medium">圣职者</span> 每晚可通灵前一天被处刑（净化）者的真实身份。</div>
              <div class="role-item"><span class="role-badge role-knight">圣骑士</span> 每晚可守护一人免受魔物夜袭。</div>
              <div class="role-item"><span class="role-badge role-wolf">拟态魔物</span> 伪装成人类的邪恶存在。每晚袭击吞噬一名村民。</div>
              <div class="role-item"><span class="role-badge role-madman">魔教徒</span> 站在魔物阵营的人类。以魔物的胜利为终极目标。</div>
              <div class="role-item"><span class="role-badge role-baker">面包师</span> 只要存活，每天清晨都会为全村送上面包。</div>
              <div class="role-item"><span class="role-badge role-freemason">共有者</span> 互相确认彼此为人类同伴的2人组合。</div>
              <div class="role-item"><span class="role-badge role-fox">妖狐</span> 免疫夜袭，但若被贤者查验则会被咒杀。第三阵营单独立场。</div>
            </div>
          </div>

          <div class="rule-section">
            <h3>【商店解锁角色与功能】</h3>
            <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.5rem;">※消耗胜利点数（P）在自定义村庄中解锁的特殊角色与功能。</p>
            <div class="role-grid">
              <div class="role-item"><span class="role-badge role-cakeshop">🍰 蛋糕师</span> (6P) 只要存活，每天早晨为全村送上可口蛋糕。</div>
              <div class="role-item"><span class="role-badge role-freemason">🤝 共有者搭档</span> (10P) 2人成对，从第一天起就互相确认彼此清白。</div>
              <div class="role-item"><span class="role-badge role-hunter">🏹 猎人</span> (16P) 具备守卫能力的村民护卫手，每晚可保护一人免遭袭击。</div>
              <div class="role-item"><span class="role-badge role-nekomata">🐾 猫又</span> (20P) 处刑时随机拖一名投票者陪葬；夜间被杀时拉袭击者陪葬。</div>
              <div class="role-item"><span class="role-badge role-fanatic">🔮 狂信者</span> (22P) 开局即完全掌握所有魔物真实身份的疯狂信徒。</div>
              <div class="role-item"><span class="role-badge role-bodyguard">🕶️ 替身护卫</span> (24P) 每晚护卫一人，目标遇袭时代替其牺牲。</div>
              <div class="role-item"><span class="role-badge role-immoral">🍷 背德者</span> (26P) 熟知妖狐真身，全心辅佐妖狐实现单独胜利。</div>
              <div class="role-item"><span class="role-badge role-fox">🦊 妖狐</span> (30P) 免疫魔物袭击，但被贤者识破时咒杀的第三阵营。</div>
              <div class="role-item"><span class="role-badge role-villager" style="background:#6366f1;">👥 最大30人村</span> (30P) 将村庄人数扩充至30人，解锁史诗级“神话之村（30人）”。</div>
            </div>
          </div>

          <div class="rule-section">
            <h3>【胜败条件】</h3>
            <p><strong>🔵 勇者与村民阵营胜利:</strong> 彻底净化所有拟态魔物</p>
            <p><strong>🔴 拟态魔物阵营胜利:</strong> 魔物人数达到或超过幸存村民人数</p>
            <p><strong>🦊 妖狐胜利:</strong> 游戏结束时妖狐依然存活（单独胜利）</p>
          </div>
        `;
      } else if (currentLang === 'ko') {
        container.innerHTML = `
          <div class="rule-section">
            <h3>【조작 방법】</h3>
            <p>낮의 심판 회의는 좌/중/우 3개 화면을 전환하며, 스와이프와 추리를 통해 의태 몬스터(마물)를 밝혀낼 단서를 포착하세요!</p>
          </div>

          <div class="rule-section">
            <h3>【게임 목적】</h3>
            <p>마을 사람으로 둔갑해 숨어든 「의태 몬스터(마물)」를 심문과 논리적 추리로 밝혀내고, 용사의 심판으로 정화하여 마을에 평화를 되찾으세요!</p>
          </div>

          <div class="rule-section">
            <h3>【기본 진행 순서】</h3>
            <ul>
              <li><strong>☀️ 아침 페이즈:</strong> 밤의 희생자(마물의 야습 피해) 및 각 직업의 CO(커밍아웃) 보고를 확인합니다.</li>
              <li><strong>💬 낮의 심판 회의 (3분):</strong> 생존한 마을 사람들의 발언을 관찰하고, 정형/자유 심문으로 의심스러운 점을 파헤칩니다. 마인드 보드로 추리를 정리할 수 있습니다.</li>
              <li><strong>⚖️ 용사의 심판 (무제한):</strong> 낮의 마지막에 가장 의심스러운 1명을 선택해 처형(정화)하거나 심판을 넘깁니다.</li>
              <li><strong>🌕 마물의 야습:</strong> 의태 몬스터가 주민을 습격하며, 현자와 성직자는 능력으로 정체를 감정/영시합니다.</li>
            </ul>
          </div>

          <div class="rule-section">
            <h3>【주요 직업 소개】</h3>
            <div class="role-grid">
              <div class="role-item"><span class="role-badge role-villager">마을사람</span> 특별한 능력이 없는 시민. 예리한 관찰과 추리로 마을을 승리로 이끕니다.</div>
              <div class="role-item"><span class="role-badge role-seer">현자</span> 매일 밤 1명을 감정하여 마물인지 인간인지 알아낼 수 있습니다.</div>
              <div class="role-item"><span class="role-badge role-medium">성직자</span> 매일 밤, 전날 처형(정화)된 인물의 진짜 정체를 영시할 수 있습니다.</div>
              <div class="role-item"><span class="role-badge role-knight">성기사</span> 매일 밤 1명을 마물의 야습으로부터 지킬 수 있습니다.</div>
              <div class="role-item"><span class="role-badge role-wolf">의태 몬스터</span> 인간으로 둔갑한 사악한 존재. 매일 밤 마을사람 1명을 습격합니다.</div>
              <div class="role-item"><span class="role-badge role-madman">마교도</span> 마물 진영에 선 인간. 마물의 승리를 목표로 마을을 혼란에 빠뜨립니다.</div>
              <div class="role-item"><span class="role-badge role-baker">제빵사</span> 살아있는 한 매일 아침 마을에 맛있는 빵을 배달합니다.</div>
